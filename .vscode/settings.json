{
    "[apex]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.python"
    },
    "[visualforce]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "commands.commands": [
        {
            "arguments": ["Salesforce Developer Setup"],
            "command": "terminals.runTerminalByName",
            "text": "$(play) Salesforce Developer Setup",
            "tooltip": "A script to initialize or refresh a Salesforce developer's setup"
        },
        {
            "arguments": ["Run LWC Tests"],
            "command": "terminals.runTerminalByName",
            "text": "$(play) Run LWC Tests",
            "tooltip": "Runs local LWC jest tests"
        },
        {
            "arguments": ["Ratchet"],
            "command": "terminals.runTerminalByName",
            "text": "$(play) Ratchet",
            "tooltip": "A script to list factory classes"
        }
    ],
    "editor.formatOnSave": true,
    "files.associations": {
        "*.json": "jsonc"
    },
    "git.mergeEditor": false,
    "merge-conflict.autoNavigateNextConflict.enabled": true,
    "prettier.bracketSpacing": false,
    "prettier.configPath": ".prettierrc",
    "prettier.documentSelectors": ["**/*.page", "**/*.component", "**/*.cmp"],
    "prettier.ignorePath": ".prettierignore",
    "prettier.jsxSingleQuote": true,
    "prettier.printWidth": 120,
    "prettier.requireConfig": true,
    "prettier.singleQuote": true,
    "prettier.tabWidth": 4,
    "python.formatting.provider": "black",
    "salesforcedx-vscode-apex.advanced.enable-completion-statistics": false,
    "salesforcedx-vscode-apex.enable-semantic-errors": false,
    "salesforcedx-vscode-apex.java.home": "",
    "salesforcedx-vscode-core.push-or-deploy-on-save.enabled": false,
    "salesforcedx-vscode-core.retrieve-test-code-coverage": true,
    "search.exclude": {
        "**/.sfdx": true,
        "**/bower_components": true,
        "**/node_modules": true
    },
    "terminal.integrated.cwd": "force-app/main/default",
    "terminals.terminals": [
        {
            "commands": [
                "[ -d 'bin/salesforce-developer-setup' ] && cd bin/salesforce-developer-setup",
                "./salesforce_developer_setup.sh"
            ],
            "description": "A script to initialize or refresh a Salesforce developer's setup",
            "focus": true,
            "icon": "code",
            "name": "Salesforce Developer Setup",
            "open": true,
            "recycle": true
        },
        {
            "commands": ["[ -d 'bin/ratchet' ] && cd bin/ratchet", "./install.sh", "exit"],
            "description": "A script to list factory classes",
            "focus": true,
            "icon": "code",
            "name": "Ratchet",
            "open": true,
            "recycle": true
        },
        {
            "commands": ["npm run test:unit"],
            "description": "Runs local LWC tests",
            "focus": true,
            "icon": "code",
            "name": "Run LWC Tests",
            "open": true,
            "recycle": true
        }
    ]
}
