{
    "commands.commands": [
        {
            "text": "$(terminal) Aliusito's Last Stand",
            "command": "terminals.runTerminalByName",
            "arguments": ["Aliusito's Last Stand"],
            "tooltip": "A script to safely move all relevant forked branches to the upstream"
        },
        {
            "text": "$(play) SF Developer Setup",
            "command": "terminals.runTerminalByName",
            "arguments": ["SF Developer Setup"],
            "tooltip": "A script to initialize or refresh a developer's setup"
        }
    ],
    "editor.formatOnSave": true,
    "files.associations": {
        "*.json": "jsonc"
    },
    "prettier.configPath": ".prettierrc",
    "prettier.ignorePath": ".prettierignore",
    "prettier.printWidth": 120,
    "prettier.tabWidth": 4,
    "prettier.bracketSpacing": false,
    "prettier.jsxSingleQuote": true,
    "prettier.singleQuote": true,
    "prettier.prettierPath": "/opt/homebrew/lib/node_modules/prettier",
    "prettier.requireConfig": true,
    "salesforcedx-vscode-core.push-or-deploy-on-save.enabled": false,
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/.sfdx": true
    },
    "terminal.integrated.cwd": "force-app/main/default",
    "terminals.terminals": [
        {
            "name": "Aliusito's Last Stand",
            "description": "A script to safely move all relevant forked branches to the upstream",
            "icon": "code",
            "commands": ["[ -d 'bin/aliusito' ] && cd bin/aliusito", "./aliusito_last_stand.sh", "sleep 120", "exit"],
            "recycle": true,
            "open": true,
            "focus": true
        },
        {
            "name": "SF Developer Setup",
            "description": "A script to initialize or refresh a Salesforce developer's setup",
            "icon": "code",
            "commands": [
                "[ -d 'bin/developer-setup' ] && cd bin/developer-setup",
                "./developer_setup.sh",
                "sleep 30",
                "pkill Code"
            ],
            "recycle": true,
            "open": true,
            "focus": true
        }
    ],
    "[apex]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.python"
    },
    "python.formatting.provider": "black"
}
