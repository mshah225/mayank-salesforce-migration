<aura:component description="ComboBoxMultiSelect">
    <aura:attribute name="value" type="String" />
    <aura:attribute name="options" type="List" />
    <aura:attribute name="label" type="String" />
    <aura:attribute name="class" type="String" />
    <aura:attribute name="placeholder" type="String" default="--Select--" />
    <aura:attribute name="required" type="Boolean" default="false" />
    <aura:attribute name="innerChangeLock" type="Boolean" default="false" />
    <aura:attribute
        name="variant"
        type="String"
        default="standard"
        description="Use only null, standard, or label-hidden."
    />
    <aura:method name="resetMultiSelect" action="{!c.clearOptions}" access="PUBLIC" />
    <aura:handler name="change" value="{!v.options}" action="{!c.resetOptions}" />
    <!-- Extract values from value and mark those options as selected -->
    <aura:handler name="change" value="{!v.value}" action="{!c.selectOptionsInValue}" />

    <div class="slds-col slds-size_1-of-1 slds-medium-size_1-of-3 slds-large-size_1-of-5">
        <div class="slds-form-element" style="padding: 0 !important">
            <div class="slds-combobox_container slds-has-selection">
                <div
                    aura:id="combobox-drop"
                    class="slds-combobox slds-dropdown-trigger slds-dropdown-trigger_click"
                    aria-expanded="false"
                    aria-haspopup="listbox"
                    role="combobox"
                    aria-label="{!v.label}"
                    aria-controls="{!v.label + 'dropdown'}"
                >
                    <div class="slds-combobox__form-element slds-input-has-icon slds-input-has-icon_right" role="none">
                        <lightning:input
                            aura:id="multi-select-combobox"
                            type="text"
                            label="{!v.label}"
                            placeholder="{!v.placeholder}"
                            readonly="true"
                            variant="{!v.variant}"
                            onclick="{!c.toggleDropdown}"
                            onblur="{!c.closeDropdown}"
                            class="slds-combobox__input compound-form-adjust cursor-initial"
                        />
                        <span class="slds-icon slds-input__icon slds-input__icon_right slds-icon-text-default">
                            <lightning:icon
                                class="icn slds-icon-text-default pointer"
                                iconName="utility:chevrondown"
                                size="x-small"
                            />
                        </span>
                    </div>
                    <div
                        id="{!v.label + 'dropdown'}"
                        class="slds-dropdown slds-dropdown_length-5 slds-dropdown_fluid"
                        role="listbox"
                        aria-label="{!v.label + ' Options'}"
                        aria-selected="false"
                    >
                        <ul
                            class="slds-listbox slds-listbox_vertical"
                            role="group"
                            aria-label="{!v.label + ' Options List'}"
                        >
                            <aura:if isTrue="{!not(empty(v.options))}">
                                <aura:iteration items="{!v.options}" var="option">
                                    <li
                                        aura:id="combobox-list-item"
                                        role="presentation"
                                        class="slds-listbox__item"
                                        onmousedown="{!c.toggleOption}"
                                        data-value="{!option.value}"
                                        aria-label="{!option.label}"
                                    >
                                        <div
                                            class="
                                                lds-media
                                                slds-listbox__option slds-listbox__option_plain
                                                slds-media_small
                                            "
                                            role="option"
                                            aria-selected="{!if(option.isSelected, 'true', 'false')}"
                                        >
                                            <span class="slds-media__figure slds-listbox__option-icon">
                                                <aura:if isTrue="{!option.isSelected}">
                                                    <span
                                                        class="
                                                            slds-icon_container
                                                            slds-icon-utility-check slds-current-color
                                                        "
                                                    >
                                                        <lightning:icon
                                                            class="icn slds-icon-text-default"
                                                            iconName="utility:check"
                                                            size="x-small"
                                                        />
                                                    </span>
                                                </aura:if>
                                            </span>
                                            <span class="slds-media__body">
                                                <a class="slds-truncate">{!option.label}</a>
                                            </span>
                                        </div>
                                    </li>
                                </aura:iteration>
                            </aura:if>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</aura:component>
