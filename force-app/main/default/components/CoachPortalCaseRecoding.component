<apex:component controller="CoachPortalCaseRecodingController" allowDML="true">
    <apex:includeScript value="/support/console/38.0/integration.js" />
    <apex:includeScript value="{! $Resource.jQuery_3_1_1}" />
    <apex:includeScript value="{! URLFOR($Resource.showMyCasesResources, 'showMyCasesResources/showMyCases.js') }" />
    <apex:stylesheet value="{! URLFOR($Resource.showMyCasesResources, 'showMyCasesResources/showMyCases.css') }" />
    <apex:stylesheet value="{! URLFOR($Resource.ASUTable, 'ASUTable.css')}" />
    <apex:stylesheet
        value="{!URLFOR($Resource.MyASUHeader4_3, 'MyASUHeader4_3/font-awesome-4.3.0/css/font-awesome.css')}"
    />

    <apex:attribute name="queryString" type="String" description="" assignTo="{!queryAttr}" />
    <apex:attribute name="transferOptions" type="SelectOption[]" description="" />
    <apex:attribute name="rerenderList" type="String" description="" />

    <apex:outputPanel id="rerenderMe" styleClass="ASUFont">
        <apex:form id="alius-format77777">
            <div class="headerFooter">
                <div class="toolbar">
                    <apex:outputPanel layout="inline" styleClass="button-group">
                        <apex:outputLink
                            styleClass="btn btn-default btn-md asu-primary"
                            value="javascript:;"
                            style="margin-right: 10px; margin-top: 5px"
                            onclick="toggleTransferModal(this)"
                            >Mass Transfer</apex:outputLink
                        >
                        <apex:commandLink
                            styleClass="btn btn-default btn-md asu-primary"
                            style="margin-top: 5px"
                            reRender="rerenderMe"
                            status="ASUAjaxStatus"
                        >
                            <apex:param name="refreshList" value="true" assignTo="{!refreshList}" />
                            <i style="padding-bottom: 3px; padding-top: 4px" class="fa fa-refresh fa-lg"></i>
                        </apex:commandLink>
                    </apex:outputPanel>
                    <apex:outputPanel
                        layout="block"
                        styleClass="input-group"
                        style="width: 100%; max-width: 250px; margin-top: 5px"
                    >
                        <apex:inputText
                            id="myStudentsInput"
                            value="{!searchString}"
                            html-placeholder="Filter Students"
                            onkeypress="return noenter(event);"
                            style="
                                padding: 6px 12px;
                                vertical-align: middle;
                                border-radius: 4px;
                                border: solid 1px #ccc;
                                font-size: 11pt;
                                border-top-right-radius: 0;
                                border-bottom-right-radius: 0;
                                border-right: none;
                                margin-right: 0px !important;
                            "
                            styleClass="form-control"
                        />
                        <apex:commandLink
                            id="searchStudentsBtn"
                            status="ASUAjaxStatus"
                            reRender="rerenderMe"
                            style="color: #555"
                            oncomplete="focusSearch()"
                            styleClass="input-group-append btn btn-md btn-light m-0 rounded-0"
                        >
                            <span class="fa fa-search" style="font-size: 16px !important" aria-hidden="true"></span>
                        </apex:commandLink>

                        <script>
                            function focusSearch() {
                                var input = document.getElementById('{!$Component.myStudentsInput}');
                                input.select();
                                var tmpStr = input.value;
                                input.value = '';
                                input.value = tmpStr;
                            }

                            jQuery(document).ready(function () {
                                var search = document.getElementById('{!$Component.myStudentsInput}');
                                jQuery(search).keypress(function (event) {
                                    if (event.which == 13) {
                                        event.preventDefault();
                                        var ele = document.getElementById('{!$Component.searchStudentsBtn}');
                                        ele.click();
                                        focusSearch();
                                    }
                                });
                            });
                        </script>

                        <apex:commandLink
                            action="{!resetSearch}"
                            status="ASUAjaxStatus"
                            reRender="rerenderMe"
                            style="
                                color: #555;
                                border-radius: 0px;
                                border-top-right-radius: 4px;
                                border-bottom-right-radius: 4px;
                            "
                            styleClass="input-group-append btn btn-md btn-light m-0"
                        >
                            <span class="fa fa-refresh" style="font-size: 16px !important" aria-hidden="true"></span>
                        </apex:commandLink>
                    </apex:outputPanel>
                </div>
                <div style="height: 1px; width = 100%"></div>
                <div>
                    <apex:outputPanel
                        layout="block"
                        styleClass="pageSizeSection"
                        style="width: 100%"
                        html-align="center"
                    >
                        <apex:commandLink
                            action="{!setConPrev}"
                            value="<< Prev"
                            rendered="{!setCon.HasPrevious}"
                            style="float: left"
                            styleClass="standardLink"
                            reRender="rerenderMe"
                            status="ASUAjaxStatus"
                        />
                        <apex:outputText value="Page Size " />
                        <apex:selectList label="Page Size" value="{!pageSize}" size="1" styleClass="pageSizeField">
                            <apex:actionSupport
                                event="onchange"
                                reRender="rerenderMe"
                                onsubmit="handlePageSizeField(this)"
                                status="ASUAjaxStatus"
                            />
                            <apex:selectOption itemValue="25" itemLabel="25" />
                            <apex:selectOption itemValue="50" itemLabel="50" />
                            <apex:selectOption itemValue="100" itemLabel="100" />
                        </apex:selectList>
                        <apex:outputText value=" Showing {!(setCon.PageSize * (setCon.PageNumber - 1)) + 1} - " />
                        <apex:outputText
                            value="{!IF(setCon.HasNext, setCon.PageSize * setCon.PageNumber, setCon.Resultsize)} of "
                        />
                        <apex:outputText value="{!setCon.ResultSize} Records" />
                        <apex:commandLink
                            action="{!setConNext}"
                            value="Next >>"
                            rendered="{!setCon.HasNext}"
                            style="float: right"
                            styleClass="standardLink"
                            reRender="rerenderMe"
                            status="ASUAjaxStatus"
                        />
                    </apex:outputPanel>
                </div>
            </div>
        </apex:form>
        <apex:form id="tableForm">
            <apex:dataTable value="{!caseWrapperList}" var="caseWrapper" styleClass="ASUTable">
                <apex:column headerClass="ASUColumnHead centerText" styleClass="ASUColumn centerText">
                    <apex:inputCheckbox
                        value="{!caseWrapper.selected}"
                        styleClass="selectBox"
                        onchange="handleSelectAll(this);"
                    />
                    <apex:facet name="header">
                        <input type="checkbox" class="selectAll" onchange="checkAll(this);" />
                    </apex:facet>
                </apex:column>

                <apex:column headerClass="ASUColumnHead" styleClass="ASUColumn">
                    <!-- There is a bug with apex:column that forces me to move this formula out of the value attribute -->
                    {!caseWrapper.obj.Contact.LastName & ', ' & caseWrapper.obj.Contact.FirstName}
                    <apex:facet name="header">
                        <apex:commandLink status="ASUAjaxStatus" reRender="rerenderMe">
                            <apex:param name="contactName" value="Contact.LastName" assignTo="{!sortField}" />
                            Name&nbsp;
                            <apex:outputPanel rendered="{!sortDir == 'ASC' && sortField == 'Contact.LastName'}">
                                <span style="font-size: 7pt" class="fa fa-chevron-down" aria-hidden="true"></span>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!sortDir == 'DESC' && sortField == 'Contact.LastName'}">
                                <span style="font-size: 7pt" class="fa fa-chevron-up" aria-hidden="true"></span>
                            </apex:outputPanel>
                        </apex:commandLink>
                    </apex:facet>
                </apex:column>

                <apex:column headerValue="EMPLID" headerClass="ASUColumnHead" styleClass="ASUColumn">
                    <apex:facet name="header">
                        <apex:commandLink status="ASUAjaxStatus" reRender="rerenderMe">
                            <apex:param name="contactEmplId" value="Contact.EMPLID__c" assignTo="{!sortField}" />
                            EMPLID&nbsp;
                            <apex:outputPanel rendered="{!sortDir == 'ASC' && sortField == 'Contact.EMPLID__c'}">
                                <span style="font-size: 7pt" class="fa fa-chevron-down" aria-hidden="true"></span>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!sortDir == 'DESC' && sortField == 'Contact.EMPLID__c'}">
                                <span style="font-size: 7pt" class="fa fa-chevron-up" aria-hidden="true"></span>
                            </apex:outputPanel>
                        </apex:commandLink>
                    </apex:facet>

                    <apex:outputLink
                        value="javascript:;"
                        onclick="openStudentProfileLightning('{!caseWrapper.obj.ContactId}', '{!caseWrapper.obj.Contact.Name}', '{!caseWrapper.obj.Contact.EMPLID__c}')"
                        styleClass="standardLink"
                        >{!caseWrapper.obj.Contact.EMPLID__c}</apex:outputLink
                    >
                </apex:column>

                <apex:column headerValue="Case (Details)" headerClass="ASUColumnHead" styleClass="ASUColumn">
                    <apex:facet name="header">
                        <apex:commandLink status="ASUAjaxStatus" reRender="rerenderMe">
                            <apex:param name="subject" value="Subject" assignTo="{!sortField}" /> Case (Details)&nbsp;
                            <apex:outputPanel rendered="{!sortDir == 'ASC' && sortField == 'Subject'}">
                                <span style="font-size: 7pt" class="fa fa-chevron-down" aria-hidden="true"></span>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!sortDir == 'DESC' && sortField == 'Subject'}">
                                <span style="font-size: 7pt" class="fa fa-chevron-up" aria-hidden="true"></span>
                            </apex:outputPanel>
                        </apex:commandLink>
                    </apex:facet>

                    <apex:outputLink
                        value="javascript:;"
                        onclick="openCaseLightning('{!caseWrapper.obj.Id}', '{!caseWrapper.obj.CaseNumber}')"
                        styleClass="standardLink"
                        >{!caseWrapper.obj.Subject}</apex:outputLink
                    >
                </apex:column>

                <apex:column
                    headerValue="Status"
                    value="{!caseWrapper.obj.Status}"
                    headerClass="ASUColumnHead"
                    styleClass="ASUColumn"
                >
                    <apex:facet name="header">
                        <apex:commandLink status="ASUAjaxStatus" reRender="rerenderMe">
                            <apex:param name="status" value="Status" assignTo="{!sortField}" /> Status&nbsp;
                            <apex:outputPanel rendered="{!sortDir == 'ASC' && sortField == 'Status'}">
                                <span style="font-size: 7pt" class="fa fa-chevron-down" aria-hidden="true"></span>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!sortDir == 'DESC' && sortField == 'Status'}">
                                <span style="font-size: 7pt" class="fa fa-chevron-up" aria-hidden="true"></span>
                            </apex:outputPanel>
                        </apex:commandLink>
                    </apex:facet>
                </apex:column>

                <apex:column headerValue="Case Owner" headerClass="ASUColumnHead" styleClass="ASUColumn">
                    <apex:facet name="header">
                        <apex:commandLink status="ASUAjaxStatus" reRender="rerenderMe">
                            <apex:param name="caseOwner" value="Owner.Name" assignTo="{!sortField}" />
                            Case Owner&nbsp;
                            <apex:outputPanel rendered="{!sortDir == 'ASC' && sortField == 'Owner.Name'}">
                                <span style="font-size: 7pt" class="fa fa-chevron-down" aria-hidden="true"></span>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!sortDir == 'DESC' && sortField == 'Owner.Name'}">
                                <span style="font-size: 7pt" class="fa fa-chevron-up" aria-hidden="true"></span>
                            </apex:outputPanel>
                        </apex:commandLink>
                    </apex:facet>
                </apex:column>

                <apex:column headerValue="Coach" headerClass="ASUColumnHead" styleClass="ASUColumn">
                    <apex:facet name="header">
                        <apex:commandLink status="ASUAjaxStatus" reRender="rerenderMe">
                            <apex:param
                                name="successCoach"
                                value="successStudent.Success_Coach_Name__c"
                                assignTo="{!sortField}"
                            />
                            Coach&nbsp;
                            <apex:outputPanel
                                rendered="{!sortDir == 'ASC' && sortField == 'successStudent.Success_Coach_Name__c'}"
                            >
                                <span style="font-size: 7pt" class="fa fa-chevron-down" aria-hidden="true"></span>
                            </apex:outputPanel>
                            <apex:outputPanel
                                rendered="{!sortDir == 'DESC' && sortField == 'successStudent.Success_Coach_Name__c'}"
                            >
                                <span style="font-size: 7pt" class="fa fa-chevron-up" aria-hidden="true"></span>
                            </apex:outputPanel>
                        </apex:commandLink>
                    </apex:facet>
                </apex:column>

                <apex:column headerValue="Delegated Resource" headerClass="ASUColumnHead" styleClass="ASUColumn">
                    <apex:facet name="header">
                        <apex:commandLink status="ASUAjaxStatus" reRender="rerenderMe">
                            <apex:param
                                name="delegatedResource"
                                value="successStudent.Delegated_Resource__r.Name"
                                assignTo="{!sortField}"
                            />
                            Delegated Resource&nbsp;
                            <apex:outputPanel
                                rendered="{!sortDir == 'ASC' && sortField == 'successStudent.Delegated_Resource__r.Name'}"
                            >
                                <span style="font-size: 7pt" class="fa fa-chevron-down" aria-hidden="true"></span>
                            </apex:outputPanel>
                            <apex:outputPanel
                                rendered="{!sortDir == 'DESC' && sortField == 'successStudent.Delegated_Resource__r.Name'}"
                            >
                                <span style="font-size: 7pt" class="fa fa-chevron-up" aria-hidden="true"></span>
                            </apex:outputPanel>
                        </apex:commandLink>
                    </apex:facet>
                </apex:column>
            </apex:dataTable>

            <div class="modal fade transferModal" tabindex="-1" role="dialog">
                <div class="modal-dialog" role="document" style="padding-left: 5%">
                    <div class="modal-content" style="width: 95%">
                        <div class="modal-header">
                            <h4 class="modal-title">Transfer Cases</h4>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>

                        <div class="modal-body">
                            <h5>Transfer Cases To:</h5>
                            <apex:selectList value="{!ownerId}" size="1" styleClass="transferList">
                                <apex:selectOptions value="{!transferOptions}" />
                            </apex:selectList>
                        </div>

                        <div class="modal-footer">
                            <apex:commandLink
                                type="button"
                                styleClass="btn btn-default btn-md asu-primary"
                                action="{!transferCases}"
                                status="ASUAjaxStatus"
                                reRender="rerenderMe,{!rerenderList}"
                                value="Transfer"
                                oncomplete="actionComplete()"
                                onclick="toggleTransferModal(this)"
                            />
                            <button type="button" class="btn btn-default btn-md asu-secondary" data-dismiss="modal">
                                Cancel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </apex:form>
        <apex:form id="alius-format77778">
            <div class="headerFooter">
                <apex:commandLink
                    action="{!setConPrev}"
                    value="<< Prev"
                    rendered="{!setCon.HasPrevious}"
                    style="float: left"
                    styleClass="standardLink"
                    reRender="rerenderMe"
                    status="ASUAjaxStatus"
                />
                <apex:outputText value="Page Size " />
                <apex:selectList label="Page Size" value="{!pageSize}" size="1" styleClass="pageSizeField">
                    <apex:actionSupport
                        event="onchange"
                        reRender="rerenderMe"
                        onsubmit="handlePageSizeField(this)"
                        status="ASUAjaxStatus"
                    />
                    <apex:selectOption itemValue="25" itemLabel="25" />
                    <apex:selectOption itemValue="50" itemLabel="50" />
                    <apex:selectOption itemValue="100" itemLabel="100" />
                </apex:selectList>
                <apex:outputText value=" Showing {!(setCon.PageSize * (setCon.PageNumber - 1)) + 1} - " />
                <apex:outputText
                    value="{!IF(setCon.HasNext, setCon.PageSize * setCon.PageNumber, setCon.Resultsize)} of "
                />
                <apex:outputText value="{!setCon.ResultSize} Records" />
                <apex:commandLink
                    action="{!setConNext}"
                    value="Next >>"
                    rendered="{!setCon.HasNext}"
                    style="float: right"
                    styleClass="standardLink"
                    reRender="rerenderMe"
                    status="ASUAjaxStatus"
                />
            </div>
        </apex:form>
    </apex:outputPanel>

    <script>
        function isLightningExperienceOrSalesforce1() {
            return typeof sforce != 'undefined' && sforce && !!sforce.one;
        }

        function openStudentProfileLightning(contactId, contactName, contactEmplid) {
            var isFound = false;
            if (sforce.console.isInConsole()) {
                sforce.console.openPrimaryTab(null, '/' + contactId, true, contactName, function (result) {
                    if (result.success) {
                        sforce.console.openSubtab(
                            result.id,
                            '/apex/studentProfile?contactId=' + contactId,
                            true,
                            contactName + ' Student Profile',
                            null
                        );
                    } else {
                        sforce.console.getPrimaryTabIds(function (primaryTabResult) {
                            for (x = 0; x < primaryTabResult.ids.length; x++) {
                                console.log(primaryTabResult.ids[x]);
                                var parentTabId = primaryTabResult.ids[x];

                                sforce.console.getPageInfo(primaryTabResult.ids[x], function (pageInfoResult) {
                                    if (pageInfoResult.success) {
                                        var info = JSON.parse(pageInfoResult.pageInfo);

                                        if (info.objectId == contactId.substring(0, 15)) {
                                            // contactId is 18 digit, ObjectId is 15
                                            sforce.console.openSubtab(
                                                parentTabId,
                                                '/apex/studentProfile?contactId=' + contactId,
                                                true,
                                                contactName + ' Student Profile',
                                                null
                                            );
                                        }
                                    }
                                });
                            }
                        });
                    }
                });
            } else if (isLightningExperienceOrSalesforce1()) {
                // contactId is to be parsed out in the listener, pre-appension is to pass the value in a single message
                var message = contactId + '/apex/StudentProfile?contactId=' + contactEmplid;
                parent.postMessage(message, '*');
            }
        }

        function openCaseLightning(Id, caseNumber) {
            if (sforce.console.isInConsole()) {
                sforce.console.openPrimaryTab(null, '/' + Id, true, caseNumber);
            } else if (isLightningExperienceOrSalesforce1()) {
                console.log('lightning');
                var message = '/lightning/r/Case/' + Id + '/view';
                console.log(message);
                parent.postMessage(message, '*');
            }
        }
    </script>
</apex:component>
