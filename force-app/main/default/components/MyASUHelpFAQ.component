<apex:component controller="MyASUHelpController" extensions="MyASUHelpPaginationController">
    <apex:attribute name="EmbedLocation" description="The location the component is embedded" type="String" />

    <apex:stylesheet value="{! URLFOR($Resource.bootstrap_4_asu, '/dist/css/bootstrap-asu.min.css')}" />
    <apex:includeScript value="{!URLFOR($Resource.jQuery_1_11_1_Min)}" />
    <script>
        $ = jQuery.noConflict();
    </script>
    <apex:includeScript value="{!URLFOR($Resource.bootstrap_4_asu, '/dist/js/bootstrap.min.js')}" />

    <div class="border myasu-help-scope">
        <h2 class="c-p9rem border-bottom font-weight-bold m-0 p-1 pl-2 bg-f5f5f5">Frequently Asked Questions</h2>
        <div id="search_content">
            <apex:form id="searchForm" styleClass="p-4 bg-maroon">
                <apex:pageBlock mode="maindetail">
                    <div>
                        <center>
                            <p class="lead d-inline-block text-white">Ask us anything.</p>
                            <div>
                                <div class="d-flex justify-content-center" style="height: 2rem">
                                    <apex:inputText id="articleTextBoxId"
                                        value="{!textToSearch}"
                                        styleClass="w-75 h-100 pl-1 border-0"
                                        html-placeholder="Type your question here"
                                        html-pattern=".{2,}"
                                        html-type="search"
                                        required="true"
                                        title="Please enter a minimum of 2 characters"
                                        maxlength="99"
                                    />
                                    <apex:commandLink styleClass="btn btn-light btn-sm rounded-0"
                                        reRender="myasu-help-region-faq-search-results"
                                    >
                                        <i class="fa fa-lg fa-search" aria-hidden="true">
                                            <span class="sr-only">Search</span>
                                        </i>
                                    </apex:commandLink>
                                </div>
                            </div>
                        </center>
                    </div>
                </apex:pageBlock>
            </apex:form>
            <apex:form id="myasu-help-region-faq-search-results" styleClass="p-2">
                <apex:actionRegion id="alius-format912">
                    <apex:pageBlock id="myasu-help-region-faq-search-results-block" mode="maindetail">
                        <!-- START viewAllArticles.page + category search from My ASU -->
                        <apex:outputPanel rendered="{!(!isTextSearchQuery) && (isCategorySearchQuery) && (EmbedLocation == 'viewAllArticles')}"
                        >
                            <div class="d-none" aria-hidden="true">{!refreshPagination}</div>
                            <h3 class="lead">Showing all results for '{!articleCategoryLabel}'</h3>
                            <ul class="pt-1 pb-1 revert-blockquote-to-ul">
                                <knowledge:articleList articleVar="article"
                                    sortBy="mostViewed"
                                    categories="{!articleCategory}"
                                    language="{!articleLanguage}"
                                    pageNumber="{!currentPage}"
                                    pageSize="{!IF(articleCategoryLabel != '', pageSize, 0)}"
                                >
                                    <li>
                                        <apex:outputLink styleClass="c-text-black underline d-inline-block mt-1 mb-1"
                                            value="/authkb?id={!article.Id}"
                                        >
                                            {!article.Title}
                                        </apex:outputLink>
                                    </li>
                                </knowledge:articleList>
                                <div style="{!IF(resultCount > 0, 'display:none', '')}">
                                    No results found. Please try a different search term.
                                </div>
                            </ul>
                            <script>
                                // Fix when the <ul> magically converts to a <blockquote>.  Known issue - https://developer.salesforce.com/forums/?id=9060G000000IBvRQAW
                                const allToConvert = document.querySelectorAll('blockquote.revert-blockquote-to-ul');
                                for (let i = 0; i < allToConvert.length; i++) {
                                    const oldBlockquote = allToConvert[i];
                                    const newUl = document.createElement('ul');
                                    newUl.innerHTML = oldBlockquote.innerHTML;
                                    newUl.className = oldBlockquote.className;
                                    oldBlockquote.replaceWith(newUl);
                                }
                            </script>
                            <div class="d-flex" style="{!IF(resultCount > 0, '', 'display:none !important')}">
                                <apex:commandLink action="{!previous}"
                                    styleClass="btn btn-light btn-sm d-inline-block rounded-0"
                                    style="{!IF(onFirstPage == false,'color:#484848','color:#BFBFBF')}"
                                    reRender="myasu-help-region-faq-search-results-block"
                                >
                                    <i class="fa fa-step-backward" aria-hidden="true" />
                                </apex:commandLink>
                                <div
                                    class="d-inline-block c-bg-gray c-border-gray text-white page-number"
                                    style="font-weight: bold"
                                >
                                    {!currentPage} of {!lastPage}
                                </div>
                                <apex:commandLink action="{!next}"
                                    styleClass="btn btn-light btn-sm d-inline-block rounded-0"
                                    style="{!IF(onLastPage == false,'color:#484848','color:#BFBFBF')}"
                                    reRender="myasu-help-region-faq-search-results-block"
                                >
                                    <i class="fa fa-step-forward" aria-hidden="true" />
                                </apex:commandLink>
                            </div>
                            <hr style="margin-top: 1.5em; margin-bottom: 0" />
                            <a
                                class="c-text-maroon underline d-inline-block mt-1 mb-1"
                                style="font-weight: bold"
                                href="/"
                                >Back to Frequently Asked Questions</a
                            >
                        </apex:outputPanel>
                        <!-- END viewAllArticles.page + category search from My ASU -->

                        <!-- START viewAllArticles.page + user text search -->
                        <apex:outputPanel rendered="{!(isTextSearchQuery) && (!isCategorySearchQuery) && (EmbedLocation == 'viewAllArticles')}"
                        >
                            <div class="d-none" aria-hidden="true">{!refreshPagination}</div>
                            <h3 class="lead">Showing all results for '{!textToSearch}'</h3>
                            <ul class="pt-1 pb-1 revert-blockquote-to-ul">
                                <knowledge:articleList articleVar="article"
                                    sortBy="mostViewed"
                                    keyword="{!textToSearch}"
                                    pageNumber="{!currentPage}"
                                    pageSize="{!IF(textToSearch != '', pageSize, 0)}"
                                >
                                    <li>
                                        <apex:outputLink styleClass="c-text-black underline d-inline-block mt-1 mb-1"
                                            value="/authkb?id={!article.Id}"
                                        >
                                            {!article.Title}
                                        </apex:outputLink>
                                    </li>
                                </knowledge:articleList>
                                <div style="{!IF(resultCount > 0, 'display:none', '')}">
                                    No results found. Please try a different search term.
                                </div>
                            </ul>
                            <script>
                                // Fix when the <ul> magically converts to a <blockquote>.  Known issue - https://developer.salesforce.com/forums/?id=9060G000000IBvRQAW
                                const allToConvert = document.querySelectorAll('blockquote.revert-blockquote-to-ul');
                                for (let i = 0; i < allToConvert.length; i++) {
                                    const oldBlockquote = allToConvert[i];
                                    const newUl = document.createElement('ul');
                                    newUl.innerHTML = oldBlockquote.innerHTML;
                                    newUl.className = oldBlockquote.className;
                                    oldBlockquote.replaceWith(newUl);
                                }
                            </script>
                            <div class="d-flex" style="{!IF(resultCount > 0, '', 'display:none !important')}">
                                <apex:commandLink action="{!previous}"
                                    styleClass="btn btn-light btn-sm d-inline-block rounded-0"
                                    style="{!IF(onFirstPage == false,'color:#484848','color:#BFBFBF')}"
                                    reRender="myasu-help-region-faq-search-results-block"
                                >
                                    <i class="fa fa-step-backward" aria-hidden="true" />
                                </apex:commandLink>
                                <div
                                    class="d-inline-block c-bg-gray c-border-gray text-white page-number"
                                    style="font-weight: bold"
                                >
                                    {!currentPage} of {!lastPage}
                                </div>
                                <apex:commandLink action="{!next}"
                                    styleClass="btn btn-light btn-sm d-inline-block rounded-0"
                                    style="{!IF(onLastPage == false,'color:#484848','color:#BFBFBF')}"
                                    reRender="myasu-help-region-faq-search-results-block"
                                >
                                    <i class="fa fa-step-forward" aria-hidden="true" />
                                </apex:commandLink>
                            </div>
                            <hr style="margin-top: 1.5em; margin-bottom: 0" />
                            <a
                                class="c-text-maroon underline d-inline-block mt-1 mb-1"
                                style="font-weight: bold"
                                href="/"
                                >Back to Frequently Asked Questions</a
                            >
                        </apex:outputPanel>
                        <!-- END viewAllArticles.page + user text search -->

                        <!-- START studentSC.page + user text search -->
                        <apex:outputPanel rendered="{!(isTextSearchQuery) && (!isCategorySearchQuery) && (EmbedLocation != 'viewAllArticles')}"
                        >
                            <h3 class="lead">Showing top results for '{!textToSearch}'</h3>
                            <ul>
                                <knowledge:articleList articleVar="article"
                                    sortBy="mostViewed"
                                    keyword="{!textToSearch}"
                                    pageSize="{!IF(textToSearch != '', pageSize, 0)}"
                                >
                                    <li>
                                        <apex:outputLink styleClass="c-text-black underline d-inline-block mt-1 mb-1"
                                            value="/authkb?id={!article.id}"
                                        >
                                            {!article.title}
                                        </apex:outputLink>
                                    </li>
                                </knowledge:articleList>
                                <apex:commandLink styleClass="c-text-maroon underline d-inline-block mt-1 mb-1"
                                    value="View all results"
                                    action="{!viewAllResults}"
                                />
                            </ul>
                            <script>
                                // Fix when the <ul> magically converts to a <blockquote>.  Known issue - https://developer.salesforce.com/forums/?id=9060G000000IBvRQAW
                                const allToConvert = document.querySelectorAll('blockquote.revert-blockquote-to-ul');
                                for (let i = 0; i < allToConvert.length; i++) {
                                    const oldBlockquote = allToConvert[i];
                                    const newUl = document.createElement('ul');
                                    newUl.innerHTML = oldBlockquote.innerHTML;
                                    newUl.className = oldBlockquote.className;
                                    oldBlockquote.replaceWith(newUl);
                                }
                            </script>
                        </apex:outputPanel>
                        <!-- END studentSC.page + user text search -->

                        <!-- START studentSC.page homepage -->
                        <apex:outputPanel rendered="{!(!isTextSearchQuery) && (!isCategorySearchQuery) && (!isSearchingWithFunctionalGroup)}"
                        >
                            <h3 class="lead mb-4 mt-0">Browse common questions</h3>
                            <div>
                                <h4 class="c-p9rem font-weight-bold mb-2">Finances</h4>
                                <ul>
                                    <apex:repeat value="{!topThreeFinancialArticles}"
                                        var="article"
                                        id="myasu-help-region-common-questions-finances"
                                    >
                                        <li>
                                            <apex:outputLink styleClass="mb-1 d-inline-block c-text-black underline"
                                                value="/authkb?id={!article.KnowledgeArticleId}"
                                                >{!article.Title}</apex:outputLink>
                                        </li>
                                    </apex:repeat>
                                    <li>
                                        <apex:outputLink styleClass="mb-2 d-inline-block c-text-maroon underline"
                                            value="{!viewAllFinancialArticlesLink}"
                                            >View all finance questions</apex:outputLink>
                                    </li>
                                </ul>
                            </div>
                            <div>
                                <h4 class="c-p9rem font-weight-bold mb-2">Technology</h4>
                                <ul>
                                    <apex:repeat value="{!topThreeTechnicalArticles}"
                                        var="article"
                                        id="myasu-help-region-common-questions-technical"
                                    >
                                        <li>
                                            <apex:outputLink styleClass="mb-1 d-inline-block c-text-black underline"
                                                value="/authkb?id={!article.KnowledgeArticleId}"
                                                >{!article.Title}</apex:outputLink>
                                        </li>
                                    </apex:repeat>
                                    <li>
                                        <apex:outputLink styleClass="mb-2 d-inline-block c-text-maroon underline"
                                            value="{!viewAllTechnicalArticlesLink}"
                                            >View all technology questions</apex:outputLink>
                                    </li>
                                </ul>
                            </div>
                            <div>
                                <h4 class="c-p9rem font-weight-bold mb-2">Housing</h4>
                                <ul>
                                    <apex:repeat value="{!topThreeHousingArticles}"
                                        var="article"
                                        id="myasu-help-region-common-questions-housing"
                                    >
                                        <li>
                                            <apex:outputLink styleClass="mb-1 d-inline-block c-text-black underline"
                                                value="/authkb?id={!article.KnowledgeArticleId}"
                                                >{!article.Title}</apex:outputLink>
                                        </li>
                                    </apex:repeat>
                                    <li>
                                        <apex:outputLink styleClass="mb-2 d-inline-block c-text-maroon underline"
                                            value="{!viewAllHousingArticlesLink}"
                                            >View all housing questions</apex:outputLink>
                                    </li>
                                </ul>
                            </div>
                        </apex:outputPanel>
                        <!-- END studentSC.page homepage -->

                        <!-- START studentSC.page + user chosen functional group articles -->
                        <apex:outputPanel rendered="{!AND(textToSearch == '', isSearchingWithFunctionalGroup)}">
                            <apex:outputPanel rendered="{!functionalGroup == 'Financial Aid'}">
                                <h3 class="lead">Showing all Finance results</h3>

                                <ul>
                                    <div style="max-height: 400px; overflow-y: scroll">
                                        <apex:repeat value="{!allFinancialArticles}" var="article">
                                            <li>
                                                <apex:outputLink styleClass="c-text-black underline d-inline-block mt-1 mb-1"
                                                    value="/authkb?id={!article.KnowledgeArticleId}"
                                                    >{!article.Title}</apex:outputLink>
                                            </li>
                                        </apex:repeat>
                                    </div>
                                    <li>
                                        <hr style="margin-top: 1.5em; margin-bottom: 0" />
                                        <apex:outputLink styleClass="c-text-maroon underline d-inline-block mt-3 mb-1"
                                            value="/"
                                            >View all common questions</apex:outputLink>
                                    </li>
                                </ul>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!functionalGroup == '%Technical Resources%'}">
                                <h3 class="lead">Showing all Technology results</h3>
                                <ul>
                                    <div style="max-height: 400px; overflow-y: scroll">
                                        <apex:repeat value="{!allTechnicalArticles}" var="article">
                                            <li>
                                                <apex:outputLink styleClass="c-text-black underline d-inline-block mt-1 mb-1"
                                                    value="/authkb?id={!article.KnowledgeArticleId}"
                                                    >{!article.Title}</apex:outputLink>
                                            </li>
                                        </apex:repeat>
                                    </div>
                                    <li>
                                        <hr style="margin-top: 1.5em; margin-bottom: 0" />
                                        <apex:outputLink styleClass="c-text-maroon underline d-inline-block mt-3 mb-1"
                                            value="/"
                                            >View all common questions</apex:outputLink>
                                    </li>
                                </ul>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!functionalGroup == 'Housing'}">
                                <h3 class="lead">Showing all Housing results</h3>
                                <ul>
                                    <div style="max-height: 400px; overflow-y: scroll">
                                        <apex:repeat value="{!allHousingArticles}" var="article">
                                            <li>
                                                <apex:outputLink styleClass="c-text-black underline d-inline-block mt-1 mb-1"
                                                    value="/authkb?id={!article.KnowledgeArticleId}"
                                                    >{!article.Title}</apex:outputLink>
                                            </li>
                                        </apex:repeat>
                                    </div>
                                    <li>
                                        <hr style="margin-top: 1.5em; margin-bottom: 0" />
                                        <apex:outputLink styleClass="c-text-maroon underline d-inline-block mt-3 mb-1"
                                            value="/"
                                            >View all common questions</apex:outputLink>
                                    </li>
                                </ul>
                            </apex:outputPanel>
                        </apex:outputPanel>
                        <!-- END studentSC.page + user chosen functional group articles -->
                    </apex:pageBlock>
                </apex:actionRegion>
            </apex:form>
        </div>
    </div>
</apex:component>