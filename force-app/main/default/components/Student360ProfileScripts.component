        var gradTestScoresLoaded = false;
        var ugMilestonesLoaded = false;
        var gradMilestonesLoaded = false;
        var UGacademicProgressLoaded = false;
        var gradAcademicProgressLoaded = false;
        var accountBalanceLoaded = false;

