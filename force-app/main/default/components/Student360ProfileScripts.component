        // Method to replace all undefined/missing fields after callout
        function cleanUpUndefined(elementId) {
            var element = document.getElementById(elementId);
            element.innerHTML = element.innerHTML.replace(/undefined/g, '--');
            element.innerHTML = element.innerHTML.replace(/NaN/g, '--');
        }

        // Method to load the Undergraduate Indicators tab
        function getStudentRetention() {
            if (!indicatorTabLoaded) {
                document.getElementById('stdtRetentionResponseErrors').innerHTML =
                    "<i class='fa fa-spinner fa-pulse fa-2x fa-fw margin-bottom'></i>";

                Visualforce.remoting.Manager.invokeAction(
                    '{!$RemoteAction.Student360ProfileController.getStudentRetention}',
                    '{!theContact.EMPLID__c}',
                    function (result, event) {
                        if (event.status) {
                            document.getElementById('stdtRetentionResponseErrors').innerHTML = '';

                            if (!Object.getOwnPropertyNames(result).length == 0) {
                                document.getElementById('UGgeneralIndicators').style.display = 'initial';
                                document.getElementById('stdtRetentionResponseErrors').style.display = 'none';
                                document.getElementById('sr_finAid_issue').innerHTML = result.FA_INDICATOR__c;
                                document.getElementById('sr_asr').innerHTML = result.ASR_INDICATOR__c;
                                if (result.ENRL_HOLD_COUNT__c > 0) {
                                    document.getElementById('sr_en_holds').innerHTML =
                                        "<span style='color:red'>" + result.ENRL_HOLD_COUNT__c + '</span>';
                                } else {
                                    document.getElementById('sr_en_holds').innerHTML = result.ENRL_HOLD_COUNT__c;
                                }
                                document.getElementById('sr_ci_index').innerHTML = result.CI_INDEX_INDICATOR__c;
                                document.getElementById('sr_eadvisor').innerHTML = result.EADVISOR_INDICATOR__c;
                                document.getElementById('sr_cum_gpa').innerHTML = result.CUM_GPA_INDICATOR__c;
                                document.getElementById('sr_probation').innerHTML = result.PROBATION_INDICATOR__c;
                                document.getElementById('sr_next_term_enrolled').innerHTML =
                                    result.NEXT_TERM_ENROLLED__c;
                                document.getElementById('sr_past_due_tip').innerHTML =
                                    (result.PAST_DUE_TIP__c == 0 ? '' : "<span style='color:red'>") +
                                    (result.PAST_DUE_TIP__c != '' ? '$' + result.PAST_DUE_TIP__c.toFixed(2) : '--') +
                                    (result.PAST_DUE_TIP__c == 0 ? '' : '</span>');
                                document.getElementById('sr_financial_hold').innerHTML = result.FINANCIAL_HOLD__c;
                                document.getElementById('sr_term_myasu_usage').innerHTML = Math.floor(
                                    result.TERM_MYASU_USAGE__c
                                );
                                document.getElementById('sr_term_avg_myasu_usage').innerHTML =
                                    result.AVG_MYASU_COHORT__c;
                                document.getElementById('sr_below_mean_myasu_usage').innerHTML = Math.floor(
                                    0.7 * result.AVG_MYASU_COHORT__c
                                );

                                cleanUpUndefined('UGgeneralIndicators');
                                indicatorTabLoaded = true;
                            } else {
                                document.getElementById('stdtRetentionResponseErrors').innerHTML =
                                    'No general indicators found.';
                                indicatorTabLoaded = true;
                            }
                        } else if (event.type === 'exception') {
                            document.getElementById('stdtRetentionResponseErrors').innerHTML =
                                event.message + '<br/>\n<pre>' + event.where + '</pre>';
                        } else {
                            document.getElementById('stdtRetentionResponseErrors').innerHTML = event.message;
                        }
                    },
                    {escape: true}
                );
            }
        }

        // Method to load test scores.
        function getStdntTestComps() {
            if (!testScoresLoaded) {
                document.getElementById('psTestScoreErrorsUG').innerHTML =
                    "<i class='fa fa-spinner fa-pulse fa-2x fa-fw margin-bottom'></i>";

                Visualforce.remoting.Manager.invokeAction(
                    '{!$RemoteAction.Student360ProfileController.getStdntTestComps}',
                    '{!theContact.EMPLID__c}',
                    'UGRD',
                    function (result, event) {
                        if (event.status) {
                            document.getElementById('psTestScoreErrorsUG').innerHTML = '';

                            if (!Object.getOwnPropertyNames(result).length == 0) {
                                document.getElementById('ps_test_score_section_ug').style.display = 'initial';

                                var html =
                                    '' +
                                    "<div class='table-responsive'>" +
                                    "<table class='table table-striped table-bordered'> " +
                                    '<thead>' +
                                    '<tr>' +
                                    '<th>Id</th>' +
                                    '<th>Component</th>' +
                                    '<th>Score</th>' +
                                    '<th>Date</th>' +
                                    '</tr>' +
                                    '</thead>' +
                                    '<tbody>';

                                for (var i = 0; i < result.length; i++) {
                                    var utcSeconds = result[i].TEST_DT__c;
                                    var testDate = new Date(utcSeconds);
                                    testDate =
                                        testDate.getMonth() +
                                        1 +
                                        '/' +
                                        testDate.getDate() +
                                        '/' +
                                        testDate.getFullYear();

                                    html +=
                                        '' +
                                        '<tr>' +
                                        '<td>' +
                                        result[i].TEST_ID__c +
                                        '</td>' +
                                        '<td>' +
                                        result[i].TEST_COMPONENT__c +
                                        '</td>' +
                                        '<td>' +
                                        result[i].SCORE__c +
                                        '</td>' +
                                        '<td>' +
                                        testDate +
                                        '</td>' +
                                        '</tr>';
                                }

                                html += '</tbody></table></div>';

                                document.getElementById('ps_test_score_section_ug').innerHTML = html;
                                cleanUpUndefined('ps_test_score_section_ug');
                                testScoresLoaded = true;
                            } else {
                                document.getElementById('psTestScoreErrorsUG').innerHTML = 'No test scores found.';
                                testScoresLoaded = true;
                            }
                        } else if (event.type === 'exception') {
                            document.getElementById('psTestScoreErrorsUG').innerHTML =
                                event.message + '<br/>\n<pre>' + event.where + '</pre>';
                        } else {
                            document.getElementById('psTestScoreErrorsUG').innerHTML = event.message;
                        }
                    },
                    {escape: true}
                );
            }
        }

