        function filterClasses() {
            var termSelect = document.getElementById('ps_classes_term_select');
            var sessionSelect = document.getElementById('ps_classes_session_select');
            var searchTerm = termSelect.options[termSelect.selectedIndex].text;
            var searchSession = sessionSelect.options[sessionSelect.selectedIndex].text;
            var classTable = document.getElementById('enrolled_classes_table');
            for (var r = 1; r < classTable.rows.length; r++) {
                var termCell = classTable.rows[r].cells[0].innerHTML;
                var sessionCell = classTable.rows[r].cells[1].innerHTML;
                var displayStyle = 'none';
                if (
                    (termCell.indexOf(searchTerm) >= 0 || searchTerm == 'All') &&
                    (sessionCell.indexOf(searchSession) >= 0 || searchSession == 'All')
                ) {
                    displayStyle = 'table-row';
                } else {
                    displayStyle = 'none';
                }
                classTable.rows[r].style.display = displayStyle;
            }
            var headerSpan = document.getElementById('enrolled_classes_header');
            headerSpan.innerHTML = '&nbsp;' + searchTerm + ' Enrolled Classes';

            classTable = document.getElementById('dropped_classes_table');
            for (var r = 1; r < classTable.rows.length; r++) {
                var termCell = classTable.rows[r].cells[0].innerHTML;
                var sessionCell = classTable.rows[r].cells[1].innerHTML;
                var displayStyle = 'none';
                if (
                    (termCell.indexOf(searchTerm) >= 0 || searchTerm == 'All') &&
                    (sessionCell.indexOf(searchSession) >= 0 || searchSession == 'All')
                ) {
                    displayStyle = 'table-row';
                } else {
                    displayStyle = 'none';
                }
                classTable.rows[r].style.display = displayStyle;
            }
            headerSpan = document.getElementById('dropped_classes_header');
            headerSpan.innerHTML = '&nbsp;' + searchTerm + ' Dropped/Withdrawn Classes';
        }

