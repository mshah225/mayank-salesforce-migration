                                document.getElementById('account_balance_past_due_tip').innerHTML = '--';
                                document.getElementById('account_balance_outstanding').innerHTML =
                                    '$' + result.DUE_AMT__c.toFixed(2);
                                document.getElementById('account_balance_total').innerHTML =
                                    '$' + result.BALANCE_AMT__c.toFixed(2);

                                cleanUpUndefined('ps_account_balance');
                                accountBalanceLoaded = true;
                            } else {
                                document.getElementById('psAccountBalanceErrors').innerHTML =
                                    'No Account Balance data found.';
                                accountBalanceLoaded = true;
                            }
                        } else if (event.type === 'exception') {
                            document.getElementById('psAccountBalanceErrors').innerHTML =
                                event.message + '<br/>\n<pre>' + event.where + '</pre>';
                        } else {
                            document.getElementById('psAccountBalanceErrors').innerHTML = event.message;
                        }
                    },
                    {escape: true}
                );
            }
        }

        // Method to get Financial Aid Summary
        function getFinancialAidSummary() {
            if (financialAidData != null) return;
            document.getElementById('psFinancialAidSummaryErrors').innerHTML =
                "<i class='fa fa-spinner fa-pulse fa-2x fa-fw margin-bottom'></i>";

            Visualforce.remoting.Manager.invokeAction(
                '{!$RemoteAction.Student360ProfileController.getFinancialSummaryData}',
                '{!theContact.EMPLID__c}',
                function (result, event) {
                    if (event.status) {
                        document.getElementById('psFinancialAidSummaryErrors').innerHTML = '';
                        financialAidData = result;

                        if (!Object.getOwnPropertyNames(financialAidData.summaryRecords).length == 0) {
                            var html = '';

                            html +=
                                "<label for='ps_financial_aid_year_select'>Academic Year:&nbsp;</label><select  id='ps_financial_aid_year_select' onchange='filterFinancialAid()'>";
                            for (var i = 0; i < financialAidData.aidYears.length; i++) {
                                html +=
                                    "<option value='" +
                                    financialAidData.aidYears[i] +
                                    "'>" +
                                    financialAidData.aidYears[i] +
                                    '</option>';
                            }
                            html += '</select>';
                            document.getElementById('ps_financial_aid_year_picklist').innerHTML = html;
                        }

                        if (!Object.getOwnPropertyNames(result.summaryRecords).length == 0) {
                            document.getElementById('ps_financial_aid_summary').style.display = 'initial';

                            var html =
                                '' +
                                "<div class='table-responsive'>" +
                                "<table id='financial_aid_table' class='table table-striped table-bordered'> " +
                                '<thead>' +
                                '<tr>' +
                                '<th>Academic Year</th>' +
                                '<th>Award Summary</th>' +
                                '<th>Category</th>' +
                                '<th>Offered Amount</th>' +
                                '<th>Accepted Amount</th>' +
                                '<th>Disbursed Amount</th>' +
                                '</tr>' +
                                '</thead>' +
                                '<tbody>';

                            for (var i = 0; i < result.summaryRecords.length; i++) {
                                html +=
                                    '' +
                                    '<tr>' +
                                    '<td>' +
                                    result.summaryRecords[i].DESCR__c +
                                    '</td>' +
                                    '<td>' +
                                    result.summaryRecords[i].SFA_CR_AWARD_TYPE__c +
                                    '</td>' +
                                    '<td>' +
                                    result.summaryRecords[i].DESCR_CATEGORY__c +
                                    '</td>' +
                                    '<td>$' +
                                    result.summaryRecords[i].OFFER_AMOUNT__c.toFixed(2) +
                                    '</td>' +
                                    '<td>$' +
                                    result.summaryRecords[i].ACCEPT_AMOUNT__c.toFixed(2) +
                                    '</td>' +
                                    '<td>$' +
                                    result.summaryRecords[i].DISBURSED_AMOUNT__c.toFixed(2) +
                                    '</td>' +
                                    "<td style='display:none'>" +
                                    result.summaryRecords[i].AID_YEAR__c +
                                    '</td>' +
                                    '</tr>';
                            }

                            html +=
                                "<tr><td/><td/><td>Totals</td><td id='fa_offered_total'></td><td id='fa_accepted_total'></td><td id='fa_disbursed_total'></td><td style='display:none'/>";

                            html += '</tbody></table></div>';

                            document.getElementById('ps_financial_aid_summary').innerHTML = html;
                            cleanUpUndefined('ps_financial_aid_summary');
                        } else {
                            document.getElementById('psFinancialAidSummaryErrors').innerHTML =
                                'No Financial Aid data found.';
                        }

                        filterFinancialAid();
                    } else if (event.type === 'exception') {
                        document.getElementById('psFinancialAidSummaryErrors').innerHTML =
                            event.message + '<br/>\n<pre>' + event.where + '</pre>';
                    } else {
                        document.getElementById('psFinancialAidSummaryErrors').innerHTML = event.message;
                    }
                },
                {escape: true}
            );
        }

        function filterFinancialAid() {
            var e = document.getElementById('ps_financial_aid_year_select');
            var search = e.options[e.selectedIndex].text;
            var faTable = document.getElementById('financial_aid_table');
            var offeredTotal = 0.0;
            var acceptedTotal = 0.0;
            var disbursedTotal = 0.0;
            for (var r = 1; r < faTable.rows.length; r++) {
                var ele = faTable.rows[r].cells[6].innerHTML;
                var displayStyle = 'none';
                if (r == faTable.rows.length - 1) {
                    displayStyle = 'table-row';
                } else if (ele.indexOf(search) >= 0 || search == 'All') {
                    displayStyle = 'table-row';
                    offeredTotal += parseInt(faTable.rows[r].cells[3].innerHTML.replace('$', ''));
                    acceptedTotal += parseInt(faTable.rows[r].cells[4].innerHTML.replace('$', ''));
                    disbursedTotal += parseInt(faTable.rows[r].cells[5].innerHTML.replace('$', ''));
                } else {
                    displayStyle = 'none';
                }
                faTable.rows[r].style.display = displayStyle;
            }
            document.getElementById('fa_offered_total').innerHTML = '$' + offeredTotal.toFixed(2).toString();
            document.getElementById('fa_accepted_total').innerHTML = '$' + acceptedTotal.toFixed(2).toString();
            document.getElementById('fa_disbursed_total').innerHTML = '$' + disbursedTotal.toFixed(2).toString();
        }
    </script>
</apex:component>
