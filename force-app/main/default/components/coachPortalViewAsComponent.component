<apex:component id="coachPortalViewAsComponent" controller="ViewAsController">
    <apex:stylesheet value="{!URLFOR($Resource.viewAsComponentResources, 'viewAsContainer.css')}" />
    <apex:includeScript value="/support/console/38.0/integration.js" />

    <apex:attribute name="hasViewAs" type="boolean" description="Does this user have the view as ability?" />
    <apex:attribute name="mimicId" type="string" description="" />
    <apex:attribute name="mimicRecordTypeId" type="string" description="" />
    <apex:attribute name="selectOptions" type="selectOption[]" description="" />

    <!-- Not in static resource as this method calls an action function to rerender -->
    <script>
        function closeAllConsoleTabs() {
            if (sforce.console.isInConsole()) {
                sforce.console.getPrimaryTabIds(function (result) {
                    if (result.success) {
                        for (x = 0; x < result.ids.length; x++) {
                            sforce.console.closeTab(result.ids[x]);
                        }
                    }
                });
            }
        }
    </script>
    <style>
        .viewAsForm {display: flex;}
    </style>

<apex:outputPanel id="dropdownLists">
    <apex:form rendered="{!hasViewAs || hasMultipleRecordTypes}" styleClass="rich-tabpanel viewAsForm buffer">
        <div>
            <apex:selectList size="1" value="{!viewAsId}">
                <apex:selectOptions value="{!selectOptions}" />
                <apex:actionSupport event="onchange" action="{!changeViewAsId}" oncomplete="closeAllConsoleTabs()" reRender="componentContent,dropdownLists" status="ASUAjaxStatus" />
            </apex:selectList>
        </div>
        <div>
            <apex:selectList size="1" value="{!viewAsRecordTypeId}">
                <apex:selectOptions value="{!viewAsRecordTypeIdOptions}" />
                <apex:actionSupport event="onchange" oncomplete="closeAllConsoleTabs()" reRender="componentContent" status="ASUAjaxStatus" />
            </apex:selectList>
        </div>
    </apex:form>
</apex:outputPanel>

    <apex:outputPanel id="componentContent">
        <apex:componentBody id="alius-format922">
            <apex:variable var="mimicId" value="{!viewAsId}" />
            <apex:variable var="mimicRecordTypeId" value="{!viewAsRecordTypeId}" />
        </apex:componentBody>
    </apex:outputPanel>
</apex:component>