<apex:component>
    <apex:attribute name="alerts" description="The alert to be displayed" type="customAlert[]" />

    <script> let allAlertsJS = []; </script>

    <apex:repeat value="{!alerts}" var="alert" rendered="{!NOT(ISBLANK(alerts))}">
        <script>
            allAlertsJS.push({
                severity: "{!alert.severity}",
                title: "{!if(alert.severity = 'CONFIRM', 'Success! ', IF(alert.severity = 'INFO', 'Information! ', IF(alert.severity = 'WARNING', 'Alert! ', 'Error! ')))}",
                message: "{!alert.message}"
            });
        </script>
    </apex:repeat>

    <div id="ASUBrandAlertWrapper"> </div>

    <script>
        $Lightning.use(
            "c:ASUBrandApp",
            function () {
                $Lightning.createComponent(
                    "c:asuBrandAlert",
                    {},
                    "ASUBrandAlertWrapper",
                    function (cmp) {
                        for (let i = 0; i < allAlertsJS.length; i++) {
                            cmp.addAlert(allAlertsJS[i].severity, allAlertsJS[i].title, allAlertsJS[i].message, null);
                        }
                    }
                );

                // Hide errors that appear randomly from LWC
                const observer = new MutationObserver(function (mutations) {
                    const errorDiv = document.querySelector('#auraErrorMessage');
                    if (errorDiv != null && errorDiv.innerHTML.length > 0) {
                        console.error(errorDiv.innerText);
                        errorDiv.innerHTML = '';
                    }
                });
                observer.observe(document, { attributes: false, childList: true, characterData: false, subtree: true });
            }
        );

    </script>
</apex:component>