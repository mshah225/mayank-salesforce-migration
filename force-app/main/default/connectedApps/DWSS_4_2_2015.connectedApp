<?xml version="1.0" encoding="utf-8"?>
<ConnectedApp xmlns="http://soap.sforce.com/2006/04/metadata">
    <contactEmail>salesforce.support@asu.edu</contactEmail>
    <description>Request for information web form for prospective undergraduate students. Maintained by the UTO Drupal team.</description>
    <label>Drupal Webforms Salesforce Suite 4-2-2015</label>
    <oauthConfig>
        <callbackUrl>https://webforms.asu.edu/salesforce/oauth_callback</callbackUrl>
        
        <scopes>Api</scopes>
        <scopes>Full</scopes>
        <scopes>RefreshToken</scopes>
    </oauthConfig>
</ConnectedApp>
