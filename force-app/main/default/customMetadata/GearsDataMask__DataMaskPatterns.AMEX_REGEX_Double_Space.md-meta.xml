    </values>
    <values>
        <field>GearsDataMask__Number_of_Characters_to_Mask__c</field>
        <value xsi:nil="true"/>
    </values>
    <values>
        <field>GearsDataMask__Pattern__c</field>
        <value xsi:type="xsd:string">\b(?&lt;!\-|\.)3[47]\d\d([ \t]{2,}?)(?&lt;!\d\ \d{4}\ )(?!(\d)\2{5}|123456|234567|345678)\d{6}(?!\ \d{5}\ \d)\1(?!(\d)\3{4}|12345|56789)\d{5}(?!\-)(?!\.\d)\b</value>
    </values>
    <values>
