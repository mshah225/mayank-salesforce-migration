        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>GearsDataMask__Description__c</field>
        <value xsi:type="xsd:string">15-digit American Express card numbers starting with either “34” or “37”. Optional spaces or dashes as matching delimiters between the number sections.  Includes modification for double spaces. Example 3770  322284  57063</value>
    </values>
    <values>
