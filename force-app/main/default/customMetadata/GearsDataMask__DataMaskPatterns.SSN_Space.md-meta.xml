<?xml version="1.0" encoding="UTF-8"?>
<CustomMetadata xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <label>SSN_Space</label>
    <protected>false</protected>
    <values>
        <field>GearsDataMask__Active__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>GearsDataMask__Description__c</field>
        <value xsi:type="xsd:string">9-digit US Social Security number; matching delimiters include no space, single space and hyphen. Pattern accepts hyperlinks containing “=” or “/”, and Campus ID’s  (Masked examples: 123456789, 123 45 6789, 123-45-6789)</value>
    </values>
    <values>
        <field>GearsDataMask__Ignore_Special_Characters__c</field>
        <value xsi:type="xsd:boolean">false</value>
    </values>
    <values>
        <field>GearsDataMask__Mask__c</field>
        <value xsi:type="xsd:string">*</value>
    </values>
    <values>
        <field>GearsDataMask__Number_of_Characters_to_Mask__c</field>
        <value xsi:nil="true"/>
    </values>
    <values>
        <field>GearsDataMask__Pattern__c</field>
        <value xsi:type="xsd:string">(?&lt;![\=\/])\b(?!000|666|9[0-9][0-9])[0-9]{3}([ -]?)(?!00)[0-9]{2}\1(?!0000)[0-9]{4}\b</value>
    </values>
    <values>
        <field>GearsDataMask__Type_of_Mask__c</field>
        <value xsi:type="xsd:string">Mask Full String</value>
    </values>
</CustomMetadata>
