    <webLinks>
        <fullName>takeownership__Take_Ownership_Multi</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Take Ownership</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>var records = {!GETRECORDIDS($ObjectType.Case)}; 

if(records.length == 0)
  alert("You must select at least one case");
else { 
  var url = '/apex/takeownership__TakeOwnershipPassThru?'; 

  if(typeof(srcUp) == "function")
    url += 'isdtp=nv&amp;';

  for(var i = 0; i &lt; records.length; i++)
    url += "cs" + (i+1) + "=" + records[i] + "&amp;"; 

  window.location.href = url; 
}</url>
    </webLinks>
