        <fullName>Case_Survey_Received_Date__c</fullName>
        <description>The date and time a survey was submitted by the Contact listed on this Case.</description>
        <externalId>false</externalId>
        <inlineHelpText>The date and time a survey was submitted by the Contact listed on this Case.</inlineHelpText>
        <label>Case Survey Received Date</label>
        <required>false</required>
