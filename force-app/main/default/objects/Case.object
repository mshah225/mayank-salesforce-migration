    <fields>
        <fullName>Forward_Case_Comments__c</fullName>
        <description>[??] - Any text entered here will be included in the email sent to a unit or individual when this Case is "Closed: Forwarded".</description>
        <externalId>false</externalId>
        <inlineHelpText>Any text entered here will be included in the email sent to a unit or individual when this Case is "Closed: Forwarded".</inlineHelpText>
        <label>Forward Case Comments</label>
        <length>5000</length>
        <trackFeedHistory>true</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Forward_Case_Contact_Email__c</fullName>
        <description>The contact's email address</description>
        <externalId>false</externalId>
        <formula>Contact.Email</formula>
        <inlineHelpText>The contact's email address</inlineHelpText>
        <label>Forward Case Contact Email</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Forward_Case_Contact_Phone__c</fullName>
        <description>The contact's preferred phone number, if the preferred communication method is a phone number.</description>
        <externalId>false</externalId>
        <formula>IF(Contact.DoNotCall, '', CASE(TEXT(Contact.Contact_Preference__c), 'Home Phone', Contact.HomePhone, 'Mobile Phone', Contact.MobilePhone, 'Local Phone', Contact.OtherPhone, ''))</formula>
        <inlineHelpText>The contact's phone number, if the preferred communication method is a phone number.</inlineHelpText>
        <label>Forward Case Contact Phone</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Forward_To_Email_Calculation__c</fullName>
        <description>[??] - A list of emails associated with the "Forward Case To Department". If the "Forward Case To Email" is left blank, it is automatically populated with this address.</description>
        <externalId>false</externalId>
        <formula>IF(CONTAINS(TEXT(Forward_To_Unit__c),"@")
,
MID(TEXT(Forward_To_Unit__c),
FIND("(",TEXT(Forward_To_Unit__c))+1,
LEN(TEXT(Forward_To_Unit__c)) - FIND("(",TEXT(Forward_To_Unit__c))-1)
,"")</formula>
        <inlineHelpText>A list of emails associated with the "Forward Case To Department". If the "Forward Case To Email" is left blank, it is automatically populated with this address.</inlineHelpText>
        <label>Forward To Email Calculation</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Forward_To_Email__c</fullName>
        <description>[??] - For most "Forward To Units" this email will be automatically provided. If forwarding to "Other Unit" an to an Individual, this field is required.</description>
        <externalId>false</externalId>
        <inlineHelpText>For most "Forward To Units" this email will be automatically provided. If forwarding to "Other Unit" an to an Individual, this field is required.</inlineHelpText>
        <label>Forward To Email</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Email</type>
        <unique>false</unique>
    </fields>
