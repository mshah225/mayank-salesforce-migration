    <fields>
        <fullName>Subject</fullName>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
    </fields>
    <fields>
        <fullName>SuppliedCompany</fullName>
        <trackTrending>false</trackTrending>
    </fields>
    <fields>
        <fullName>SuppliedEmail</fullName>
        <trackTrending>false</trackTrending>
    </fields>
    <fields>
        <fullName>SuppliedName</fullName>
        <trackTrending>false</trackTrending>
    </fields>
    <fields>
        <fullName>SuppliedPhone</fullName>
        <trackTrending>false</trackTrending>
    </fields>
    <fields>
        <fullName>Thread_Id__c</fullName>
        <externalId>false</externalId>
        <formula>"ref:_" &amp; LEFT($Organization.Id,5) &amp; SUBSTITUTE(RIGHT($Organization.Id,10), "0", "" )&amp; "._" &amp; LEFT(Id,5) &amp; SUBSTITUTE(Left(RIGHT(Id,10), 5), "0", "") &amp; RIGHT(Id,5) &amp; ":ref"</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Thread Id</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Thunderbird__c</fullName>
        <description>[Peoplesoft] - Displays an icon for a Thunderbird Teach-out student. Automatically set when the Contact has one or more Student Group records where Status is True and PeopleSoft Code is SRKJ.</description>
        <externalId>false</externalId>
        <formula>Contact.Thunderbird__c</formula>
        <inlineHelpText>Displays an icon for a Thunderbird Teach-out student. Automatically set when the Contact has Student Group records where Status is True and PeopleSoft Code is SRKJ.</inlineHelpText>
        <label>Thunderbird Teach-out</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Total_Attachments__c</fullName>
        <externalId>false</externalId>
        <formula>Parent.Attachments__c + Attachments__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Attachments</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Type</fullName>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
    </fields>
    <fields>
        <fullName>Type_of_Additional_Assignment_Needed__c</fullName>
        <description>Picklist field used to indicate what type of additional assignment is needed for the case to be assigned appropriately.  Value will be copied over from Case Assignment Rule object when case is created.</description>
        <externalId>false</externalId>
        <label>Type of Additional Assignment Needed</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Territory Manager</fullName>
                    <default>false</default>
                    <label>Territory Manager</label>
                </value>
                <value>
                    <fullName>Enrollment Coach</fullName>
                    <default>false</default>
                    <label>Enrollment Coach</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Visible_by_Contact__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Used in the Case Query for the My ASU service center to display the Case to the logged in User.</description>
        <externalId>false</externalId>
        <inlineHelpText>If checked, this Case should be visible by the Contact in the My ASU Service Center.</inlineHelpText>
        <label>Visible by Contact</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Web_Submission__c</fullName>
        <description>[??] - When a Case is created via a webform submission, that form can pass a hidden identifier to this text field. This is then used to correctly assign the Case (via Workflow or Apex).</description>
        <externalId>false</externalId>
        <inlineHelpText>When a Case is created via a webform submission, that form can pass a hidden identifier to this text field. This is then used to correctly assign the Case (via Workflow or Apex).</inlineHelpText>
        <label>Web Submission</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
