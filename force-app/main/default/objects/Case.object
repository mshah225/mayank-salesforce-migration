    <fields>
        <fullName>Created_By_Name__c</fullName>
        <description>[??] - Displays the First and Last Name of the individual who Created this Case. Used for Templates and Visualforce pages.</description>
        <externalId>false</externalId>
        <formula>CreatedBy.FirstName &amp; " " &amp; CreatedBy.LastName</formula>
        <inlineHelpText>Displays the First and Last Name of the individual who Created this Case. Used for Templates and Visualforce pages.</inlineHelpText>
        <label>Created By Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Created_By_Role__c</fullName>
        <description>[??] - Role of user that created the case</description>
        <externalId>false</externalId>
        <formula>CreatedBy.UserRole.Name</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Created By Role</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Curr_Cont_Prediction_Level__c</fullName>
        <externalId>false</externalId>
        <formula>Contact.Curr_Cont_Prediction_Level__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Current Outlook Level</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CurrentStudent__c</fullName>
        <description>[??] - Describes whether student affiliation on the Contact record is current or not.</description>
        <externalId>false</externalId>
        <formula>ISPICKVAL(Contact.Affiliation_Student__c, 'Current')</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Current Student</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Customer_emoticon__c</fullName>
        <description>[??] - How the customer was feeling when he enter the support case.</description>
        <externalId>false</externalId>
        <formula>IF(   (TEXT( Customer_emoticon_value__c ) =="")  ,"" ,IMAGE( "resource/pkb_mobile/imgs/"+TEXT( Customer_emoticon_value__c ) +".png" ,TEXT( Customer_emoticon_value__c )  ,20,20))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>How the customer was feeling when he enter the support case.</inlineHelpText>
        <label>Customer emoticon</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Customer_emoticon_value__c</fullName>
        <description>[??] - Store the emoticon as a text value.</description>
        <externalId>false</externalId>
        <label>Customer emoticon value</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
