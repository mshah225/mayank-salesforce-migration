    <fields>
        <fullName>Student_Profile__c</fullName>
        <externalId>false</externalId>
        <formula>IF( AND(NOT(ISBLANK(TEXT(Contact.Affiliation_Student__c))), Contact.RecordTypeId = "012d0000000wzM4") ,
HYPERLINK('/apex/StudentProfileRedirect?studentId=' + Contact.EMPLID__c, 'Open', '_self'), NULL)</formula>
        <label>Student Profile</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Student_Visa__c</fullName>
        <description>[peoplesoft] - Formula field that displays whether or not the Contact__r.Visa_Type__c contains F1 or J1 visa types.</description>
        <externalId>false</externalId>
        <formula>IF(INCLUDES( Contact.Visa_Type__c, "F1"), "F1" + BR(), NULL)+
IF(INCLUDES( Contact.Visa_Type__c, "J1"), "J1", NULL)</formula>
        <label>Student Visa</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Sub_Category_Display__c</fullName>
        <externalId>false</externalId>
        <formula>IF(isPickVal( Sub_Category__c,"" ),"(not indicated)",text( Sub_Category__c ))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Sub-Category Display</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
