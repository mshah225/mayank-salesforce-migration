        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Home_Phone__c</fullName>
        <externalId>false</externalId>
        <formula>Contact.HomePhone</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Home Phone</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Illegal_Characters_In_Outbound_Email__c</fullName>
        <defaultValue>false</defaultValue>
        <description>[??] - Set to TRUE (via Workflow) if an Email is sent containing illegal characters (e.g. the "&lt;&lt;" in a Email Template that indicate a staff member should fill out missing information.</description>
        <externalId>false</externalId>
        <inlineHelpText>Set to TRUE (via Workflow) if an Email is sent containing illegal characters (e.g. the "&lt;&lt;" in a Email Template that indicate a staff member should fill out missing information.</inlineHelpText>
        <label>Illegal Characters In Outbound Email</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>In_Contact_Id__c</fullName>
        <description>Syncs inContact reports with Salesforce Case Id</description>
        <externalId>false</externalId>
        <label>In Contact Id</label>
        <length>24</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Inbound_Interaction_Date__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>The date and time this Case Contact was first considered an Inbound Interaction. Set via Workflow.</inlineHelpText>
        <label>Inbound Interaction Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
