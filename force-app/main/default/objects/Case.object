        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>happy</fullName>
                    <default>false</default>
                    <label>happy</label>
                </value>
                <value>
                    <fullName>confused</fullName>
                    <default>false</default>
                    <label>confused</label>
                </value>
                <value>
                    <fullName>annoyed</fullName>
                    <default>false</default>
                    <label>annoyed</label>
                </value>
                <value>
                    <fullName>frustrated</fullName>
                    <default>false</default>
                    <label>frustrated</label>
                </value>
            </valueSetDefinition>
        </valueSet>
