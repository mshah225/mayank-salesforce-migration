    <fields>
        <fullName>Assign_Case_to_Opp_Owner__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(Opportunity__c),"No associated Opportunity",
IF(OwnerId = Opportunity__r.OwnerId,"Owners already match",
IF(NOT(Opportunity__r.Owner.IsActive),"Opportunity Owner is Inactive",
HYPERLINK("/"&amp;Id&amp;"/a?newOwn_lkid=&amp;"&amp;Opportunity__r.OwnerId&amp;"&amp;newOwn="&amp;Opportunity__r.Owner.FirstName&amp;"%20"&amp;Opportunity__r.Owner.LastName&amp;"&amp;retURL=%2F"&amp;Id
,
"Change Owner to "&amp;Opportunity__r.Owner.FirstName&amp;" "&amp;Opportunity__r.Owner.LastName))))</formula>
        <inlineHelpText>Please note that a Change Owner dialog will appear in a new tab. You must click Save, and then close the tab.</inlineHelpText>
        <label>Assign Case to Opp Owner</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
