    <listViews>
        <fullName>AISSS_Downtown_Phoenix_Appointments</fullName>
        <columns>CASES.CASE_NUMBER</columns>
        <columns>Category__c</columns>
        <columns>NAME</columns>
        <columns>CASES.SUBJECT</columns>
        <columns>CASES.STATUS</columns>
        <columns>CASES.PRIORITY</columns>
        <columns>CASES.CREATED_DATE</columns>
        <columns>CASES.LAST_UPDATE</columns>
        <columns>UPDATEDBY_USER.ALIAS</columns>
        <columns>Total_Attachments__c</columns>
        <filterScope>Queue</filterScope>
        <filters>
            <field>CASES.CLOSED</field>
            <operation>notEqual</operation>
            <value>1</value>
        </filters>
        <filters>
            <field>Campus__c</field>
            <operation>equals</operation>
            <value>Downtown</value>
        </filters>
        <label>AISSS - Downtown Phoenix Appointments</label>
        <queue>American_Indian_Student_Support_Svc_Case</queue>
        <sharedTo>
            <group>American_Indian_Student_Support_Svc_Case</group>
            <group>UTO_Administration</group>
            <role>S_Service</role>
        </sharedTo>
    </listViews>
