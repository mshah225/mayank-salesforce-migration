    <fields>
        <fullName>Feedback_Link__c</fullName>
        <description>List of Functional Groups who should not received the GetFeedback survey on closed cases.</description>
        <externalId>false</externalId>
        <formula>IF(OR(
/* Check to see if the Case is not "Closed: Resolved"*/
NOT(ISPICKVAL(Status,"Closed: Resolved")), IsClosedOnCreate == TRUE,
/* Check to see if the case has been closed for more than 14 days */
TODAY()-DATEVALUE(ClosedDate) &gt; 14,
/*Check to see if the Case is associated with a Functional Group that should be excluded */
CC_Functional_Group__r.Name = "Admission Services",
CC_Functional_Group__r.Name = "Educational Outreach and Student Services",
CC_Functional_Group__r.Name = "Enterprise Marketing Hub",
CC_Functional_Group__r.Name = "ESM Online",
CC_Functional_Group__r.Name = "External Unit",
CC_Functional_Group__r.Name = "First in the World Grant",
CC_Functional_Group__r.Name = "Office of the President",
CC_Functional_Group__r.Name = "Office of the University Provost",
CC_Functional_Group__r.Name = "Student Success Innovations",
CC_Functional_Group__r.Name = "ASU Salesforce Support",
CC_Functional_Group__r.Name = "ASU Advisor Outreach",
CC_Functional_Group__r.Name = "ASU Coach Outreach",
CC_Functional_Group__r.Name = "Enrollment Analysis",
ISBLANK(TEXT(Functional_Group__c)),
/*Check for Origin Chat and exclude */
ISPICKVAL(Origin__c , "Chat"),
/*Check to see if the Case is associated with a Category that should be excluded */
CONTAINS(TEXT(Category__c), "Recruitment"),
CONTAINS(TEXT(Sub_Category__c), "Recruitment"),
CONTAINS(TEXT(Category__c), "Outreach")),
/* If any of the above is true, display nothing.*/
"",
/*Else, check to see if the feedback has been provided*/
IF(NOT(ISBLANK(Case_Survey_Received_Date__c)),
/*If feedback has been provided, display that message*/
"You have already provided feedback on this case. Thank you.",
/*Else, show the Link. Note that the "_blank" parameter "Displays link in a new unnamed window."*/
"Take a " + HYPERLINK("https://asu.getfeedback.com/r/fWD3ZfaE?Case_ID="&amp;Id&amp;"&amp;name="&amp;Contact.FirstName,"survey","_blank") + " to tell us how we did."))</formula>
        <inlineHelpText>List of Functional Groups who should not received the GetFeedback survey on closed cases.</inlineHelpText>
        <label>Feedback Link</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
