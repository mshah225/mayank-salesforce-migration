        <fullName>Case_Feed_Email__c</fullName>
        <description>Referenced in Apex code to display the default email address of the User's department. Uses CAR for the default email address. -- In Development --</description>
        <externalId>false</externalId>
        <label>Case Feed Email</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
