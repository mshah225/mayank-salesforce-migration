                <fullName>Very Good</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Very Poor</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>X6_Was_your_question_or_issue_resolved__c</picklist>
            <values>
                <fullName>No</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Yes</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>reason_the_student_will_not_return_this__c</picklist>
            <values>
                <fullName>Academic Support</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Financial</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Health</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Judicial Affairs</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Other</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Social Engagement</fullName>
                <default>false</default>
            </values>
        </picklistValues>
    </recordTypes>
