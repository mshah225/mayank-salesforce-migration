<?xml version="1.0" encoding="utf-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Case_Owner__c</fullName>
    <externalId>false</externalId>
    <formula>IF(NOT(ISBLANK(Owner:User.FirstName)), 
HYPERLINK(Owner:User.Id,Owner:User.FirstName + " " + Owner:User.LastName),
IF(NOT(ISBLANK(Owner:Queue.Name)),
HYPERLINK(Owner:Queue.Id,Owner:Queue.Name),
""))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Case Record Owner</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
