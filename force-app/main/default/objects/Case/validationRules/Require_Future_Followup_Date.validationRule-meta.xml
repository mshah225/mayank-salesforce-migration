<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Future_Followup_Date</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 RecordTypeId = '012d00000021xGK',
 ISNEW(),
 Followup_Date__c &lt; DATEVALUE(NOW()) 
)</errorConditionFormula>
    <errorDisplayField>Followup_Date__c</errorDisplayField>
    <errorMessage>You have selected a Followup Date that has already passed. Please select a future date.</errorMessage>
</ValidationRule>
