<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Record_Type_Id_Required_for_Functional_G</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 RecordTypeId = '012q00000009HMV',
 ISBLANK(Record_Types_String__c)
)</errorConditionFormula>
    <errorDisplayField>Record_Types__c</errorDisplayField>
    <errorMessage>Functional Groups must be associated to at least one record type</errorMessage>
</ValidationRule>
