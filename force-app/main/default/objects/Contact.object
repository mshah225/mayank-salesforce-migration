    <fields>
        <fullName>Thunderbird_Student_Group_Count__c</fullName>
        <description>[Peoplesoft] - A count of the total Student Group records where Status is True and PeopleSoft Code is SRKJ. Used to determine if this Contact should be flagged as a Thunderbird student.</description>
        <externalId>false</externalId>
        <inlineHelpText>A count of the total Student Group records where Status is True and PeopleSoft Code is SRKJ. Used to determine if this Contact should be flagged as a Thunderbird student.</inlineHelpText>
        <label>Thunderbird Student Group Count</label>
        <summaryFilterItems>
            <field>Student_Group__c.SG_Status__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryFilterItems>
            <field>Student_Group__c.SG_PeopleSoft_Code__c</field>
            <operation>equals</operation>
            <value>SRKJ</value>
        </summaryFilterItems>
        <summaryForeignKey>Student_Group__c.SG_Contact__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Thunderbird__c</fullName>
        <description>[Peoplesoft] - Displays an icon for a Thunderbird student. Automatically set when the Contact has one or more Student Group records where Status is True and PeopleSoft Code is SRKJ.</description>
        <externalId>false</externalId>
        <formula>IF(Thunderbird_Student_Group_Count__c &gt; 0, 
IMAGE("/resource/Thunderbird_icon","Thunderbird Student",20,20), 
"")</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Displays an icon for a Thunderbird Teach-out student. Automatically set when the Contact has one or more Student Group records where Status is True and PeopleSoft Code is SRKJ.</inlineHelpText>
        <label>Thunderbird Teach-out</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
