    </fields>
    <fields>
        <fullName>CAP_Student_Group_Count__c</fullName>
        <description>[Peoplesoft] - A count of the total Student Group records where Status is True and PeopleSoft Code is CP00, CP01, or CP02. Used to determine if this Contact should be flagged as a College Achievement Plan participant.</description>
        <externalId>false</externalId>
        <inlineHelpText>A count of the total Student Group records where Status is True and PeopleSoft Code is CP00, CP01, or CP02. Used to determine if this Contact should be flagged as a College Achievement Plan participant.</inlineHelpText>
        <label>CAP Student Group Count</label>
        <summaryFilterItems>
            <field>Student_Group__c.SG_Status__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryFilterItems>
            <field>Student_Group__c.SG_PeopleSoft_Code__c</field>
            <operation>equals</operation>
            <value>CP00, CP01, CP02</value>
        </summaryFilterItems>
        <summaryForeignKey>Student_Group__c.SG_Contact__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>CAP__c</fullName>
        <description>[Peoplesoft] - Displays a green icon for a College Achievement Plan participant. Automatically set when the Contact has one or more Student Group records where Status is True and PeopleSoft Code is CP00, CP01, or CP02.</description>
        <externalId>false</externalId>
        <formula>IF(CAP_Student_Group_Count__c &gt; 0, 
IMAGE("/resource/CAP_Student_Indicator","CAP Participant",20,20), 
IF(CAP_Ineligible_Student_Group_Count__c &gt; 0, 
IMAGE("/resource/CAP_Student_Indicator_Ineligable","CAP Ineligible",20,20), 
IF(CAP_Possible__c, 
IMAGE("/resource/CAP_Student_Indicator_Potential","CAP Possible",20,20), 
"")))</formula>
        <inlineHelpText>Displays a green icon for a College Achievement Plan participant. Automatically set when the Contact has one or more Student Group records where Status is True and PeopleSoft Code is CP00, CP01, or CP02.</inlineHelpText>
        <label>CAP</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
