    <webLinks>
        <fullName>et4ae5__ExactTarget_Resubscribe</fullName>
        <availability>online</availability>
        <displayType>link</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Marketing Cloud Resubscribe</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT("/soap/ajax/19.0/connection.js")}
      {!REQUIRESCRIPT("/soap/ajax/15.0/apex.js")}
      var didResub;
      try
      {
      didResub=sforce.apex.execute("et4ae5/jsButtonMethods","performResub", {subscriberKey:"{!CASESAFEID(Contact.Id)}",objectType:"contact"});
      }
      catch (e)
      {
      didResub=sforce.apex.execute("jsButtonMethods","performResub", {subscriberKey:"{!CASESAFEID(Contact.Id)}",objectType:"contact"});
      }
      if (didResub=="connection error")
      {
      alert("{!$Label.et4ae5__msg0047}");
      }
      else if (didResub=="not found")
      {
      alert("{!$Label.et4ae5__msg0085}");
      }
      else if (didResub=="other error")
      {
      alert("{!$Label.et4ae5__msg0086}");
      }
      else if (didResub=="not integrated")
      {
      alert("{!$Label.et4ae5__msg0087}");
      }
      else if (didResub=="success")
      {
      alert("{!Contact.Name} {!$Label.et4ae5__wasresublegacy}");
      }
      else
      {
      alert(didResub);
      }
      var theUrl="/{!Contact.Id}";
      parent.location.href=theUrl;</url>
    </webLinks>
