} else {
    if(typeof(srcUp)=='function') {
        srcUp('/apex/StudentProfile?contactId={!Contact.EMPLID__c}');
    } else {
           window.open('/apex/StudentProfile?contactId={!Contact.EMPLID__c}', '_blank');
    }
}</url>
