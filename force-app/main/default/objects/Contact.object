    <fields>
        <fullName>SEED_Eligible__c</fullName>
        <description>If contact has SEED student group on their record, shows true.</description>
        <externalId>false</externalId>
        <formula>SEED_Student_Group_Count__c  &gt; 0</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>If contact has SEED student group on their record, shows true.</inlineHelpText>
        <label>SEED Eligible</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>SEED_Student_Group_Count__c</fullName>
        <description>[Peoplesoft] - A count of the total Student Group records where Status is True and PeopleSoft Code is FA01. Used to determine if this Contact should be flagged as a SEED participant.</description>
        <externalId>false</externalId>
        <inlineHelpText>A count of the total Student Group records where Status is True and PeopleSoft Code is FA01. Used to determine if this Contact should be flagged as a SEED participant.</inlineHelpText>
        <label>SEED Student Group Count</label>
        <summaryFilterItems>
            <field>Student_Group__c.SG_Status__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryFilterItems>
            <field>Student_Group__c.SG_PeopleSoft_Code__c</field>
            <operation>equals</operation>
            <value>FA01</value>
        </summaryFilterItems>
        <summaryForeignKey>Student_Group__c.SG_Contact__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>SEED__c</fullName>
        <externalId>false</externalId>
        <formula>IF(SEED_Student_Group_Count__c &gt; 0, 
IMAGE('/resource/SEEDicon',"SEED Student",16,20), 
"")</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>SEED</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
