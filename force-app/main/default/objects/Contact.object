        <fullName>Most_Recent_Outlook_Change_Direction__c</fullName>
        <description>The direction of change between -2 (for null previous values) to 1 (for positive changes) for the students civitas persistence score</description>
        <externalId>false</externalId>
        <label>Most Recent Outlook Change Direction</label>
        <summarizedField>Persistence_Outlook__c.Change_Direction__c</summarizedField>
        <summaryForeignKey>Persistence_Outlook__c.Contact__c</summaryForeignKey>
        <summaryOperation>max</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>My_ASU_View_As_Student__c</fullName>
        <externalId>false</externalId>
        <formula>HYPERLINK("https://webapp4.asu.edu/myasu/viewas?id=" &amp; ASURite_ID__c, "LINK to MyASU")</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Directs to My ASU, Viewing as Student</inlineHelpText>
        <label>My ASU View As Student</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
