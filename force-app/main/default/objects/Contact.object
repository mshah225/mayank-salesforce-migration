    <webLinks>
        <fullName>et4ae5__Send_ExactTarget_Email</fullName>
        <availability>online</availability>
        <displayType>link</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Send Marketing Cloud Email</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT("/soap/ajax/28.0/connection.js")}
{!REQUIRESCRIPT("/soap/ajax/28.0/apex.js")}
var bAccessable; 
try{
     bAccessable = sforce.apex.execute("et4ae5.SObjectHelperJS","isFieldAccessible",{sSObject:"Contact", sField:"HasOptedOutOfEmail"});
}catch (e) {
     bAccessable = false;
}

if(bAccessable == "true"){
     var sHasOptedOutOfEmail = "" + {!Contact.HasOptedOutOfEmail} + "";
     if(sHasOptedOutOfEmail == "1"){
          alert("{!$Label.et4ae5__ctoptedout}");
     }else{
          try{
               var urlPrefix=sforce.apex.execute("et4ae5/jsButtonMethods","namespace", {});
               var theUrl="https://"+urlPrefix+"/apex/singleSendETEmail?contactId={!CASESAFEID(Contact.Id)}";
               parent.location.href = theUrl;
          }catch (e){
               var theUrl="/apex/singleSendETEmail?contactId={!CASESAFEID(Contact.Id)}";
               parent.location.href = theUrl;
          }
     }
}else{
     alert("{!$Label.et4ae5__ctoptedoutaccess}");
}</url>
    </webLinks>
