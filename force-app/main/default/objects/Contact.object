        <externalId>false</externalId>
        <formula>HYPERLINK("https://webapp6.asu.edu/corda/dashboards/Retention/main.dashxml?tab_select=3&amp;profile_tab_select=1&amp;sf_search_emplid=" + EMPLID__c ,  FirstName + ' ' + LastName)</formula>
        <inlineHelpText>Only undergraduate students who are active for the current or a future term can be found in the Retention Dashboard.</inlineHelpText>
