    <validationRules>
        <fullName>Contact_Data_Entry_Minimum_Requirements</fullName>
        <active>true</active>
        <description>Check to see that the minimum requirements are entered when creating a Contact record. A user must fill out these required fields in order to save the Contact: First Name, Last Name, and Email or Phone.</description>
        <errorConditionFormula>/* Requires First and Last Name, as well as Phone or Email to be populated */

AND( ISNew(), $Setup.Validation_Rule_Exception__c.Run_Validation_Rule__c,
OR( 
ISBLANK ( FirstName ), 
ISBLANK ( LastName ), 
AND( 
ISBLANK ( Email ), 
ISBLANK ( Phone ), 
ISBLANK ( HomePhone ), 
ISBLANK ( MobilePhone ), 
ISBLANK ( OtherPhone ) 
) 
) 
)</errorConditionFormula>
        <errorMessage>You must fill out these required fields in order to save the Contact: First Name, Last Name, and either Phone or Email.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Minimum_Length</fullName>
        <active>true</active>
        <description>Minimum Length for the field</description>
        <errorConditionFormula>Self_Service_PIN__c  &lt; 100000 
&amp;&amp; NOT(ISNULL(Self_Service_PIN__c))</errorConditionFormula>
        <errorDisplayField>Self_Service_PIN__c</errorDisplayField>
        <errorMessage>The field needs to be at least 6 digits long</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SMS_Phone_Contains_Only_Numbers</fullName>
        <active>false</active>
        <description>Checking to see that the SMS Phone field has only numbers in the field</description>
        <errorConditionFormula>NOT(
OR(
ISBLANK(SMS_Phone__c),
REGEX( SMS_Phone__c,"^[0-9]{10}$"),
REGEX( SMS_Phone__c,"^[0-9]{15}$")
)
)</errorConditionFormula>
        <errorDisplayField>SMS_Phone__c</errorDisplayField>
        <errorMessage>SMS Phone must only contain 10 or 15 numbers. Please check the length and remove any symbols () + - / or letters.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>silverpop__Disable_Changing_Enable_Sync</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
ISCHANGED(silverpop__Sync_to_Silverpop_Chk__c ), silverpop__Sync_to_Silverpop_Chk__c=false)</errorConditionFormula>
        <errorMessage>Sync to Silverpop selection cannot be changed. Once the box is checked, it cannot be unchecked.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>silverpop__Disable_Changing_To_None</fullName>
        <active>false</active>
        <description>Sync to Silverpop selection cannot be changed. Once set to "Yes, Always Sync" or "No, Don't Sync" it cannot be changed back to "-None-.”</description>
        <errorConditionFormula>AND( ISCHANGED(silverpop__Sync_to_Silverpop__c ) &amp;&amp; ISPICKVAL( PRIORVALUE(silverpop__Sync_to_Silverpop__c ) , "No, Don't Sync") ,ISPICKVAL( silverpop__Sync_to_Silverpop__c  , ""))</errorConditionFormula>
        <errorMessage>Sync to Silverpop selection cannot be changed. Once set to "Yes, Always Sync" or "No, Don't Sync" it cannot be changed back to "-None-.”</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>silverpop__Prevent_Change_From_Engage</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
PRIORVALUE( silverpop__Sync_to_Silverpop_Chk__c) = false , 
ISCHANGED( silverpop__CRMI_Modified_Date__c ))</errorConditionFormula>
        <errorDisplayField>silverpop__CRMI_Modified_Date__c</errorDisplayField>
        <errorMessage>Engage contact could not sync to Salesforce because the matching lead or contact in Salesforce has been set to not sync. You will need to change the "Sync to Silverpop" setting for the lead or contact in Salesforce.</errorMessage>
    </validationRules>
