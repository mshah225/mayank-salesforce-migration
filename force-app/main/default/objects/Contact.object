    <webLinks>
        <fullName>Start_Chat</fullName>
        <availability>online</availability>
        <description>Starts a Pitch Chat with the contact</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Start Chat</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!requireScript("/support/console/38.0/integration.js")}
{!requireScript("/soap/ajax/38.0/connection.js")}

// Query for the base URI
sforce.connection.sessionId = '{!$Api.Session_ID}';
var result = sforce.connection.query('SELECT Id, Label, Login_Endpoint__c, Application_Base_URI__c, Authorization_Key__c, Username__c, Password__c FROM Rest_Service_Setting__mdt WHERE DeveloperName = \'RocketChat_API_Settings\'');
var contactId = '{!Contact.Id}';
var contactName = '{!Contact.Name}';
var asuRiteId = '{!Contact.ASURite_ID__c}';
var chatURI = result.getArray('records')[0].Application_Base_URI__c + asuRiteId;

if (sforce.console.isInConsole()) {

    var openSubtab = function(result) {
        sforce.console.openSubtab(result.id, chatURI, true, 'Pitch Chat - ' + contactName, null);
    };

    sforce.console.getEnclosingPrimaryTabId(openSubtab);
}</url>
    </webLinks>
