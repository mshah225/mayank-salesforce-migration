    <fields>
        <fullName>CAP_Ineligible_Student_Group_Count__c</fullName>
        <description>[Peoplesoft] - A count of the total Student Group records where Status is True and PeopleSoft Code is CP03. Used to determine if this Contact should be flagged as a currently ineligible College Achievement Plan participant.</description>
        <externalId>false</externalId>
        <inlineHelpText>A count of the total Student Group records where Status is True and PeopleSoft Code is CP03. Used to determine if this Contact should be flagged as a currently ineligible College Achievement Plan participant.</inlineHelpText>
        <label>CAP Ineligible Student Group Count</label>
        <summaryFilterItems>
            <field>Student_Group__c.SG_Status__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryFilterItems>
            <field>Student_Group__c.SG_PeopleSoft_Code__c</field>
            <operation>equals</operation>
            <value>CP03</value>
        </summaryFilterItems>
        <summaryForeignKey>Student_Group__c.SG_Contact__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
