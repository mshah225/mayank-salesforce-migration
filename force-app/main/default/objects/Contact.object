        <defaultValue>false</defaultValue>
        <description>[Peoplesoft] - Checkbox that Indicates possible CAP student</description>
        <externalId>false</externalId>
        <inlineHelpText>Indicates possible CAP student</inlineHelpText>
        <label>CAP Possible</label>
