    <fields>
        <fullName>Marital_Status__c</fullName>
        <description>[Peoplesoft] - Examples include: Single, Married, Divorced, Unknown</description>
        <externalId>false</externalId>
        <label>Marital Status</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Single</fullName>
                    <default>false</default>
                    <label>Single</label>
                </value>
                <value>
                    <fullName>Married</fullName>
                    <default>false</default>
                    <label>Married</label>
                </value>
                <value>
                    <fullName>Divorced</fullName>
                    <default>false</default>
                    <label>Divorced</label>
                </value>
                <value>
                    <fullName>Unknown</fullName>
                    <default>false</default>
                    <label>Unknown</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Middle_Name__c</fullName>
        <description>[Peoplesoft] - An individual's middle name</description>
        <externalId>false</externalId>
        <label>Middle Name</label>
        <length>80</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Military_Veteran_Status__c</fullName>
        <description>[Peoplesoft] - SR1B	Veteran Verified, SR1C	Dependent of Veteran Verified, SR1D	Self-Identified Veteran or Dependent</description>
        <externalId>false</externalId>
        <label>Military/Veteran Status</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
