<?xml version="1.0" encoding="utf-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Preferred_First_Name__c</fullName>
    <businessOwnerGroup>Data_Owner_SSI</businessOwnerGroup>
    <businessStatus>Active</businessStatus>
    <complianceGroup>FERPA</complianceGroup>
    <description>Salesforce formula field for preferred name.</description>
    <externalId>false</externalId>
    <formula>If(
(
(isBlank(FirstName)) &amp;&amp; (isBlank(PS_Preferred_First_Name__c))
),"",
If(
(isBlank(PS_Preferred_First_Name__c)),FirstName,PS_Preferred_First_Name__c
)
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Formula Field - generates PS preferred name value if populated. If PS preferred name is blank, populate with First Name.</inlineHelpText>
    <label>Preferred First Name</label>
    <required>false</required>
    <securityClassification>Public</securityClassification>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
