<?xml version="1.0" encoding="utf-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Preferred_Full_Name__c</fullName>
    <businessOwnerGroup>Data_Owner_SSI</businessOwnerGroup>
    <businessStatus>Active</businessStatus>
    <description>If preferred name exists (Preferred First Name + Last Name), else (First Name + Last Name)</description>
    <externalId>false</externalId>
    <formula>If(
(
(isBlank(FirstName)) &amp;&amp; (isBlank(PS_Preferred_First_Name__c))
),"",
If(
(isBlank(PS_Preferred_First_Name__c)),(FirstName &amp; " " &amp; LastName),(PS_Preferred_First_Name__c &amp; " " &amp; LastName)
)
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Formula Field - If preferred name exists (Preferred First Name + Last Name), else (First Name + Last Name)</inlineHelpText>
    <label>Preferred Full Name</label>
    <required>false</required>
    <securityClassification>Public</securityClassification>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
