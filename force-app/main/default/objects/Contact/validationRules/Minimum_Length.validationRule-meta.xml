<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Minimum_Length</fullName>
    <active>true</active>
    <description>Minimum Length for the field</description>
    <errorConditionFormula>Self_Service_PIN__c  &lt; 100000 
&amp;&amp; NOT(ISNULL(Self_Service_PIN__c))</errorConditionFormula>
    <errorDisplayField>Self_Service_PIN__c</errorDisplayField>
    <errorMessage>The field needs to be at least 6 digits long</errorMessage>
</ValidationRule>
