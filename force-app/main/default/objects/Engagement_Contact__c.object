    <fields>
        <fullName>Case_Thread_Id__c</fullName>
        <description>Look up to the related Case and pull in the Thread Id for email sending.</description>
        <externalId>false</externalId>
        <formula>IF( Case__c = '' ,'', Case__r.Thread_Id__c)</formula>
