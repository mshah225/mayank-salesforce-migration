    <fields>
        <fullName>Additional_Message_Text__c</fullName>
        <description>Use this field to append text onto the bottom of the email.</description>
        <externalId>false</externalId>
        <inlineHelpText>Use this field to append text onto the bottom of the email.</inlineHelpText>
        <label>Additional Message Text</label>
        <length>2000</length>
        <trackTrending>false</trackTrending>
        <type>Html</type>
        <visibleLines>25</visibleLines>
    </fields>
