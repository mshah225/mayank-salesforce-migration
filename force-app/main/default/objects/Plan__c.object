    <fields>
        <fullName>eAdvisor_Organization__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>[Peoplesoft] - Lookup to the Organization Object.  Eadvisor Oracle database. Table plancollege to get COLLEGE_ACAD_ORG. And then query PS_ACAD_ORG_TBL  to get the DESCRFORMAL using the value of the college_acad_org for ACAD_ORG in PS_ACAD_ORG_TBL.</description>
        <externalId>false</externalId>
        <label>eAdvisor Organization</label>
        <referenceTo>Organization__c</referenceTo>
        <relationshipLabel>Plans (eAdvisor Organization)</relationshipLabel>
        <relationshipName>Plans_eAdvisor_Org</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
