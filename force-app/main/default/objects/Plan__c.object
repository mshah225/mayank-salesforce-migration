    <fields>
        <fullName>Plan_URL__c</fullName>
        <description>[Peoplesoft] - URL for the plan (major)</description>
        <externalId>false</externalId>
        <formula>IF (TEXT( Program__r.Career__c ) = "Non-Credit" || NOT(Available_in_Degree_Search__c),"", 
"https://webapp4.asu.edu/programs/t5/majorinfo/ASU00/"&amp; Plan_Code__c &amp;"/"&amp; 
CASE(TEXT( Program__r.Career__c ), 
"Law", "graduate", 
"Undergraduate", "undergrad", 
LOWER(TEXT( Program__r.Career__c ))) 
&amp;"/false")</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Plan URL</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
