<?xml version="1.0" encoding="utf-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Case_Owner_Id__c</fullName>
    <description>Displays the related cases owner's Id, prioritizes queue</description>
    <externalId>false</externalId>
    <formula>IF(
 ISBLANK( Case__r.Owner:Queue.Id ),
 Case__r.Owner:User.Id,
 Case__r.Owner:Queue.Id
)</formula>
    <label>Case Owner Id</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
