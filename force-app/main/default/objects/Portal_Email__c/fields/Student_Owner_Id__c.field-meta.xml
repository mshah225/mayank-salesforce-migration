<?xml version="1.0" encoding="utf-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Student_Owner_Id__c</fullName>
    <description>Displays the Success_Student__c owner's Id, prioritizes queue</description>
    <externalId>false</externalId>
    <formula>IF(
 ISBLANK( Success_Student__r.Owner:Queue.Id ),
 Success_Student__r.Owner:User.Id,
 Success_Student__r.Owner:Queue.Id
)</formula>
    <label>Student Owner Id</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
