    <fields>
        <fullName>SI_Code__c</fullName>
        <description>[Peoplesoft] - Examples include: A10, A11, A12, A13, A14, A15, A16, AA1, AD1, AD2, AD3, AD4, AD5, AD6, AD7, AD8, AD9</description>
        <externalId>false</externalId>
        <label>Code</label>
        <length>3</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SI_Description__c</fullName>
        <description>[Peoplesoft] - Examples include: Academic Administrative Hold, Admin Hold, Administrative Hold, Admissions Hold, Admissions Hold 1 Semester, Admissions VIP, Advising Applied Arts &amp; Sci, Advising Business, Advising Design, Advising Education</description>
        <externalId>false</externalId>
        <label>Description</label>
        <length>100</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
