        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>IER_Privacy_Changed__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates whether the "IER Private in Salesforce" field was recently changed; used by a scheduled job to set IER records' visibility</description>
        <externalId>false</externalId>
        <inlineHelpText>Indicates whether the "IER Private in Salesforce" field was recently changed</inlineHelpText>
        <label>IER Privacy Changed</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>IER_Private_in_Salesforce__c</fullName>
        <defaultValue>false</defaultValue>
        <externalId>false</externalId>
        <inlineHelpText>If checked, emails sent via a Salesforce Campaign associated with this Subscription will be Private to the Queue that owns this Subscription record.</inlineHelpText>
        <label>IER Private in Salesforce</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Parent_Subscription__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <externalId>false</externalId>
        <label>Parent Subscription</label>
        <referenceTo>Subscription__c</referenceTo>
        <relationshipLabel>Child Subscriptions</relationshipLabel>
        <relationshipName>Subscriptions</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Subscriber_Privacy_Changed__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates whether the "Subscriber Private in Salesforce" field was recently changed; used by a scheduled job to set Subscriber records' Owner values</description>
        <externalId>false</externalId>
        <inlineHelpText>Indicates whether the "Subscriber Private in Salesforce" field was recently changed</inlineHelpText>
        <label>Subscriber Privacy Changed</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Subscriber_Private_in_Salesforce__c</fullName>
        <defaultValue>false</defaultValue>
        <externalId>false</externalId>
        <inlineHelpText>Makes this record and associated Contact or Lead Subscriber records only visible to the Users that are members of the Queue listed as this Subscription's Owner. Note that the Subscriber record must be owned by a Queue in order to check this box.</inlineHelpText>
        <label>Subscriber Private in Salesforce</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Subscription_Center_Description__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>A short (up to 1000 character) description to be displayed for ASU constituents who are managing their subscription preferences in the subscription center.</inlineHelpText>
        <label>Subscription Center Description</label>
        <length>1000</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Subscription_Description__c</fullName>
        <externalId>false</externalId>
        <label>Subscription Description</label>
        <length>5000</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Subscription_Type__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>Business Unit types are primarily used to store opt-in information 
Area of Interest types store general interests, within a BU (e.g. Financial Aid, Academic Research) 
List types store explicit list (e.g. newsletter, membership)</inlineHelpText>
        <label>Subscription Type</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Business Unit</fullName>
                    <default>false</default>
                    <label>Business Unit</label>
                </value>
                <value>
                    <fullName>Area of Interest</fullName>
                    <default>false</default>
                    <label>Area of Interest</label>
                </value>
                <value>
                    <fullName>List</fullName>
                    <default>false</default>
                    <label>List</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <allowInChatterGroups>true</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Business Unit and List subscriptions being used by the Subscription Center and Marketing Cloud. This object stores the list-level details for emails where we need to store a subscriber/contact/lead preference. This object is owned by the Enterprise Marketing Hub and the Marketing Cloud Governance team. Any changes to this object should be approved/reviewed by them.</description>
    <enableActivities>true</enableActivities>
