        </apex:tabPanel>

        <script>
            function noenter(ev, element) {
                if (window.event) {
                    ev = window.event;
                }

                var keyCode;

                if (ev.keyCode) {
                    keyCode = ev.keyCode;
                } else {
                    keyCode = ev.charCode;
                }

                if (keyCode == 13) {
                    var ele = document.getElementById(element);
                    ele.click();

                    return false;
                } else {
                    return true;
                }
            }
        </script>
    </body>
