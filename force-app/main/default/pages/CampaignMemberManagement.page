                    <apex:tab label="Communications" name="marketingCommunications" id="marketingCommunications">
                        <apex:form id="viewCommunications">
                            <apex:outputPanel layout="block" style="overflow:auto;height:295px;">
                                <apex:pageBlock title="Communications">
                                    <apex:pageBlockSection id="communicationFilter" columns="1">
                                        <!-- Filters start here -->
                                        <apex:outputPanel rendered="{!IF(allMessageList.size > 0,true,false)}">
                                            <apex:outputText id="alius-format16">Filter By: </apex:outputText>
                                            <apex:selectList styleClass="indent" value="{!commFilterType}" size="1">
                                                <apex:selectOptions value="{!commFilterOptions}" />
                                            </apex:selectList>

                                            <apex:outputLabel styleClass="indent">Start:&nbsp;</apex:outputLabel>
                                            <apex:input type="date" value="{!commFilterStartDate}" />

                                            <apex:outputLabel styleClass="indent">End:&nbsp;</apex:outputLabel>
                                            <apex:input type="date" value="{!commFilterEndDate}" />

                                            <apex:commandLink id="searchButton" style="text-decoration:none; margin-left:5px;" styleClass="btn" reRender="communicationList,noCommsMsg">
                                                Search
                                            </apex:commandLink>
                                            <apex:commandLink styleClass="indent" style="margin-left: 20px" id="clearFilterLink" reRender="communicationFilter,communicationList"
                                                action="{!clearCommFilter}">
                                                Reset
                                            </apex:commandLink>
                                        </apex:outputPanel>
                                        <!-- Filters end here -->
                                    </apex:pageBlockSection>
                                    <apex:pageBlockTable id="communicationList" value="{!filteredMessageList}" var="message" cellpadding="7" width="100%" rendered="{!IF(allMessageList.size > 0,true,false)}">
                                        <!-- Email Name -->
                                        <apex:column id="alius-format17">
                                            <apex:facet name="header">Email Name</apex:facet>
                                            <apex:outputText id="alius-format18">
                                                <apex:outputLink value="#" onclick="openNewViewTab('{!message.Id}','{!message.name}');">
                                                    {!message.name}
                                                </apex:outputLink>
                                            </apex:outputText>
                                        </apex:column>

                                        <!-- Subject -->
                                        <apex:column id="alius-format19">
                                            <apex:facet name="header">Subject</apex:facet>
                                            <apex:outputText value="{!message.subject}" />
                                        </apex:column>

                                        <!-- Sent By -->
                                        <apex:column id="alius-format110">
                                            <apex:facet name="header">Sent By</apex:facet>
                                            <apex:outputText value="{!message.sender}" />
                                        </apex:column>

                                        <!-- Delivery Status -->
                                        <apex:column id="alius-format111">
                                            <apex:facet name="header">Delivery Status</apex:facet>
                                            <apex:outputText value="{!message.deliveryStatus}" />
                                        </apex:column>

                                        <!-- Sent Date/Time -->
                                        <apex:column id="alius-format112">
                                            <apex:facet name="header">Sent Date/Time</apex:facet>
                                            <apex:outputText value=" {!message.timeSent}" />
                                        </apex:column>

                                        <!-- Open Date/Time -->
                                        <apex:column id="alius-format113">
                                            <apex:facet name="header">Open Date/Time</apex:facet>
                                            <apex:outputText value=" {!message.timeOpened}" />
                                        </apex:column>

                                        <!-- Unique Clicks -->
                                        <apex:column id="alius-format114">
                                            <apex:facet name="header">Unique Clicks</apex:facet>
                                            <apex:outputText value="{!message.uniqueClicks}" />
                                        </apex:column>
                                    </apex:pageBlockTable>
                                    <apex:outputText id="noCommsMsg" rendered="{!IF(allMessageList.size == 0,true,false)}">
                                        No Communications Found
                                    </apex:outputText>
                                </apex:pageBlock>
                            </apex:outputPanel>
                        </apex:form>
                    </apex:tab>
                </apex:tabPanel>
            </apex:tab>

