<apex:page controller="CampusVisitBadgeController">
    
    <div style="max-width: fit-content;
                margin-left: auto;
                margin-right: auto;">
        <div style="display: {!IF(imageUrl == null, 'none', 'block')}">
            <apex:image url="{!imageUrl}" style="max-width:465px; max-height:120px;"/>
        </div>
    </div>
    
    <div style="margin-top: 10px; font-size: x-large; text-align: center; font-weight: bold;">        
        {!firstName}
    </div>

    <div style="margin-top: 10px; font-size: x-large; text-align: center; font-weight: bold;">        
        {!lastName}
    </div>
</apex:page>