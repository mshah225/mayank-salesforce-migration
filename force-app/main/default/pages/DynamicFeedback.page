<apex:page sidebar="false" showHeader="false" standardStylesheets="false" controller="FeedbackButtonController" cache="true"
    action="{!init}">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.1/jquery.min.js" />

    <head>
        <title>My ASU | Help | {!carName} Feedback</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <c:GoogleTagManager />
        <c:GoogleAnalytics />

        <apex:stylesheet value="{!URLFOR($Resource.bootstrap_337, 'bootstrap_337/css/bootstrap.css')}" />
        <apex:stylesheet value="{!URLFOR($Resource.ASU_Web_Standards, 'ASU_Web_Standards.css')}" />

        <style>
            .dynamic-feedback-container .webform-component-textarea {
                font-weight: 400;
            }

            .dynamic-feedback-container .alert-block p {
                padding: 0 !important;
            }
        </style>
    </head>

    <c:ASUBrandHeader siteTitleName="{!siteTitleName}" siteTitleUrl="{!siteTitleUrl}" />

    <c:GoogleTagManagerBody />
    <div class="dynamic-feedback-container" id="asu-content-container">
        <c:MyASUHelpPageNotifications />
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <apex:outputPanel id="alerts">
                        <c:customAlerts alerts="{!alertHandler.alerts}" />
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!NOT(ISBLANK(retURL))}">
                        <ol class="breadcrumb">
                            <li>
                                <a href="{!retURL}">Back</a>
                            </li>
                            <li class="active">Feedback</li>
                        </ol>
                    </apex:outputPanel>
                    <apex:form id="feedbackForm">
                        <p class="lead">
                            ASU values your experience and wants to ensure that you receive quality service. Tell us how we can improve your experience
                            below.
                        </p>
                        <div class="form-item webform-component webform-component-textarea webform-component--text-area">
                            <apex:outputLabel value="Feedback Comments" for="caseFeedbackComments" />
                            <apex:inputTextarea id="caseFeedbackComments" value="{!caseDescription}" styleClass="form-textarea form-control" cols="60"
                                rows="5" />
                        </div>
                        <apex:commandLink value="Submit" action="{!submit}" styleClass="btn btn-primary" reRender="alerts,feedbackForm" />
                    </apex:form>
                </div>
            </div>
        </div>
    </div>

    <c:ASUBrandFooter />
</apex:page>