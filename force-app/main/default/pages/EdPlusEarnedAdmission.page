<apex:page id="edplusEALA" standardController="Contact" extensions="EdPlusEarnedAdmissionController" sideBar="false" showHeader="false"
    tabStyle="Contact" docType="HTML-5.0">

    <head>
        <apex:includeScript value="//code.jquery.com/jquery-2.1.1.min.js" />
        <apex:includeScript value="/support/console/50.0/integration.js" />
    </head>

    <body>
        <apex:outputPanel layout="block" style="width: 100%; height: 100%; max-height: 220px">
            <apex:form>
                <apex:pageBlock id="applicationList" title="EA Learner Applications">
                    <apex:outputPanel layout="block" style="overflow: auto; width: 100%; height: 100%; max-height: 250px" id="applicationresults">
                        <apex:pageBlockTable value="{!applications}" var="f" rendered="{!applications.size > 0}">

                            <apex:column headerValue="EA Learner Application ID" style="">
                                <a href="/{!f.Id}" data-id="{!f.Id}" data-type="EA Learner Application" data-obj="EA_Learner_Application__x" class="navLink navTrack">{!f.Name__c}</a>
                            </apex:column>

                            <apex:column headerValue="Completed" style="vertical-align: middle">
                                <apex:inputCheckbox value="{!f.Completed__c}" disabled="true" />
                            </apex:column>

                            <apex:column value="{!f.Number_of_Credits_Needed__c}" headerValue="Total Number of Credits Needed" style="vertical-align: middle"
                            />
                            <apex:column value="{!f.Number_of_Credits_Completed__c}" headerValue="Total Number of Credits Completed" style=" vertical-align: middle"
                            />
                            <apex:column value="{!f.Eligibility_Start_Date__c}" headerValue="Eligibility Start Date" style="vertical-align: middle" />
                            <apex:column value="{!f.Eligibility_End_Date__c}" headerValue="Eligibility End Date" style="vertical-align: middle" />
                        </apex:pageBlockTable>
                        <apex:outputText rendered="{!applications.size == 0}" value="No records to display." />
                    </apex:outputPanel>
                </apex:pageBlock>
            </apex:form>
        </apex:outputPanel>
        <script type="text/javascript">
            function bindEvents() {
                // In service console
                if (sforce.console.isInConsole()) {
                    // For each link
                    $('a.navLink').each(function () {
                        var id = $(this).data('id');
                        var type = $(this).data('type');
                        var obj = $(this).data('obj');

                        // Attach click event
                        $(this).on('click', function (e) {
                            e.preventDefault();

                            // Launch sub tab
                            openCaseSubTab(id, type, type, obj);

                            // Selective tracking
                            if ($(this).hasClass('navTrack')) {
                                trackUsage('Viewed External ' + type, id);
                            }
                        });
                    });
                } else {
                    // Loop over links, update the URL if we are in lightning
                    $('a.navLink').each(function () {
                        var id = $(this).data('id');
                        var type = $(this).data('type');
                        var link;

                        // If lightning experience
                        if (document.referrer.indexOf('.lightning.force.com') > 0) {
                            link = '/one/one.app?#/sObject/' + id + '/view';
                        } else {
                            link = '/' + id;
                        }
                        $(this).attr('href', link);
                        $(this).attr('target', '_blank');

                        // Selective tracking
                        if ($(this).hasClass('navTrack')) {
                            // Attach click event to track usage
                            $(this).on('click', function (e) {
                                trackUsage('Viewed External ' + type, id);
                            });
                        }
                    });
                }
            }

            // Open sub tab
            function openCaseSubTab(recordId, title, type, obj) {
                sforce.console.getEnclosingPrimaryTabId(function (result) {
                    sforce.console.openSubtab(result.id, '/' + recordId, true, title, null);
                });
            }

            // On document ready
            $(document).ready(function () {
                bindEvents();
            });
        </script>
        <!-- Used to submitted usage data -->
        <apex:form>
            <apex:actionFunction name="trackUsage" action="{!trackUsage}" reRender="fakseresults">
                <apex:param name="val_action" value="" assignTo="{! trackedAction }" />
                <apex:param name="val_relatedRecordId" value="" assignTo="{! relatedRecordId }" />
            </apex:actionFunction>
        </apex:form>
        <!-- Used to submitted usage data -->
    </body>
</apex:page>