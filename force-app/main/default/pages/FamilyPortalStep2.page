                                        </div>
                                        <div class="p-1 col-lg-6 col-12 row">
                                            <apex:outputLabel styleclass="col-4" for="fp-street-addr">Street Address</apex:outputLabel>
                                            <apex:inputField styleClass="col-7" id="fp-street-addr" value="{!familyPortalGuardian.Street__c}" />
                                        </div>
                                    </div>
                                    <div class="d-flex flex-lg-row flex-column">
                                        <div class="p-1 col-lg-6 col-12 row">
                                            <apex:outputLabel styleclass="col-4" for="fp-city">City</apex:outputLabel>
                                            <apex:inputField styleClass="col-7" id="fp-city" value="{!familyPortalGuardian.City__c}" />
                                        </div>
                                        <apex:outputPanel layout="block" styleClass="p-1 col-lg-6 col-12 row" rendered="{!!guardianSelectedCountryIsUnitedStatesOrCanada}">
                                            <apex:outputLabel styleclass="col-4" for="fp-region">State/Province/Region</apex:outputLabel>
                                            <apex:inputField styleClass="col-7" id="fp-region" value="{!familyPortalGuardian.State__c}" />
                                        </apex:outputPanel>
                                        <apex:outputPanel layout="block" styleClass="p-1 col-lg-6 col-12 row" rendered="{!guardianSelectedCountryIsUS}">
                                            <apex:outputLabel styleclass="col-4" for="fp-state">State</apex:outputLabel>
                                            <apex:selectList styleClass="col-7" id="fp-state" value="{!familyPortalGuardian.State__c}" multiselect="false" size="1">
                                                <apex:selectOptions value="{!guardianStateOptions}" />
                                            </apex:selectList>
                                        </apex:outputPanel>
                                        <apex:outputPanel layout="block" styleClass="p-1 col-lg-6 col-12 row" rendered="{!guardianSelectedCountryIsCanada}">
                                            <apex:outputLabel styleclass="col-4" for="fp-province">Province</apex:outputLabel>
                                            <apex:selectList styleClass="col-7" id="fp-province" value="{!familyPortalGuardian.State__c}" multiselect="false" size="1">
                                                <apex:selectOptions value="{!guardianProvinceOptions}" />
                                            </apex:selectList>
                                        </apex:outputPanel>
                                    </div>
                                    <div class="d-flex flex-lg-row flex-column">
                                        <apex:outputPanel layout="block" styleClass="p-1 col-lg-6 col-12 row" rendered="{!guardianSelectedCountryIsUS}">
                                            <apex:outputLabel styleclass="col-4" for="fp-zip-code">Zip Code</apex:outputLabel>
                                            <apex:inputField styleClass="col-7" id="fp-zip-code" value="{!familyPortalGuardian.Zip_Code__c}" />
                                        </apex:outputPanel>
                                        <apex:outputPanel layout="block" styleClass="p-1 col-lg-6 col-12 row" rendered="{!!guardianSelectedCountryIsUS}">
                                            <apex:outputLabel styleclass="col-4" for="fp-postal-code">Postal Code</apex:outputLabel>
                                            <apex:inputField styleClass="col-7" id="fp-postal-code" value="{!familyPortalGuardian.Zip_Code__c}" />
                                        </apex:outputPanel>
                                        <div class="p-1 col-lg-6 col-12 row"></div>
                                    </div>
                                </apex:outputPanel>
                            </div>
                            <div role="button" class="mt-4">
                                <apex:commandLink action="{!familyPortalStep3}" styleClass="btn btn-maroon btn-md btn-block">
                                    Next
                                </apex:commandLink>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </apex:form>
    </div>

    <script>
        $(document).ready(function () {
            $('.family-portal-2-body-phone').keypress(function (e) {
                if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {
                    return false;
                }
            });
        });

        // Add required asteriks
        $('.requiredInput').each(function () {
            $(this.parentNode).find('label').append(' <span class="requiredInputAsterisk"><sup>*</sup></span>');
            $('.requiredInputAsterisk').css('color', 'red');
        });

        // Fix classes for required fields - need to add padding and move col-7 to wrapper div
        $('.requiredInput').addClass('col-7');
        $('.requiredInput').each(function () {
            $(this.parentNode).find('input').addClass('pl-2').removeClass('col-7');
        });

    </script>

    <div id="ASUBrandFooterWrapper" class="no-slds-scope"></div>

    <script>
        const title = 'ASU Family';
        const baseUrl = 'https://webapp4.asu.edu/myasu';
        $Lightning.use(
            "c:ASUBrandApp",
            function () {
                $Lightning.createComponent(
                    "c:asuBrandHeader",
                    { title, baseUrl },
                    "ASUBrandHeaderWrapper"
                );
                $Lightning.createComponent(
                    "c:asuBrandFooter",
                    {},
                    "ASUBrandFooterWrapper"
                );
                // Hide errors that appear randomly from LWC
                const observer = new MutationObserver(function (mutations) {
                    const errorDiv = document.querySelector('#auraErrorMessage');
                    if (errorDiv != null && errorDiv.innerHTML.length > 0) {
                        console.error(errorDiv.innerText);
                        errorDiv.innerHTML = '';
                    }
                });
                observer.observe(document, { attributes: false, childList: true, characterData: false, subtree: true });

            }
        );
    </script>
</apex:page>