                                                ? result.studentSearchResults[i].Emergency_Contact_Country_Name__c
                                                : '--';

                                        var emergencyContactAddress =
                                            result.studentSearchResults[i].Emergency_Contact_Address__c != null &&
                                            result.studentSearchResults[i].Emergency_Contact_Address__c != ''
                                                ? result.studentSearchResults[i].Emergency_Contact_Address__c +
                                                  '<br />' +
                                                  emergencyContactCity +
                                                  ', ' +
                                                  emergencyContactState +
                                                  ' ' +
                                                  emergencyContactZip +
                                                  '<br />' +
                                                  emergencyContactCountry
                                                : '--';

                                        var emergencyContactPhone =
                                            result.studentSearchResults[i].Emergency_Contact_Phone__c != null &&
                                            result.studentSearchResults[i].Emergency_Contact_Phone__c != ''
                                                ? result.studentSearchResults[i].Emergency_Contact_Phone__c
                                                : '--';

                                        // Filter only numbers from the input
                                        var emergencyContactPhoneCleaned =
                                            emergencyContactPhone != '--'
                                                ? emergencyContactPhone.replace(/\D/g, '')
                                                : null;

                                        // Check if the input is of correct length (10)
                                        var emergencyContactPhoneValidated =
                                            emergencyContactPhoneCleaned != null
                                                ? emergencyContactPhoneCleaned.match(/^(\d{3})(\d{3})(\d{4})$/)
                                                : false;

                                        // If phone number is valid, display in proper format
                                        emergencyContactPhone =
                                            emergencyContactPhone != '--' && emergencyContactPhoneValidated
                                                ? '(' +
                                                  emergencyContactPhoneValidated[1] +
                                                  ') ' +
                                                  emergencyContactPhoneValidated[2] +
                                                  '-' +
                                                  emergencyContactPhoneValidated[3]
