                    }
                }
            });

            // $or: [
            //                 {ASURite_ID__c: {$eq: a}},
            //                 {EMPLID__c: {$eq: b}},
            //                 {ASURite_ID__c: {$eq: a}},
            //                 {EMPLID__c: {$eq: b}},
            //             ],
            //
            // Following query is equivalent to this SOQL
            //
            // "SELECT Id, Name, CreatedDate FROM Contact
            //  WHERE LastName LIKE 'A%' AND CreatedDate >= YESTERDAY AND Account.Name = 'Sony, Inc.'
            //  ORDER BY CreatedDate DESC, Name ASC
            //  LIMIT 5 OFFSET 10"
            //
            // conn.sobject('Location__c')
            //     .find(
            //         {

            //                 {ASURite_ID__c: {$eq: a}},
            //                 {EMPLID__c: {$eq: b}},
            //                 {ASURite_ID__c: {$eq: a}},
            //                 {EMPLID__c: {$eq: b}},
            //         },
            //         'Id, ASURite_ID__c, Birthdate, EMPLID__c, LastName, Preferred_First_Name__c, Preferred_Full_Name__c'
