            var searchString = document.getElementById('{!$Component.form1.searchString}');

            var locationQuery = 'SELECT Id, Location_Code__c FROM Location__c WHERE Location_Status = true';
            var records = [];

            var conn = new jsforce.Connection({accessToken: '{!$API.Session_Id}'});
            conn.query(locationQuery, function (locationError, locationResponse) {
                if (locationError) {
                    document.getElementById('student-search-errors').innerHTML = err;
                } else {
                    let locationRecords = locationResponse.records;

                    console.log('total : ' + result.totalSize);
