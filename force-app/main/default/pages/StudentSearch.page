                                        //     emergencyContactOtherPhoneType != '' &&
                                        //     emergencyContactOtherPhone != '--'
                                        // ) {
                                        //     html += ' (' + emergencyContactOtherPhoneType + ')';
                                        // }

                                        html +=
                                            '</td>' +
                                            '<td data-header="Address">' +
