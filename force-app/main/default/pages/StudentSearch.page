                    let isSearchingByCampus = false;
                    // iterate over locationRecords and check for a search term match to location code
                    locationRecords.forEach(function (record) {
                        delete record.attributes;
                    });
                    locationRecords = JSON.stringify(locationRecords);

                    if (true) {
