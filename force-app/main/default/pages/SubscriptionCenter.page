<apex:page docType="html-5.0" showHeader="false" standardStylesheets="false" sidebar="false" cache="false" applyHtmlTag="false"
    applyBodyTag="false" controller="SubscriptionCenterController">
    <!--action="{!init}"-->

    <html lang="en">

    <head>
        <title>ASU | Subscription Center</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="shortcut icon" href="{!URLFOR($Resource.bootstrap_4_asu, '/dist/img/favicon/favicon.ico')}" />
        <apex:stylesheet value="{!URLFOR($Resource.Font_Awesome_4_7_0, 'Font_Awesome_4_7_0/css/font-awesome.min.css')}" />
        <apex:stylesheet value="{! URLFOR($Resource.bootstrap_4_asu, '/dist/css/bootstrap-asu.min.css')}" />
        <apex:stylesheet value="{!URLFOR($Resource.Subscription_Center, 'sub_center/css/multi-switch.min.css')}" />
        <apex:includeScript value="{!URLFOR($Resource.jQuery_1_11_1_Min)}" />
        <script>$ = jQuery.noConflict();</script>
        <apex:includeScript value="{!URLFOR($Resource.bootstrap_4_asu, '/dist/js/bootstrap.min.js')}" />
        <c:MultiSwitch />
        <script>
            $ = jQuery.noConflict();
            $(document).ready(function () {
                $('.multi-switch').multiSwitch({ width: '65px' });
                if ({!hasOptedOutOfEmail
            }) {
                $('.optedOutModal').modal({ backdrop: 'static', keyboard: false });
                $('.optedOutModal').modal('show');
            } else if ({!updateSuccess}) {
                $('.updateSuccessModal').modal('show');
            }
            $('.searchInput').keypress(function (pressedKey) {
                console.log('pressedKey');
                console.log(pressedKey);
                console.log(pressedKey.keyCode);
                if (pressedKey.keyCode == 13) {
                    $('.searchSubs').click();
                }
            });
            });

            let changeIconTimeout = null;
            function changeIcon() {
                if (changeIconTimeout != null) {
                    window.clearTimeout(changeIconTimeout);
                }

                changeIconTimeout = window.setTimeout(() => {
                    const closedAreas = document.querySelectorAll('a[data-toggle="collapse"].collapsed');
                    for (let i = 0; i < closedAreas.length; i++) {
                        const closed = closedAreas[i];
                        if (closed.querySelector('i.rotate-icon') != null) {
                            closed.querySelector('i').classList.add('fa-chevron-right');
                            closed.querySelector('i').classList.remove('fa-chevron-down');
                        }
                    }
                    const openAreas = document.querySelectorAll('a[data-toggle="collapse"]:not(.collapsed)');
                    for (let i = 0; i < openAreas.length; i++) {
                        const open = openAreas[i];
                        if (open.querySelector('i.rotate-icon') != null) {
                            open.querySelector('i').classList.add('fa-chevron-down');
                            open.querySelector('i').classList.remove('fa-chevron-right');
                        }
                    }
                }, 100)
            }
            $(document).ready(changeIcon());
        </script>
        <style>
            .subscription-center-scope .bg-f5f5f5 {
                background-color: #f5f5f5;
            }

            .subscription-center-scope a:hover:not(.btn) {
                text-decoration: underline;
                color: #d23153 !important;
            }

            .subscription-center-scope .multi-switch-wrapper:first-child {
                width: 65px;
                display: inline-block;
            }

            .subscription-center-scope .checkLabel {
                width: 200%;
                transform: translateX(-25%);
            }
        </style>
        <c:GoogleTagManager />
        <apex:includeLightning />
        <c:SLDSRemoveGlobalStyles />
    </head>

    <body>
        <c:GoogleTagManagerBody />

        <div id="ASUBrandHeaderWrapper" class="no-slds-scope"></div>

        <div class="container subscription-center-scope">
            <apex:outputPanel id="optedOut">
                <apex:form>
                    <div class="modal fade optedOutModal" role="dialog">
                        <div class="modal-dialog modal-md">
                            <div class="modal-content text-center p-1">
                                <div class="modal-header">
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <div class="modal-body">
                                    <p>
                                        <span class="font-weight-bold">{!subscriberEmail}</span> has been unsubscribed from all ASU Communications.
                                    </p>
                                </div>
                                <div class="pl-3 pr-3 pb-3">
                                    <apex:commandLink id="reSubscribe" value="Re-subscribe to ASU Communications" type="submit" action="{!toggleOptOut}" styleClass="btn btn-maroon btn-lg btn-block"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>
                </apex:form>
            </apex:outputPanel>
            <apex:outputPanel id="optOutConfirmation">
                <apex:form>
                    <div class="modal fade" id="confirmOptOutModal" role="dialog" tabindex="-1">
                        <div class="modal-dialog modal-md">
                            <div class="modal-content text-center p-1">
                                <div class="modal-header">
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <div class="modal-body">
                                    <p>Are you sure you want to unsubscribe from all ASU Communications?</p>
                                </div>
                                <div class="pl-3 pr-3 pb-3">
                                    <apex:commandLink id="optOutConfirm" value="Confirm" action="{!toggleOptOut}" styleClass="btn btn-maroon btn-lg btn-block"
                                    />
                                    <button id="optOutCancel" type="button" data-dismiss="modal" ng-click="cancel()" class="btn btn-light btn-lg btn-block">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </apex:form>
            </apex:outputPanel>
            <apex:outputPanel id="updateSuccess">
                <apex:form>
                    <div class="modal fade updateSuccessModal" role="dialog" tabindex="-1">
                        <div class="modal-dialog modal-md">
                            <div class="modal-content" style="text-align: center; padding: 8px">
                                <div class="modal-header">
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <div class="modal-body">
                                    <p>You have successfully updated your subscriptions</p>
                                </div>

                                <div class="pl-3 pr-3 pb-3">
                                    <button id="successOk" type="button" data-dismiss="modal" ng-click="cancel()" class="btn btn-maroon btn-lg btn-block">
                                        Ok
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </apex:form>
            </apex:outputPanel>
            <div class="row mb-3 p-2">
                <div class="col-1"></div>
                <div class="col-10">
                    <apex:outputPanel id="unsubscribeDone" rendered="{!directUnsubscribe}">
                        <apex:form>
                            <apex:outputPanel rendered="{!(!directUnsubscribeSuccess)}">
                                <div class="panel panel-default">
                                    <div class="panel-body text-center">
                                        <h2 class="font-weight-normal h3 my-2 mx-0 text-center">Unsubscribe from Messages</h2>
                                        <p class="my-2">
                                            Are you sure you want to unsubscribe from {!directUnsubscribeName} messages?
                                        </p>
                                        <apex:commandLink id="confirmUnsub" action="{!doUnsubscribe}" value="Yes, unsubscribe me" styleClass="btn btn-maroon btn-md text-white"
                                        />
                                        <p class="my-2">
                                            You can also
                                            <a href="SubscriptionCenter?subscriberKey={!subscriberIdentifier}" id="manage1">manage your subscriptions</a>.
                                        </p>
                                    </div>
                                </div>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!directUnsubscribeSuccess}">
                                <div class="panel panel-default">
                                    <div class="panel-body text-center">
                                        <h2 class="font-weight-normal h3 my-2 mx-0 text-center">
                                            <span class="font-weight-bold">{!subscriberEmail}</span>{!unsubscribeMessage}
                                        </h2>
                                        <apex:outputLink id="manage3" value="SubscriptionCenter?subscriberKey={!subscriberIdentifier}" styleClass="mt-2 btn btn-maroon btn-md text-white">Manage My Subscriptions</apex:outputLink>
                                    </div>
                                </div>
                            </apex:outputPanel>
                        </apex:form>
                    </apex:outputPanel>
                    <apex:outputPanel id="noSubscriber" rendered="{!noSubscriber}">
                        <div class="mt-3 mb-3">
                            <h2 class="font-weight-normal h3 m-0">A valid subscriber or subscription could not be found. For further assistance...</h2>
                        </div>
                    </apex:outputPanel>
                    <apex:outputPanel id="manageSubs" rendered="{!AND(AND(!hasOptedOutOfEmail, !noSubscriber), !directUnsubscribe)}">
                        <apex:form>
                            <div class="mt-3 mb-3">
                                <h2 class="font-weight-normal h3 m-0">Manage My ASU Email Subscriptions</h2>
                            </div>
                            <apex:outputPanel id="noSubscriberRecs" rendered="{!noSubscriberRecords}">
                                <p class="lead">You have no current subscriptions</p>
                            </apex:outputPanel>
                            <!-- Var for creating unique collapsible heading ids -->
                            <apex:variable value="{!1}" var="panelHeading" />

                            <apex:repeat value="{!mySubsBUMapKeys}" var="buSubId">
                                <apex:outputPanel rendered="true" styleClass="panel">
                                    <div class="text-dark panel-heading">
                                        <div role="tab" id="heading{!panelHeading}" class="row border rounded bg-f5f5f5 p-1">
                                            <div class="col-7">
                                                <a class="d-table w-100 h-100 text-dark text-decoration-none collapsed" data-toggle="collapse" href="#collapse{!panelHeading}"
                                                    onclick="changeIcon()">
                                                    <div class="d-table-cell align-middle">
                                                        <h4 class="font-weight-normal p-0">{!subbedBuSubIdToWrapperMap[buSubId].name}</h4>
                                                    </div>
                                                </a>
                                            </div>
                                            <div class="col-4 text-center">
                                                <div class="multi-switch-wrapper">
                                                    <input type="checkbox" aria-label="{!subbedBuSubIdToWrapperMap[buSubId].name}_toggle_box" class="multi-switch" initial-value="{!subbedBuSubIdToWrapperMap[buSubId].multiCheckVal}"
                                                        unchecked-value="2" checked-value="1" value="{!subbedBuSubIdToWrapperMap[buSubId].multiCheckVal}"
                                                    />
                                                    <apex:inputText styleClass="hiddencmw d-none" value="{!subbedBuSubIdToWrapperMap[buSubId].subscriberStatus}" title="{!subbedBuSubIdToWrapperMap[buSubId].subscriberStatus}"
                                                        label="{!subbedBuSubIdToWrapperMap[buSubId].subscriberStatus}" />

                                                    <div class="d-md-block d-none checkLabel">
                                                        {!IF(subbedBuSubIdToWrapperMap[buSubId].subscriberStatus == 'No Preference', 'No Preference', IF(subbedBuSubIdToWrapperMap[buSubId].subscriberStatus
                                                        == 'Unsubscribed','No','Yes'))}
                                                    </div>
                                                    <div class="d-sm-block d-md-none checkLabel">
                                                        {!IF(subbedBuSubIdToWrapperMap[buSubId].subscriberStatus == 'No Preference', 'No Pref', IF(subbedBuSubIdToWrapperMap[buSubId].subscriberStatus
                                                        == 'Unsubscribed','No','Yes'))}
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-1">
                                                <a class="d-table w-100 h-100 text-dark text-decoration-none collapsed" data-toggle="collapse" href="#collapse{!panelHeading}"
                                                    onclick="changeIcon()">
                                                    <div class="d-table-cell text-center align-middle">
                                                        <i class="fa fa-lg fa-chevron-right rotate-icon"></i>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    <div id="collapse{!panelHeading}" class="row panel-body collapse" role="tabpanel" aria-labelledby="heading{!panelHeading}">
                                        <ul class="list-group w-100">
                                            <apex:repeat value="{!subsByParentSubIdMap[buSubId]}" var="subw">
                                                <li class="list-group-item">
                                                    <div class="row">
                                                        <div class="col-7">
                                                            <h4 class="text-dark text-decoration-none font-weight-normal">
                                                                {!subw.name}
                                                            </h4>
                                                            <apex:outputPanel rendered="{!subw.desc1 != null}">
                                                                <p>{!subw.desc1}</p>
                                                            </apex:outputPanel>
                                                        </div>
                                                        <div class="col-4 text-center">
                                                            <div class="multi-switch-wrapper">
                                                                <input type="checkbox" aria-label="{!subw.name}_toggle_box" class="multi-switch" initial-value="{!subw.multiCheckVal}" unchecked-value="2"
                                                                    checked-value="1" value="{!subw.multiCheckVal}" />
                                                                <apex:inputText styleClass="hiddencmw d-none" value="{!subw.subscriberStatus}" title="{!subw.subscriberStatus}" label="{!subw.subscriberStatus}"
                                                                />

                                                                <div class="d-md-block d-none checkLabel">
                                                                    {!IF(subw.subscriberStatus == 'No Preference', 'No Preference', IF(subw.subscriberStatus == 'Unsubscribed','No','Yes'))}
                                                                </div>
                                                                <div class="d-sm-block d-md-none checkLabel">
                                                                    {!IF(subw.subscriberStatus == 'No Preference', 'No Pref', IF(subw.subscriberStatus == 'Unsubscribed','No','Yes'))}
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-1"></div>
                                                    </div>
                                                </li>
                                            </apex:repeat>
                                        </ul>
                                    </div>
                                </apex:outputPanel>

                                <!-- Increment the unique panel heading id -->
                                <apex:variable var="panelHeading" value="{!panelHeading + 1}" />
                            </apex:repeat>
                            <div class="text-right mt-2">
                                <apex:commandLink id="updateSubs" value="Update Subscriptions" action="{!updateSubscriptions}" styleClass="btn btn-maroon btn-md text-white"
                                />
                            </div>
                            <div class="text-right mt-2">
                                <a href="#" id="unsubAll" data-toggle="modal" data-target="#confirmOptOutModal">Unsubscribe from All ASU Communications</a>
                            </div>
                        </apex:form>

                        <apex:form>
                            <apex:outputPanel id="exploreSubscriptions">
                                <div class="mt-3 mb-3">
                                    <h2 class="font-weight-normal h3 m-0">Explore Other Subscriptions</h2>
                                </div>
                                <div>
                                    <apex:outputText styleClass="font-weight-bold" value="{!subscriberEmail}" />
                                </div>
                                <div class="row mt-2">
                                    <div class="col-9">
                                        <p>
                                            We want to stay in touch, but only in ways that you find helpful. Select the types of emails you would like to receive below
                                            and click 'Update Subscriptions' when finished.
                                        </p>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-6">
                                        <apex:inputText value="{!searchTerms}" label="Keywords" html-placeholder="Keywords" title="Keywords" styleClass="searchInput pl-2 pr-2 pb-1 pt-1"
                                        />
                                        <apex:commandLink action="{!filterAvailableSubscriptions}" value="Search" styleClass="btn btn-maroon btn-md text-white searchSubs"
                                        />
                                    </div>
                                </div>

                                <!-- Var for creating unique collapsible heading ids -->
                                <apex:variable value="{!1}" var="panelHeading" />

                                <apex:repeat value="{!availableSubsBUMapKeys}" var="buSubId">
                                    <apex:outputPanel rendered="true" styleClass="panel">
                                        <div class="text-dark panel-heading">
                                            <div role="tab" id="heading2{!panelHeading}" class="row border rounded bg-f5f5f5 p-1">
                                                <div class="col-7">
                                                    <a class="d-table w-100 h-100 text-dark text-decoration-none collapsed" data-toggle="collapse" href="#collapse2{!panelHeading}"
                                                        onclick="changeIcon()">
                                                        <div class="d-table-cell align-middle">
                                                            <h4 class="font-weight-normal p-0">{!notSubbedBuSubIdToWrapperMap[buSubId].name}</h4>
                                                        </div>
                                                    </a>
                                                </div>
                                                <div class="col-4 text-center">
                                                    <div class="multi-switch-wrapper">
                                                        <input type="checkbox" aria-label="{!notSubbedBuSubIdToWrapperMap[buSubId].name}_toggle_box" class="multi-switch" initial-value="{!notSubbedBuSubIdToWrapperMap[buSubId].multiCheckVal}"
                                                            unchecked-value="2" checked-value="1" value="{!notSubbedBuSubIdToWrapperMap[buSubId].multiCheckVal}"
                                                        />
                                                        <apex:inputText styleClass="hiddencmw d-none" value="{!notSubbedBuSubIdToWrapperMap[buSubId].subscriberStatus}" title="{!notSubbedBuSubIdToWrapperMap[buSubId].subscriberStatus}"
                                                            label="{!notSubbedBuSubIdToWrapperMap[buSubId].subscriberStatus}"
                                                        />

                                                        <div class="d-md-block d-none checkLabel">
                                                            {!IF(notSubbedBuSubIdToWrapperMap[buSubId].subscriberStatus == 'No Preference', 'No Preference', IF(notSubbedBuSubIdToWrapperMap[buSubId].subscriberStatus
                                                            == 'Unsubscribed','No','Yes'))}
                                                        </div>
                                                        <div class="d-sm-block d-md-none checkLabel">
                                                            {!IF(notSubbedBuSubIdToWrapperMap[buSubId].subscriberStatus == 'No Preference', 'No Pref', IF(notSubbedBuSubIdToWrapperMap[buSubId].subscriberStatus
                                                            == 'Unsubscribed','No','Yes'))}
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-1">
                                                    <a class="d-table w-100 h-100 text-dark text-decoration-none collapsed" data-toggle="collapse" href="#collapse2{!panelHeading}"
                                                        onclick="changeIcon()">
                                                        <div class="d-table-cell text-center align-middle">
                                                            <i class="fa fa-lg fa-chevron-right rotate-icon"></i>
                                                        </div>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>

                                        <div id="collapse2{!panelHeading}" class="row panel-body collapse" role="tabpanel" aria-labelledby="collapse2{!panelHeading}">
                                            <ul class="list-group w-100">
                                                <apex:repeat value="{!availableSubsByParentSubIdMap[buSubId]}" var="subw">
                                                    <li class="list-group-item">
                                                        <div class="row">
                                                            <div class="col-7">
                                                                <h4 class="text-dark text-decoration-none font-weight-normal">
                                                                    {!subw.name}
                                                                </h4>
                                                                <apex:outputPanel rendered="{!subw.desc1 != null}">
                                                                    <p>{!subw.desc1}</p>
                                                                </apex:outputPanel>
                                                            </div>
                                                            <div class="col-4 text-center">
                                                                <div class="multi-switch-wrapper">
                                                                    <input type="checkbox" aria-label="{!subw.name}_toggle_box" class="multi-switch" initial-value="{!subw.multiCheckVal}" unchecked-value="2"
                                                                        checked-value="1" value="{!subw.multiCheckVal}" />
                                                                    <apex:inputText styleClass="hiddencmw d-none" value="{!subw.subscriberStatus}" title="{!subw.subscriberStatus}" label="{!subw.subscriberStatus}"
                                                                    />

                                                                    <div class="d-md-block d-none checkLabel">
                                                                        {!IF(subw.subscriberStatus == 'No Preference', 'No Preference', IF(subw.subscriberStatus == 'Unsubscribed','No','Yes'))}
                                                                    </div>
                                                                    <div class="d-sm-block d-md-none checkLabel">
                                                                        {!IF(subw.subscriberStatus == 'No Preference', 'No Pref', IF(subw.subscriberStatus == 'Unsubscribed','No','Yes'))}
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-1"></div>
                                                        </div>
                                                    </li>
                                                </apex:repeat>
                                            </ul>
                                        </div>
                                    </apex:outputPanel>

                                    <!-- Increment the unique panel heading id -->
                                    <apex:variable var="panelHeading" value="{!panelHeading + 1}" />
                                </apex:repeat>

                                <div class="text-right mt-2">
                                    <apex:commandLink id="updateSubs2" action="{!updateSubscriptions}" value="Update
                                        Subscriptions" styleClass="btn btn-maroon btn-md text-white" />
                                </div>
                                <div class="text-right mt-2">
                                    <a href="#" id="unsubAll2" data-toggle="modal" data-target="#confirmOptOutModal">Unsubscribe from All ASU Communications</a>
                                </div>
                            </apex:outputPanel>
                        </apex:form>
                    </apex:outputPanel>
                </div>
                <div class="col-1"></div>
            </div>
        </div>

        <div id="ASUBrandFooterWrapper" class="no-slds-scope"></div>

        <script>
            const title = 'Subscription Center';
            const baseUrl = 'https://webapp4.asu.edu/myasu';
            $Lightning.use(
                "c:ASUBrandApp",
                function () {
                    $Lightning.createComponent(
                        "c:asuBrandHeader",
                        { title, baseUrl },
                        "ASUBrandHeaderWrapper"
                    );
                    $Lightning.createComponent(
                        "c:asuBrandFooter",
                        {},
                        "ASUBrandFooterWrapper"
                    );
                    // Hide errors that appear randomly from LWC
                    const observer = new MutationObserver(function (mutations) {
                        const errorDiv = document.querySelector('#auraErrorMessage');
                        if (errorDiv != null && errorDiv.innerHTML.length > 0) {
                            console.error(errorDiv.innerText);
                            errorDiv.innerHTML = '';
                        }
                    });
                    observer.observe(document, { attributes: false, childList: true, characterData: false, subtree: true });
                }
            );
        </script>
    </body>

    </html>
</apex:page>