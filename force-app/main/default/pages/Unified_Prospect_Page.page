<apex:page controller="UnifiedProspectPageController" tabStyle="New_Undergrad_Prospect__tab" docType="html-5.0" sidebar="false"
    showHeader="true" standardStylesheets="false">

    <head>
        <style>
            body {
                min-width: 1200px;
            }

            .Custom3Tab .primaryPalette,
            .individualPalette .Custom3Block .primaryPalette {
                background-color: #a30046 !important;
            }

            .Custom3Tab .listViewport .subNav .linkBar,
            .Custom3Tab .mComponent .cHeader,
            .Custom3Tab .genericTable,
            .Custom3Tab .bSubBlock,
            .Custom3Tab .bPageBlock {
                border-top: 6px solid #353535 !important;
                border-radius: 0px !important;
            }

            .Custom3Tab .brdPalette {
                border-top-color: #990033 !important;
            }

            .Custom3Tab .tertiaryPalette,
            .individualPalette .Custom3Block .tertiaryPalette,
            .layoutEdit .individualPalette .Custom3Block .tertiaryPalette {
                background-color: #353535 !important;
                border-color: #353535 !important;
            }

            .even {
                background-color: #fff !important;
            }

            .button {
                transition: background-color 0.5s ease;
                background: #a30046 !important;
                color: #fff !important;
                border: none !important;
                padding: 8px 15px 8px 15px !important;
                font-weight: 400 !important;
                border-radius: 3px !important;
                min-width: 70px;
            }

            .button:hover {
                background: #d23153 !important;
            }

            .activeTab {
                background-color: #a30046;
                color: #fff !important;
                background-image: none;
                width: 200px;
                height: 15px;
                padding: 8px;
                font-size: 9pt;
                border: none !important;
            }

            .inactiveTab {
                transition: background-color 0.5s ease;
                background-color: lightgrey;
                color: #000 !important;
                background-image: none;
                width: 200px;
                height: 17px;
                padding-top: 5px;
                border: none !important;
            }

            .inactiveTab:hover {
                background-color: #d23153;
                color: #fff !important;
                background-image: none;
                width: 200px;
                height: 17px;
                padding-top: 5px;
            }
        </style>
    </head>

    <body id="contentBody" class="content">
        <apex:form id="unifiedForm">
            <apex:pageBlock title="ASU New Prospect Entry Form (Graduate and Undergraduate)" id="undergradBlock">
                <apex:pageMessage rendered="{!$CurrentPage.parameters.saved == 'true' && error == false}" severity="confirm">
                    Successfully saved new prospect.
                </apex:pageMessage>

                <apex:pageMessages id="msgs" />

                <apex:pageBlockSection id="contactInfo" title="Contact Information" collapsible="false" columns="2">
                    <i>
                        You must fill out these required fields in order to save the prospect: First Name, Last Name, Email, and one of these two
                        fields: Phone or Zip Code
                    </i>
                    <br />
                    <apex:outputText value="" />

                    <apex:inputField value="{!contact.FirstName}" required="true" id="firstname" tabOrderHint="1" />

                    <apex:inputField value="{!contact.Lead_Email__c}" required="true" id="email" label="Email" type="email" taborderhint="10"
                    />

                    <apex:inputField value="{!contact.LastName}" required="true" id="lastname" tabOrderHint="2" />

                    <apex:inputField value="{!contact.Phone}" id="phone" type="tel" taborderhint="11" />

                    <apex:inputField value="{!contact.Gender__c}" id="gender" tabOrderHint="3" />

                    <apex:inputField value="{!contact.MobilePhone}" id="mobilephone" label="Mobile Phone" type="tel" taborderhint="12" />

                    <apex:inputField value="{!contact.Birthdate}" id="birthdate" type="date" style="width: 130px" tabOrderHint="4" />

                    <apex:pageBlockSectionItem id="alius-format1155">
                        <apex:outputLabel for="smsTextCheck">SMS Permission</apex:outputLabel>

                        <apex:inputCheckbox id="smsTextCheck" value="{!smsText}" />
                    </apex:pageBlockSectionItem>

                    <apex:inputField value="{!contact.MailingCountryCode}" id="country" label="Mailing Country" tabOrderHint="5" />

                    <apex:inputField value="{!contact.Country_of_Citizenship__c}" id="citizenship" taborderhint="13" />

                    <apex:inputField value="{!contact.MailingStreet}" id="streetaddress" style="width: 144px; height: 30px" tabOrderHint="6"
                    />

                    <div></div>

                    <apex:inputField value="{!contact.MailingCity}" id="city" taborderhint="7" />

                    <div></div>

                    <apex:inputField label="Mailing State / Province" value="{!contact.MailingStateCode}" id="state" tabOrderHint="8" />

                    <div></div>

                    <apex:inputField value="{!contact.MailingPostalCode}" id="zip" tabOrderHint="9" />
                </apex:pageBlockSection>
            </apex:pageBlock>

            <apex:pageBlock id="opportunity_info">
                <apex:pageBlockSection title="Career Selection" collapsible="false" columns="2">
                    <apex:pageBlockSectionItem id="alius-format1156">
                        <apex:outputLabel for="careerList">Select Career</apex:outputLabel>

                        <apex:actionRegion id="alius-format1157">
                            <apex:selectList id="careerList" value="{!career}" size="1" multiselect="false">
                                <apex:selectOptions value="{!careers}" id="career" />
                                <apex:actionSupport event="onchange" rerender="opportunity_info, msgs" status="careerEvent" />
                            </apex:selectList>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>

                    <apex:actionStatus id="careerEvent">
                        <apex:facet name="start">
                            <img src="/img/loading.gif" />
                        </apex:facet>
                    </apex:actionStatus>
                </apex:pageBlockSection>

                <apex:pageBlockSection id="undergrad_opportunity_info" rendered="{!career == 'undergraduate'}" title="Undergraduate Opportunity Information"
                    collapsible="false" columns="2">
                    <apex:inputField value="{!opportunity.Term__c}" id="term" required="true" tabOrderHint="100" />

                    <apex:inputField value="{!opportunity.Online_Degree__c}" id="online_degree" tabOrderHint="103" />

                    <apex:inputField value="{!opportunity.Type}" id="degreetype" required="true" tabOrderHint="101" />

                    <apex:inputField value="{!opportunity.International_Student__c}" id="international" tabOrderHint="104" />

                    <apex:inputField value="{!opportunity.Military_Status__c}" id="military" tabOrderHint="102" />

                    <apex:inputField label="Previous Institution" value="{!previousEducation.Account__c}" id="previous_education_account" tabOrderHint="105"
                    />

                    <apex:pageBlockSectionItem id="alius-format1158">
                        <apex:outputLabel value="Interest: " for="asuLocationIntList" />
                        <apex:actionRegion id="alius-format1159">
                            <apex:selectList id="interestPickList" value="{!pickSelection}" size="1">
                                <apex:selectOption itemValue="--Select--" />
                                <apex:selectOption itemValue="ASU Location" />
                                <apex:selectOption itemValue="ASU Colleges" />
                                <apex:selectOption itemValue="Academic" />
                                <apex:actionSupport event="onchange" reRender="undergrad_opportunity_info,msgs" status="intEvent" />
                            </apex:selectList>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>

                    <apex:actionStatus id="intEvent">
                        <apex:facet name="start">
                            <img src="/img/loading.gif" />
                        </apex:facet>
                    </apex:actionStatus>

                    <apex:pageBlockSectionItem rendered="{!IF(pickSelection == 'ASU Location',true,false)}">
                        <apex:outputLabel value="ASU Location: " for="asuLocationIntList" />

                        <apex:selectList id="asuLocationIntList" value="{!selectedInterestId}" size="1">
                            <apex:selectOptions value="{!asuLocationIntList}" />
                        </apex:selectList>
                    </apex:pageBlockSectionItem>

                    <apex:pageBlockSectionItem rendered="{!IF(pickSelection == 'ASU Colleges',true,false)}">
                        <apex:outputLabel value="College Interest: " for="asuCollegesIntList" />

                        <apex:selectList id="asuCollegesIntList" value="{!selectedInterestId}" size="1" multiselect="false">
                            <apex:selectOptions value="{!asuCollegesIntList}" />
                        </apex:selectList>
                    </apex:pageBlockSectionItem>

                    <apex:pageBlockSectionItem rendered="{!IF(pickSelection == 'Academic',true,false)}">
                        <apex:outputLabel value="Academic Interest: " for="academicIntList" />

                        <apex:selectList id="academicIntList" value="{!selectedInterestId}" size="1" multiselect="false">
                            <apex:selectOptions value="{!academicIntList}" />
                        </apex:selectList>
                    </apex:pageBlockSectionItem>
                </apex:pageBlockSection>

                <apex:pageBlockSection id="grad_opportunity_info" rendered="{!career == 'graduate' || career == 'law'}" title="Graduate Opportunity Information"
                    collapsible="false" columns="1">
                    <apex:pageBlockSection columns="2">
                        <apex:pageBlockSectionItem id="alius-format1160">
                            <apex:outputLabel for="degreetype">Type</apex:outputLabel>

                            <apex:inputField value="{!opportunity.Type}" id="degreetype" required="true" taborderhint="200" />
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection>

                    <apex:pageBlockSection columns="2" id="college_section">
                        <apex:pageBlockSectionItem id="alius-format1161">
                            <apex:outputLabel for="collegeList">College</apex:outputLabel>

                            <apex:actionRegion id="alius-format1162">
                                <div class="requiredBlock" style="background-color: #c00; height: 18px; width: 3px; float: left"></div>

                                <apex:selectList id="collegeList" value="{!collegeSelected}" size="1" required="true" tabindex="201">
                                    <apex:selectOptions value="{!programList}" />

                                    <apex:actionSupport event="onchange" reRender="college_section, msgs" status="collegeEvent" />

                                    <apex:actionStatus id="collegeEvent">
                                        <apex:facet name="start">
                                            <img src="/img/loading.gif" />
                                        </apex:facet>
                                    </apex:actionStatus>
                                </apex:selectList>
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>

                        <apex:pageBlockSectionItem id="academic_plan">
                            <apex:outputLabel for="planList">Academic Plan</apex:outputLabel>

                            <apex:selectList id="planList" value="{!planSelected}" size="1" tabindex="202">
                                <apex:selectOptions value="{!planList}" />
                            </apex:selectList>
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection>

                    <apex:pageBlockSection columns="2">
                        <apex:inputField value="{!opportunity.Online_Degree__c}" id="online_degree" taborderhint="205" />

                        <apex:inputField value="{!opportunity.Term__c}" id="term" required="true" taborderhint="208" />

                        <apex:inputField value="{!opportunity.International_Student__c}" id="international" taborderhint="206" />

                        <apex:inputField value="{!opportunity.Military_Status__c}" id="military" taborderhint="209" />
                    </apex:pageBlockSection>
                </apex:pageBlockSection>
            </apex:pageBlock>

            <apex:pageBlock id="sourceEventBlock">
                <apex:pageBlockSection id="sourceEventSection" title="Create EITHER a Case or Event" collapsible="false" columns="1">
                    <apex:tabPanel switchType="client" selectedTab="source" id="theTabPanel" tabClass="activeTab" inactiveTabClass="inactiveTab"
                        width="100%">
                        <apex:tab label="Case" name="source" id="sourceTab">
                            <apex:outputPanel layout="block" style="overflow: auto; height: 260px">
                                <table style="width: 100%">
                                    <tr>
                                        <td style="padding-right: 20px; width: 20%">
                                            <apex:outputLabel for="cOrigin"> Origin: </apex:outputLabel>
                                            <br />
                                            <apex:selectList id="originPickList" value="{!originSelection}" size="1" multiselect="false">
                                                <apex:selectOption itemValue="--Select--" />

                                                <apex:selectOption itemValue="Email" />

                                                <apex:selectOption itemValue="In Person" />

                                                <apex:selectOption itemValue="Incoming Call" />
                                            </apex:selectList>
                                            <br />
                                            <br />

                                            <apex:outputPanel id="wrapper">
                                                <apex:outputLabel value="Case Functional Group" for="functionalGroupOptions" />
                                                <apex:actionRegion id="alius-format1163">
                                                    <apex:selectList id="functionalGroupOptions" label="Case Functional Group" value="{!ccPicklist.selectedFunctionalGroup}"
                                                        size="1">
                                                        <apex:actionSupport event="onchange" action="{!ccPicklist.updateCategoryAndSubCategory}" rerender="wrapper" />
                                                        <apex:selectOptions value="{!ccPicklist.functionalGroupOptions}" />
                                                    </apex:selectList>
                                                </apex:actionRegion>
                                                <br />
                                                <br />

                                                <apex:outputLabel value="Case Category" for="categoryOptions" />
                                                <apex:actionRegion id="alius-format1164">
                                                    <apex:selectList id="categoryOptions" value="{!ccPicklist.selectedCategory}" size="1">
                                                        <apex:actionSupport event="onchange" action="{!ccPicklist.updateSubCategories}" rerender="wrapper" />
                                                        <apex:selectOptions value="{!ccPicklist.categoryOptions}" />
                                                    </apex:selectList>
                                                </apex:actionRegion>
                                                <br />
                                                <br />
                                                <apex:outputLabel value="Case Sub Category" for="subCategoryOptions" />
                                                <apex:actionRegion id="alius-format1165">
                                                    <apex:selectList label="Case Sub Category" value="{!ccPicklist.selectedSubCategory}" size="1">
                                                        <apex:selectOptions id="subCategoryOptions" value="{!ccPicklist.subCategoryOptions}" />
                                                    </apex:selectList>
                                                </apex:actionRegion>
                                                <br />
                                                <br />
                                            </apex:outputPanel>
                                        </td>

                                        <td style="padding-left: 20px; border-left: solid 1px #ccc; width: 80%">
                                            <apex:outputText id="alius-format1166">
                                                <b>Notes</b>
                                            </apex:outputText>
                                            <br />
                                            <br />
                                            <apex:outputLabel for="cSub"> Subject: </apex:outputLabel>
                                            <br />
                                            <apex:inputField id="cSub" value="{!caseC.Subject}" style="width: 250px; padding: 5px" />
                                            <br />
                                            <br />
                                            <apex:outputLabel for="cDesc"> Description: </apex:outputLabel>
                                            <br />
                                            <apex:inputField id="cDesc" value="{!caseC.Description}" style="width: 250px; height: 150px; padding: 5px" />
                                        </td>
                                    </tr>
                                </table>
                            </apex:outputPanel>
                        </apex:tab>

                        <apex:tab label="Event" name="event" id="eventTab">
                            <apex:outputPanel id="eventSearchPanel" layout="block" style="overflow: hidden; height: 260px">
                                <apex:actionRegion id="alius-format1167">
                                    <table style="width: 100%">
                                        <tr>
                                            <td style="padding-right: 20px; width: 15%">
                                                <apex:outputLabel for="elIdInput">
                                                    <b>Selected Event:</b>
                                                </apex:outputLabel>
                                                <br />
                                                <br />
                                                <apex:inputText id="elIdInput" value="{!eventName}" html-placeholder="Selected event will appear here" style="width: 250px; padding: 6px; color: #990033"
                                                    disabled="true" />
                                                <br />
                                                <br />
                                                <apex:outputText id="eventSelectedHelpText">
                                                    <i>Search for an event on the right and click 'Select'</i>
                                                </apex:outputText>
                                                <br />
                                                <br />
                                                <apex:outputPanel id="statusSelect">
                                                    <apex:outputLabel for="camStatus" value="Status:" rendered="{!IF(elId != null,true,false)}" />
                                                    <br />
                                                    <apex:selectList id="camStatus" rendered="{!IF(elId != null,true,false)}" value="{!camMemEvent.Status}" size="1">
                                                        <apex:selectOptions value="{!selectedEventCamMemStatuses}" />
                                                    </apex:selectList>
                                                </apex:outputPanel>
                                            </td>

                                            <td style="padding-left: 20px; border-left: solid 1px #ccc; width: 80%">
                                                <apex:outputPanel layout="block" style="overflow: auto; height: 250px">
                                                    <apex:outputLabel for="eventSearchInput">
                                                        <b>Search:</b>
                                                    </apex:outputLabel>
                                                    <br />
                                                    <br />
                                                    <apex:inputText id="eventSearchInput" value="{!eventSearchString}" html-placeholder="Enter search terms" style="width: 250px; padding: 6px"
                                                        onkeypress="return noenter(event,'{!$Component.searchSubmit}');" />

                                                    <apex:commandLink id="searchSubmit" value="Search" style="text-decoration: none; margin-left: 5px" styleClass="button" action="{!eventSearch}"
                                                        status="actStatusEvent" reRender="eventList,eventPanel,msgs" />

                                                    <apex:actionStatus id="actStatusEvent">
                                                        <apex:facet name="start">
                                                            <img src="/img/loading.gif" style="
                                                                    margin-top: 7px;
                                                                    margin-left: -90px;
                                                                    position: absolute;
                                                                " />
                                                        </apex:facet>
                                                    </apex:actionStatus>

                                                    <br />
                                                    <br />

                                                    <span>
                                                        <apex:outputLabel for="deptCollList" value="Department/College:" />
                                                        <apex:selectList id="deptCollList" size="1" value="{!deptColl}" style="margin-left: 5px">
                                                            <apex:selectOptions value="{!departmentsColleges}" />
                                                        </apex:selectList>
                                                    </span>

                                                    <span style="margin-left: 10px">
                                                        <apex:outputLabel for="camLocation" value="Location:" />
                                                        <apex:inputField id="camLocation" value="{!tempCampaign.Campus_Location__c}" style="margin-left: 5px" />
                                                    </span>

                                                    <span style="margin-left: 10px">
                                                        <apex:outputLabel for="camStart" value="Event Start Date:" />
                                                        <apex:input id="camStart" value="{!camStartDate}" type="date" style="margin-left: 5px" />
                                                    </span>
                                                    <br />
                                                    <br />
                                                    <apex:outputText id="eventHelpText">
                                                        <i>Search by Name, Type, or Category</i>
                                                    </apex:outputText>
                                                    <br />
                                                    <br />
                                                    <apex:outputPanel id="eventPanel">
                                                        <apex:dataTable id="eventList" value="{!eventList}" var="el" width="100%" cellpadding="8" rowClasses="even,odds" rendered="{!IF(eventList.size
                                                                            > 0, true, false)}">
                                                            <apex:column id="alius-format1168">
                                                                <apex:commandLink value="Select" reRender="elIdInput,msgs,statusSelect" status="actStatusEvent">
                                                                    <apex:param name="elId" value="{!el.Id}" assignTo="{!elId}" />
                                                                    <apex:param name="eventName" value="{!el.Name}" assignTo="{!eventName}" />
                                                                </apex:commandLink>
                                                            </apex:column>

                                                            <apex:column headerValue="Name" value="{!el.Name}" />

                                                            <apex:column headerValue="Start Date" value="{!el.Event_Start_Date__c}" />

                                                            <apex:column headerValue="Start Time" value="{!el.Event_Start_Time__c}" />

                                                            <apex:column headerValue="Campus" value="{!el.Campus_Location__c}" />

                                                            <apex:column headerValue="Location" value="{!el.Event_Location__c}" />

                                                            <apex:column headerValue="Department/College" value="{!el.Requested__c}" />
                                                        </apex:dataTable>

                                                        <apex:outputText rendered="{!IF((eventList.size = 0
                                                            && eventSearchString != null),true, false)}">
                                                            <br />
                                                            <br /> No results found for
                                                            <b>{!eventSearchString}</b>.
                                                        </apex:outputText>
                                                    </apex:outputPanel>
                                                </apex:outputPanel>
                                            </td>
                                        </tr>
                                    </table>
                                </apex:actionRegion>
                            </apex:outputPanel>
                        </apex:tab>
                    </apex:tabPanel>
                </apex:pageBlockSection>
            </apex:pageBlock>

            <apex:pageBlock id="alius-format1169">
                <apex:commandButton styleClass="button" action="{!savePage}" value="Save" status="saveStatus" />

                <apex:commandButton styleClass="button" action="{!saveAndNew}" value="Save and New" status="saveStatus" />
                <apex:actionStatus id="saveStatus">
                    <apex:facet name="start">
                        <img src="/img/loading.gif" style="margin-bottom: -4px" />
                    </apex:facet>
                </apex:actionStatus>
            </apex:pageBlock>
        </apex:form>

        <script>
            function noenter(ev, element) {
                if (window.event) {
                    ev = window.event;
                }

                var keyCode;

                if (ev.keyCode) {
                    keyCode = ev.keyCode;
                } else {
                    keyCode = ev.charCode;
                }

                if (keyCode == 13) {
                    var ele = document.getElementById(element);
                    ele.click();

                    return false;
                } else {
                    return true;
                }
            }
        </script>
    </body>
</apex:page>