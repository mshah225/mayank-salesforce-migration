    <script type="text/javascript">
        var inConsole = false;

        function setTabTitle() {
            //Set the current tab's title
            if (sforce.console.isInConsole() || window.location.href.includes('FrameOrigin')) {
                sforce.console.setTabTitle("{!theContact.Preferred_First_Name__c}'s Student Profile");
                inConsole = true;
            }
        }

        var pageLoad = window.onload;
        window.onload = function () {
            if (pageLoad) {
                pageLoad();
            }
            setTabTitle();
        };

        function openNewSubtab(subtabUrl, subtabTitle) {
            var openSubtab = function (result) {
                if (result.id === 'null') {
                    window.open(subtabUrl);
                    return;
                }

                if (subtabTitle !== 'null') {
                    sforce.console.openSubtab(result.id, subtabUrl, true, subtabTitle, null);
                } else {
                    sforce.console.openSubtab(result.id, subtabUrl, true);
                }
            };

            if (inConsole) {
                sforce.console.getEnclosingPrimaryTabId(openSubtab);
            } else {
                window.open(subtabUrl);
            }
        }

        Visualforce.remoting.timeout = 120000;
        (function ($) {
            fakewaffle.responsiveTabs(['xs', 'sm']);
        })(jQuery);

        function submitCase() {
            var subject = document.getElementById('usrSubject').value;
            var description = document.getElementById('usrDescription').value;
            if (subject.length <= 0 || description.length <= 0) {
                document.getElementById('modalError').innerHTML =
                    'Please ensure that subject and description are not blank';
            } else {
                Visualforce.remoting.Manager.invokeAction(
                    '{!$RemoteAction.StudentProfileController.createCase}',
                    description,
                    subject,
                    '{!theContact.EMPLId__c}',
                    function (result, event) {
                        document.getElementById('usrSubject').value = '';
                        document.getElementById('usrDescription').value = '';
                        document.getElementById('modalError').innerHTML = '';
                        var url = window.location.href;
                        sforce.console.openPrimaryTab(null, './' + result, true);
                        jQuery('#myModal').modal('hide');
                    }
                );
            }
        }

        function clearError() {
            document.getElementById('modalError').innerHTML = '';
            document.getElementById('usrSubject').value = '';
            document.getElementById('usrDescription').value = '';
        }

        $j = jQuery.noConflict();

        var timeoutHandle;

        $j('.fa-question-circle').mouseenter(function () {
            var that = $j(this);
            that.tooltip('show');
            window.clearTimeout(timeoutHandle);
        });

        $j('.fa-question-circle').mouseleave(function () {
            var _this = $j(this);
            timeoutHandle = window.setTimeout(function () {
                _this.tooltip('hide');
            }, 2000);
        });

        $j('#sunCard').error(function () {
            $j(this).attr('src', '{!$Resource.blankAvatar}');
        });

        $j(document).ready(function () {
            $j('#btnLoadIndicatorsHistory').click(function () {
                getRetentionSNPs();
            });

            maskPhoneNumbers();
            filterFinancialAid();

            loadRemoteSunCardPhoto();
            loadCommentsTab();
            loadUGIndicatorTab();
            loadClassesTab();
        });

        function loadRemoteSunCardPhoto() {
            Visualforce.remoting.Manager.invokeAction(
                '{!$RemoteAction.StudentProfileController.getSunCardPhotoRA}',
                '{!theContact.ASURite_ID__c}',
                '{!theContact.EMPLID__c}',
                function (result, event) {
                    if (event.status) {
                        if (result.length != 0) {
                            var onlineStudent = '{!theContact.ASU_Online_Student__c}';
                            if (onlineStudent === true) {
                                result = '{!$Resource.blankAvatar}';
                            }

                            var blankAvatarURL = '{!URLFOR($Resource.blankAvatar)}';

                            var html =
                                '<img id="studentPhotoImg2" src="' +
                                result +
                                '" ' +
                                ' alt="suncard photo" ' +
                                ' onerror="if (this.src != \'' +
                                blankAvatarURL +
                                ")') this.src='" +
                                blankAvatarURL +
                                '\'" ' +
                                ' class="img-responsive intro" ' +
                                ' style="max-width:200px;width:100%;"/>';
                            document.getElementById('sunDevilImgDiv').innerHTML = html;
                            cleanUpUndefined('sunDevilImgDiv');
                        } else {
                            jQuery('#sunImgSpinner').remove();
                        }
                    } else {
                        jQuery('#sunImgSpinner').remove();
                    }
                },
                { buffer: false, escape: true, timeout: 120000 }
            );
        }

        // Arrow Functionality
        $j('.page-header-smaller').click(function () {
            var container = $j(this);
            var arrow = $j(this).find('.fa-caret-down, .fa-caret-right');
            if (arrow.hasClass('fa-caret-down')) {
                container.next().slideUp().addClass('hide');
            } else if (arrow.hasClass('fa-caret-right')) {
                container.next().removeClass('hide').slideDown();
            }

            arrow.toggleClass('fa-caret-right');
            arrow.toggleClass('fa-caret-down');
        });

        $j('.sideBoxMoreLink').click(function (e) {
            e.stopPropagation();
        });

        // Arrow Functionality
        $j('.grad-row-toggle').click(function () {
            var container = $j(this);
            var arrow = $j(this).find('.fa-caret-down, .fa-caret-right');
            if (arrow.hasClass('fa-caret-down')) {
                while (
                    container.next() != null &&
                    container.next().size() > 0 &&
                    (container.next()[0].classList.contains('gradExtraInfo') ||
                        container.next()[0].classList.contains('committeeExtraInfo') ||
                        container.next()[0].classList.contains('advisorExtraInfo'))
                ) {
                    container = container.next();
                    container.slideUp().addClass('hide');
                    container.find('.fa-caret-down').toggleClass('fa-caret-down fa-caret-right');
                }
            } else if (arrow.hasClass('fa-caret-right')) {
                while (
                    container.next() != null &&
                    container.next().size() > 0 &&
                    container.next()[0].classList.contains('gradExtraInfo')
                ) {
                    container = container.next();
                    if (!container[0].classList.contains('hideOnStart')) {
                        container.removeClass('hide').slideDown();
                    }
                }
            }

            arrow.toggleClass('fa-caret-right');
            arrow.toggleClass('fa-caret-down');
        });

        // Committee Arrow Functionality
        $j('.committee-row-toggle').click(function () {
            var container = $j(this);
            var arrow = $j(this).find('.fa-caret-down, .fa-caret-right');
            if (arrow.hasClass('fa-caret-down')) {
                while (
                    container.next() != null &&
                    container.next().size() > 0 &&
                    container.next()[0].classList.contains('committeeExtraInfo')
                ) {
                    container = container.next();
                    container.slideUp().addClass('hide');
                }
            } else if (arrow.hasClass('fa-caret-right')) {
                while (
                    container.next() != null &&
                    container.next().size() > 0 &&
                    container.next()[0].classList.contains('committeeExtraInfo')
                ) {
                    container = container.next();
                    container.removeClass('hide').slideDown();
                }
            }

            arrow.toggleClass('fa-caret-right');
            arrow.toggleClass('fa-caret-down');
        });

        // Advisor Arrow Functionality
        $j('.advisor-row-toggle').click(function () {
            var container = $j(this);
            var arrow = $j(this).find('.fa-caret-down, .fa-caret-right');
            if (arrow.hasClass('fa-caret-down')) {
                while (
                    container.next() != null &&
                    container.next().size() > 0 &&
                    container.next()[0].classList.contains('advisorExtraInfo')
                ) {
                    container = container.next();
                    container.slideUp().addClass('hide');
                }
            } else if (arrow.hasClass('fa-caret-right')) {
                while (
                    container.next() != null &&
                    container.next().size() > 0 &&
                    container.next()[0].classList.contains('advisorExtraInfo')
                ) {
                    container = container.next();
                    container.removeClass('hide').slideDown();
                }
            }

            arrow.toggleClass('fa-caret-right');
            arrow.toggleClass('fa-caret-down');
        });

        //  add smooth scroll to tab on click for mobile
        $j(document).on('click', 'a.tabLink', function () {
            if (
                navigator.userAgent.match(/Android/i) ||
                navigator.userAgent.match(/webOS/i) ||
                navigator.userAgent.match(/iPhone/i) ||
                navigator.userAgent.match(/iPad/i) ||
                navigator.userAgent.match(/iPod/i) ||
                navigator.userAgent.match(/BlackBerry/i) ||
                navigator.userAgent.match(/Windows Phone/i)
            ) {
                if (!$j(this).hasClass('collapsed')) {
                    $j('html, body').animate(
                        {
                            scrollTop: $j(this).offset().top - 10,
                        },
                        800
                    );
                }
            }
        });

        var indicatorTabLoaded = false;
        var advisorNotesLoaded = false;
        var commentsLoaded = false;
        var guestAccessLoaded = false;
        var indicatorHistoryLoaded = false;
        var transcriptsLoaded = false;
        var classesData;
        var financialAidData;

        function loadClassesTab() {
            getEnrolledClasses();
            getCreditByExamData();
            getTransferWork();
        }

        function loadUGIndicatorTab() {
            getStudentRetention();
            getGeneralIndicators();
            getTranscripts();
        }

        function loadCommentsTab() {
            getPSAdvisorNotes();
            getComments();
            getGuestAccess();
        }

        // Method to replace all undefined/missing fields after callout
        function cleanUpUndefined(elementId) {
            var element = document.getElementById(elementId);

            if (element) {
                element.innerHTML = element.innerHTML.replace(/undefined/g, '--');
                element.innerHTML = element.innerHTML.replace(/NaN/g, '--');
            }
        }

        // Method to load the Undergraduate Indicators tab
        function getStudentRetention() {
            if (!indicatorTabLoaded) {
                document.getElementById('stdtRetentionResponseErrors').innerHTML =
                    "<i class='fa fa-spinner fa-pulse fa-2x fa-fw margin-bottom'></i>";
                var retentionQuery =
                    'SELECT ASR_INDICATOR__c, CI_INDEX_INDICATOR__c, ' +
                    'CUM_GPA_INDICATOR__c, DisplayUrl, EADVISOR_INDICATOR__c, EMPLID__c, ' +
                    'ENRL_HOLD_COUNT__c, ExternalId, FA_INDICATOR__c, FINANCIAL_HOLD__c, ' +
                    'Id, NEXT_TERM_ENROLLED__c, ' +
                    'STRM__c, TOT_IND__c, AVG_MYASU_COHORT__c, ' +
                    'PAST_DUE_TIP__c, TERM_MYASU_USAGE__c ' +
                    'FROM ASU_STDNT_RETENTION__x ' +
                    "WHERE EMPLID__c = '{!theContact.EMPLID__c}'";
                var conn = new jsforce.Connection({ accessToken: '{!$API.Session_Id}' });
                conn.query(
                    retentionQuery,
                    function (err, response) {
                        if (err) {
                            document.getElementById('stdtRetentionResponseErrors').innerHTML = err;
                        } else {
                            document.getElementById('stdtRetentionResponseErrors').innerHTML = '';

                            if (!response.totalSize == 0) {
                                var result = response.records[0];
                                document.getElementById('UGgeneralIndicators').style.display = 'initial';
                                document.getElementById('stdtRetentionResponseErrors').style.display = 'none';
                                document.getElementById('sr_finAid_issue').innerHTML = result.FA_INDICATOR__c;
                                document.getElementById('sr_asr').innerHTML = result.ASR_INDICATOR__c;
