                        return;
                    }

                    for (var i = 0; i < keySet.length; i++) {
                        awardMap.set(keySet[i], valueSet[i]);
                    }
                    var selectHtml =
                        "<label for='awardSelectOptions'>Academic Year:&nbsp;</label><select id='awardSelectOptions' onchange='buildAwardTable()'>";
                    for (var i = 0; i < keySet.length; i++) {
                        selectHtml += '<option ';
                        selectHtml += " value='" + keySet[i] + "'>" + keySet[i] + '</option>';
                    }
                    selectHtml += '</select>&nbsp;&nbsp;';
                    document.getElementById('selectListForAwards').innerHTML = selectHtml;

                    buildAwardTable();
                },
                {buffer: false, escape: true, timeout: 120000}
            );
        }

        function buildAwardTable() {
            var selectedYear = document.getElementById('awardSelectOptions').value;
            var awardsForSelectedYear = awardMap.get(selectedYear);

            var html = '';
            var formatter = new Intl.NumberFormat('en-US', {
                style: 'currency',
                currency: 'USD',
            });

            for (var i = 0; i < awardsForSelectedYear.length; i++) {
                html +=
                    '' +
                    "<div class='table-responsive'>" +
                    "<table class='table table-striped table-bordered'> " +
                    '<thead>' +
                    '<tr>' +
                    '<th>' +
                    awardsForSelectedYear[i].term_description +
                    '</th>' +
                    '<th>Category</th>' +
                    '<th>Current Offer</th>' +
                    '<th>Accepted Amount</th>' +
                    '<th>Disbursed Amount</th>' +
                    '<th>Status</th>' +
                    '</tr>' +
                    '</thead>' +
                    '<tbody>';

                var awardDetails = awardsForSelectedYear[i].award_details;

                for (var j = 0; j < awardDetails.length; j++) {
                    html +=
                        '<tr>' +
                        '<td>' +
                        awardDetails[j].award_name +
                        '</td>' +
                        '<td>' +
                        awardDetails[j].category_description +
                        '</td>' +
                        '<td>' +
                        formatter.format(awardDetails[j].current_offer) +
                        '</td>' +
                        '<td>' +
                        formatter.format(awardDetails[j].accept_balance) +
                        '</td>' +
                        '<td>' +
                        formatter.format(awardDetails[j].disbursed_balance) +
                        '</td>' +
                        '<td>' +
                        awardDetails[j].disbursement_status +
                        '</td>' +
                        '</tr>';
                }

                html +=
                    '<tr>' +
                    '<th colspan="2">Total</th>' +
                    '<th>' +
                    formatter.format(awardsForSelectedYear[i].total_current_amount) +
                    '</th>' +
                    '<th>' +
                    formatter.format(awardsForSelectedYear[i].total_accepted_amount) +
                    '</th>' +
                    '<th>' +
                    formatter.format(awardsForSelectedYear[i].total_disbursed_amount) +
                    '</th>' +
                    '</tr>';

                html += '</tbody></table></div>';
            }

            document.getElementById('awardTable').innerHTML = html;
        }

        //Charge History
        var chargeHistoryMap = new Map();

        function loadFinancialAidChargeHistory() {
            Visualforce.remoting.Manager.invokeAction(
                '{!$RemoteAction.StudentProfileController.getChargeHistoryMap}',
                '{!theContact.EMPLID__c}',
                function (result, event) {
                    var keySet = Object.keys(result);
                    var valueSet = Object.values(result);

                    if (keySet.length == null || keySet.length == 0) {
                        document.getElementById('selectListForChargeHistory').innerHTML =
                            'There is currently no Charge History information available for this student';
                        return;
                    }

                    for (var i = 0; i < keySet.length; i++) {
                        awardMap.set(keySet[i], valueSet[i]);
                    }
                    var selectHtml =
                        "<label for='chargeHistorySelectOptions'>Academic Year:&nbsp;</label><select id='chargeHistorySelectOptions' onchange='buildChargeHistoryTable()'>";
                    for (var i = 0; i < keySet.length; i++) {
                        selectHtml += '<option ';
                        selectHtml += " value='" + keySet[i] + "'>" + keySet[i] + '</option>';
                    }
                    selectHtml += '</select>&nbsp;&nbsp;';
                    document.getElementById('selectListForChargeHistory').innerHTML = selectHtml;

                    buildChargeHistoryTable();
                },
                {buffer: false, escape: true, timeout: 120000}
            );
        }

        function buildChargeHistoryTable() {
            var selectedTerm = document.getElementById('chargeHistorySelectOptions').value;
            var chargeHistoryForSelectedTerm = awardMap.get(selectedTerm);

            var html = '';
            var formatter = new Intl.NumberFormat('en-US', {
                style: 'currency',
                currency: 'USD',
            });

            html +=
                '' +
                "<div class='table-responsive'>" +
                "<table class='table table-striped table-bordered'> " +
                '<thead>' +
                '<tr>' +
                '<th>Term</th>' +
                '<th>Description</th>' +
                '<th>Charge</th>' +
                '<th>Payments / Financial Aid</th>' +
                '<th>Balance</th>' +
                '</tr>' +
                '</thead>' +
                '<tbody>';

            var chargeHistoryDetails = chargeHistoryForSelectedTerm.charge_details;

            for (var j = 0; j < chargeHistoryDetails.length; j++) {
                html +=
                    '<tr>' +
                    '<td>' +
                    chargeHistoryForSelectedTerm.term_name +
                    '</td>' +
                    '<td>' +
                    chargeHistoryDetails[j].description +
                    '</td>' +
                    '<td>' +
                    formatter.format(chargeHistoryDetails[j].charge) +
                    '</td>' +
                    '<td>' +
                    formatter.format(chargeHistoryDetails[j].payment) +
                    '</td>' +
                    '<td>' +
                    formatter.format(chargeHistoryDetails[j].balance) +
                    '</td>' +
                    '</tr>';
            }

            html +=
                '<tr>' +
                '<th colspan="2">Total</th>' +
                '<th>' +
                formatter.format(chargeHistoryForSelectedTerm.total_charges) +
                '</th>' +
                '<th>' +
                formatter.format(chargeHistoryForSelectedTerm.total_payment) +
                '</th>' +
                '<th>' +
                formatter.format(chargeHistoryForSelectedTerm.total_balance) +
                '</th>' +
                '</tr>';

            html += '</tbody></table></div>';

            document.getElementById('chargeHistoryTable').innerHTML = html;
        }

