        // Method to get transcripts
        function getTranscripts() {
            if (!transcriptsLoaded) {
                var conn = new jsforce.Connection({accessToken: '{!$API.Session_Id}'});
                document.getElementById('psTranscriptErrors').innerHTML =
                    "<i class='fa fa-spinner fa-pulse fa-2x fa-fw margin-bottom'></i>";
                document.getElementById('grpsTranscriptErrors').innerHTML =
                    "<i class='fa fa-spinner fa-pulse fa-2x fa-fw margin-bottom'></i>";

                var transcriptQuery =
                    'SELECT Address1__c, Address2__c, Address3__c, ' +
                    'Address4__c, City__c, Country__c, Send_To_Name__c, ' +
                    'Postal__c, State__c, Status__c, Request_Or_Sent_Date__c, ' +
                    'Id ' +
                    'FROM Transcript_Sent__c ' +
                    "WHERE Contact__c = '{!theContact}' " +
                    'ORDER BY Request_Or_Sent_Date__c DESC, Send_To_Name__c DESC';
                conn.query(
                    transcriptQuery,
                    function (err, response) {
                        if (err) {
                            document.getElementById('psTranscriptErrors').innerHTML = err;
                            document.getElementById('grpsTranscriptErrors').innerHTML = err;
                        } else {
                            document.getElementById('psTranscriptErrors').innerHTML = '';
                            document.getElementById('grpsTranscriptErrors').innerHTML = '';
                            if (!response.totalSize == 0) {
                                document.getElementById('ps_transcript').style.display = 'initial';
                                document.getElementById('gr_psTranscript').style.display = 'initial';

                                var html =
                                    '' +
                                    "<div class='table-responsive'>" +
                                    "<table id='transcript_table' class='table table-striped table-bordered'> " +
                                    '<thead>' +
                                    '<tr>' +
                                    '<th>Request Date</th>' +
                                    '<th>Status</th>' +
                                    '<th>Recipient</th>' +
                                    '</tr>' +
                                    '</thead>' +
                                    '<tbody>';
                                var result = response.records;
                                for (var i = 0; i < result.length; i++) {
                                    var utcSeconds = result[i].Request_Or_Sent_Date__c;
                                    var sentDate = new Date(utcSeconds);
                                    sentDate =
                                        sentDate.getUTCMonth() +
                                        1 +
                                        '/' +
                                        sentDate.getUTCDate() +
                                        '/' +
                                        sentDate.getUTCFullYear();

                                    var status = result[i].Status__c;
                                    var recipient = new Array(
                                        result[i].Send_To_Name__c,
                                        result[i].Address1__c,
                                        result[i].Address2__c,
                                        result[i].Address3__c,
                                        result[i].Address4__c
                                    );

                                    html +=
                                        '' +
                                        '<tr>' +
                                        '<td>' +
                                        sentDate +
                                        '</td>' +
                                        '<td>' +
                                        status +
                                        '</td>' +
                                        '<td>' +
                                        "<li class='transcriptAddress'>" +
                                        recipient[0] +
                                        '</li>';

                                    for (var j = 1; j < recipient.length; j++) {
                                        if (recipient[j] != null && recipient[j] != '-') {
                                            html += "<li class='transcriptAddress'> " + recipient[j] + '</li>';
                                        }
                                    }

                                    html +=
                                        "<li class='transcriptAddress'>" +
                                        result[i].City__c +
                                        ', ' +
                                        result[i].State__c +
                                        ' ' +
                                        result[i].Postal__c +
                                        '</li>' +
                                        "<li class='transcriptAddress'> " +
                                        result[i].Country__c +
                                        '</li>' +
                                        '</td>' +
                                        '</tr>';
                                }

                                html += '' + '</tbody>' + '</table>' + '</div>';

                                document.getElementById('ps_transcript').innerHTML = html;
                                document.getElementById('gr_psTranscript').innerHTML = html;
                                cleanUpUndefined('ps_transcript');
                                cleanUpUndefined('gr_psTranscript');
                                transcriptsLoaded = true;
                            } else {
                                document.getElementById('ps_transcript').innerHTML = 'No transcripts found.';
                                document.getElementById('ps_transcript').style.display = 'initial';
                                document.getElementById('gr_psTranscript').innerHTML = 'No transcripts found.';
                                document.getElementById('gr_psTranscript').style.display = 'initial';
                                transcriptsLoaded = true;
                            }
                        }
                    },
                    {buffer: false, escape: true, timeout: 120000}
                );
            }
        }

        // Method to load the advisor comments.
        function getPSAdvisorNotes() {
            if (!advisorNotesLoaded) {
                document.getElementById('psAdvisingNotesResponseErrors').innerHTML =
                    "<i class='fa fa-spinner fa-pulse fa-2x fa-fw margin-bottom'></i>";

                var advisorNoteQuery =
                    'SELECT ACAD_CAREER__c, COMMENTS__c, CREATDTTM__c, CREATEOPRID__c, DisplayUrl, ' +
                    'EMPLID__c, ExternalId, Id, NAME__c, STRM__c,  Academic_Plan__c, Academic_Plan__r.Name, Academic_Program__r.Name, Student_Career_Number__c ' +
                    'FROM PS_ASU_SP_ADNOTE_V__x ' +
                    "WHERE EMPLID__c = '{!theContact.EMPLID__c}' " +
                    'ORDER BY CREATDTTM__c DESC';
                var conn = new jsforce.Connection({accessToken: '{!$API.Session_Id}'});
                conn.query(advisorNoteQuery, function (err, response) {
                    if (err) {
                        document.getElementById('psAdvisingNotesResponseErrors').innerHTML = err;
                    } else {
                        if (!response.totalSize == 0) {
                            var noteResponse = response.records;
                            noteResponse.forEach(function (record) {
                                delete record.attributes;
                            });
                            noteResponse = JSON.stringify(noteResponse);
                            Visualforce.remoting.Manager.invokeAction(
                                '{!$RemoteAction.StudentProfileController.getPSAdvisorNotes}',
                                '{!theContact.EMPLID__c}',
                                noteResponse,
                                function (result, event) {
                                    if (event.status) {
                                        document.getElementById('psAdvisingNotesResponseErrors').innerHTML = '';

                                        if (!Object.getOwnPropertyNames(result).length == 0) {
                                            document.getElementById('psAdvisingNotesResponseErrors').style.display =
                                                'none';
                                            var html = '<table class="table table-striped table-bordered">';

                                            for (var i = 0; i < result.length; i++) {
                                                var dateStamp = new Date(result[i].note.CREATDTTM__c);
                                                var commentDate = new Date(
                                                    dateStamp.toLocaleString('en-US', {timeZone: 'Etc/GMT'})
                                                );
                                                commentDate =
                                                    commentDate.getMonth() +
                                                    1 +
                                                    '/' +
                                                    commentDate.getDate() +
                                                    '/' +
                                                    commentDate.getFullYear();
                                                html +=
                                                    '<tr>' +
                                                    '<td>' +
                                                    (result[i].advUserId == undefined
                                                        ? ''
                                                        : "<a href='/_ui/core/userprofile/UserProfilePage?u=" +
                                                          result[i].advUserId +
                                                          "&tab=sfdc.ProfilePlatformFeed' target='_blank'>") +
                                                    result[i].note.NAME__c +
                                                    (result[i].advUserId == undefined ? '' : '</a>') +
                                                    '</td> <td>' +
                                                    commentDate +
                                                    '</td>' +
                                                    '</td> <td>' +
                                                    result[i].note.Academic_Plan__r.Name +
                                                    '</td>' +
                                                    '</td> <td>' +
                                                    result[i].note.Academic_Program__r.Name +
                                                    '</td>' +
                                                    '</tr>' +
                                                    '<tr>' +
                                                    '<td colspan="4">' +
                                                    result[i].note.COMMENTS__c.replace(/(?:\r\n|\r|\n)/g, '<br />') +
                                                    '</td>' +
                                                    '</tr>';
                                            }
                                            html += '</table>';
                                            document.getElementById('ps_advising_notes_section').innerHTML = html;
                                            cleanUpUndefined('ps_advising_notes_section');
                                            advisorNotesLoaded = true;
                                        } else {
                                            document.getElementById('psAdvisingNotesResponseErrors').innerHTML =
                                                'No advising notes found.';
                                            advisorNotesLoaded = true;
                                        }
                                    } else if (event.type === 'exception') {
                                        document.getElementById('psAdvisingNotesResponseErrors').innerHTML =
                                            event.message + '<br/>\n<pre>' + event.where + '</pre>';
                                    } else {
                                        document.getElementById('psAdvisingNotesResponseErrors').innerHTML =
                                            event.message;
                                    }
                                },
                                {buffer: false, escape: true, timeout: 120000}
                            );
                        } else {
                            document.getElementById('psAdvisingNotesResponseErrors').innerHTML =
                                'No advising notes found.';
                            advisorNotesLoaded = true;
                        }
                    }
                });
            }
        }

