                    "WHERE emplId__c = '{!theContact.EMPLID__c}' " +
                    'ORDER BY CREATED_EW_DTTM__c DESC, STRM__c DESC';
                var conn = new jsforce.Connection({ accessToken: '{!$API.Session_Id}' });
                conn.query(
                    rententionQuery,
                    function (err, response) {
                        if (err) {
                            document.getElementById('psRetentionSNPErrors').innerHTML = err;
                        } else {
                            document.getElementById('psRetentionSNPErrors').innerHTML = '';

                            if (!response.totalSize == 0) {
                                var result = response.records;
                                document.getElementById('ps_retention_snp').style.display = 'initial';

                                var html =
                                    '' +
                                    "<div class='table-responsive'>" +
                                    "<table class='table table-striped table-bordered'> " +
                                    '<thead>' +
                                    '<tr>' +
