                                        typeof result[i].FINANCIAL_HOLD__c == 'string' &&
                                        result[i].FINANCIAL_HOLD__c == 'Y'
                                    )
                                        totIndicators++;

                                    if (typeof result[i].PAST_DUE_TIP__c == 'number' && result[i].PAST_DUE_TIP__c != 0)
                                        result[i].PAST_DUE_TIP__c = '$' + result[i].PAST_DUE_TIP__c;

                                    html +=
                                        '' +
                                        '<tr>' +
                                        '<td>' +
                                        createdDate +
                                        '</td>' +
                                        '<td>' +
                                        result[i].STRM__c +
                                        '</td>' +
                                        '<td>' +
                                        result[i].FA_INDICATOR__c +
                                        '</td>' +
                                        '<td>' +
                                        result[i].CI_INDEX_INDICATOR__c +
                                        '</td>' +
                                        '<td>' +
                                        result[i].ASR_INDICATOR__c +
                                        '</td>' +
                                        '<td>' +
                                        result[i].EADVISOR_INDICATOR__c +
                                        '</td>' +
                                        '<td>' +
                                        result[i].TERM_MYASU_USAGE__c +
                                        '</td>' +
                                        '<td>' +
                                        result[i].AVG_MYASU_COHORT__c +
                                        '</td>' +
                                        '<td>' +
                                        result[i].CUM_GPA_INDICATOR__c +
                                        '</td>' +
                                        '<td>' +
                                        result[i].PROBATION_INDICATOR__c +
                                        '</td>' +
                                        '<td>' +
                                        result[i].TRANSCRIPTS_SENT_COUNT__c +
                                        '</td>' +
                                        '<td>' +
