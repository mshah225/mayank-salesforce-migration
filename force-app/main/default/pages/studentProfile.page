<apex:page
    id="studentProfile"
    controller="StudentProfileController"
    cache="true"
    showHeader="false"
    sideBar="false"
    standardStylesheets="false"
    docType="HTML-5.0"
    action="{!init}"
>
    <apex:includeScript value="/support/console/42.0/integration.js" />
    <apex:includeScript value="{!URLFOR($Resource.jsForce)}" />

    <head>
        <title>{!theContact.Preferred_First_Name__c}'s Student Profile</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <!-- Latest compiled and minified CSS -->
        <link
            rel="stylesheet"
            href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/css/bootstrap.min.css"
            integrity="sha384-1q8mTJOASx8j1Au+a5WDVnPi2lkFfwwEAa8hDDdjZlpLegxhjVME1fgjWPGmkzs7"
            crossorigin="anonymous"
        />
        <link href="https://fonts.googleapis.com/css?family=Roboto:normal,medium" rel="stylesheet" type="text/css" />
        <apex:stylesheet
            value="{!URLFOR($Resource.MyASUHeader4_3,
                'MyASUHeader4_3/font-awesome-4.3.0/css/font-awesome.css')}"
        />
        <c:StudentProfileStyles />
        <style>
            .gradTable {
                font-family: arial, sans-serif;
                border-collapse: collapse;
                width: 100%;
            }

            .planMargin {
                margin-left: 75px;
            }

            .gradTD,
            .gradTH {
                text-align: left;
                padding: 8px;
            }

            .gradTD {
                border: 0px !important;
            }

            .gradTR {
                background-color: rgba(140, 29, 64, 0.2);
                border: 1px solid #ddd;
            }

            .innerHeaders {
                font-size: 1.15em;
                border-top: 1px solid #ddd;
            }

            .gradTH {
                border-bottom: 2px solid #333 !important;
                border-top: 1px solid #ddd;
            }

            .mobile {
                display: none;
                margin: auto !important;
                margin-bottom: 24px !important;
                max-width: 50% !important;
            }

            li.transcriptAddress {
                list-style: none;
            }

            th.transcriptHeader {
                width: 165px;
            }

            #ps_financial_aid_checklist_note {
                font-weight: 900;
                margin-bottom: 0.5em;
            }

            #ps_financial_aid_communications_note {
                margin-top: 0.5em;
            }

            #ps_financial_aid_communications a,
            #ps_financial_aid_communications a:hover {
                color: #9f2b50;
            }

            @media screen and (max-width: 767px) {
                .browser {
                    display: none;
                }

                .mobile {
                    display: block;
                }
            }

            @media screen and (max-width: 991px) {
                #ps_enrolled_classes .table,
                #ps_dropped_withdrawn_classes .table {
                    margin: 0 auto;
                    width: 100%;
                    border-spacing: 0;
                    border: none;
                }

                #ps_enrolled_classes .table thead,
                #ps_dropped_withdrawn_classes .table thead {
                    position: absolute;
                    clip: rect(1px, 1px, 1px, 1px);
                    padding: 0;
                    border: 0;
                    height: 1px;
                    width: 1px;
                    overflow: hidden;
                }

                #ps_enrolled_classes .table tbody,
                #ps_enrolled_classes .table tr,
                #ps_enrolled_classes .table th,
                #ps_enrolled_classes .table td,
                #ps_dropped_withdrawn_classes .table tbody,
                #ps_dropped_withdrawn_classes .table tr,
                #ps_dropped_withdrawn_classes .table th,
                #ps_dropped_withdrawn_classes .table td {
                    display: inline-block;
                    padding: 0;
                    text-align: left;
                    white-space: normal;
                }

                #ps_enrolled_classes .table tr td,
                #ps_enrolled_classes .table tr th,
                #ps_dropped_withdrawn_classes .table tr td,
                #ps_dropped_withdrawn_classes .table tr th {
                    padding: 2em 1em;
                    vertical-align: middle;
                    overflow: hidden;
                    position: relative;
                    vertical-align: top;
                    border-top: none;
                    width: 100%;
                    white-space: normal;
                }

                #ps_enrolled_classes .table th[scope='row'],
                #ps_dropped_withdrawn_classes .table th[scope='row'] {
                    width: 100%;
                    text-align: center;
                    display: block;
                    background-color: #8c1d40;
                    color: white;
                    margin: 0 auto;
                    padding: 0.5em 0;
                }

                #ps_enrolled_classes .table td[data-header]:before,
                #ps_dropped_withdrawn_classes .table td[data-header]:before {
                    content: attr(data-header);
                    display: block;
                    float: left;
                    width: 50%;
                    color: #000000;
                    font-weight: bold;
                    text-align: left;
                }

                #ps_enrolled_classes .table td[data-header] > *,
                #ps_dropped_withdrawn_classes .table td[data-header] > * {
                    display: block;
                    width: 50%;
                    float: right;
                    clear: right;
                    padding-left: 1em;
                    margin-top: 0;
                }

                #ps_enrolled_classes .table td[data-header]:after,
                #ps_dropped_withdrawn_classes .table td[data-header]:after {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 0;
                    width: 50%;
                    border-right: 1px solid #edf0f1;
                    padding-bottom: 200%;
                    display: block;
                }
            }

            @media screen and (min-width: 992px) and (max-width: 1115px) {
                .browser {
                    padding: 8px !important;
                    font-size: 15px !important;
                }

                .browser img {
                    height: 36px !important;
                    width: 36px !important;
                }
            }

            .hide {
                display: none;
            }

            .headerTextColor {
                color: #9f2b50;
            }

            .customErrorBox {
                border-style: solid;
                border-width: 2px;
                border-color: #9f2b50;
                background: #fff;
                margin-bottom: 10px;
                margin-top: 20px;
            }

            .errorM3 .msgIcon,
            .errorSmall {
                background-image: none !important;
            }

            .customErrorMessage .message {
                background: none !important;
                border: none !important;
                margin-top: 0px !important;
            }

            .customErrorMessage .message .h4,
            h4 {
                color: #9f2b50 !important;
            }

            .alignTop {
                vertical-align: top;
            }

            .alert {
                margin-top: 20px;
                color: white;
                font-family: 'Roboto', 'Helvetica Neue', Helvetica, Arial, sans-serif !important;
                font-size: 14px;
                background: #9f2b50;
            }
        </style>
    </head>

    <body>
        <div class="mainCont">
            <div class="row intro">
                <div class="col-xs-4 col-md-2 intro" style="margin-bottom: 20px">
                    <apex:outputPanel id="photoRerenderPanel" layout="none">
                        <apex:form id="alius-format1182">
                            <div
                                id="sunDevilImgDiv"
                                style="{!IF(urlParamsExistAndAreValid, 'display:block', 'display:none')}"
                            >
                                <img
                                    id="studentPhotoImg2"
                                    src=" {!if(ISBLANK(suncardPhotoURL), URLFOR($Resource.blankAvatar), suncardPhotoURL)}"
                                    alt="suncard photo"
                                    class="img-responsive intro"
                                    style="max-width: 200px; width: 100%"
                                />
                            </div>
                        </apex:form>
                    </apex:outputPanel>
                </div>

                <div class="col-xs-8 col-md-4">
                    <div style="padding-top: 10px">
                        <span style="color: #6e7d83; font-weight: 200">
                            <h2
                                style="{!IF(!urlParamsExistAndAreValid, 'display:block', 'display:none')}"
                                class="intro"
                            >
                                <span class="headerTextColor"> {!contactName} </span>
                            </h2>
                            <h2 style="margin-top: 0px" class="intro">
                                <span style="color: #9f2b50"> {!theContact.Preferred_Full_Name__c} </span>
                                <apex:outputPanel rendered="{!deceased != ''}">
                                    <span style="font-size: 12pt; margin-left: 20px"> {!deceased} </span>
                                </apex:outputPanel>
                            </h2>
                            <h4
                                class="intro"
                                style="{!IF(urlParamsExistAndAreValid, 'display:block; color:#6e7d83 !important;', 'display:none;')}"
                            >
                                {!theContact.EMPLID__c}
                                <span style="color: #353535">|</span>
                                {!theContact.ASURite_ID__c}
                            </h4>

                            <apex:outputPanel
                                rendered="{!IF(studentProgram.Status__c == 'Active in Program', true, false)}"
                            >
                                <h4 class="intro" style="color: #6e7d83 !important">{!studentProgram.Career__c}</h4>

                                <h4 class="intro" style="color: #6e7d83 !important">
                                    {!studentProgram.Program_Description__c}
                                </h4>

                                <h4 class="intro" style="color: #6e7d83 !important">
                                    {!studentProgram.Plan_Transcript_Description__c +
                                    IF(ISBLANK(studentProgram.Degree__c),'', ', ' + studentProgram.Degree__c)}
                                    <apex:outputPanel rendered="{!activeGraduatePrograms.size > 1}">
                                        <div class="program-indicator-count" title="Count of Enrolled Active Plans">
                                            {!activeGraduatePrograms.size}
                                        </div>
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!accelerated}">
                                        <div class="accelerated-indicator" title="Accelerated">A</div>
                                    </apex:outputPanel>
                                </h4>

                                <h4 class="intro" style="color: #6e7d83 !important">
                                    {!IF(subPlanString==null, '--', subPlanString)}
                                </h4>

                                <h4 class="intro" style="color: #6e7d83 !important">
                                    {!studentProgram.Campus__r.Name}
                                </h4>
                            </apex:outputPanel>
                        </span>
                    </div>
                </div>

                <div class="col-xs-12 col-md-6">
                    <div class="sideBox" style="padding: 15px 15px 0 15px">
                        <h4 class="page-header-smaller" style="padding-bottom: 10px">Quick Reference Links</h4>
                        <table class="table table-borderless">
                            <tr>
                                <td>
                                    <a
                                        href="https://cs.oasis.asu.edu/psp/asucsprd/EMPLOYEE/CAMP/c/ASU_STUDENT_RECORDS.ASU_PP_PROXY_INQ.GBL?EMPLID={!theContact.EMPLID__c}"
                                        target="_blank"
                                    >
                                        Parent and Guest Access
                                    </a>
                                </td>
                                <td>
                                    <a
                                        href="https://cs.oasis.asu.edu/asucsprd/asusignon.html?dest=/EMPLOYEE/PSFT_ASUCSPRD/c/ASU_STUDENT_RECORDS.ASU_TSRQST_UNOFF.GBL?EMPLID={!theContact.EMPLID__c}"
                                        target="_blank"
                                    >
                                        Unofficial Transcript
                                    </a>
                                </td>
                                <td>
                                    AppXtender
                                    <a
                                        href="https://appx.asu.edu/AppXtender/DataSources/AX-SFA/ISubmitQuery?AutoLogoutOnClose=False&DocNavBlocked=True&DispMode=11&AppName=STUDENT&SearchAllRevisions=True&PublicQuery=False&UpdateAvlFieldsOnly=True&EMPLID={!theContact.EMPLID__c}"
                                        target="_blank"
                                        >(SFA)</a
                                    >
                                    -
                                    <a
                                        href="https://appx.asu.edu/AppXtender/DataSources/AX-GRAD/ISubmitQuery?AppName=GRADADM&EMPL+ID={!theContact.EMPLID__c}"
                                        target="_blank"
                                        >(GRAD)</a
                                    >
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <!--a href="/{!theContact.Id}" target="_blank"-->
                                    <a href="#" onclick="openNewSubtab('/{!theContact.Id}','Details');return false">
                                        Salesforce Contact
                                    </a>
                                </td>
                                <td>
                                    <a href="https://webapp4.asu.edu/uachieve/student/search.html" target="_blank">
                                        DARS
                                    </a>
                                </td>
                                <td>
                                    <a href="https://webapp4.asu.edu/gradapprev/" target="_blank"> GAR </a>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <a
                                        href="https://webapp4.asu.edu/myasu/viewas?id={!theContact.ASURite_ID__c}"
                                        target="_blank"
                                    >
                                        My ASU View As Student
                                    </a>
                                </td>
                                <td>
                                    <a
                                        href="https://cs.oasis.asu.edu/asucsprd/asusignon.html?dest=/EMPLOYEE/PSFT_ASUCSPRD/c/SCC_ADMIN_OVRD.SSS_STUDENT_CENTER.GBL?EMPLID={!theContact.EMPLID__c}"
                                        target="_blank"
                                    >
                                        Student's PeopleSoft
                                    </a>
                                </td>
                                <td>
                                    <a
                                        href="https://cs.oasis.asu.edu/asucsprd/asusignon.html?dest=/EMPLOYEE/PSFT_ASUCSPRD/c/ASU_ADMISSIONS.ASU_GPORTAL_SEARCH.GBL%3FEMPLID={!theContact.EMPLID__c}"
                                        target="_blank"
                                    >
                                        Gportal
                                    </a>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <a href="#" data-toggle="modal" data-target="#myModal"> Create New Service Case </a>
                                </td>

                                <div class="modal fade" id="myModal" role="dialog">
                                    <div class="modal-dialog">
                                        <!-- Modal content-->
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <button
                                                    type="button"
                                                    class="close"
                                                    onclick="clearError()"
                                                    data-dismiss="modal"
                                                >
                                                    &times;
                                                </button>
                                                <h4 class="modal-title">New Service Case</h4>
                                            </div>
                                            <div class="modal-body">
                                                <div id="modalError" style="color: red"></div>
                                                <div class="form-group">
                                                    <label for="comment">Subject:</label>
                                                    <input type="text" class="form-control" id="usrSubject" />
                                                </div>
                                                <div class="form-group">
                                                    <label for="comment">Description:</label>
                                                    <textarea
                                                        class="form-control"
                                                        rows="5"
                                                        id="usrDescription"
                                                    ></textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-default" onclick="submitCase();">
                                                    Submit
                                                </button>
                                                <button
                                                    type="button"
                                                    class="btn btn-default"
                                                    onclick="clearError()"
                                                    data-dismiss="modal"
                                                >
                                                    Cancel
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <td>
                                    <a
                                        href="https://cs.oasis.asu.edu/asucsprd/asusignon.html?dest=/EMPLOYEE/PSFT_ASUCSPRD/c/ASU_ACADEMIC_ADVISING_STAFF.ASU_AA_POS_SRCH_FL.GBL?EMPLID={!theContact.EMPLID__c}"
                                        target="_blank"
                                    >
                                        iPOS
                                    </a>
                                </td>
                                <td>
                                    <style>
                                        .feedbackButton {
                                            position: relative;
                                            border: 1px solid transparent;
                                            border-radius: 4px;
                                            margin: 0px;
                                            padding-left: 24px;
                                            padding-right: 24px;
                                            padding-top: 12px;
                                            padding-bottom: 12px;
                                            color: white;
                                            background-color: RGB(140, 29, 64);
                                            transition: all 0.25s ease-in-out 0s;
                                            word-wrap: break-word;
                                            font-size: 20px;
                                            text-align: center;
                                            text-decoration: none;
                                        }
                                    </style>
                                    <a
                                        style="
                                            border-radius: 4px;
                                            margin-left: -7px;
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            padding-top: 4px;
                                            padding-bottom: 4px;
                                            color: white;
                                            background-color: RGB(140, 29, 64);
                                            font-size: 16px;
                                            text-align: center;
                                        "
                                        href="./dynamicfeedback?carName=Student Profile&misc={!theContact.FirstName} {!theContact.lastName} Id:{!theContact.EMPLID__c}"
                                        target="_blank"
                                    >
                                        Feedback
                                    </a>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            <div class="customErrorBox" style="{!IF(urlParamsExistAndAreValid, 'display: none', 'display:block')}">
                <apex:outputPanel styleClass="customErrorMessage">
                    <apex:pageMessages id="alius-format1183"></apex:pageMessages>
                </apex:outputPanel>
            </div>

            <div class="row">
                <div class="col-lg-4">
                    <div class="sideBox">
                        <div role="tabpanel" class="tab-pane active" id="activeCases">
                            <div class="page-header-smaller" style="margin: 0 0 -5px 0; border: none">
                                <h4 style="display: inline-block; margin-top: 5px">
                                    <i class="fa fa-caret-right"></i>
                                    &nbsp;Active Cases ({!openCases.size})
                                </h4>

                                <div class="pull-right">
                                    <apex:outputPanel rendered="{!$User.UITheme == 'Theme3'}">
                                        <a
                                            href="#"
                                            onclick="openNewSubtab('/500?rlid=RelatedCaseList\&id={!theContact.Id}', 'All Cases');return false"
                                            class="pull-right sideBoxMoreLink"
                                            style="font-size: 11pt; margin-top: 2px"
                                        >
                                            See all cases...
                                        </a>
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!CONTAINS($User.UITheme, 'Theme4')}">
                                        <a
                                            href="#"
                                            onclick="openNewSubtab('/lightning/r/{!theContact.Id}/related/Cases/view', 'All Cases');return false"
                                            class="pull-right sideBoxMoreLink"
                                            style="font-size: 11pt; margin-top: 2px"
                                        >
                                            See all cases...
                                        </a>
                                    </apex:outputPanel>
                                </div>
                            </div>

                            <div class="hide" style="margin-top: 5px; padding-top: 10px; border-top: 2px solid #9f2b50">
                                <apex:dataTable
                                    rendered="{!openCases.size > 0}"
                                    styleClass="table"
                                    value="{!openCases}"
                                    var="oc"
                                    cellPadding="10"
                                    rowClasses="sideBoxTableRow"
                                    headerClass="sideBoxTableHeader"
                                >
                                    <apex:column headerValue="Last Modified">
                                        <apex:outputText value="{0, date, MM/d/YY}">
                                            <apex:param value="{!oc.LastModifiedDate}" />
                                        </apex:outputText>
                                    </apex:column>
                                    <apex:column headerValue="Status" value="{!oc.Status}" />
                                    <apex:column headerValue="Subject">
                                        <!--a href="/{!oc.Id}" target="_blank"-->
                                        <a href="#" onclick="openNewSubtab('/{!oc.Id}','null');return false">
                                            <apex:outputText
                                                rendered="{!IF(LEN(oc.Subject) > 100
                                                , true, false)}"
                                            >
                                                {!LEFT(oc.Subject, 100)}
                                            </apex:outputText>

                                            <apex:outputText
                                                rendered="{!IF(LEN(oc.Subject) < 100
                                                , true, false)}"
                                            >
                                                {!oc.Subject}
                                            </apex:outputText>
                                        </a>
                                    </apex:column>
                                </apex:dataTable>

                                <apex:outputText rendered="{!openCases.size == 0}">
                                    No active/open cases found for {!theContact.Preferred_First_Name__c}.
                                </apex:outputText>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="sideBox">
                        <div role="tabpanel" class="tab-pane active" id="serviceIndicators">
                            <div class="page-header-smaller" style="margin: 0 0 -5px 0; border: none">
                                <h4 style="display: inline-block; margin-top: 5px">
                                    <i class="fa fa-caret-right"></i>
                                    <a id="serviceIndicatorHeader"> &nbsp;Service Indicators </a>
                                </h4>

                                <div class="pull-right">
                                    <a
                                        href="https://cs.oasis.asu.edu/psp/asucsprd/EMPLOYEE/CAMP/c/MAINTAIN_SERVICE_IND_STDNT.ACTIVE_SRVC_INDICA.GBL?EMPLID={!theContact.EMPLID__c}"
                                        class="pull-right sideBoxMoreLink"
                                        target="_blank"
                                        style="font-size: 11pt; margin-top: 2px"
                                    >
                                        Manage...
                                    </a>
                                </div>
                            </div>

                            <div class="hide">
                                <apex:form>
                                    <div id="serviceIndicatorTable">
                                        <i class="fa fa-spinner fa-pulse"></i>
                                    </div>
                                </apex:form>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="sideBox">
                        <div role="tabpanel" class="tab-pane active" id="activeStudentGroups">
                            <div class="page-header-smaller" style="margin: 0 0 -5px 0; border: none">
                                <h4 style="display: inline-block; margin-top: 5px">
                                    <i class="fa fa-caret-right"></i>
                                    &nbsp;Active Student Groups ({!sGroupList.size})
                                </h4>

                                <div class="pull-right">
                                    <apex:outputPanel rendered="{!$User.UITheme == 'Theme3'}">
                                        <a
                                            href="#"
                                            onclick="openNewSubtab('/a0N?rlid=00Nd0000007tI9X\&id={!theContact.Id}','Student Groups');return false"
                                            class="pull-right sideBoxMoreLink"
                                            style="margin-top: 2px"
                                        >
                                            See all {!sGroupList.size}...
                                        </a>
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!CONTAINS($User.UITheme, 'Theme4')}">
                                        <a
                                            href="#"
                                            onclick="openNewSubtab('/lightning/r/{!theContact.Id}/related/Student_Groups_Contact__r/view','Student Groups');return false"
                                            class="pull-right sideBoxMoreLink"
                                            style="margin-top: 2px"
                                        >
                                            See all {!sGroupList.size}...
                                        </a>
                                    </apex:outputPanel>
                                </div>
                            </div>

                            <div class="hide" style="margin-top: 5px; padding-top: 10px; border-top: 2px solid #9f2b50">
                                <apex:dataTable
                                    rendered="{!sGroupList.size > 0}"
                                    styleClass="table"
                                    value="{!sGroupList}"
                                    var="sg"
                                    cellPadding="10"
                                    rowClasses="sideBoxTableRow"
                                    headerClass="sideBoxTableHeader"
                                >
                                    <apex:column headerValue="Date">
                                        <apex:outputText value="{0, date, MM/d/YY}">
                                            <apex:param value="{!sg.SG_Effective_Date__c}" />
                                        </apex:outputText>
                                    </apex:column>
                                    <apex:column headerValue="Code" value="{!sg.SG_PeopleSoft_Code__c}" />
                                    <apex:column headerValue="Description">
                                        <apex:outputText
                                            value="{!LEFT(sg.SG_Description__c, 100)}
                                    ..."
                                        />
                                    </apex:column>
                                </apex:dataTable>

                                <apex:outputText rendered="{!sGroupList.size == 0}">
                                    No Student Groups found for {!theContact.Preferred_First_Name__c}
                                </apex:outputText>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-12">
                    <!-- Nav tabs -->
                    <ul class="nav nav-tabs responsive" id="mainTabs" role="tablist">
                        <li role="presentation" class="active">
                            <a
                                href="#general"
                                aria-controls="general"
                                role="tab"
                                data-toggle="tab"
                                class="tabLink active"
                            >
                                General
                            </a>
                        </li>

                        <li role="presentation">
                            <a href="#classes" aria-controls="classes" role="tab" data-toggle="tab" class="tabLink">
                                Classes
                            </a>
                        </li>

