        // Method to load the advisor comments.
        function getComments() {
            if (!commentsLoaded) {
                document.getElementById('psCommentsResponseErrors').innerHTML =
                    "<i class='fa fa-spinner fa-pulse fa-2x fa-fw margin-bottom'></i>";
                var commentQuery =
                    'SELECT ADMIN_FUNCTION__c, ADMIN_ROLENAME__c, COMMENT_DTTM__c, COMNT_ID__c, ' +
                    'COMMENTS__c, DisplayUrl, EMPLID__c, ExternalId, Id, NAME__c ' +
                    'FROM PS_ASU_SP_COMMNT_V__x ' +
                    "WHERE EMPLID__c = '{!theContact.EMPLID__c}' AND CMNT_Category__c  != 'GRPOS' AND CMNT_Category__c != 'GRGCPS'" +
                    'ORDER BY COMMENT_DTTM__c DESC';
                var conn = new jsforce.Connection({ accessToken: '{!$API.Session_Id}' });
                conn.query(commentQuery, function (err, response) {
                    if (err) {
                        document.getElementById('psCommentsResponseErrors').innerHTML = err;
                    } else {
                        var commentResponse = response.records;
                        commentResponse.forEach(function (record) {
                            delete record.attributes;
                        });
                        commentResponse = JSON.stringify(commentResponse);
                        Visualforce.remoting.Manager.invokeAction(
                            '{!$RemoteAction.StudentProfileController.getComments}',
                            '{!theContact.EMPLID__c}',
                            commentResponse,
                            function (result, event) {
                                if (event.status) {
                                    document.getElementById('psCommentsResponseErrors').innerHTML = '';

                                    if (Object.getOwnPropertyNames(result).length != 0 && result != '') {
                                        document.getElementById('psCommentsResponseErrors').style.display = 'none';
                                        var html = '';

                                        for (var i = 0; i < result.length; i++) {
                                            var utcSeconds = result[i].comment.COMMENT_DTTM__c;
                                            var commentDate = new Date(utcSeconds);
                                            commentDate =
                                                commentDate.getMonth() +
                                                1 +
                                                '/' +
                                                commentDate.getDate() +
                                                '/' +
                                                commentDate.getFullYear();

                                            html +=
                                                '' +
                                                "<div class='comments-panel'>" +
                                                "<div class='comments-header'>" +
                                                '<h4>' +
                                                (result[i].commenterUserId == undefined
                                                    ? ''
                                                    : "<a href='/_ui/core/userprofile/UserProfilePage?u=" +
                                                    result[i].commenterUserId +
                                                    "&tab=sfdc.ProfilePlatformFeed' target='_blank'>") +
                                                result[i].comment.NAME__c +
                                                (result[i].commenterUserId == undefined ? '' : '</a>') +
                                                '</h4>' +
                                                "<span class='comments-header-date'>" +
                                                '&nbsp;&nbsp;-&nbsp;&nbsp;' +
                                                commentDate +
                                                '</span>' +
                                                '</div>' +
                                                "<div class='comments-main-comment'" +
                                                "id='ps_comments_main'>" +
                                                result[i].comment.COMMENTS__c +
                                                '</div>' +
                                                '</div>' +
                                                "<hr class='comments-hr'/>";
                                        }

                                        document.getElementById('ps_comments_section').innerHTML = html;
                                        cleanUpUndefined('ps_comments_section');
                                        commentsLoaded = true;
                                    } else {
                                        document.getElementById('psCommentsResponseErrors').innerHTML =
                                            'No comments found.';
                                        commentsLoaded = true;
                                    }
                                } else if (event.type === 'exception') {
                                    document.getElementById('psCommentsResponseErrors').innerHTML =
                                        event.message + '<br/>\n<pre>' + event.where + '</pre>';
                                } else {
                                    document.getElementById('psCommentsResponseErrors').innerHTML = event.message;
                                }
                            },
                            { buffer: false, escape: true, timeout: 120000 }
                        );
                    }
                });
            }
        }

