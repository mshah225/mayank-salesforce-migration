                                        typeof result[i].NEXT_TERM_ENROLLED__c == 'string' &&
                                        result[i].NEXT_TERM_ENROLLED__c == 'N'
                                    )
                                        totIndicators++;
                                    if (result[i].PAST_DUE_TIP__c > 0) totIndicators++;
