        // Method to get Enrolled Classes
        function getEnrolledClasses() {
            if (classesData != null) return;
            document.getElementById('psEnrolledClassesErrors').innerHTML =
                "<i class='fa fa-spinner fa-pulse fa-2x fa-fw margin-bottom'></i>";
            document.getElementById('psDroppedWithdrawnClassesErrors').innerHTML =
                "<i class='fa fa-spinner fa-pulse fa-2x fa-fw margin-bottom'></i>";

            var classQuery =
                'SELECT ACAD_CAREER__c, ASU_SCH_DATES__c, CATALOG_NBR__c, CLASS_DESCR__c, ' +
                'CLASS_NBR__c, CRSE_GRADE_OFF__c, CRSE_ID__c, CUM_GPA__c, CUR_GPA__c, ' +
                'DisplayUrl, EARN_CREDIT__c, EMPLID__c, ENRL_STATUS_REASON__c, ExternalId, ' +
                'FT_FULL_NAME__c, Id, SCH_DAILY_TIME__c, SCH_HTML_DAY1__c, SESSION_CODE__c, ' +
                'SSR_CLSTOPIC_DESCR__c, SSR_MTG_LOC_LONG__c, STDNT_ENRL_STATUS__c, STRM__c,  ' +
                'SUBJECT__c, TERM_DESCR30__c, UNT_TAKEN__c, VALID_ATTEMPT__c   ' +
                'FROM PS_ASU_SP_CLASS_V__x  ' +
                "WHERE EMPLID__c = '{!theContact.EMPLID__c}'  " +
                'ORDER BY STRM__c DESC, CLASS_NBR__c ASC';
            var asrQuery =
                'SELECT CLASS_NBR__c, SESSION_CODE__c, STRM__c ' +
                'FROM PS_ASU_SP_ASR_CLSV__x ' +
                "WHERE EMPLID__c = '{!theContact.EMPLID__c}' " +
                "AND STRM__c = '{!currentTerm}'";
            var conn = new jsforce.Connection({ accessToken: '{!$API.Session_Id}' });
            conn.query(classQuery, function (err, response) {
                if (err) {
                    document.getElementById('psAdvisingNotesResponseErrors').innerHTML = err;
                } else {
                    conn.query(asrQuery, function (errorAsr, responseAsr) {
                        if (errorAsr) {
                            document.getElementById('psAdvisingNotesResponseErrors').innerHTML = errorAsr;
                        } else {
                            let classResponse = response.records;
                            let asrResponse = responseAsr.records;
                            let currentTermClassSessionMap = new Map();
                            let currentTermEnrolled = 0;
                            let nextTermClassSessionMap = new Map();
                            let nextTermEnrolled = 0;
                            let futureTermClassSessionMap = new Map();
                            let futureTermEnrolled = 0;

                            classResponse.forEach(function (record) {
                                delete record.attributes;

                                if (record.STDNT_ENRL_STATUS__c === 'E' && record.ENRL_STATUS_REASON__c === 'ENRL') {
                                    if (record.STRM__c === '{!currentTerm}') {
                                        currentTermEnrolled += record.UNT_TAKEN__c;
                                        if (!currentTermClassSessionMap.has(record.SESSION_CODE__c)) {
                                            currentTermClassSessionMap.set(record.SESSION_CODE__c, record.UNT_TAKEN__c);
                                        } else {
                                            currentTermClassSessionMap.set(
                                                record.SESSION_CODE__c,
                                                currentTermClassSessionMap.get(record.SESSION_CODE__c) +
                                                record.UNT_TAKEN__c
                                            );
                                        }
                                    } else if (record.STRM__c === '{!nextTerm}') {
                                        nextTermEnrolled += record.UNT_TAKEN__c;
                                        if (!nextTermClassSessionMap.has(record.SESSION_CODE__c)) {
                                            nextTermClassSessionMap.set(record.SESSION_CODE__c, record.UNT_TAKEN__c);
                                        } else {
                                            nextTermClassSessionMap.set(
                                                record.SESSION_CODE__c,
                                                nextTermClassSessionMap.get(record.SESSION_CODE__c) +
                                                record.UNT_TAKEN__c
                                            );
                                        }
                                    } else if (record.STRM__c === '{!futureTerm}') {
                                        futureTermEnrolled += record.UNT_TAKEN__c;
                                        if (!futureTermClassSessionMap.has(record.SESSION_CODE__c)) {
                                            futureTermClassSessionMap.set(record.SESSION_CODE__c, record.UNT_TAKEN__c);
                                        } else {
                                            futureTermClassSessionMap.set(
                                                record.SESSION_CODE__c,
                                                futureTermClassSessionMap.get(record.SESSION_CODE__c) +
                                                record.UNT_TAKEN__c
                                            );
                                        }
                                    }
                                }
                            });

                            buildSessionRows(
                                currentTermClassSessionMap,
                                '#currentTermEnrolledHours',
                                '#currentTermEnrolled',
                                currentTermEnrolled
                            );
                            buildSessionRows(
                                nextTermClassSessionMap,
                                '#nextTermEnrolledHours',
                                '#nextTermEnrolled',
                                nextTermEnrolled
                            );
                            buildSessionRows(
                                futureTermClassSessionMap,
                                '#futureEnrolledHours',
                                '#futureTermEnrolled',
                                futureTermEnrolled
                            );

                            function buildSessionRows(sessionMap, termHoursId, termEnrolledId, termEnrolledHours) {
                                let termRowHTML = '';
                                new Map([...sessionMap.entries()].sort()).forEach(function (value, key) {
                                    termRowHTML +=
                                        '' +
                                        '<tr class="gradExtraInfo hide">\n' +
                                        '<th class="gradTD" style="border-right:none;">\n' +
                                        '<span style="margin-left:3rem;">Session ' +
                                        key +
                                        '</span>\n' +
                                        '</th>\n' +
                                        '<td class="gradTD" style="border-left:none;">\n' +
                                        '' +
                                        value +
                                        '\n' +
                                        '</td>\n' +
                                        '</tr>';
                                });

                                if (termEnrolledHours > 0) {
                                    $j(termHoursId).after(termRowHTML).find('span.hide').removeClass('hide');
                                }
                                $j(termEnrolledId).html(termEnrolledHours);
                            }

                            asrResponse.forEach(function (record) {
                                delete record.attributes;
                            });
                            classResponse = JSON.stringify(classResponse);
                            asrResponse = JSON.stringify(asrResponse);
                            Visualforce.remoting.Manager.invokeAction(
                                '{!$RemoteAction.StudentProfileController.getClassesData}',
                                classResponse,
                                asrResponse,
                                function (result, event) {
                                    if (event.status) {
                                        document.getElementById('psEnrolledClassesErrors').innerHTML = '';
