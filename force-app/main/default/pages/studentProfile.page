        // Method to get transcripts
        function getTranscripts() {
            if (!transcriptsLoaded) {
                var conn = new jsforce.Connection({ accessToken: '{!$API.Session_Id}' });
                document.getElementById('psTranscriptErrors').innerHTML =
                    "<i class='fa fa-spinner fa-pulse fa-2x fa-fw margin-bottom'></i>";
                document.getElementById('grpsTranscriptErrors').innerHTML =
                    "<i class='fa fa-spinner fa-pulse fa-2x fa-fw margin-bottom'></i>";

                var transcriptQuery =
                    'SELECT EMPLID__c, ADDRESS1__c, ADDRESS2__c, ADDRESS3__c, ' +
                    'ADDRESS4__c, CITY__c, COUNTRY__c, SEND_TO_NAME__c, ' +
                    'POSTAL__c, STATE__c, STATUS__c, REQUEST_OR_SENT_DATE__c, ' +
                    'DisplayURL, ExternalId, Id ' +
                    'FROM JBT_RET_TRANSCRIPT_SENT_VW__x ' +
                    "WHERE EMPLID__c = '{!theContact.EMPLID__c}' " +
                    'ORDER BY REQUEST_OR_SENT_DATE__c DESC, SEND_TO_NAME__c DESC';
                conn.query(
                    transcriptQuery,
                    function (err, response) {
                        if (err) {
                            document.getElementById('psTranscriptErrors').innerHTML = err;
                            document.getElementById('grpsTranscriptErrors').innerHTML = err;
                        } else {
                            document.getElementById('psTranscriptErrors').innerHTML = '';
                            document.getElementById('grpsTranscriptErrors').innerHTML = '';
                            if (!response.totalSize == 0) {
                                document.getElementById('ps_transcript').style.display = 'initial';
                                document.getElementById('gr_psTranscript').style.display = 'initial';

                                var html =
                                    '' +
                                    "<div class='table-responsive'>" +
                                    "<table id='transcript_table' class='table table-striped table-bordered'> " +
                                    '<thead>' +
                                    '<tr>' +
                                    '<th>Sent On</th>' +
                                    '<th>Status</th>' +
                                    '<th>Recipient</th>' +
                                    '</tr>' +
                                    '</thead>' +
                                    '<tbody>';
                                var result = response.records;
                                for (var i = 0; i < result.length; i++) {
                                    var utcSeconds = result[i].REQUEST_OR_SENT_DATE__c;
                                    var sentDate = new Date(utcSeconds);
                                    sentDate =
                                        sentDate.getUTCMonth() +
                                        1 +
                                        '/' +
                                        sentDate.getUTCDate() +
                                        '/' +
                                        sentDate.getUTCFullYear();

                                    var status = result[i].STATUS__c;
                                    var recipient = new Array(
                                        result[i].SEND_TO_NAME__c,
                                        result[i].ADDRESS1__c,
                                        result[i].ADDRESS2__c,
                                        result[i].ADDRESS3__c,
                                        result[i].ADDRESS4__c
                                    );

                                    html +=
                                        '' +
                                        '<tr>' +
                                        '<td>' +
                                        sentDate +
                                        '</td>' +
                                        '<td>' +
                                        status +
                                        '</td>' +
                                        '<td>' +
                                        "<li class='transcriptAddress'>" +
                                        recipient[0] +
                                        '</li>';

                                    for (var j = 1; j < recipient.length; j++) {
                                        if (recipient[j] != null && recipient[j] != '-') {
                                            html += "<li class='transcriptAddress'> " + recipient[j] + '</li>';
                                        }
                                    }

                                    html +=
                                        "<li class='transcriptAddress'>" +
                                        result[i].CITY__c +
                                        ', ' +
                                        result[i].STATE__c +
                                        ' ' +
                                        result[i].POSTAL__c +
                                        '</li>' +
                                        "<li class='transcriptAddress'> " +
                                        result[i].COUNTRY__c +
                                        '</li>' +
                                        '</td>' +
                                        '</tr>';
                                }

                                html += '' + '</tbody>' + '</table>' + '</div>';

                                document.getElementById('ps_transcript').innerHTML = html;
                                document.getElementById('gr_psTranscript').innerHTML = html;
                                cleanUpUndefined('ps_transcript');
                                cleanUpUndefined('gr_psTranscript');
                                transcriptsLoaded = true;
                            } else {
                                document.getElementById('ps_transcript').innerHTML = 'No transcripts found.';
                                document.getElementById('gr_psTranscript').innerHTML = 'No transcripts found.';
                                transcriptsLoaded = true;
                            }
                        }
                    },
                    { buffer: false, escape: true, timeout: 120000 }
                );
            }
        }

        // Method to retention snps.
        function getRetentionSNPs() {
            if (!indicatorHistoryLoaded) {
                document.getElementById('psRetentionSNPErrors').innerHTML =
                    "<i class='fa fa-spinner fa-pulse fa-2x fa-fw margin-bottom'></i>";
                var rententionQuery =
                    'SELECT ASR_INDICATOR__c, AVG_MYASU_COHORT__c, CI_INDEX_INDICATOR__c, ' +
                    'CREATED_EW_DTTM__c, CUM_GPA_INDICATOR__c, DisplayUrl, EADVISOR_INDICATOR__c, ' +
                    'EMPLID__c, ENRL_HOLD_COUNT__c, ExternalId, FA_INDICATOR__c, ' +
                    'FINANCIAL_HOLD__c, Id, NEXT_TERM_ENROLLED__c, PAST_DUE_TIP__c, ' +
