                                    '<th>Cumulative GPA</th>' +
                                    '<th>Probation</th>' +
                                    '<th>Transcripts Sent</th>' +
                                    '<th>Past Due</th>' +
                                    '<th>Financial Holds</th>' +
                                    '<th>Total Indicators</th>' +
                                    '</tr>' +
                                    '</thead>' +
                                    '<tbody>';

                                for (var i = 0; i < result.length; i++) {
                                    var utcSeconds = result[i].CREATED_EW_DTTM__c;
                                    var createdDate = new Date(utcSeconds);
                                    createdDate =
                                        createdDate.getMonth() +
                                        1 +
                                        '/' +
                                        createdDate.getDate() +
                                        '/' +
                                        createdDate.getFullYear();

                                    var totIndicators = 0;

                                    if (typeof result[i].FA_INDICATOR__c == 'string' && result[i].FA_INDICATOR__c != '')
                                        totIndicators++;
                                    if (result[i].CI_INDEX_INDICATOR__c > 0 && result[i].CI_INDEX_INDICATOR__c <= 93)
                                        totIndicators++;
                                    if (result[i].ASR_INDICATOR__c > 0) totIndicators++;
                                    if (
                                        typeof result[i].EADVISOR_INDICATOR__c == 'string' &&
                                        result[i].EADVISOR_INDICATOR__c.startsWith('Off Track')
                                    )
                                        totIndicators++;
                                    if (result[i].TERM_MYASU_USAGE__c < 0.7 * result[i].AVG_MYASU_COHORT__c)
                                        totIndicators++;
                                    if (result[i].CUM_GPA_INDICATOR__c > 0 && result[i].CUM_GPA_INDICATOR__c <= 2.25)
                                        totIndicators++;
                                    if (
                                        typeof result[i].PROBATION_INDICATOR__c == 'string' &&
                                        result[i].PROBATION_INDICATOR__c == 'PROB'
                                    )
                                        totIndicators++;
                                    if (result[i].ENRL_HOLD_COUNT__c > 0) totIndicators++;
