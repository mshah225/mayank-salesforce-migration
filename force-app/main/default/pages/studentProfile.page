    <apex:includeScript value="{!URLFOR($Resource.bs_responsive_tabs)}" />
    <apex:includeScript value="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.0/jquery.mask.min.js" />

    <script type="text/javascript">
        var inConsole = false;

        function setTabTitle() {
            //Set the current tab's title
            if (sforce.console.isInConsole() || window.location.href.includes('FrameOrigin')) {
                sforce.console.setTabTitle("{!theContact.Preferred_First_Name__c}'s Student Profile");
                inConsole = true;
            }
        }

        var pageLoad = window.onload;
        window.onload = function () {
            if (pageLoad) {
                pageLoad();
            }
            setTabTitle();
        };

        function openNewSubtab(subtabUrl, subtabTitle) {
            var openSubtab = function (result) {
                if (result.id === 'null') {
                    window.open(subtabUrl);
                    return;
                }

                if (subtabTitle !== 'null') {
                    sforce.console.openSubtab(result.id, subtabUrl, true, subtabTitle, null);
                } else {
                    sforce.console.openSubtab(result.id, subtabUrl, true);
                }
            };

            if (inConsole) {
                sforce.console.getEnclosingPrimaryTabId(openSubtab);
            } else {
                window.open(subtabUrl);
            }
        }

        Visualforce.remoting.timeout = 120000;
        (function ($) {
            fakewaffle.responsiveTabs(['xs', 'sm']);
        })(jQuery);

        function submitCase() {
            var subject = document.getElementById('usrSubject').value;
            var description = document.getElementById('usrDescription').value;
            if (subject.length <= 0 || description.length <= 0) {
                document.getElementById('modalError').innerHTML =
                    'Please ensure that subject and description are not blank';
            } else {
                Visualforce.remoting.Manager.invokeAction(
                    '{!$RemoteAction.StudentProfileController.createCase}',
                    description,
                    subject,
                    '{!theContact.EMPLId__c}',
                    function (result, event) {
                        document.getElementById('usrSubject').value = '';
                        document.getElementById('usrDescription').value = '';
                        document.getElementById('modalError').innerHTML = '';
                        var url = window.location.href;
                        sforce.console.openPrimaryTab(null, './' + result, true);
                        jQuery('#myModal').modal('hide');
                    }
                );
            }
        }

        function clearError() {
            document.getElementById('modalError').innerHTML = '';
            document.getElementById('usrSubject').value = '';
            document.getElementById('usrDescription').value = '';
        }

        $j = jQuery.noConflict();

        var timeoutHandle;

        $j('.fa-question-circle').mouseenter(function () {
            var that = $j(this);
            that.tooltip('show');
            window.clearTimeout(timeoutHandle);
        });

        $j('.fa-question-circle').mouseleave(function () {
            var _this = $j(this);
            timeoutHandle = window.setTimeout(function () {
                _this.tooltip('hide');
            }, 2000);
        });

        $j('#sunCard').error(function () {
            $j(this).attr('src', '{!$Resource.blankAvatar}');
        });

        $j(document).ready(function () {
            maskPhoneNumbers();

            loadRemoteSunCardPhoto();
            loadFinancialAidIndicators();
            loadCommentsTab();
            loadUGIndicatorTab();
            loadClassesTab();
        });

        function loadFinancialAidIndicators() {
            loadServiceIndicators();
            loadFinancialAidChecklist();
            loadFinancialAidEditMessages();
            loadFinancialAidAwards();
            loadFinancialAidChargeHistory();
            loadAccountBalance();
            loadRefunds();
            loadDepositStatus();
        }

        function loadRemoteSunCardPhoto() {
            Visualforce.remoting.Manager.invokeAction(
                '{!$RemoteAction.StudentProfileController.getSunCardPhotoRA}',
                '{!theContact.ASURite_ID__c}',
                '{!theContact.EMPLID__c}',
                function (result, event) {
                    if (event.status) {
                        if (result.length != 0) {
                            var onlineStudent = '{!theContact.ASU_Online_Student__c}';
                            if (onlineStudent === true) {
                                result = '{!$Resource.blankAvatar}';
                            }

                            var blankAvatarURL = '{!URLFOR($Resource.blankAvatar)}';

                            var html =
                                '<img id="studentPhotoImg2" src="' +
                                result +
                                '" ' +
                                ' alt="suncard photo" ' +
                                ' onerror="if (this.src != \'' +
                                blankAvatarURL +
                                ")') this.src='" +
                                blankAvatarURL +
                                '\'" ' +
                                ' class="img-responsive intro" ' +
                                ' style="max-width:200px;width:100%;"/>';
                            document.getElementById('sunDevilImgDiv').innerHTML = html;
                            cleanUpUndefined('sunDevilImgDiv');
                        } else {
                            jQuery('#sunImgSpinner').remove();
                        }
                    } else {
                        jQuery('#sunImgSpinner').remove();
                    }
                },
                {buffer: false, escape: true, timeout: 120000}
            );
        }

        // Arrow Functionality
        $j('.page-header-smaller').click(function () {
            var container = $j(this);
            var arrow = $j(this).find('.fa-caret-down, .fa-caret-right');
            if (arrow.hasClass('fa-caret-down')) {
                container.next().slideUp().addClass('hide');
            } else if (arrow.hasClass('fa-caret-right')) {
                container.next().removeClass('hide').slideDown();
            }

            arrow.toggleClass('fa-caret-right');
            arrow.toggleClass('fa-caret-down');
        });

        $j('.sideBoxMoreLink').click(function (e) {
            e.stopPropagation();
        });

        // Arrow Functionality
        $j('.grad-row-toggle').click(function () {
            var container = $j(this);
            var arrow = $j(this).find('.fa-caret-down, .fa-caret-right');
            if (arrow.hasClass('fa-caret-down')) {
                while (
                    container.next() != null &&
                    container.next().size() > 0 &&
                    (container.next()[0].classList.contains('gradExtraInfo') ||
                        container.next()[0].classList.contains('committeeExtraInfo') ||
                        container.next()[0].classList.contains('advisorExtraInfo'))
                ) {
                    container = container.next();
                    container.slideUp().addClass('hide');
                    container.find('.fa-caret-down').toggleClass('fa-caret-down fa-caret-right');
                }
            } else if (arrow.hasClass('fa-caret-right')) {
                while (
                    container.next() != null &&
                    container.next().size() > 0 &&
                    container.next()[0].classList.contains('gradExtraInfo')
                ) {
                    container = container.next();
                    if (!container[0].classList.contains('hideOnStart')) {
                        container.removeClass('hide').slideDown();
                    }
                }
            }

            arrow.toggleClass('fa-caret-right');
