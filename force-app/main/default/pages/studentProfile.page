                    { buffer: false, escape: true, timeout: 120000 }
                );
            }
        }

        // Method to load the advisor comments.
        function getPSAdvisorNotes() {
            if (!advisorNotesLoaded) {
                document.getElementById('psAdvisingNotesResponseErrors').innerHTML =
                    "<i class='fa fa-spinner fa-pulse fa-2x fa-fw margin-bottom'></i>";

                var advisorNoteQuery =
                    'SELECT ACAD_CAREER__c, COMMENTS__c, CREATDTTM__c, CREATEOPRID__c, DisplayUrl, ' +
                    'EMPLID__c, ExternalId, Id, NAME__c, STRM__c,  Academic_Plan__c, Academic_Plan__r.Name, Academic_Program__r.Name, Student_Career_Number__c ' +
                    'FROM PS_ASU_SP_ADNOTE_V__x ' +
                    "WHERE EMPLID__c = '{!theContact.EMPLID__c}' " +
                    'ORDER BY CREATDTTM__c DESC';
                var conn = new jsforce.Connection({ accessToken: '{!$API.Session_Id}' });
                conn.query(advisorNoteQuery, function (err, response) {
                    if (err) {
                        document.getElementById('psAdvisingNotesResponseErrors').innerHTML = err;
                    } else {
                        if (!response.totalSize == 0) {
                            var noteResponse = response.records;
                            noteResponse.forEach(function (record) {
                                delete record.attributes;
                            });
                            noteResponse = JSON.stringify(noteResponse);
                            Visualforce.remoting.Manager.invokeAction(
                                '{!$RemoteAction.StudentProfileController.getPSAdvisorNotes}',
                                '{!theContact.EMPLID__c}',
                                noteResponse,
                                function (result, event) {
                                    if (event.status) {
                                        document.getElementById('psAdvisingNotesResponseErrors').innerHTML = '';

                                        if (!Object.getOwnPropertyNames(result).length == 0) {
                                            document.getElementById('psAdvisingNotesResponseErrors').style.display =
                                                'none';
                                            var html = '<table class="table table-striped table-bordered">';

                                            for (var i = 0; i < result.length; i++) {
                                                var dateStamp = new Date(result[i].note.CREATDTTM__c);
