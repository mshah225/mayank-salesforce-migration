                                }

                                html += '</tbody></table></div>';

                                document.getElementById('ps_retention_snp').innerHTML = html;
                                cleanUpUndefined('ps_retention_snp');
                                indicatorHistoryLoaded = true;
                            } else {
                                document.getElementById('psRetentionSNPErrors').innerHTML =
                                    'No indicator history found.';
                                indicatorHistoryLoaded = true;
                            }
                        }
