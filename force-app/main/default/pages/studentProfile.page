        function sortEnrolledClassList(paramToSort, direction) {
            var enrolledWrapperJson = JSON.stringify(enrolledWrapper);
            Visualforce.remoting.Manager.invokeAction(
                '{!$RemoteAction.StudentProfileController.sortClasses}',
                paramToSort,
                enrolledWrapperJson,
                direction,
                function (result, event) {
                    document.getElementById('ps_enrolled_classes').style.display = 'initial';

                    var html =
                        '' +
                        "<div class='table-responsive'>" +
