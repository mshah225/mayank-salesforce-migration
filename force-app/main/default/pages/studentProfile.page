        function filterClasses() {
            var termSelect = document.getElementById('ps_classes_term_select');
            var sessionSelect = document.getElementById('ps_classes_session_select');
            var searchTerm =
                termSelect.options[termSelect.selectedIndex] === undefined
                    ? ''
                    : termSelect.options[termSelect.selectedIndex].text;
            var searchSession =
                sessionSelect.options[sessionSelect.selectedIndex] === undefined
                    ? ''
                    : sessionSelect.options[sessionSelect.selectedIndex].text;
            var classTable = document.getElementById('enrolled_classes_table');
            var summaryHtml = '';
            var earnedUnits = 0;
            var cumGpa = '';
            var curGpa = '';
            for (var r = 1; r < classTable.rows.length; r++) {
                var termCell = classTable.rows[r].cells[0].innerHTML;
                var sessionCell = classTable.rows[r].cells[1].innerHTML;
                var displayStyle = 'none';
                if (
                    (termCell.indexOf(searchTerm) >= 0 || searchTerm == 'All') &&
                    (sessionCell.indexOf(searchSession) >= 0 || searchSession == 'All')
                ) {
                    displayStyle = 'table-row';
                    if (curGpa == '' && searchTerm != 'All' && classTable.rows[r].cells[15] != null)
                        curGpa = 'Term GPA: ' + classTable.rows[r].cells[15].innerHTML + '&nbsp;&nbsp;&nbsp';
                    if (cumGpa == '' && classTable.rows[r].cells[16] != null) {
                        cumGpa = 'Cumulative GPA: ' + classTable.rows[r].cells[16].innerHTML;
                    }
                    if (
                        classTable.rows[r].cells[14] != null && classTable.rows[r].cells[14].innerHTML == 'YY' &&
                        classTable.rows[r].cells[17] != null && classTable.rows[r].cells[17].innerHTML != '{!currentTerm}'
                    ) {
                        earnedUnits += Number(classTable.rows[r].cells[6].innerHTML);
                    }
                } else {
                    displayStyle = 'none';
                }
                classTable.rows[r].style.display = displayStyle;
            }
            summaryHtml = 'Total Earned Units: ' + earnedUnits + '&nbsp;&nbsp;&nbsp' + curGpa + cumGpa;
            var summaryDiv = document.getElementById('ps_enrolled_classes_summary');
            summaryDiv.innerHTML = summaryHtml;
            var headerSpan = document.getElementById('enrolled_classes_header');
            headerSpan.innerHTML = '&nbsp;' + searchTerm + ' Enrolled Classes';

            classTable = document.getElementById('dropped_classes_table');
            for (var r = 1; r < classTable.rows.length; r++) {
                var termCell = classTable.rows[r].cells[0].innerHTML;
                var sessionCell = classTable.rows[r].cells[1].innerHTML;
                var displayStyle = 'none';
                if (
                    (termCell.indexOf(searchTerm) >= 0 || searchTerm == 'All') &&
                    (sessionCell.indexOf(searchSession) >= 0 || searchSession == 'All')
                ) {
                    displayStyle = 'table-row';
                } else {
                    displayStyle = 'none';
                }
                classTable.rows[r].style.display = displayStyle;
            }
            headerSpan = document.getElementById('dropped_classes_header');
            headerSpan.innerHTML = '&nbsp;' + searchTerm + ' Dropped/Withdrawn Classes';
        }

