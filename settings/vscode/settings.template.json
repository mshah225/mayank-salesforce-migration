"commands.commands": [
    {
        "text": "$(heart) Zen",
        "command": "workbench.action.toggleZenMode",
        "tooltip": "Toggle Zen mode"
    },
    {
        "text": "$(chevron-right) Commands",
        "command": "workbench.action.showCommands",
        "tooltip": "Show commands"
    },
    {
        "command": "workbench.action.files.newUntitledFile",
        "text": "$(file-code) New file",
        "tooltip": "New file"
    },
    {
        "text": "$(terminal) Aliusito CI",
        "command": "terminals.runTerminalByName",
        "arguments": ["Aliusito CI"],
        "tooltip": "A script to safely update all branches from the upstream"
    },
    {
        "text": "$(play) Developer Setup",
        "command": "terminals.runTerminalByName",
        "arguments": ["Developer Setup"],
        "tooltip": "A script to initialize or refresh a developer's setup"
    },
    {
        "text": "$(file-code) SF Metadata Parser",
        "command": "terminals.runTerminalByName",
        "arguments": ["SF Metadata Parser"],
        "tooltip": "A script to parse out SF metadata security settings"
    },
    {
        "text": "$(gear) Settings",
        "command": "workbench.action.openSettingsJson",
        "tooltip": "Settings"
    }
],
"editor.formatOnSave": true,
"prettier.configPath": "force-app/crm-salesforce-enterprise/settings/prettier/.prettierrc",
"prettier.ignorePath": "force-app/crm-salesforce-enterprise/settings/prettier/.prettierignore",
"prettier.prettierPath": "/usr/local/lib/node_modules/prettier",
"prettier.requireConfig": true,
"salesforcedx-vscode-core.push-or-deploy-on-save.enabled": false,
"terminal.integrated.cwd": "force-app/crm-salesforce-enterprise/src",
"terminals.terminals": [
    {
        "name": "Aliusito CI",
        "description": "A script to safely update all branches from the upstream",
        "icon": "code",
        "commands": ["cd ~/VSCode/asu/force-app/crm-salesforce-enterprise/bin/aliusito", "./aliusito.sh"],
        "recycle": true,
        "open": true,
        "focus": true
    },
    {
        "name": "Developer Setup",
        "description": "A script to initialize or refresh a developer's setup",
        "icon": "code",
        "commands": [
            "cd ~/VSCode/asu/force-app/crm-salesforce-enterprise/bin/developer-setup",
            "./developer_setup.sh"
        ],
        "recycle": true,
        "open": true,
        "focus": true
    },
    {
        "name": "SF Metadata Parser",
        "description": "A script to parse out SF metadata security settings",
        "icon": "code",
        "commands": [
            "cd ~/VSCode/asu/force-app/crm-salesforce-enterprise/bin/metadata-parser",
            "python3 metadata_parser.py"
        ],
        "recycle": true,
        "open": true,
        "focus": true
    }
],
"[apex]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
},
"[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
},
"[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
},
"[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
},
"[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
}