<aura:component
    controller="CaseCreationFormController"
    implements="forceCommunity:availableForAllPageTypes"
    access="global"
>
    <aura:attribute name="caseAssignmentRule" type="String" access="public" />
    <aura:attribute name="defaultDescription" type="String" access="public" />
    <aura:attribute name="defaultSubject" type="String" access="public" />
    <aura:attribute name="formName" type="String" access="public" />
    <aura:attribute name="usingDefaultSubject" type="Boolean" access="public" />
    <aura:attribute name="usingDefaultDescription" type="Boolean" access="public" />

    <aura:attribute name="providedSubject" type="String" />
    <aura:attribute name="message" type="String" />
    <aura:attribute name="providedDescription" type="String" />

    <html>
        <body>
            <h1>
                <center>{!v.formName}</center>
            </h1>
            <h3 style="color: DarkOrange">
                <center>{!v.message}</center>
            </h3>

            <form class="slds-form--stacked">
                <aura:if isTrue="{!v.usingDefaultSubject}">
                    <aura:set attribute="else">
                        <lightning:textarea
                            aura:id="subjectResponse"
                            label="Case Subject"
                            value="{!v.providedSubject}"
                            required="true"
                        />
                    </aura:set>
                </aura:if>

                <aura:if isTrue="{!v.usingDefaultDescription}">
                    <aura:set attribute="else">
                        <lightning:textarea
                            aura:id="descriptionResponse"
                            label="Case Description"
                            value="{!v.providedDescription}"
                            required="true"
                        />
                    </aura:set>
                </aura:if>
                <lightning:button aura:id="submitButton" label="Submit" onclick="{!c.createCase}" />
            </form>
        </body>
    </html>
</aura:component>
