        <script>
            var jsonHeaderString = '[';
        </script>

        <apex:repeat value="{!menuLinks}" var="link">
            <script>
                jsonHeaderString += '{"title":"{!link.name}","path":"{!link.url}"},';
            </script>
        </apex:repeat>

        <script>
            var ASUHeader = ASUHeader || {};
            ASUHeader.browser = false;
            window.ASUHeader = window.ASUHeader || {};
            ASUHeader.site_menu = ASUHeader.site_menu || {};

            if ('{!menuLinks.size}' > 0) {
                var pos = jsonHeaderString.lastIndexOf(',');
                jsonHeaderString = jsonHeaderString.substring(0, pos);
                jsonHeaderString += ']';
                ASUHeader.site_menu.json = jsonHeaderString;
            } else {
                ASUHeader.site_menu.json =
                    '[' +
                    '{"title":"Student Home","path":"{!$Label.MyASU_Help_Base_URL}/myasu/student"},' +
                    '{"title":"Finances","path":"{!$Label.MyASU_Help_Base_URL}/myasu/student/finances"},' +
                    '{"title":"Campus Services","path":"{!$Label.MyASU_Help_Base_URL}/myasu/student/campusservices"},' +
                    '{"title":"Profile","path":"{!$Label.MyASU_Help_Base_URL}/myasu/student/profile"},' +
                    '{"title":"Help","path":"{!$Label.MyASU_Help_Base_URL}/myasu/student/servicecenter"}]';
            }

            ASUHeader.site_menu.site_name = 'My ASU';
            ASUHeader.user_signedin = true;
            ASUHeader.user_displayname = '{!JSENCODE($User.FirstName)}';
        </script>

