<apex:component controller="ASUBrandHeaderController">
    <apex:attribute name="firstName" description="The contacts first name" type="String" />
    <apex:attribute name="lastName" description="The contacts last name" type="String" />
    <apex:attribute name="viewingAs" description="Is the user viewing as?" type="Boolean" />
    <apex:attribute name="stopViewAsUrl" description="The Url to stop viewing as" type="String" />
    <apex:attribute name="viewAsUrl" description="The Url to start or change view as" type="String" />
    <apex:attribute name="emplId" description="The contacts Employee/Affiliate Id" type="String" />
    <apex:attribute name="menuLinks" description="The provided menu links" type="Link[]" />
    <apex:attribute name="showNavBar" description="If true, the main menu will be shown on the page" type="boolean" default="true"
    />

    <c:ASUBrandMenuStyles />

    <div id="myasu-tabs-wrapper">
        <apex:outputPanel rendered="{!showNavBar}">
            <header class="navbar navbar-default" role="banner">
                <div id="myasu-tabs" class="myasu-cont">
                    <div class="navbar-links">
                        <apex:outputPanel rendered="{!IF(ISNULL(menuLinks) || ISBLANK(menuLinks), false, true)}">
                            <apex:repeat value="{!menuLinks}" var="link" id="linkRepeater">
                                <apex:outputPanel rendered="{!IF(link.name != 'Service Center' && link.name != 'Help', true, false)}">
                                    <span class='tab'>
                                        <apex:outputLink styleClass="tracking" value="{!link.url}" rendered="{!IF(link.name == 'Home', true, false) || IF(link.name == 'Student Home', true, false)}">
                                            <span class="fa fa-home" title="Home"></span>
                                        </apex:outputLink>
                                        <apex:outputLink styleClass="tracking" value="{!link.url}" rendered="{!IF(link.name != 'Home' && link.name != 'Student Home', true, false)}">
                                            {!link.name}
                                        </apex:outputLink>
                                    </span>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!IF(link.name == 'Service Center' || link.name == 'Help', true, false)}">
                                    <span class='selected tab'>
                                        <apex:outputLink styleClass="tracking" value="{!link.url}" rendered="{!IF(link.name != 'Home' && link.name != 'Student Home', true, false)}">
                                            Help
                                        </apex:outputLink>
                                    </span>
                                </apex:outputPanel>
                            </apex:repeat>
                        </apex:outputPanel>
                        <apex:outputPanel rendered="{!AND(firstName != null, lastName != null)">
                            <p class="username pull-right">
                                {!firstName} {!lastName}
                                <apex:outputPanel rendered="{!viewingAs}" style="font-size:9pt;">
                                    &nbsp;&nbsp;({!emplId})
                                    <br />
                                    <a class="viewAsLink" href="{!viewAsUrl}">Change View As</a>
                                    <a class="viewAsLink" href="{!stopViewAsUrl}">Stop Viewing As</a>
                                </apex:outputPanel>
                            </p>
                        </apex:outputPanel>
                    </div>
                </div>
            </header>
        </apex:outputPanel>
    </div>
</apex:component>