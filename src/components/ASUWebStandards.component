        -------------------------------------------------------------- */
            /* Default table styles */
            table {
                background-color: white;
                margin-bottom: 24px;
                max-width: 100%;
                width: 100%;
            }

            table>thead>tr>th,
            table>thead>tr>td,
            table>tbody>tr>th,
            table>tbody>tr>td,
            table>tfoot>tr>th,
            table>tfoot>tr>td {
