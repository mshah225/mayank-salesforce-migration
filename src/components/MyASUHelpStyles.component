<apex:component>
    <apex:stylesheet value="{!URLFOR($Resource.Font_Awesome_4_7_0, 'Font_Awesome_4_7_0/css/font-awesome.min.css')}" />
    <apex:stylesheet value="{!URLFOR($Resource.bootstrap_4_asu, '/dist/css/bootstrap-asu.min.css')}" />
    <style>
        .myasu-help-scope * {
            font-size: 0.95rem;
        }

        .myasu-help-scope a {
            text-decoration: none;
        }

        .myasu-help-scope .bg-f5f5f5 {
            background-color: #f5f5f5;
        }

        .myasu-help-scope .c-text-maroon {
            color: #8c1d40;
        }

        .myasu-help-scope a.c-text-maroon:visited {
            color: #8c1d40;
        }

        .c-text-black {
            color: black;
        }

        .myasu-help-scope a.c-text-black:visited {
            color: black;
        }

        .myasu-help-scope a:hover:not(.btn) {
            color: #d23153 !important;
        }

        .myasu-help-scope a:hover:not(.btn):not(.no-underline) {
            text-decoration: underline;
        }

        .myasu-help-scope .underline {
            text-decoration: underline;
        }


        .myasu-help-scope *:hover {
            z-index: 1;
        }

        .myasu-help-scope *:active,
        .myasu-help-scope .active {
            z-index: 2;
        }

        .myasu-help-scope *:focus {
            z-index: 3;
        }
    </style>
</apex:component>