<apex:component >
    <apex:attribute name="asurite" description="The contacts ASURITE Id" type="String"/>
    <!-- This component renders the Bomgar Scripts to start chat -->
    <script src="https://bomgar.asu.edu/api/start_session.js"></script>
    <script>
        BG.setSite("bomgar.asu.edu");
        // Start 'Finances' Chat
        function startFAChat()
        {
            var jsonString = null;
            var jsonObject = {};
                jsonObject.employeeNumber = "{!$User.EmplId__c}";
                jsonObject.description = document.getElementById('FADesc').value;
                jsonObject.asuriteId = "{!asurite}";
                jsonObject.externalKey = 'Finances';
            try
            {
                jsonString = JSON.stringify(jsonObject);
            }
            catch (e)
            {

            }
            if (jsonString == null)
            {
                jsonString = '{"employeeNumber":"{!$User.EmplId__c}", "description":"' + document.getElementById('FADesc').value + '", "asuriteId":"{!asurite}", "externalKey":"Finances"}';
            }

            BG.start(BG.START_TYPE.CHAT,
            {
                issue:
                {
                    codeName: 'studentfinances_chat',
                    customerName: "{!$User.FirstName} {!$User.LastName}",
                    companyName: 'ASU',
                    details: document.getElementById('FADesc').value
                },
                attributes:
                {
                    externalKey: ('SFDC:' + jsonString)
                },
                uiOptions:
                {
                    fallbackToFullWindow:true
                }
            });
        }
    </script>

