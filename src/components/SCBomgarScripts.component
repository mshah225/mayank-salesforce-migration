<apex:component >
    <apex:attribute name="asurite" description="The contacts ASURITE Id" type="String"/>
    <apex:attribute name="firstName" description="The contacts first name" type="String"/>
    <apex:attribute name="lastName" description="The contacts last name" type="String"/>
    <apex:attribute name="emplId" description="The contacts Employee/Affiliate Id" type="String"/>
    <apex:attribute name="viewingAs" description="Whether or not the user is currently viewing as" type="Boolean"/>
    <!-- This component renders the Bomgar Scripts to start chat -->
    <script src="https://bomgar.asu.edu/api/start_session.js"></script>
    <script>
        BG.setSite("bomgar.asu.edu");
        // Start 'Finances' Chat
        function startFAChat()
        {
            document.getElementById("faChatBtn").firstChild.data = "Starting Chat...";
            document.getElementById("faChatBtn").setAttribute("style","width:100px");
            document.getElementById("faChatBtn").disabled = true;

            var viewingAs = "{!viewingAs}"

            if (viewingAs != "true")
            {
                var jsonString = null;
                var jsonObject = {};
                    jsonObject.employeeNumber = "{!emplId}";
                    jsonObject.description = document.getElementById('FADesc').value;
                    jsonObject.asuriteId = "{!asurite}";
                    jsonObject.externalKey = 'Finances';

                try
                {
                    jsonString = JSON.stringify(jsonObject);
                }
                catch (e)
                {

                }

                if (jsonString == null)
                {
                    jsonString = '{"employeeNumber":"{!emplId}", "description":"' + document.getElementById('FADesc').value + '", "asuriteId":"{!asurite}", "externalKey":"Finances"}';
                }

                BG.start(BG.START_TYPE.CHAT,
                {
                    issue:
                    {
                        codeName: 'studentfinances_chat',
                        customerName: "{!firstName} {!lastName}",
                        companyName: 'ASU',
                        details: document.getElementById('FADesc').value
                    },
                    attributes:
                    {
                        externalKey: ('SFDC:' + jsonString)
                    },
                    uiOptions:
                    {
                        fallbackToFullWindow:true
                    }
                });
            }
        }
    </script>

