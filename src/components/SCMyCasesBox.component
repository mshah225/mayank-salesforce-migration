<apex:component controller="ServiceCenter" allowDML="true">
    <!-- This component renders the My Cases Box on the Service Center -->
    <apex:outputPanel rendered="{!MyCasesBox}">
        <div class="box">
            <div class="header">
                <h6><b>My Cases</b></h6>
            </div>

            <div class="content box-padding" id="crm_content" >
                <p>Save time and submit your question or support request online.</p>

                <button id="showNewCase"
                        class="btn kbbtn"
                        style="color:#fff;background:#990033;padding:5px;width:75px;">
                    New Case
                </button>

                <button id="cancel"
                        class="btn kbbtn"
                        style="display:none;color:#fff;background:#990033;padding:5px;width:75px;">
                    My Cases
                </button>
                <br />
                <br />

                <script>
                    $( "#showNewCase" ).click(function() {
                        $( "#newCaseForm" ).slideToggle( "500" );
                        $( "#myCases" ).slideToggle( "500" );
                        $( "#showNewCase" ).hide();
                        $( "#cancel" ).show();
                        $( "#caseSubject" ).focus(600);
                    });

                    $( "#cancel" ).click(function() {
                        $( "#newCaseForm" ).slideToggle( "500" );
                        $( "#myCases" ).slideToggle( "500" );
                        $( "#showNewCase" ).show();
                        $( "#cancel" ).hide();
                    });
                </script>

                <div id="myCases">
                    <apex:form >
                        <h5>My Open Cases</h5>

                        <apex:pageBlock mode="maindetail">
                            <apex:pageBlockTable rendered="{!(myCases.size >= 1)}"
                                                 value="{!myCases}"
                                                 var="case"
                                                 styleClass="myCasesTable">
                                <apex:column headerValue="Subject"
                                             styleClass="truncate"
                                             width="66%"
                                             value="{!case.Subject}"
                                             style="background-color:white;"
                                             onmousemove="this.style.backgroundColor='white'"
                                             onmouseout="this.style.backgroundColor ='white'"/>

                                <apex:column headerValue="Status"
                                             width="33%"
                                             value="{!case.Status}"
                                             style="background-color:white;"
                                             onmousemove="this.style.backgroundColor='white'"
                                             onmouseout="this.style.backgroundColor ='white'"/>

                                <apex:column width="33%"
                                             onmousemove="this.style.backgroundColor='white'"
                                             style="background-color:white;"
                                             onmouseout="this.style.backgroundColor ='white'">
                                    <apex:commandLink value="View"
                                                      styleClass="btn"
                                                      style="padding:4px;"
                                                      action="{!viewCase}">
                                        <apex:param name="caseId" value="{!case.Id}"/>
                                    </apex:commandLink>
                                </apex:column>
                            </apex:pageBlockTable>

                            <apex:outputText rendered="{!(myCases.size = 0)}">
                                <div class="padClass">You do not have any open cases.</div>
                            </apex:outputText>
                        </apex:pageBlock>
                    </apex:form>
                    <br />
                    <apex:form >
                        <h5>My Closed Cases</h5>
                        <apex:pageBlock mode="maindetail">
                            <apex:pageBlockTable rendered="{!(closedCases.size >= 1)}"
                                                 value="{!closedCases}"
                                                 var="case"
                                                 styleClass="myCasesTable">
                                <apex:column headerValue="Subject"
                                             styleClass="truncate"
                                             width="66%"
                                             value="{!case.Subject}"
                                             style="background-color:white;"
                                             onmousemove="this.style.backgroundColor='white'"
                                             onmouseout="this.style.backgroundColor ='white'"/>

                                <apex:column headerValue="Status"
                                             width="33%"
                                             value="{!case.Status}"
                                             style="background-color:white;"
                                             onmousemove="this.style.backgroundColor='white'"
                                             onmouseout="this.style.backgroundColor ='white'"/>

                                <apex:column width="33%"
                                             style="background-color:white;"
                                             onmousemove="this.style.backgroundColor='white'"
                                             onmouseout="this.style.backgroundColor ='white'">
                                    <apex:commandLink value="View"
                                                      styleClass="btn"
                                                      style="padding:4px;"
                                                      action="{!viewCase}">
                                        <apex:param name="caseId" value="{!case.Id}"/>
                                    </apex:commandLink>
                                </apex:column>
                            </apex:pageBlockTable>

                            <apex:outputText rendered="{!(closedCases.size = 0)}">
                                <div class="padClass">You do not have any closed cases.</div>
                            </apex:outputText>
                        </apex:pageBlock>
                    </apex:form>

                    <div style="text-align:right">
                        <br />
                        <apex:form >
                            <apex:pageBlock mode="maindetail">
                                <a href="/viewAllCases?source=studentSC" style="padding:4px" class="btn">
                                    View All Cases
                                </a>
                            </apex:pageBlock>
                        </apex:form>
                    </div>

                </div>

                <script>
                    jQuery(document).ready(function($){
                        $("td.truncate").each(function(){
                            if ($(this).text().length > 99) {
                                $(this).text($(this).text().substr(0, 99));
                                $(this).append('...');
                            }
                        });
                    });
                </script>

                <div id="newCaseForm" style="display:none">
                    <apex:form style="width:100%">
                        <h5>Create a New Case</h5>

                        <div style="height:5px;"></div>

                        <apex:pageBlock >
                            <apex:pageBlockSection collapsible="false" columns="1">
                                <label for="caseSubject" style="margin-bottom:0px;">Subject</label>

                                <apex:inputField id="caseSubject"
                                                 styleClass="caseField"
                                                 value="{!newCase.subject}"
                                                 required="true"
                                                 label=""
                                                 html-placeholder="Enter a subject"/>
                                <br />
                                <label for="caseDesc" style="margin-bottom:0px;">Description</label>

                                <apex:inputField id="caseDesc"
                                                 styleClass="caseField"
                                                 value="{!newCase.description}"
                                                 required="true"
                                                 style="height:100px;resize:none;"
                                                 label=""
                                                 html-placeholder="Enter a description"/>

                                <apex:outputText id="newCaseHelpText">
                                    Responses to your case will be sent to your official ASU
                                    email or the email account you are forwarding your ASU email to.
                                </apex:outputText>
                            </apex:pageBlockSection>

                            <apex:pageblockbuttons location="bottom">
                                <apex:commandButton action="{!submitCase}"
                                                    value="Submit"
                                                    styleClass="btn kbbtn"
                                                    style="color:#fff;background:#990033;padding:5px;width:55px;"/>
                            </apex:pageblockbuttons>
                        </apex:pageBlock>
                    </apex:form>
                </div>
            </div>
        </div><!-- end box -->
    </apex:outputPanel>
</apex:component>