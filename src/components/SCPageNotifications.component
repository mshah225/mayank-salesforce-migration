<apex:component >
	<!-- This component renders the page notifications on the page -->
	<apex:attribute name="pinError" description="Boolean to display the pin error banner" type="Boolean"/>
	<apex:attribute name="pinMessage" description="This is the message that is displayed" type="String"/>
	<apex:attribute name="pinSuccess" description="Boolean to display the pin success banner" type="Boolean"/>
	<apex:attribute name="feedback" description="String to determine if feedback is given" type="String"/>
	<apex:attribute name="confirm" description="String to determine if AKB feedback or site feedback is given" type="String"/>
	<apex:attribute name="suggest" description="String to determine if suggest an article feedback is given" type="String"/>
	<center>
	    <apex:outputPanel rendered="{!pinError}">
	        <div class="alert alert-danger">
	            <button type='button' class='close' data-dismiss='alert'>×</button>
	            <apex:outputText escape="false" value="{!pinMessage}"/>
	        </div>
	    </apex:outputPanel>

	    <apex:outputPanel rendered="{!pinSuccess}">
	        <div class="alert alert-success">
	            <button type='button' class='close' data-dismiss='alert'>×</button>
	            <apex:outputText escape="false" value="{!pinMessage}"/>
	        </div>
	    </apex:outputPanel>

	    <apex:outputPanel rendered="{!$CurrentPage.parameters.Feedback != null}">
	        <div class="alert alert-success feedbackConfirm">
	            <button type='button' class='close' id="closeFeedbackConfirm" data-dismiss='alert'>×</button>
	            <p><strong>Thank you for your feedback.</strong> Your feedback helps ASU make the Knowledge Base better.</p>
	        </div>
	     </apex:outputPanel>

	     <apex:outputPanel rendered="{!$CurrentPage.parameters.Confirm == 'newcase'}">
	        <div class="alert alert-success caseConfirm">
	            <button type='button' class='close' id="closeConfirmCase" data-dismiss='alert'>×</button>
	            <p><strong>Your request has been submitted.</strong> We are working on responding to you as soon as possible.<br />
	            A member of the ASU team will contact you if additional information is needed to answer your request.<br />
	            Please check back here, in the My ASU Service Center, to track the status of your request.</p>
	        </div>
	    </apex:outputPanel>

	    <apex:outputPanel rendered="{!$CurrentPage.parameters.Confirm == 'feedback'}">
	        <div class="alert alert-success caseConfirm">
	            <button type='button' class='close' id="closeConfirmFeedback" data-dismiss='alert'>×</button>
	            <p><strong>Thank you for your feedback about the My ASU Service Center!</strong></p>
	        </div>
	    </apex:outputPanel>

	    <apex:outputPanel rendered="{!$CurrentPage.parameters.Suggest != null}">
            <div class="alert alert-success feedbackConfirm">
                <button type='button' class='close' id="closeFeedbackConfirm" data-dismiss='alert'>×</button>
                <p><strong>Thank you for suggesting an article!</strong> Your suggestions help ASU make the Knowledge Base better.</p>
            </div>
         </apex:outputPanel>
	</center>
</apex:component>
