        <!--BEGIN MASS EMAIL MODAL-->
        <apex:form id="frmMassEmail" >
        <c:vsModal id="massEmail" imageurl="{!$Resource.RedEmail}" title="Mass Email">
            <apex:outputPanel layout="block" id="massEmailPanel">
                 <apex:outputPanel layout="block">
                    <apex:outputPanel layout="block" style="col-md-12">
                        <apex:actionStatus id="statusMassEmail">
                            <apex:facet name="start">
                            <div id="facetOuter">
                            </div>
                            <div id="facetInner">
                                <div class="imgFrame">
                                    <img src="/img/loading.gif" class="img" />
                                    <span class="imgText">Loading details...</span>
                                </div>
                            </div>
                            </apex:facet>
                        </apex:actionStatus>
                        <apex:outputPanel id="pnlContent">
                            <apex:outputPanel rendered="true">
                            <c:vsPanel title="Mass Email Student(s)" type="teal">
                            <c:vsWell style="text-align:center;"> 
                                <apex:outputPanel layout="block" rendered="{!selectedStudents.size>0 && !isEmailSuccess}">
                                   <c:vsGlyph icon="envelope" style="font-size:32px"/>&nbsp;<span style="font-size:48px">{!selectedStudents.size}</span>  
                                </apex:outputPanel>
                                <apex:outputPanel layout="block" rendered="{!selectedStudents.size>0 && !isEmailSuccess}">
                                   <h5>You are about to send an email to {!selectedStudents.size} student(s)</h5>
                                </apex:outputPanel>
                                <apex:outputPanel layout="block" rendered="{!selectedStudentCases.size>0 && !isEmailSuccess}">
                                   <c:vsGlyph icon="envelope" style="font-size:32px"/>&nbsp;<span style="font-size:48px">{!selectedStudentCases.size}</span>  
                                </apex:outputPanel>
                                <apex:outputPanel layout="block" rendered="{!selectedStudentCases.size>0 && !isEmailSuccess}">
                                   <h5>You are about to send an email to {!selectedStudentCases.size} student(s)</h5>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!IF(isEmailSuccess && selectedStudents.size>0,true,false)}"><p class="text-muted">Awesome! {!selectedStudents.size} Emails Successfully Sent!</p></apex:outputPanel>
                                <apex:outputPanel rendered="{!IF(isEmailSuccess && selectedStudentCases.size>0,true,false)}"><p class="text-muted">Awesome! {!selectedStudentCases.size} Emails Successfully Sent!</p></apex:outputPanel>
                                <c:vsProgressBar type="success" animated="true" value="{!progressStatus}"/> 
                            </c:vsWell> 
                            <apex:outputPanel layout="block" rendered="{!!isEmailSuccess}">
                                <c:vsAlert type="danger" rendered="{!isError}"><apex:messages /></c:vsAlert>
                                <div><apex:outputLabel ><b>Planned Message Template:</b></apex:outputLabel></div>
                                <div>
                                    <apex:selectList styleClass="form-control selectWidth" id="ddlPlannedMessages" multiselect="false" size="1" value="{!selectedPlannedMessage}">
                                        <apex:selectOptions value="{!plannedMessages}"> 
                                            <apex:actionSupport event="onclick" action="{!selectPlannedMessage}" rerender="pnlContent"> 
                                                <apex:param name="selectedPlannedMessage" value="{!selectedPlannedMessage}"/>    
                                            </apex:actionSupport>  
                                        </apex:selectOptions>     
                                    </apex:selectList>
                                </div>
                                
                                <div><apex:outputLabel ><b>Email Message:</b></apex:outputLabel></div>
                                <div>
                                    <apex:inputtextarea richtext="false" cols="65" rows="5" value="{!newEmailMessage}">
                                    <apex:actionSupport event="onchange" action="{!selectNewEmailMessage}" rerender="pnlDummy"> 
                                          <apex:param name="newEmailMessage" value="{!newEmailMessage}"/>    
                                    </apex:actionSupport> 
                                    </apex:inputtextarea>
                                </div>
                            </apex:outputPanel>
                            
                            <apex:outputPanel layout="block" rendered="{!isPreview}">
                                <div><apex:outputLabel ><b>Preview</b></apex:outputLabel></div>
                                <div>
                                    <apex:outputText value="{!previewMessage}" escape="false" />
                                </div>
                            </apex:outputPanel>
                            </c:vsPanel> 
                            </apex:outputPanel>
                        </apex:outputPanel>
                    </apex:outputPanel>
                </apex:outputPanel>
                
                <apex:outputPanel layout="block">
                    <apex:outputPanel layout="block" style="col-md-12">
                        <apex:outputPanel id="pnlButtons" layout="block" styleClass="modal-footer">
                            <apex:outputPanel rendered="true">
                            <apex:commandButton value="Close" styleClass="buttonASU" html-data-dismiss="modal"/>
                            <apex:commandButton rendered="{!!isEmailSuccess}" status="status" value="Preview" styleClass="buttonASU" action="{!previewMassEmail}" reRender="massEmailPanel" />
                            <apex:commandButton rendered="{!!isEmailSuccess}" status="status" value="Send" styleClass="buttonASU" action="{!sendMassEmail}" reRender="pnlDashboard,massEmailPanel" />
                            <apex:actionStatus id="status">
                                <apex:facet name="start">
                                <div id="facetOuter">
                                </div>
                                <div id="facetInner">
                                    <div class="imgFrame">
                                        <img src="/img/loading.gif" class="img" />
                                        <span class="imgText">Please Wait...</span>
                                    </div>
                                </div>
                                </apex:facet>
                            </apex:actionStatus>
                            </apex:outputPanel>
                        </apex:outputPanel>
                    </apex:outputPanel>
                </apex:outputPanel>
            </apex:outputPanel>
            
        </c:vsModal>
        </apex:form>
        <!--END MASS EMAIL MODAL-->
        
