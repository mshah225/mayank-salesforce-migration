<apex:component controller="SuccessPortal_MainPageController" id="mainPage">
    <c:vsAlert type="danger" rendered="{!isError}"><apex:messages /></c:vsAlert>
    <!--<c:vsVisualStrapBlock style="padding:5px">-->
    <apex:outputPanel styleClass="visualstrap " style="padding:5px" layout="block">
    <!--Start Main Form-->  
    <apex:form id="frmMain">
    <!--
    Code Revision History
    09/01/2016 - JCG - Added a new Case Emails grid to display email replies to a specific case
    09/07/2016 - JCG - Uncommented Pitch Chat code
    09/15/2016 - JCG - SFE-6481 - Dynamically render case details description and course fields
    09/23/2016 - JCG - SFE-6662 - Removed the tooltip feature component and row column components.
    -->    
    <!-- BEGIN VIEW AS FOR COACHES -->
    <apex:outputPanel id="pnlViewAsCoach">
    
    <c:vsPanel rendered="{!isCoachLead || isCoachManager || isCoachAdmin}" >
        <div><apex:outputLabel ><b>Viewing as:</b></apex:outputLabel></div>
        <div>
            <apex:selectList styleClass="form-control selectWidth" id="ddlViewAsUsers" multiselect="false" size="1" value="{!selectedCoachUserId}" Title="UserID" onchange="changedValue()" >
                 <apex:selectOptions value="{!viewAsUsers}"/>  
            </apex:selectList>
            <apex:actionFunction status="statusVAC" name="changedValue" action="{!selectCoachUserId}" rerender="pnlCaseSummaryList,pnlCaseDetails,pnlCaseDetailGrids,pnlCasesGrid" oncomplete="initPageBlockTableEnhancerADV()"/>
            <apex:actionStatus id="statusVAC">
                <apex:facet name="start">
                <div id="facetOuter">
                </div>
                <div id="facetInner">
                    <div class="imgFrame">
                        <img src="/img/loading.gif" class="img" />
                        <span class="imgText">Switching view...</span>
                    </div>
                </div>
                </apex:facet>
           </apex:actionStatus>
        </div>   
                 
    </c:vsPanel>
    </apex:outputPanel>
    <!-- END VIEW AS FOR COACHES -->
    
    <!-- BEGIN VIEW AS COMMITTEES FOR ADVISOR USERS -->
    <apex:outputPanel id="pnlViewAsAdvisor">
    <c:vsPanel rendered="{!isAdvisorUser}" >
        <div><apex:outputLabel ><b>Viewing as:</b></apex:outputLabel></div>
        <div>
            <apex:selectList styleClass="form-control selectWidth" id="ddlViewAsCommittees" multiselect="false" size="1" value="{!selectedAdvisorQueueId}" Title="QueueID" onchange="changedValue()" >
                 <apex:selectOptions value="{!viewAsCommittees}"/>  
            </apex:selectList>
            <apex:actionFunction status="statusVAA" name="changedValue" action="{!selectAdvisorQueueId}" rerender="pnlCaseSummaryList,pnlCaseDetailGrids,pnlCaseDetails,pnlCasesGrid" oncomplete="initPageBlockTableEnhancerADV()"/>
            <apex:actionStatus id="statusVAA">
                <apex:facet name="start">
                <div id="facetOuter">
                </div>
                <div id="facetInner">
                    <div class="imgFrame">
                        <img src="/img/loading.gif" class="img" />
                        <span class="imgText">Switching view...</span>
                    </div>
                </div>
                </apex:facet>
           </apex:actionStatus>
        </div>      
    </c:vsPanel>  
    </apex:outputPanel>
    <!-- END VIEW AS COMMITTEES FOR ADVISOR USERS -->
    
    <!-- BEGIN VIEW AS FOR ADVISOR LEADS, MANAGERS, ADMINS -->
    <apex:outputPanel id="pnlViewAsAdvisorUber">
    <c:vsPanel rendered="{!isAdvisorLead || isAdvisorManager || isAdvisorAdmin}" >
        <div><apex:outputLabel ><b>Viewing as:</b></apex:outputLabel></div>
        <div>
            <apex:selectList styleClass="form-control selectWidth" id="ddlViewAsQueues" multiselect="false" size="1" value="{!selectedAdvisorQueueId}" Title="QueueID" onchange="changedValue()" >
                 <apex:selectOptions value="{!viewAsQueues}"/>  
            </apex:selectList>
            <apex:actionFunction status="statusVAQ" name="changedValue" action="{!selectAdvisorQueueId}" rerender="pnlCaseSummaryList,pnlCaseDetails,pnlCaseDetailGrids,pnlCasesGrid"/>
            <apex:actionStatus id="statusVAQ">
                <apex:facet name="start">
                <div id="facetOuter">
                </div>
                <div id="facetInner">
                    <div class="imgFrame">
                        <img src="/img/loading.gif" class="img" />
                        <span class="imgText">Switching view...</span>
                    </div>
                </div>
                </apex:facet>
           </apex:actionStatus>
        </div>      
    </c:vsPanel>  
    </apex:outputPanel>
    <!-- END VIEW AS FOR ADVISOR LEADS, MANAGERS, ADMINS -->
  
    <!-- BEGIN DASHBOARD FOR COACHES -->
    <apex:outputPanel id="pnlDashboard">
    <c:vsPanel rendered="{!isCoachUser || isCoachLead || isCoachManager || isCoachAdmin}" > 
     
       <apex:outputPanel layout="block">
         <apex:outputPanel styleClass="col-md-4" layout="block">  
           <c:vsWell style="text-align:center">  
             <apex:outputPanel layout="block" styleClass="row "> 
               <apex:outputPanel styleClass="col-md-4" layout="block" style="font-size:48px"> 
                 <c:vsGlyph icon="hand-right" styleClass="{!IF(dashCasesCount == 0,'glyphBlack', IF(dashCasesCount < 50 ,'glyphGreen', 'glyphRed'))}"/>              
               </apex:outputPanel>  
               <apex:outputPanel styleClass="col-md-8" layout="block">                 
                 <h4>  
                   Outreaches  
                 </h4>  
                 <p class="text-muted infolabel">{!dashCasesCount} New Today</p>              
               </apex:outputPanel>  
             </apex:outputPanel>  
           </c:vsWell>  
         </apex:outputPanel>
           
         <apex:outputPanel styleClass="col-md-4" layout="block">    
           <c:vsWell style="text-align:center">  
             <apex:outputPanel layout="block" styleClass="row "> 
               <apex:outputPanel styleClass="col-md-4" layout="block" style="font-size:48px">  
                 <c:vsGlyph icon="envelope" styleClass="{!IF(dashEmailsCount == 0,'glyphBlack', IF(dashEmailsCount < 50 ,'glyphGreen', 'glyphRed'))}"/>              
               </apex:outputPanel>  
               <apex:outputPanel styleClass="col-md-8" layout="block">                  
                 <h4>  
                    Emails
                 </h4>  
                 <p class="text-muted infolabel">{!dashEmailsCount}  Sent Today</p>              
               </apex:outputPanel>  
             </apex:outputPanel>  
           </c:vsWell>  
         </apex:outputPanel> 
         <!-- 
         <c:vsColumn type="col-md-3">  
             <c:vsWell style="text-align:center">                
               <apex:outputPanel layout="block" styleClass="row ">  
                 <apex:outputPanel styleClass="col-md-4" layout="block" style="font-size:48px">  
                   <c:vsGlyph icon="phone" styleClass="{!IF(dashSMSCount == 0,'glyphBlack', IF(dashSMSCount < 50 ,'glyphGreen', 'glyphRed'))}"/>              
                 </apex:outputPanel>  
                 <apex:outputPanel styleClass="col-md-8" layout="block">                   
                   <h4>  
                    SMS Messages  
                   </h4>  
                   <p class="text-muted infolabel">{!dashSMSCount} Sent Today</p>              
                 </apex:outputPanel>  
               </apex:outputPanel>                
             </c:vsWell>  
         </c:vsColumn> 
         --> 
         <apex:outputPanel styleClass="col-md-4" layout="block">  
           <c:vsWell style="text-align:center">  
             <apex:outputPanel layout="block" styleClass="row ">  
               <apex:outputPanel styleClass="col-md-4" layout="block" style="font-size:48px">  
                   <c:vsGlyph icon="comment" styleClass="{!IF(dashChatsCount == 0,'glyphBlack', IF(dashChatsCount < 50 ,'glyphGreen', 'glyphRed'))}"/>              
               </apex:outputPanel>  
               <apex:outputPanel styleClass="col-md-8" layout="block">                   
                 <h4>  
                   Chats
                 </h4>  
                 <p class="text-muted infolabel">{!dashChatsCount}  New Today</p>              
               </apex:outputPanel>  
             </apex:outputPanel>  
           </c:vsWell>  
         </apex:outputPanel> 
       </apex:outputPanel>  
     </c:vsPanel>
     </apex:outputPanel> 
    <!-- END DASHBOARD FOR COACHES -->
    
    <apex:outputPanel layout="block" >
    <apex:outputPanel styleClass="col-md-12" layout="block"> 
        <apex:outputPanel layout="block" styleclass="rowStyle"> 
            <!--BEGIN CASE SUMMARY-->  
            <apex:outputPanel styleClass="col-md-4" layout="block">
                
                <apex:outputPanel id="pnlCaseSummaryList">
                <apex:outputPanel rendered="true">
                <c:vsPanel title="Outreach Summary List" type="teal">
                    <c:vsWell rendered="{!isCoachUser || isCoachLead || isCoachManager || isCoachAdmin}" style="text-align:center;">  
                        <c:vsGlyph icon="briefcase" style="font-size:32px"/>&nbsp;<span style="font-size:48px">{!CasesAssigned.size}</span>  
                        <p class="text-muted">Total Assigned Outreaches</p> 
                        <c:vsProgressBar type="success" animated="true" value="25"/> 
                    </c:vsWell> 
                    <apex:pageblock title="">
                    <apex:dataTable value="{!rowsSummaryCases}" var="case" id="tblSummaryCases" styleClass="table table-bordered"> 
                         <apex:column headerValue="Outreach Name" headerClass="headerColumnLeft">  
                            <apex:commandLink action="{!selectCaseSubject}" status="statusSCS" style="font-size:small" value="{!case.sumSubject}" rerender="pnlCaseDetails,pnlCaseDetailGrids,pnlCasesGrid" oncomplete="initPageBlockTableEnhancerADV()" >
                                <apex:param name="selectedCaseSubject" value="{!case.sumSubject}"/>
                                <apex:param name="selectedDueDate" value="{!case.sumDueDate}"/>
                                <apex:param name="selectedCasePriority" value="{!case.sumPriority}"/>
                            </apex:commandLink>  
                            <apex:actionStatus id="statusSCS">
                                <apex:facet name="start">
                                <div id="facetOuter">
                                </div>
                                <div id="facetInner">
                                    <div class="imgFrame">
                                        <img src="/img/loading.gif" class="img" />
                                        <span class="imgText">Please Wait...</span>
                                    </div>
                                </div>
                                </apex:facet>
                            </apex:actionStatus>
                            <apex:image rendered="{!IF(isCoachUser || isCoachLead || isCoachManager || isCoachAdmin,true,false)}" value="{!$Resource.Spacer}" width="5px" height="10px"/>
                            <apex:image rendered="{!IF((isCoachUser || isCoachLead || isCoachManager || isCoachAdmin) && case.sumPriority=='1 - Highest Priority' || case.sumPriority=='2 - High Priority' || case.sumPriority=='3 - Normal Priority' || case.sumPriority=='4 - Minor Priority',true,false)}" value="{!case.sumIcon}" width="10" height="10"/>
                            <apex:image rendered="{!IF((isCoachUser || isCoachLead || isCoachManager || isCoachAdmin) && case.sumPriority=='1 - Highest Priority' || case.sumPriority=='2 - High Priority' || case.sumPriority=='3 - Normal Priority',true,false)}" value="{!case.sumIcon}" width="10" height="10"/>
                            <apex:image rendered="{!IF((isCoachUser || isCoachLead || isCoachManager || isCoachAdmin) && case.sumPriority=='1 - Highest Priority' || case.sumPriority=='2 - High Priority',true,false)}" value="{!case.sumIcon}" width="10" height="10"/>
                            <apex:image rendered="{!IF((isCoachUser || isCoachLead || isCoachManager || isCoachAdmin) && case.sumPriority=='1 - Highest Priority',true,false)}" value="{!case.sumIcon}" width="10" height="10"/>

                        </apex:column>  
                        <apex:column value="{!case.sumCount}" headerValue="Count" headerClass="headerColumn" styleClass="rowColumn"/>
                        <apex:column value="{!case.sumDueDate}" headerValue="Due Date" headerClass="headerColumn" styleClass="rowColumn"/>
                   </apex:dataTable>
                   </apex:pageblock>
                   <c:vsAlert rendered="{!CasesAssigned.empty}" type="warning" style="text-align:center">  
                        <c:vsGlyph icon="exclamation-sign"/> No records to display  
                   </c:vsAlert> 
                   <center>
                   <apex:outputPanel styleClass="btn-toolbar" layout="block">
                            <apex:commandButton rendered="true" status="statusAMS" style="font-size:small" action="{!selectCaseSubject}" value="My Students" rerender="pnlCaseDetails,pnlCaseDetailGrids,pnlCasesGrid" oncomplete="initPageBlockTableEnhancerADV()" >
                                <apex:param name="selectedCaseSubject" value="My Students"/>
                            </apex:commandButton><apex:outputPanel styleClass="badge">{!myStudentsCount}</apex:outputPanel>
                            <apex:actionStatus id="statusAMS">
                                <apex:facet name="start">
                                <div id="facetOuter">
                                </div>
                                <div id="facetInner">
                                    <div class="imgFrame">
                                        <img src="/img/loading.gif" class="img" />
                                        <span class="imgText">Please Wait...</span>
                                    </div>
                                </div>
                                </apex:facet>
                            </apex:actionStatus>
                            
                            <apex:commandButton status="statusMOC" style="font-size:small" action="{!selectCaseSubject}" value="My Open Proactive Cases" rerender="pnlCaseDetails,pnlCaseDetailGrids,pnlCasesGrid" oncomplete="initPageBlockTableEnhancerADV()" >
                                <apex:param name="selectedCaseSubject" value="My Open Proactive Cases"/>
                            </apex:commandButton><apex:outputPanel styleClass="badge">{!myOpenCasesCount}</apex:outputPanel>
                            <apex:actionStatus id="statusMOC">
                                <apex:facet name="start">
                                <div id="facetOuter">
                                </div>
                                <div id="facetInner">
                                    <div class="imgFrame">
                                        <img src="/img/loading.gif" class="img" />
                                        <span class="imgText">Please Wait...</span>
                                    </div>
                                </div>
                                </apex:facet>
                            </apex:actionStatus>
                            
                            <apex:commandButton status="statusWL" style="font-size:small" action="{!selectCaseSubject}" value="My Watchlist" rerender="pnlCaseDetails,pnlCaseDetailGrids,pnlCasesGrid" oncomplete="initPageBlockTableEnhancerADV()" >
                                <apex:param name="selectedCaseSubject" value="My Watchlist"/>
                                <apex:param name="selectedDueDate" value=""/>
                            </apex:commandButton><apex:outputPanel styleClass="badge">{!myWatchlistCount}</apex:outputPanel>
                            <apex:actionStatus id="statusWL">
                                <apex:facet name="start">
                                <div id="facetOuter">
                                </div>
                                <div id="facetInner">
                                    <div class="imgFrame">
                                        <img src="/img/loading.gif" class="img" />
                                        <span class="imgText">Please Wait...</span>
                                    </div>
                                </div>
                                </apex:facet>
                            </apex:actionStatus>
                    </apex:outputPanel>
                    </center>
                </c:vsPanel> 
                </apex:outputPanel>
                </apex:outputPanel>
                
            </apex:outputPanel> 
            <!--END CASE SUMMARY--> 
            
            <!--BEGIN CASE DETAILS--> 
            <apex:outputPanel styleClass="col-md-8" layout="block">
                
                <apex:outputPanel id="pnlCaseDetails">
                <apex:outputPanel rendered="{!contactSelected}">
                <c:vsPanel title="{!selectedContactName} {!selectedContactEmplId} - Details Section" type="teal"> 
                  <c:vsWell rendered="{!isCoachUser || isCoachLead || isCoachManager || isCoachAdmin}" style="text-align:center;">  
                        <c:vsGlyph icon="calendar" style="font-size:32px"/>&nbsp;<span style="font-size:48px">{!caseTasks.size}</span>  
                        <p class="text-muted">Total Engagement Activities</p> 
                        <c:vsProgressBar type="{!caseTasksIndicator}" animated="true" value="{!caseTasks.size*10}"/> 
                  </c:vsWell> 
                  <apex:outputPanel layout="block" rendered="{!!isSuccess}">
                      <c:vsAlert type="danger" rendered="{!isError}"><apex:messages /></c:vsAlert>
                  </apex:outputPanel>
                  
                  <apex:outputPanel id="pnlCoachCaseDetails">
                  <apex:outputPanel rendered="{!IF(isCoachUser || isCoachLead || isCoachManager || isCoachAdmin,true,false)}">
                  <c:vsFormBlock alignment="vertical">
                  <apex:outputPanel layout="block" styleclass="rowStyle"> 
                      <apex:outputPanel styleClass="col-md-6" layout="block">
                        <c:vsFormGroup >
                        <apex:outputPanel id="Panel0">
                             <h5><b>Outreach Name:</b> {!selectedCaseSubject} </h5>     
                        </apex:outputPanel>
                        </c:vsFormGroup>
                      </apex:outputPanel>

                      <apex:outputPanel styleClass="col-md-3" layout="block">
                        <c:vsFormGroup >
                        <apex:outputPanel id="Panel1">
                             <div><apex:outputLabel ><b>Term:</b></apex:outputLabel></div>   
                             <div><apex:inputText disabled="true" style="border: 3px solid #cccccc;" id="txtTerm" value="{!selectedTerm}"/></div>    
                        </apex:outputPanel>
                        <apex:outputPanel id="Panel2">
                             <div><apex:outputLabel ><b>Session:</b></apex:outputLabel></div>   
                             <div><apex:inputText disabled="true" style="border: 3px solid #cccccc;" id="txtSession" value="{!selectedSession}"/></div>    
                        </apex:outputPanel>
                        <apex:outputPanel id="Panel3">
                             <div><apex:outputLabel ><b>Class Num:</b></apex:outputLabel></div>   
                             <div><apex:inputText disabled="true" style="border: 3px solid #cccccc;" id="txtClassNumber" value="{!selectedClassNumber}"/></div>    
                        </apex:outputPanel>
                        </c:vsFormGroup>
                      </apex:outputPanel>
                      
                      <apex:outputPanel styleClass="col-md-3" layout="block">
                        <c:vsFormGroup >
                        <apex:outputPanel id="Panel4">
                             <!--
                             <div><apex:outputLabel ><b>Session Code:</b></apex:outputLabel></div>   
                             <div><apex:inputText disabled="true" style="border: 3px solid #cccccc;" id="txtSessionCode" value="{!selectedSessionCode}"/></div>    
                             -->
                        </apex:outputPanel>
                        <apex:outputPanel id="Panel5">
                             <div><apex:outputLabel ><b>Session Decode:</b></apex:outputLabel></div>   
                             <div><apex:inputText disabled="true" style="border: 3px solid #cccccc;" id="txtSessionDecode" value="{!selectedSessionDecode}"/></div>    
                        </apex:outputPanel>
                        <apex:outputPanel id="Panel6">
                             <div><apex:outputLabel ><b>Course Code:</b></apex:outputLabel></div>   
                             <div><apex:inputText disabled="true" style="border: 3px solid #cccccc;" id="txtCourseCode" value="{!selectedCourseCode}"/></div>    
                        </apex:outputPanel>
                        </c:vsFormGroup>
                      </apex:outputPanel>
                  </apex:outputPanel>
                  </c:vsFormBlock>
                  </apex:outputPanel>
                  </apex:outputPanel>
                  
                  <apex:outputPanel id="pnlAdvisorCaseDetails">
                  <apex:outputPanel rendered="{!IF(isAdvisorUser || isAdvisorLead || isAdvisorManager || isAdvisorAdmin,true,false)}">
                  <c:vsFormBlock alignment="vertical">
                  <apex:outputPanel layout="block" styleclass="rowStyle"> 
                      <apex:outputPanel styleClass="col-md-6" layout="block">
                        <c:vsFormGroup >
                        <apex:outputPanel id="Panel7">
                             <h5><b>Outreach Name:</b> {!selectedCaseSubject} </h5>     
                        </apex:outputPanel>
                        </c:vsFormGroup>
                      </apex:outputPanel>
                      <apex:outputPanel styleClass="col-md-6" layout="block">
                        <c:vsFormGroup >
                        <apex:outputPanel id="Panel8">
                             <h5><b>Description:</b> {!selectedCaseDescription} </h5>     
                        </apex:outputPanel>
                        </c:vsFormGroup>
                      </apex:outputPanel>
                  </apex:outputPanel>
                  </c:vsFormBlock>
                  </apex:outputPanel>
                  </apex:outputPanel>
            
                  <apex:outputPanel layout="block" styleclass="rowStyle">   
                      <apex:outputPanel styleClass="col-md-6" layout="block">
                        <c:vsFormGroup >
                            <div><apex:outputLabel ><b>Outreach Status:</b></apex:outputLabel></div>
                            <div>
                                <apex:selectList styleClass="form-control selectWidth" id="ddlOutreachStatus" multiselect="false" size="1" value="{!selectedOutreachStatus}" Title="Status" onchange="changedValue1()" >
                                     <apex:selectOptions value="{!outreachStatuses}"/>  
                                </apex:selectList>
                                <apex:actionFunction status="statusOS" name="changedValue1" action="{!selectOutreachStatus}" rerender="pnlCaseDetails"/>
                                <apex:actionStatus id="statusOS">
                                    <apex:facet name="start">
                                    <div id="facetOuter">
                                    </div>
                                    <div id="facetInner">
                                        <div class="imgFrame">
                                            <img src="/img/loading.gif" class="img" />
                                            <span class="imgText">Working...</span>
                                        </div>
                                    </div>
                                    </apex:facet>
                               </apex:actionStatus>
                            </div>                                   
                        </c:vsFormGroup>
                      </apex:outputPanel>
                      
                      <apex:outputPanel styleClass="col-md-6" layout="block">
                      <apex:outputPanel id="pnlFollowupDate">
                      <apex:outputPanel rendered="{!contactSelected}">
                      <apex:actionRegion >
                        <c:vsFormGroup >
                          <div><apex:outputLabel ><b>Followup Date:</b></apex:outputLabel></div>
                          <div>
                              <apex:input type="date" value="{!selectedFollowupDate}" id="followUpDate">
                                  <apex:actionSupport event="onchange" action="{!selectFollowupDate}" rerender="pnlDummy"> 
                                      <apex:param name="selectedFollowupDate" value="{!selectedFollowupDate}"/>    
                                  </apex:actionSupport> 
                              </apex:input>
                          </div>
                        </c:vsFormGroup>
                      </apex:actionRegion> 
                      </apex:outputPanel>
                      </apex:outputPanel>
                      </apex:outputPanel>
                  </apex:outputPanel>
                  
                  <apex:outputPanel layout="block" styleclass="rowStyle"> 
                      <apex:outputPanel styleClass="col-md-12" layout="block">
                        <apex:outputPanel id="pnlStudentsIntention">
                        <apex:outputPanel rendered="{!IF((contactSelected && selectedCaseSubject=='Not Enrolled' && advisorCaseRecordTypeId==selectedCaseRecordTypeId) || (contactSelected && coachCaseRecordTypeId==selectedCaseRecordTypeId),true,false)}">
                        <c:vsFormGroup >
                            <div><apex:outputLabel ><b>Student&apos;s Intention:</b></apex:outputLabel></div>
                            <div>
                                <apex:selectList styleClass="form-control selectWidth" id="ddlStudentsIntention" multiselect="false" size="1" value="{!selectedStudentIntention}" Title="Status" onchange="changedValue2()" >
                                     <apex:selectOptions value="{!studentIntentions}"/>  
                                </apex:selectList>
                                <apex:actionFunction status="statusSI" name="changedValue2" action="{!selectStudentIntention}" rerender="pnlCaseDetails,pnlReason,pnlTermReturning"/>
                                <apex:actionStatus id="statusSI">
                                    <apex:facet name="start">
                                    <div id="facetOuter">
                                    </div>
                                    <div id="facetInner">
                                        <div class="imgFrame">
                                            <img src="/img/loading.gif" class="img" />
                                            <span class="imgText">Working...</span>
                                        </div>
                                    </div>
                                    </apex:facet>
                               </apex:actionStatus>
                            </div>
                        </c:vsFormGroup>
                        </apex:outputPanel>
                        </apex:outputPanel>
                      </apex:outputPanel>
                  </apex:outputPanel>
                    
                  <apex:outputPanel layout="block" styleclass="rowStyle"> 
                      <apex:outputPanel styleClass="col-md-12" layout="block">
                        <apex:outputPanel id="pnlReasonsNotReturning">
                        <apex:outputPanel rendered="{!IF((selectedStudentIntention!='Will enroll' && selectedStudentIntention!='') && (selectedCaseSubject=='Not Enrolled' && advisorCaseRecordTypeId==selectedCaseRecordTypeId) || (selectedStudentIntention!='Will enroll' && selectedStudentIntention!='' && selectedStudentIntention!='Active') && coachCaseRecordTypeId==selectedCaseRecordTypeId,true,false)}">
                        <c:vsFormGroup >
                            <div><apex:outputLabel ><b>Reason(s) Not Returning:</b></apex:outputLabel></div>
                            <apex:panelGrid columns="3">
                                <apex:selectList id="selRNR1" value="{!leftReasonsNotReturningSelected}" multiselect="true" style="width:350px" size="5">
                                    <apex:selectOptions value="{!unSelectedReasonsNotReturningValues}" />
                                </apex:selectList>
                                    <apex:panelGroup >
                                        <br/>
                                        <apex:image value="{!$Resource.buttonSelect}" height="32px" width="32px">
                                            <apex:actionSupport status="statusRE" event="onclick" action="{!selectReasonsNotReturningClick}" reRender="pnlReasonsNotReturning"/>
                                        </apex:image>
                                        <br/><br/>
                                        <apex:image value="{!$Resource.buttonUnselect}" height="32px" width="32px">
                                            <apex:actionSupport status="statusRE" event="onclick" action="{!unSelectReasonsNotReturningClick}" reRender="pnlReasonsNotReturning"/>
                                        </apex:image>
                                    </apex:panelGroup>
                                <apex:selectList id="selRNR2" value="{!selectedReasonsNotReturning}" multiselect="true" style="width:350px" size="5">
                                    <apex:selectOptions value="{!SelectedReasonsNotReturningValues}" />
