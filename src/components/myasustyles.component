    .arrow:after,
    .arrow:before {
        border-left: 15px solid transparent;
        border-right: 15px solid transparent;
        border-top: 15px solid #e9e9e9;
        bottom: -8px;
        content: '';
        left: 50%;
        margin-left: -16px;
        position: absolute;
