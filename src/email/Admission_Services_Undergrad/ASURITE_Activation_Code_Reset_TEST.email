<table border="0" cellpadding="5" width="550" cellspacing="5" height="400" >
<tr valign="top" height="400" >
<td tEditID="c1r1" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<div style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial;"><font face="arial">Hello&nbsp;{!Contact.FirstName}</font><span style="font-family: arial;">,</span></div><div style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial;"><br></div><div><div style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial;"><font face="arial">Thank you for contacting Admission Services at Arizona State University. In order to access services on <a href="http://my.asu.edu">My ASU</a>, including checking the status of your application, you must have your ASURITE UserID and activation code. Please allow two hours to pass before activating your ASURITE UserID. &nbsp;&nbsp;</font></div><div style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial;"><font face="arial">&nbsp;</font></div><div><font face="arial" style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial;">Please follow the instructions on the ASURITE activation </font><font face="Arial, sans-serif"><font style="color: rgb(0, 0, 0);">webpage:&nbsp;<a href="https://asu.edu/asurite">https://asu.edu/asurite</a></font></font><font face="Arial, sans-serif">.</font><font face="arial" style="color: rgb(0, 0, 0); font-size: 12pt;"> If you have further questions, please contact Admission Services at 480-965-7788.</font></div><div style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial;"><font face="arial">&nbsp; &nbsp;</font></div><div style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial;"><font face="arial"><b>Your ASURITE UserID is:</b> {!Contact.ASURite_ID__c}</font></div><div style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial;"><font face="arial"><b>Your activation code is:</b> (INSERT CODE HERE)</font></div><div style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial;"><font face="arial">Sincerely,</font></div><div style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial;"><font face="arial">{!User.Recruiter_Full_Name__c}</font></div><div style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial;"><font face="arial">{!User.Recruiter_Title__c}</font></div><div style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial;"><font face="arial">Admission Services</font></div><div style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial;"><font face="arial">{!User.Recruiter_Email__c}</font></div><div style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial;"><font face="arial">{!User.Recruiter_Phone__c}</font></div></div><div style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial;"><br></div><div style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial;"><br></div><div style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial;"><div style="font-family: 'Times New Roman'; font-size: medium;"><div><font face="arial" size="2" color="#666666">If you would like any additional information or have questions related to this subject, please reply to this email.</font></div><div><font face="arial" size="2" color="#666666"><br></font></div><div><font face="arial" size="2" color="#666666">{!Case.Thread_Id}</font></div></div></div>]]></td>
</tr>
</table>