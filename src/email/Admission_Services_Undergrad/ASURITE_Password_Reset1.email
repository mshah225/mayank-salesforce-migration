<table height="400" width="550" cellpadding="5" border="0" cellspacing="5" >
<tr height="400" valign="top" >
<td style=" color:#000000; font-size:12pt; background-color:#FFFFFF; font-family:arial; bLabel:main; bEditID:r3st1;" tEditID="c1r1" locked="0" aEditID="c1r1" >
<![CDATA[<div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">Hello {!Contact.FirstName},&nbsp;</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">Thank you for contacting Admission Services at Arizona State University. In order to access services on <a href="https://webapp4.asu.edu/myasu/">My ASU</a>, including the status of your application, you must have your ASURITE UserID and password.&nbsp;</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">Your ASURITE ID is: <b>{!Contact.ASURite_ID__c}</b></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">To reset your password:</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><ol><li><span style="font-size: 12pt;">Go to the <a href="https://webapp4.asu.edu/myasu/">My ASU</a> login screen.</span></li><li><span style="font-size: 12pt;">Enter your ASURITE UserID.</span></li><li><span style="font-size: 12pt;">Click <b>Forgot ID/Password</b>?</span></li><li><span style="font-size: 12pt;">Follow the instructions on the screen to reset your password.</span></li></ol></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">&nbsp;</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">If you have further questions regarding your ASURITE UserID, please contact the ASU Help Desk at 855-278-5080.&nbsp;</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">Sincerely,</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">{!User.Recruiter_Full_Name__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">{!User.Recruiter_Title__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">Admission Services</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">{!User.Recruiter_Email__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">{!User.Recruiter_Phone__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div><div style="font-family: 'Times New Roman'; font-size: medium;"><div><font face="arial" size="2" color="#666666">If you would like any additional information or have questions related to this subject, please reply to this email.</font></div><div><font face="arial" size="2" color="#666666"><br></font></div><div><font face="arial" size="2" color="#666666">{!Case.Thread_Id}</font></div></div></div>]]></td>
</tr>
</table>