<td tEditID="c1r1" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">Hello {!Contact.FirstName},&nbsp;</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div><font face="arial">Thank you for applying to Arizona State University. We have approved your request to waive the application for admission processing fee. Please allow 24–48 hours for the application fee reminder to be removed from your <b>Priority Tasks</b> on <a href="http://my.asu.edu">My ASU</a>.</font></div><div><font face="arial">&nbsp;</font></div><div><font face="arial">If you have any questions, please contact me at&nbsp;</font>{!Case.Opportunity_Owner_s_Recruiter_Email__c}<font face="arial">. I am your personal&nbsp;contact for admission-related questions, and I’ll be happy to help you through the admission process.</font></div></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">Sincerely,</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">{!Case.Opportunity_Owner_s_Full_Name__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">{!Case.Opportunity_Owner_s_Title__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">Admission Services</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">{!Case.Opportunity_Owner_s_Recruiter_Email__c}</font></div><div><font face="arial">{!Case.Opportunity_Owner_s_Pone__c}</font></div></div></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="font-family: 'Times New Roman'; font-size: medium;"><font face="arial" size="2" color="#666666">If you have any additional information or questions related to this, please reply to this email.</font></div><div style="font-family: 'Times New Roman'; font-size: medium;"><font face="arial" size="2" color="#666666"><br></font></div><div style="font-family: 'Times New Roman'; font-size: medium;"><font face="arial" size="2" color="#666666">{!Case.Thread_Id}</font></div></div>]]></td>
