<![CDATA[<div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">Hello&nbsp;{!Contact.FirstName}</font><span style="font-family: arial;">,</span></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-family: arial;"><br></span></div><div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div><font face="arial">Congratulations for being conditionally admitted to Arizona State University!</font></div><div><font face="arial"><br></font></div><div><font face="arial">Please find your conditional admission letter attached to this email.</font></div></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">Best regards,</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">International Admission Services</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div><div style="font-family: 'Times New Roman'; font-size: medium;"><font face="arial" size="2" color="#666666">If you have any additional information or questions related to this, please reply to this email.</font></div><div style="font-family: 'Times New Roman'; font-size: medium;"><font face="arial" size="2" color="#666666"><br></font></div><div style="font-family: 'Times New Roman'; font-size: medium;"><font face="arial" size="2" color="#666666">{!Case.Thread_Id}</font></div></div></div></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div>]]></td>
