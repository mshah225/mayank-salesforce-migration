<tr valign="top" height="400" >
<td tEditID="c1r1" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">Hello&nbsp;{!Contact.FirstName}</font><span style="font-family: arial;">,</span></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-family: arial;"><br></span></div><div><div><font face="arial">Thank you for sending your financial guarantee form. However, you must also send us a proof of funds for $45,533 in the form of a bank statement. Please email this document to <a href="mailto:fg@asu.edu">fg@asu.edu</a>.</font></div><div><font face="arial"><br></font></div><div><font face="arial">If you have any questions, please feel free to contact me.</font></div></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">Sincerely,</font></div></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div><font face="arial">{!User.Recruiter_Full_Name__c}</font></div><div><font face="arial">{!User.Recruiter_Title__c}</font></div><div><font face="arial">Admission Services</font></div><div><font face="arial">{!User.Recruiter_Email__c}</font></div><div><font face="arial">{!User.Recruiter_Phone__c}</font></div><div><font face="arial"><br></font></div><div><div style="font-family: 'Times New Roman'; font-size: medium;"><font face="arial" size="2" color="#666666">If you have any additional information or questions related to this, please reply to this email.</font></div><div style="font-family: 'Times New Roman'; font-size: medium;"><font face="arial" size="2" color="#666666"><br></font></div><div style="font-family: 'Times New Roman'; font-size: medium;"><font face="arial" size="2" color="#666666">{!Case.Thread_Id}</font></div></div></div>]]></td>
</tr>
</table>