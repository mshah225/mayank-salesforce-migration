<![CDATA[<div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">Hello {!Contact.FirstName},</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div><div><font face="arial">Thank you for sending your test scores to Arizona State University. Admission Services only accepts official SAT and ACT test scores. Official test scores are sent directly to ASU from the College Board/SAT or the ACT corporation.&nbsp;</font></div><div><font face="arial"><br></font></div><div><font face="arial">If you have further questions, please contact your dedicated admission representative at <a href="https://asu.edu/findmyrep">asu.edu/findmyrep</a>.&nbsp;</font></div></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">Thank you,</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">&nbsp;</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">Admission Services</font></div></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div><div style="font-size: medium; font-family: 'Times New Roman';"><font face="arial" size="2" color="#666666">If you would like any additional information or have questions related to this subject, please reply to this email.</font></div><div style="font-size: medium; font-family: 'Times New Roman';"><font face="arial" size="2" color="#666666"><br></font></div><div style="font-size: medium; font-family: 'Times New Roman';"><font face="arial" size="2" color="#666666">{!Case.Thread_Id}</font></div></div></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div>]]></td>
