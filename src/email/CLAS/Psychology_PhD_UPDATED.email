<td tEditID="c1r1" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<span id="docs-internal-guid-c5a06b01-b3a7-9e42-d83a-426f0e31593d"><p dir="ltr" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; line-height: 1.15; margin-top: 0pt; margin-bottom: 10pt;"><span style="font-family: Arial; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(255, 255, 255);">{!Contact.FirstName},</span></p><p dir="ltr" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; line-height: 1.15; margin-top: 0pt; margin-bottom: 10pt;"><span style="font-size: 15px; font-family: Arial; vertical-align: baseline; white-space: pre-wrap;">Thank you for contacting the Department of Psychology at Arizona State University. We invite you to check out our </span><a href="https://psychology.clas.asu.edu/graduate/prospective%20students" style="text-decoration:none;"><span style="font-size: 15px; font-family: Arial; color: rgb(17, 85, 204); text-decoration: underline; vertical-align: baseline; white-space: pre-wrap;">website</span></a><span style="font-size: 15px; font-family: Arial; vertical-align: baseline; white-space: pre-wrap;"> for details on our graduate programs, including program descriptions, admission requirements, application deadlines and faculty research.</span><a href="https://psychology.clas.asu.edu/graduate/prospective%20students" style="text-decoration:none;"><span style="font-size: 15px; font-family: Arial; color: rgb(0, 0, 0); vertical-align: baseline; white-space: pre-wrap;"> </span></a></p><p dir="ltr" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; line-height: 1.15; margin-top: 0pt; margin-bottom: 10pt;"><span style="font-size: 15px; font-family: Arial; vertical-align: baseline; white-space: pre-wrap;">The Department of Psychology offers graduate studies leading to the Doctor of Philosophy degree in six major areas of doctoral study: behavioral neuroscience, clinical psychology, cognitive science, developmental psychology, quantitative psychology and social psychology.The PhD includes a master’s in passing as part of the doctoral training.</span></p><p dir="ltr" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; line-height: 1.15; margin-top: 0pt; margin-bottom: 10pt;"><span style="font-size: 15px; font-family: Arial; vertical-align: baseline; white-space: pre-wrap;">Please review the program details on our website. If you have specific program questions, please feel free to contact me. I wish you all the best in your pursuit of graduate studies.</span></p><p dir="ltr" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; line-height: 1.15; margin-top: 0pt; margin-bottom: 10pt;"><span style="font-size: 15px; font-family: Arial; vertical-align: baseline; white-space: pre-wrap;">Have a wonderful day,</span></p><p dir="ltr" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; line-height: 1.15; margin-top: 0pt; margin-bottom: 0pt;"><span style="font-size: 15px; font-family: Arial; vertical-align: baseline; white-space: pre-wrap;">Sno Kleespies</span></p><p dir="ltr" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; line-height: 1.15; margin-top: 0pt; margin-bottom: 0pt;"><span style="font-size: 15px; font-family: Arial; vertical-align: baseline; white-space: pre-wrap;">Graduate Studies Coordinator</span></p><p dir="ltr" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; line-height: 1.15; margin-top: 0pt; margin-bottom: 0pt;"><span style="font-size: 15px; font-family: Arial; vertical-align: baseline; white-space: pre-wrap;">Department of Psychology</span></p><p dir="ltr" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; line-height: 1.15; margin-top: 0pt; margin-bottom: 0pt;"><span style="font-family: Arial; font-size: 15px; white-space: pre-wrap;">psychgrad@asu.edu</span></p><p dir="ltr" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; line-height: 1.15; margin-top: 0pt; margin-bottom: 0pt;"><span style="font-family: Arial; font-size: 15px; white-space: pre-wrap;"><br></span></p><p dir="ltr" style="margin-top: 0pt; margin-bottom: 0pt;"><font face="Arial" color="#cccccc" size="1"><span style="line-height: 17.25px; white-space: pre-wrap;">{!Case.Thread_Id}</span></font></p></span>]]></td>
