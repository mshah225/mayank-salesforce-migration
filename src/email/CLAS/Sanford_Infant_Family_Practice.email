<td tEditID="c1r1" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<font face="arial"><span style="font-size: 12pt;">Dear&nbsp;{!Contact.FirstName},</span></font><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Thank you for your interest in the Infant Family Practice Master's program at the T. Denny Sanford School of Social and Family Dynamics.</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Unfortunately, this program has been put on indefinite hiatus. Please check back with us for any updates in the future.</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Thank you,</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b>Gina Perez, M.Ed.</b></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Graduate Programs Coordinator</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">T. Denny Sanford School of Social and Family Dynamics</div><div><font face="arial" color="#ffffff">{!Case.Thread_Id}</font></div>]]></td>
</tr>
