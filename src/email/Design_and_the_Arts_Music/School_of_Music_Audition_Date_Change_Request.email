<![CDATA[<font face="arial" style="color: rgb(0, 0, 0);"><span style="font-size: 12pt;">Dear&nbsp;{!Contact.FirstName},</span></font><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div><div style="color: rgb(0, 0, 0);"><font face="arial">We have received your request to change your audition date. Before we can process your request, please pay the $10 fee <a href="https://www.regonline.com/auditionFY16">online</a>.&nbsp;</font></div><div style="color: rgb(0, 0, 0);"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0);"><font face="arial">After you submit the payment, please email <a href="mailto:MusicAdmissions@asu.edu">MusicAdmissions@asu.edu </a>for a new audition date confirmation email.</font></div><div style="color: rgb(0, 0, 0);"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0);"><font face="arial">Sincerely,</font></div><div style="color: rgb(0, 0, 0);"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0);"><div><b style="font-size: 12pt;">Julie Stephens</b></div><div style="font-size: 12pt;"><div><font face="arial" color="#999999">Coordinator, Academic Affairs + Admissions</font></div><div><font face="arial"><b><font color="#990000">Arizona State University</font>&nbsp;|&nbsp;</b></font><b style="color: rgb(255, 204, 0); font-size: 12pt;">Herberger Institute for Design and the Arts&nbsp;</b></div><div><span style="font-size: 12pt; color: rgb(153, 153, 153);">P.O. Box 870405 |&nbsp;</span><span style="font-size: 12pt; color: rgb(153, 153, 153);">Tempe, Arizona 85287-0405</span></div><div><font color="#999999">Phone: 480-965-5069</font></div><div><span style="color: rgb(255, 255, 255); font-size: 12pt;">{!Case.Thread_Id}</span></div></div></div></div>]]></td>
</tr>
