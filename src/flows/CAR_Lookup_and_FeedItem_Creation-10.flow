<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>postChatterNotification</name>
        <label>postChatterNotification</label>
        <locationX>350</locationX>
        <locationY>254</locationY>
        <actionName>chatterPost</actionName>
        <actionType>chatterPost</actionType>
        <inputParameters>
            <name>subjectNameOrId</name>
            <value>
                <elementReference>varChatterGroupId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>text</name>
            <value>
                <elementReference>forChatterTemplate</elementReference>
            </value>
        </inputParameters>
        <outputParameters>
            <assignToReference>varFeedItemId</assignToReference>
            <name>feedItemId</name>
        </outputParameters>
    </actionCalls>
    <decisions>
        <name>decChatterGroupFound</name>
        <label>decChatterGroupFound</label>
        <locationX>350</locationX>
        <locationY>137</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Chatter_Group_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varChatterNotificationGroup</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>postChatterNotification</targetReference>
            </connector>
            <label>Chatter Group Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>decEmailCount</name>
        <label>decEmailCount</label>
        <locationX>24</locationX>
        <locationY>232</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Email_Count_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varEmailCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>0</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Email_is_Recoginzed</targetReference>
            </connector>
            <label>Email Count = 1</label>
        </rules>
    </decisions>
    <decisions>
        <name>Email_is_Recoginzed</name>
        <label>Email is Recoginzed</label>
        <locationX>127</locationX>
        <locationY>355</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCARID</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varReceivesNotifications</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>lookupChatterGroup</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <description>Using formula for Chatter post (Can&apos;t use HTML in feedItem yet)
Reverting to basic formula.</description>
    <formulas>
        <name>forChatterTemplate</name>
        <dataType>String</dataType>
        <expression>&quot;You have a new case with this Id: &quot; + LEFT({!varCaseId},15) +
&quot;                 and this Subject: &quot; + {!varEmailSubject}</expression>
    </formulas>
    <interviewLabel>CAR Lookup and FeedItem Creation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CAR Lookup and FeedItem Creation</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>lookupCAR</name>
        <label>lookupCAR</label>
        <locationX>26</locationX>
        <locationY>12</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>lookupCaseEmailCount</targetReference>
        </connector>
        <filters>
            <field>Email_Address__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varInboundEmailAddress</elementReference>
            </value>
        </filters>
        <object>Case_Assignment_Rule__c</object>
        <outputAssignments>
            <assignToReference>varChatterNotificationGroup</assignToReference>
            <field>Chatter_Notification_Group__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varCARID</assignToReference>
            <field>Id</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varReceivesNotifications</assignToReference>
            <field>Receives_Chatter_Notifications__c</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>lookupCaseEmailCount</name>
        <label>lookupCaseEmailCount</label>
        <locationX>25</locationX>
        <locationY>121</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>decEmailCount</targetReference>
        </connector>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varCaseId</elementReference>
            </value>
        </filters>
        <object>Case</object>
        <outputAssignments>
            <assignToReference>varEmailCount</assignToReference>
            <field>Reply_Count__c</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>lookupChatterGroup</name>
        <label>lookupChatterGroup</label>
        <locationX>187</locationX>
        <locationY>136</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>decChatterGroupFound</targetReference>
        </connector>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varChatterNotificationGroup</elementReference>
            </value>
        </filters>
        <object>CollaborationGroup</object>
        <outputAssignments>
            <assignToReference>varChatterGroupId</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <startElementReference>lookupCAR</startElementReference>
    <textTemplates>
        <name>ChatterTemplate</name>
        <text>&lt;SPAN ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;You have a new case with this ID: {!varCaseId}&lt;/FONT&gt;&lt;/SPAN&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;From this Email: &lt;FONT KERNING=&quot;1&quot;&gt;{!varFromAddress}&lt;/FONT&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;With this Subject: {!varEmailSubject}&lt;/FONT&gt;&lt;/DIV&gt;</text>
    </textTemplates>
    <variables>
        <name>varCARID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varCaseId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varChatterGroupId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varChatterNotificationGroup</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varEmailCount</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varEmailSubject</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varFeedItemId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varFromAddress</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varInboundEmailAddress</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varReceivesNotifications</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
