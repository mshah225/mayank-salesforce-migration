                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>myRule_1_A1</targetReference>
            </connector>
            <label>RecordType = Interest, CampaignType = PSMajors</label>
        </rules>
    </decisions>
    <description>Update the Plan URL field with the Plan URL from the Plan object for Interest Record Type where Campaign Type = PSMajors</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>IF (TEXT( [Campaign].Career__c  ) = &quot;Non-Credit&quot;,&quot;&quot;, 
&quot;https://webapp4.asu.edu/programs/t5/majorinfo/ASU00/&quot;&amp;[Campaign].Campaign_External_ID__c   &amp;&quot;/&quot;&amp; 
CASE(TEXT( [Campaign].Career__c ), 
&quot;Law&quot;, &quot;graduate&quot;, 
&quot;Undergraduate&quot;, &quot;undergrad&quot;, 
LOWER(TEXT( [Campaign].Career__c  ))) 
&amp;&quot;/false&quot;)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_2_myRule_1_A1_Interest_URL_c</name>
        <dataType>String</dataType>
        <expression>IF (TEXT( {!myVariable_current.Career__c}  ) = &quot;Non-Credit&quot;,&quot;&quot;, 
&quot;https://webapp4.asu.edu/programs/t5/majorinfo/ASU00/&quot;&amp;{!myVariable_current.Campaign_External_ID__c}   &amp;&quot;/&quot;&amp; 
CASE(TEXT( {!myVariable_current.Career__c} ), 
&quot;Law&quot;, &quot;graduate&quot;, 
&quot;Undergraduate&quot;, &quot;undergrad&quot;, 
LOWER(TEXT( {!myVariable_current.Career__c}  ))) 
&amp;&quot;/false&quot;)</expression>
    </formulas>
    <interviewLabel>Campaign-1_Campaign</interviewLabel>
    <label>Campaign Interest Update Plan URL</label>
