    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
	OR(ISNEW(),
		ISCHANGED([Account].RecordTypeId)),
	OR([Account].RecordType.DeveloperName = &quot;External_Mastered_Org&quot;, 
			[Account].RecordType.DeveloperName = &quot;SF_Mastered_Org&quot;
		)
	)
</stringValue>
