<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <choices>
        <name>Downtown</name>
        <choiceText>Downtown</choiceText>
        <dataType>String</dataType>
    </choices>
    <choices>
        <name>Tempe</name>
        <choiceText>Tempe</choiceText>
        <dataType>String</dataType>
    </choices>
    <decisions>
        <name>Role_Creation_Loop</name>
        <label>Role Creation Loop</label>
        <locationX>422</locationX>
        <locationY>333</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Create_Another_Role</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Do_you_have_another_role_to_create</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>screenCaseRequisition</targetReference>
            </connector>
            <label>Create Another Role</label>
        </rules>
        <rules>
            <name>Don_t_Create_Another_Role</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Do_you_have_another_role_to_create</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>All_done</targetReference>
            </connector>
            <label>Don&apos;t Create Another Role</label>
        </rules>
    </decisions>
    <formulas>
        <name>DeveloperNameFormula</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE( {!forManagerRoleName}, &quot; &quot;, &quot;_&quot;)</expression>
    </formulas>
    <formulas>
        <name>DeveloperNameFormulaStaff</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!StaffNameFormula}, &quot; &quot;, &quot;_&quot;)</expression>
    </formulas>
    <formulas>
        <name>forManagerRoleName</name>
        <dataType>String</dataType>
        <expression>{!Generic_Role_Name} &amp;&quot; &quot;&amp;&quot;Manager&quot;</expression>
    </formulas>
    <formulas>
        <name>QueueIdShort</name>
        <dataType>String</dataType>
        <expression>LEFT({!varQueueId}, 15)</expression>
    </formulas>
    <formulas>
        <name>StaffNameFormula</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!forManagerRoleName}, &quot;Manager&quot;, &quot;Staff&quot;)</expression>
    </formulas>
    <interviewLabel>Role Creation Tool {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Role Creation Tool</label>
    <processType>Flow</processType>
    <recordCreates>
        <name>createUserRole</name>
        <label>createUserRole</label>
        <locationX>278</locationX>
        <locationY>2</locationY>
        <assignRecordIdToReference>varManagerRoleId</assignRecordIdToReference>
        <connector>
            <targetReference>createUserRoleStaff</targetReference>
        </connector>
        <faultConnector>
            <targetReference>FaultReporting</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>CaseAccessForAccountOwner</field>
            <value>
                <stringValue>Edit</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ContactAccessForAccountOwner</field>
            <value>
                <stringValue>Read</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DeveloperName</field>
            <value>
                <elementReference>DeveloperNameFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>forManagerRoleName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OpportunityAccessForAccountOwner</field>
            <value>
                <stringValue>Edit</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ParentRoleId</field>
            <value>
                <stringValue>00Ed00000017dtP</stringValue>
            </value>
        </inputAssignments>
        <object>UserRole</object>
    </recordCreates>
    <recordCreates>
        <name>createUserRoleStaff</name>
        <label>createUserRoleStaff</label>
        <locationX>278</locationX>
        <locationY>117</locationY>
        <assignRecordIdToReference>varUserRoleStaffId</assignRecordIdToReference>
        <connector>
            <targetReference>Another_Role</targetReference>
        </connector>
        <faultConnector>
            <targetReference>FaultReporting</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>CaseAccessForAccountOwner</field>
            <value>
                <stringValue>Edit</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ContactAccessForAccountOwner</field>
            <value>
                <stringValue>Read</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DeveloperName</field>
            <value>
                <elementReference>DeveloperNameFormulaStaff</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>StaffNameFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OpportunityAccessForAccountOwner</field>
            <value>
                <stringValue>Edit</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ParentRoleId</field>
            <value>
                <elementReference>varManagerRoleId</elementReference>
            </value>
        </inputAssignments>
        <object>UserRole</object>
    </recordCreates>
    <screens>
        <name>All_done</name>
        <label>All done!</label>
        <locationX>723</locationX>
        <locationY>332</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>FinishElement</name>
            <fieldText>&lt;SPAN ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:48px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;B&gt;CREATION DONE&lt;/B&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:48px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;B&gt;GET OUT!&lt;/B&gt;&lt;/FONT&gt;&lt;/DIV&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
    </screens>
    <screens>
        <name>Another_Role</name>
        <label>Another Role?</label>
        <locationX>421</locationX>
        <locationY>216</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Role_Creation_Loop</targetReference>
        </connector>
        <fields>
            <name>Do_you_have_another_role_to_create</name>
            <dataType>Boolean</dataType>
            <fieldText>Do you have another role to create?</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
    </screens>
    <screens>
        <name>FaultReporting</name>
        <label>FaultReporting</label>
        <locationX>504</locationX>
        <locationY>1</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
    </screens>
    <screens>
        <name>screenCaseRequisition</name>
        <label>screenCaseRequisition</label>
        <locationX>5</locationX>
        <locationY>3</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>createUserRole</targetReference>
        </connector>
        <fields>
            <name>Generic_Role_Name</name>
            <dataType>String</dataType>
            <fieldText>Generic Role Name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
    </screens>
    <screens>
        <name>Test</name>
        <label>Test</label>
        <locationX>133</locationX>
        <locationY>254</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>TestFields</name>
            <fieldText>{!DeveloperNameFormula}
{!DeveloperNameFormulaStaff}
{!forManagerRoleName}
{!StaffNameFormula}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
    </screens>
    <startElementReference>screenCaseRequisition</startElementReference>
