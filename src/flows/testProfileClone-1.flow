    <decisions>
        <name>decCARCreationContinues</name>
        <label>decCARCreationContinues</label>
        <locationX>952</locationX>
        <locationY>288</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Creation_Incomplete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CAR_Creation_Completed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>decideCARRecordType</targetReference>
            </connector>
            <label>Creation Incomplete</label>
        </rules>
        <rules>
            <name>Creation_Complete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CAR_Creation_Completed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>OWE_Data_Entry_Form</targetReference>
            </connector>
            <label>Creation Complete</label>
        </rules>
    </decisions>
    <decisions>
        <name>decideCARRecordType</name>
        <label>decideCARRecordType</label>
        <locationX>951</locationX>
        <locationY>184</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>ASU_Service_RT</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Is_ASU_Service_Record_Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>assASUServiceRT</targetReference>
            </connector>
            <label>ASU Service RT</label>
        </rules>
        <rules>
            <name>ASU_Recruiting_RT</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Is_ASU_Service_Record_Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>assASURecruitRt</targetReference>
            </connector>
            <label>ASU Recruiting RT</label>
        </rules>
    </decisions>
    <decisions>
        <name>decOWECreation</name>
        <label>decOWECreation</label>
        <locationX>953</locationX>
        <locationY>365</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>OWE_Creation_Incomplete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Check_if_OWE_s_are_now_completed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>createOWE</targetReference>
            </connector>
            <label>OWE Creation Incomplete</label>
        </rules>
        <rules>
            <name>OWE_Creation_Complete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Check_if_OWE_s_are_now_completed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Final_Summary_and_ToDo_List</targetReference>
            </connector>
            <label>OWE Creation Complete</label>
        </rules>
    </decisions>
    <formulas>
        <name>DeveloperNameFormula</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE( {!Manager_Role_Name}, &quot; &quot;, &quot;_&quot;)</expression>
    </formulas>
    <formulas>
        <name>DeveloperNameFormulaStaff</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!StaffNameFormula}, &quot; &quot;, &quot;_&quot;)</expression>
    </formulas>
    <formulas>
        <name>EmailFolderDeveloperName</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!Email_Folder_Name}, &quot; &quot;,&quot;_&quot;)</expression>
    </formulas>
    <formulas>
        <name>QueueIdShort</name>
        <dataType>String</dataType>
        <expression>LEFT({!varQueueId}, 15)</expression>
    </formulas>
    <formulas>
        <name>StaffNameFormula</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!Manager_Role_Name}, &quot;Manager&quot;, &quot;Staff&quot;)</expression>
    </formulas>
    <interviewLabel>testProfileClone {!$Flow.CurrentDateTime}</interviewLabel>
    <label>testProfileClone</label>
