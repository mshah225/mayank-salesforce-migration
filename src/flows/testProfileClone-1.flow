    <screens>
        <name>CAR_Data_Entry_Form</name>
        <label>CAR Data Entry Form</label>
        <locationX>757</locationX>
        <locationY>6</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>decCARCreationContinues</targetReference>
        </connector>
        <fields>
            <name>CAREntryDisplay1</name>
            <fieldText>Select &quot;Completed&quot; when done.

Additionally, leave fields blank if necessary.</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>CAR_Creation_Completed</name>
            <dataType>Boolean</dataType>
            <fieldText>CAR Creation Completed - Select after *last* CAR is completed.</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Is_ASU_Service_Record_Type</name>
            <dataType>Boolean</dataType>
            <fieldText>Is ASU Service Record Type</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Priority</name>
            <dataType>Number</dataType>
            <fieldText>Priority</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <scale>0</scale>
        </fields>
        <fields>
            <name>CAREntryDisplay2</name>
            <fieldText>Priority: Add 1 to the last, highest CAR.</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Category</name>
            <dataType>String</dataType>
            <fieldText>Category</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>CAREntryDisplay3</name>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Sub_Category</name>
            <dataType>String</dataType>
            <fieldText>Sub Category</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>CAREntryDisplay4</name>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Functional_Group</name>
            <dataType>String</dataType>
            <fieldText>Functional Group</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>CAREntryDisplay5</name>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>CAR_Email_Address</name>
            <dataType>String</dataType>
            <fieldText>CAR Email Address</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <validationRule>
                <errorMessage>Please ensure you enter a valid email address for your CAR.</errorMessage>
                <formulaExpression>REGEX ( UPPER ( {!CAR_Email_Address} ) ,&quot;^[A-Z0-9._%+-/!#$%&amp;&apos;*=?^_`{|}~]+@[A-Z0-9.-]+\\.[A-Z]{2,4}$&quot;)</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>CAREntryDisplay6</name>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Customer_Notice_Email_From_Name</name>
            <dataType>String</dataType>
            <fieldText>Customer Notice Email From Name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>CAREntryDisplay7</name>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Campus</name>
            <dataType>String</dataType>
            <fieldText>Campus</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
