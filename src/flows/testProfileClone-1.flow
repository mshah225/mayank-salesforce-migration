        <fields>
            <name>testCloneURL</name>
            <fieldText>&lt;SPAN ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;To Do:&lt;/FONT&gt;&lt;/SPAN&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;1) Clone Recruitment Profile: &lt;A HREF=&quot;https://asu--bill.cs41.my.salesforce.com/_ui/perms/ui/profile/ProfileClone/e?id=00ed0000001A1mz&amp;retURL=%2F00ed0000001A1mz&quot; TARGET=&quot;_blank&quot;&gt;here&lt;/A&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;    Clone Service Profile: &lt;A HREF=&quot;https://asu--bill.cs41.my.salesforce.com/_ui/perms/ui/profile/ProfileClone/e?id=00ed0000001A1Gf&amp;retURL=%2F00ed0000001A1Gf&quot; TARGET=&quot;_blank&quot;&gt;here&lt;/A&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;2) Confirm Manager User Role Accurate: &lt;A HREF=&quot;https://asu--bill.cs41.my.salesforce.com/{!varManagerRoleId}/e&quot; TARGET=&quot;_blank&quot;&gt;Link:&lt;/A&gt; &lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;Id: {!varManagerRoleId}&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;3) Confirm Staff User Role Accurate: &lt;A HREF=&quot;https://asu--bill.cs41.my.salesforce.com/{!varUserRoleStaffId}/e&quot; TARGET=&quot;_blank&quot;&gt;Link:&lt;/A&gt; &lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;Id: {!varUserRoleStaffId}&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;4) Add Users to Public Group &lt;A HREF=&quot;https://asu--qa.cs11.my.salesforce.com/p/own/OrgPublicGroupsPage/d?setupid=PublicGroups&amp;retURL=%2Fui%2Fsetup%2FSetup%3Fsetupid%3DUsers&quot; TARGET=&quot;_blank&quot;&gt;Link&lt;/A&gt;&lt;A HREF=&quot;https://asu--bill.cs41.my.salesforce.com/{!varPublicGroupId}/e&quot; TARGET=&quot;_blank&quot;&gt;:&lt;/A&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;Id: {!varPublicGroupId} &lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;5) Add Users to Queue: &lt;A HREF=&quot;https://asu--qa.cs11.my.salesforce.com/p/own/OrgQueuesPage/d?retURL=%2Fui%2Fsetup%2FSetup%3Fsetupid%3DUsers&amp;setupid=Queues&quot; TARGET=&quot;_blank&quot;&gt;Link&lt;/A&gt;&lt;A HREF=&quot;https://asu--bill.cs41.my.salesforce.com/{!varQueueId}/e&quot; TARGET=&quot;_blank&quot;&gt;:&lt;/A&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;Id: {!varQueueId}&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;6) Add Users to Chatter Group: &lt;A HREF=&quot;https://asu--bill.cs41.my.salesforce.com/{!varChatterGroupId}/e&quot; TARGET=&quot;_blank&quot;&gt;Link:&lt;/A&gt; &lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;Id: {!varChatterGroupId}&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;7) Add Templates to Email Folder: &lt;A HREF=&quot;https://asu--bill.cs41.my.salesforce.com/{!varEmailTemplateFolder}/e&quot; TARGET=&quot;_blank&quot;&gt;Link:&lt;/A&gt; &lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;Id: {!varEmailTemplateFolder}&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;8) Confirm CAR&amp;apos;s accurate: &lt;A HREF=&quot;https://asu--bill.cs41.my.salesforce.com/a04?fcf=00Bd0000005UZuW&quot; TARGET=&quot;_blank&quot;&gt;here&lt;/A&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;9) Confirm OWE&amp;apos;s accurate: &lt;A HREF=&quot;https://asu--bill.cs41.my.salesforce.com/email-admin/owa/listOrgWideEmailAddress.apexp&quot; TARGET=&quot;_blank&quot;&gt;here&lt;/A&gt;&lt;/FONT&gt;&lt;/DIV&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
    </screens>
    <screens>
        <name>OWE_Data_Entry_Form</name>
        <label>OWE Data Entry Form</label>
        <locationX>696</locationX>
        <locationY>283</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>decOWECreation</targetReference>
        </connector>
        <fields>
            <name>Check_if_OWE_s_are_now_completed</name>
            <dataType>Boolean</dataType>
            <fieldText>Check if OWE&apos;s are now completed.</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>OWEDisplayScreen1</name>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>OWE_Display_Name</name>
            <dataType>String</dataType>
            <fieldText>OWE Display Name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>OWEDisplayScreen2</name>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>OWE_Email_Address</name>
            <dataType>String</dataType>
            <fieldText>OWE Email Address</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <validationRule>
                <errorMessage>Please ensure you enter a valid email address for your OWE.</errorMessage>
                <formulaExpression>REGEX ( UPPER ( {!OWE_Email_Address} ) ,&quot;^[A-Z0-9._%+-/!#$%&amp;&apos;*=?^_`{|}~]+@[A-Z0-9.-]+\\.[A-Z]{2,4}$&quot;)</formulaExpression>
            </validationRule>
        </fields>
    </screens>
    <screens>
        <name>screenCaseRequisition</name>
        <label>screenCaseRequisition</label>
        <locationX>5</locationX>
        <locationY>5</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>createUserRole</targetReference>
        </connector>
        <fields>
            <name>Manager_Role_Name</name>
            <dataType>String</dataType>
            <fieldText>Manager Role Name (Include &quot;Manager&quot; at end)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <validationRule>
                <errorMessage>Please add &quot;Manager&quot; to the end of your role name.</errorMessage>
                <formulaExpression>CONTAINS({!Manager_Role_Name}, &quot;Manager&quot;)</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>DisplaySpace1</name>
            <fieldText>eg: ASU Service Manager</fieldText>
            <fieldType>DisplayText</fieldType>
