didUnsub=sforce.apex.execute("et4ae5/jsButtonMethods","performUnsub", {subscriberKey:pacId,objectType:"contact"});
}
catch (e)
{
pacId=sforce.apex.execute("jsButtonMethods","getPACId", {acctId:"{!CASESAFEID( Account.Id )}"}); 
didUnsub=sforce.apex.execute("jsButtonMethods","performUnsub", {subscriberKey:pacId,objectType:"contact"});
}
if (didUnsub=="connection error")
{
alert("The connection to Marketing Cloud is currently unavailable. Try your request again later. If the problem persists, please contact your system administrator.");
}
else if (didUnsub=="not found")
{
alert("This subscriber could not be found in the All Subscriber List in Marketing Cloud. The Email Opt Out flag will not be updated.");
}
else if (didUnsub=="other error")
{
alert("An unexpected error has been encountered. The Email Opt Out flag will not be updated.");
}
else if (didUnsub=="not integrated")
{
