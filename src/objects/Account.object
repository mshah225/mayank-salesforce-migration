    <validationRules>
        <fullName>Billing_City_and_Website_Required_on_Acc</fullName>
        <active>false</active>
        <description>Errors if the Billing City or Website are not entered on account.  Used for Data.com integrity.</description>
        <errorConditionFormula>AND( 
$User.ProfileId &lt;&gt; '00ed00000017Iob',
OR(ISBLANK(Website),ISBLANK(BillingCity)), 
NOT(ISPICKVAL(Type, 'Institution')), 
OR(RecordTypeId = '012d0000000wzM1', RecordTypeId = '012d0000000wzM3') 
) 

/*Excludes Sys Admin profile, includes SF Mastered Org and External Mastered Org RT's*/</errorConditionFormula>
        <errorMessage>Please ensure this account has a billing city and website.</errorMessage>
    </validationRules>
