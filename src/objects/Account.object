    <webLinks>
        <fullName>et4ae5__Send_ExactTarget_Email</fullName>
        <availability>online</availability>
        <displayType>link</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Send Marketing Cloud Email</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT("/soap/ajax/19.0/connection.js")}
{!REQUIRESCRIPT("/soap/ajax/15.0/apex.js")}
try
{
var urlPrefix = sforce.apex.execute("et4ae5/jsButtonMethods","namespace", {});
var pacId=sforce.apex.execute("et4ae5/jsButtonMethods","getPACId", {acctId:"{!CASESAFEID( Account.Id )}"});
var theUrl = "https://"+urlPrefix+"/apex/singleSendETEmail?contactId="+pacId;
var npaUrl = parent.location.href;
if(pacId=="error")
{
parent.location.href = npaUrl;
}
else
{
parent.location.href = theUrl;
}
}
catch(e)
{
var pacId=sforce.apex.execute("jsButtonMethods","getPACId", {acctId:"{!CASESAFEID( Account.Id )}"});
var theUrl = "/apex/singleSendETEmail?contactId="+pacId;
var npaUrl = parent.location.href;
if(pacId=="error")
{
parent.location.href = npaUrl;
}
else
{
parent.location.href = theUrl;
}
}</url>
    </webLinks>
