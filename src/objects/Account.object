    <webLinks>
        <fullName>et4ae5__ExactTarget_Resubscribe</fullName>
        <availability>online</availability>
        <displayType>link</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Marketing Cloud Resubscribe</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT("/soap/ajax/19.0/connection.js")}
{!REQUIRESCRIPT("/soap/ajax/15.0/apex.js")}
var pacId, didResub;
try
{
pacId=sforce.apex.execute("et4ae5/jsButtonMethods","getPACId", {acctId:"{!CASESAFEID( Account.Id )}"}); 
didResub=sforce.apex.execute("et4ae5/jsButtonMethods","performResub", {subscriberKey:pacId,objectType:"contact"});
}
catch (e)
{
pacId=sforce.apex.execute("jsButtonMethods","getPACId", {acctId:"{!CASESAFEID( Account.Id )}"}); 
didResub=sforce.apex.execute("jsButtonMethods","performResub", {subscriberKey:pacId,objectType:"contact"});
}
if (didResub=="connection error")
{
alert("The connection to Marketing Cloud is currently unavailable. Try your request again later. If the problem persists, please contact your system administrator.");
}
else if (didResub=="not found")
{
alert("This subscriber could not be found in the All Subscriber List in Marketing Cloud. The Email Opt Out flag will not be updated.");
}
else if (didResub=="other error")
{
alert("An unexpected error has been encountered. The Email Opt Out flag will not be updated.");
}
else if (didResub=="not integrated")
{
alert("You must be integrated with Marketing Cloud to update an Marketing Cloud subscriber.");
}
else if (didResub=="success")
{
alert("{!Account.Name} was resubscribed successfully.");
} 
var theUrl="/{!Account.Id}";
parent.location.href=theUrl;</url>
    </webLinks>
    <webLinks>
        <fullName>et4ae5__ExactTarget_Unsubscribe</fullName>
