    <webLinks>
        <fullName>silverpop__Send_Silverpop_Email</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Send Silverpop Email</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>//Display new window 90% of height

var contactnumber = {!FLOOR(Campaign.NumberOfContacts)};
var leadnumber = {!FLOOR(Campaign.NumberOfLeads)};

if ( !{!ISNULL( Campaign.silverpop__Silverpop_ID__c )}  || !{!ISBLANK( Campaign.silverpop__Silverpop_ID__c )} ) {

    alert('This Campaign is already associated with a Silverpop Sent Email. Create a new Campaign to send another Silverpop Email.');

} else if ((contactnumber &lt;= 0) &amp;&amp; (leadnumber &lt;= 0)) {
      
     alert('This Campaign must have at least one member before an email can be sent.');   
        
} else {
     window.open('/apex/silverpop__SP_EngageCampaignLogin?id={!Campaign.Id}', '_blank', 
    'height=700,width=1024,location=0,resizable=0,toolbar=0,status=0,menubar=no,scrollbars=1');

}</url>
    </webLinks>
