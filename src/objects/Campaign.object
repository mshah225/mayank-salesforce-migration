    <validationRules>
        <fullName>Admission_Services_Event_Types</fullName>
        <active>false</active>
        <description>Only users in Admission Services can create the following Campaign Types: Admission Services, Admission Services Recruiter Events, Admission Services Visit Managed.</description>
        <errorConditionFormula>AND(ISNEW(),
 OR(
  ISPICKVAL(Type, 'Admission Services'),
  ISPICKVAL(Type, 'Admission Services Recruiter Events'),
  ISPICKVAL(Type, 'Admission Services Visit Managed')
 ),
 NOT(
  OR(
   $Setup.Recruitment_Profiles__c.Bypass_Recruitment_Validation_Rules__c,
NOT( $Setup.Validation_Rule_Exception__c.Run_Validation_Rule__c )
  )
 )
)</errorConditionFormula>
        <errorDisplayField>Type</errorDisplayField>
        <errorMessage>This Event type is for Admission Services users only. Please select a different Campaign Event type.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>EventStartMustBeBeforeEnd</fullName>
        <active>false</active>
        <description>The start date time must be before end date time</description>
        <errorConditionFormula>Event_Start_Date__c &gt; Event_End_Date__c</errorConditionFormula>
        <errorDisplayField>Event_End_Date__c</errorDisplayField>
        <errorMessage>The Event Start Date must be before the event end date.  Please make necessary change and try again.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Event_End_Time_Format_is_Incorrect</fullName>
        <active>true</active>
        <errorConditionFormula>NOT(
OR(
LEN ( Event_End_Time__c ) = 0,
or (REGEX( Event_End_Time__c , "[1-9]{1}:[0-5]{1}[0,5]{1} [a.m.,p.m.]{4}"),
(REGEX( Event_End_Time__c , "[1]{1}[0-1]{1}:[0-5]{1}[0,5]{1} [a.m.,p.m.]{4}")),
(REGEX( Event_End_Time__c ,"[1]{1}[2]{1}:[0-5]{1}[0,5]{1} [a.m.,p.m.]{4}")),
(REGEX( Event_End_Time__c , "[1-9]{1} [a.m.,p.m.]{4}")),
(REGEX( Event_End_Time__c , "[1]{1}[0-1]{1} [a.m.,p.m.]{4}")),
(REGEX (Event_End_Time__c, "[a-z]{4}")))))</errorConditionFormula>
        <errorDisplayField>Event_End_Time__c</errorDisplayField>
        <errorMessage>Use the ASU Communication Guide styles (e.g.  10 a.m. - noon - 1:30 p.m.), 5 minute increments only. https://commguide.asu.edu/standards/writing/days</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Event_Start_Time_Format_is_Incorrect</fullName>
        <active>true</active>
        <description>Use the ASU Communication Guide styles (e.g 10 a.m, noon, 1:30 p.m.), 15 minute increments only. See https://commguide.asu.edu/standards/writing/days</description>
        <errorConditionFormula>NOT(
OR(
LEN ( Event_Start_Time__c ) = 0,
or (REGEX( Event_Start_Time__c , "[1-9]{1}:[0-5]{1}[0,5]{1} [a.m.,p.m.]{4}"),
(REGEX( Event_Start_Time__c , "[1]{1}[0-1]{1}:[0-5]{1}[0,5]{1} [a.m.,p.m.]{4}")),
(REGEX( Event_Start_Time__c ,"[1]{1}[2]{1}:[0-5]{1}[0,5]{1} [a.m.,p.m.]{4}")),
(REGEX( Event_Start_Time__c , "[1-9]{1} [a.m.,p.m.]{4}")),
(REGEX( Event_Start_Time__c , "[1]{1}[0-1]{1} [a.m.,p.m.]{4}")),
(REGEX (Event_Start_Time__c, "[a-z]{4}")))))</errorConditionFormula>
        <errorDisplayField>Event_Start_Time__c</errorDisplayField>
        <errorMessage>Use the ASU Communication Guide styles (e.g.  10 a.m. - noon - 1:30 p.m.), 5 minute increments only. https://commguide.asu.edu/standards/writing/days</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Registration_Time_format_is_Incorrect</fullName>
        <active>true</active>
        <errorConditionFormula>NOT(
OR(
LEN ( Registration_Time__c) = 0,
or (REGEX( Registration_Time__c , "[1-9]{1}:[0-5]{1}[0,5]{1} [a.m.,p.m.]{4}"),
(REGEX( Registration_Time__c , "[1]{1}[0-1]{1}:[0-5]{1}[0,5]{1} [a.m.,p.m.]{4}")),
(REGEX( Registration_Time__c ,"[1]{1}[2]{1}:[0-5]{1}[0,5]{1} [a.m.,p.m.]{4}")),
(REGEX( Registration_Time__c , "[1-9]{1} [a.m.,p.m.]{4}")),
(REGEX( Registration_Time__c , "[1]{1}[0-1]{1} [a.m.,p.m.]{4}")),
(REGEX (Registration_Time__c, "[a-z]{4}")))))</errorConditionFormula>
        <errorDisplayField>Registration_Time__c</errorDisplayField>
        <errorMessage>Use the ASU Communication Guide styles (e.g 10 a.m, noon, 1:30 p.m.), 5 minute increments only. https://commguide.asu.edu/standards/writing/days</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_DepartmentCollege</fullName>
        <active>true</active>
        <description>Require "Department/College" on College Department Event Types</description>
        <errorConditionFormula>AND(
RecordType.Name = 'Event',
ISPICKVAL(Type, 'College Department Events'),
ISBLANK(Requested__c)  
)</errorConditionFormula>
        <errorDisplayField>Requested__c</errorDisplayField>
        <errorMessage>If this is a College Department Event, then Department / College cannot be left blank.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Subscription_Center_MC_BU_is_not_blank</fullName>
        <active>true</active>
        <description>If the campaign is for the subscription center, then make sure the business unit field is not blank.</description>
        <errorConditionFormula>AND(
RecordType.Name = 'Subscription Center',
ISBLANK( Marketing_Cloud_Business_Unit__c )
)</errorConditionFormula>
        <errorMessage>Please enter in a Marketing Cloud Business Unit.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Subscription_Center_MC_VisibleOnSubPage</fullName>
        <active>true</active>
        <description>If the campaign is for the subscription center, then make sure the Marketing_Cloud_Private_Campaign__c and Visible_on_Subscription_Center__c are not true at the same time.</description>
        <errorConditionFormula>AND(
RecordType.Name = 'Subscription Center',
 Marketing_Cloud_Private_Campaign__c ,
 Visible_on_Subscription_Center__c 
)</errorConditionFormula>
        <errorMessage>You need to modify your campaign - it cannot be both private and visible on subscription center page at the same time. It should be private OR visible on subscription page.</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>Mass_Delete</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Mass Delete</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>{!REQUIRESCRIPT("/soap/ajax/9.0/connection.js")} 

var records = {!GETRECORDIDS(  $ObjectType.Campaign  )}; 

if (records[0] == null) { 
alert("Please select at least one record.") } 
else { 

var errors = []; 
var result = sforce.connection.deleteIds(records); 
if (result &amp;&amp; result.length){ 
var numFailed = 0; 
var numSucceeded = 0; 
for (var i = 0; i &lt; result.length; i++){ 
var res = result[i]; 
if (res &amp;&amp; res.success == 'true'){ 
numSucceeded++; 
} else { 
var es = res.getArray("errors"); 
if (es.length &gt; 0) { 
errors.push(es[0].message); 
} 
numFailed++; 
} 
} 
if (numFailed &gt; 0){ 
alert("Failed: " + numFailed + "\nSucceeded: " + numSucceeded + " \n Due to: " + errors.join("\n")); 
} else { 
alert("Number of records deleted: " + numSucceeded); 
} 
} 
window.location.reload(); 
}</url>
    </webLinks>
