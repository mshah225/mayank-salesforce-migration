    <recordTypes>
        <fullName>Cohort</fullName>
        <active>true</active>
        <description>Record type used to group Leads and Contacts into specific constituent groups.</description>
        <label>Cohort</label>
        <picklistValues>
            <picklist>CBO__c</picklist>
            <values>
