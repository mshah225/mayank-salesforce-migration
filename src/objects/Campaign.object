    <fields>
        <fullName>Number_Available__c</fullName>
        <description>The number of registrations available according to Capacity less Number Registered/Attended Attendees.</description>
        <externalId>false</externalId>
        <formula>Capacity__c -  Number_Registered_Attended_Attendees__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>The number of registrations available according to Capacity less Number Registered/Attended Attendees.</inlineHelpText>
        <label>Number Available</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Number_Registered_Attended_Attendees__c</fullName>
        <externalId>false</externalId>
        <formula>Number_Registered_Attended_Guests__c + Number_Registered_Attended_Participants__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>The Number Registered/Attended Participants + Number Registered/Attended Guests</inlineHelpText>
        <label>Number Registered/Attended Attendees</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Number_Registered_Attended_Guests__c</fullName>
        <description>The sum of the Number of Guests at any of the following Statuses: Applicant, Attendee, Completer, Not Registered - Attended, Participant, Registered, Registered - Attended, Saver</description>
        <externalId>false</externalId>
        <inlineHelpText>The sum of the Number of Guests at any of the following Statuses: Applicant, Attendee, Completer, Not Registered - Attended, Participant, Registered, Registered - Attended, Saver</inlineHelpText>
        <label>Number Registered/Attended Guests</label>
        <summarizedField>CampaignMember.Number_of_Guests__c</summarizedField>
        <summaryFilterItems>
            <field>CampaignMember.Status</field>
            <operation>equals</operation>
            <value>The sum of the Number of Guests at any of the following Statuses: Applicant, Attendee, Completer, Not Registered - Attended, Participant, Registered, Registered - Attended, Saver</value>
        </summaryFilterItems>
        <summaryForeignKey>CampaignMember.CampaignId</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Number_Registered_Attended_Participants__c</fullName>
        <description>The sum of the Number of Participants (e.g Students) at any of the following Statuses: Applicant, Attendee, Completer, Not Registered - Attended, Participant, Registered, Registered - Attended, Saver</description>
        <externalId>false</externalId>
        <inlineHelpText>The sum of the Number of Participants (e.g Students) at any of the following Statuses: Applicant, Attendee, Completer, Not Registered - Attended, Participant, Registered, Registered - Attended, Saver</inlineHelpText>
        <label>Number Registered/Attended Participants</label>
        <summaryFilterItems>
            <field>CampaignMember.Status</field>
            <operation>equals</operation>
            <value>The sum of the Number of Guests at any of the following Statuses: Applicant, Attendee, Completer, Not Registered - Attended, Participant, Registered, Registered - Attended, Saver</value>
        </summaryFilterItems>
        <summaryForeignKey>CampaignMember.CampaignId</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
