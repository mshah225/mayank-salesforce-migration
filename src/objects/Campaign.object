        <fullName>et4ae5__Send_ExactTarget_Email</fullName>
        <availability>online</availability>
        <displayType>link</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Send Marketing Cloud Email</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT("/soap/ajax/19.0/connection.js")}
{!REQUIRESCRIPT("/soap/ajax/15.0/apex.js")}
try
{
var urlPrefix = sforce.apex.execute("et4ae5/jsButtonMethods","namespace", {});
var theUrl = "https://"+urlPrefix+"/apex/singleSendETEmail?campaignId={!CASESAFEID( Campaign.Id )}";
parent.location.href = theUrl;
}
catch (e)
{
var theUrl = "/apex/singleSendETEmail?campaignId={!CASESAFEID( Campaign.Id )}";
parent.location.href = theUrl;
}</url>
