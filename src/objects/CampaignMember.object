    <fields>
        <fullName>Max_Modified_Date__c</fullName>
        <description>If there is no Contact, we know this is a lead, so evaluate for the most recently updated amongst Campaign Member, Campaign, and Lead when Campaign Record Type equals Interest

If there is no Lead, we can only evaluate for the most recently updated between Campaign Member, Campaign, and Opportunity when Campaign Record Type equals Interest

Else, evaluate for the most recently updated between Campaign Member and Campaign</description>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(ContactId)&amp;&amp; Campaign.RecordType.DeveloperName = "Interest",

NOW() - MIN( NOW() - LastModifiedDate , NOW() - Campaign.LastModifiedDate, NOW() - Lead.LastModifiedDate),
IF(ISBLANK(LeadId)&amp;&amp; Campaign.RecordType.DeveloperName = "Interest",

NOW() - MIN( NOW() - LastModifiedDate , NOW() - Campaign.LastModifiedDate, NOW() - Opportunity__r.LastModifiedDate),

NOW() - MIN( NOW() - LastModifiedDate , NOW() - Campaign.LastModifiedDate)))</formula>
        <inlineHelpText>Displays last modified date of either the Campaign Member or Campaign</inlineHelpText>
        <label>Max Modified Date</label>
        <required>false</required>
        <type>DateTime</type>
    </fields>
