    </fields><fields xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Campaign_Member_Source__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(Campaign_Member_Explicit_Source__c),
IF(OR(ISPICKVAL(Campaign.Source_Type__c,"Internal"),ISPICKVAL(Campaign.Source_Type__c,"External")),
CampaignId,"NO SOURCE"),Campaign_Member_Explicit_Source__c)</formula>
        <inlineHelpText>The ID of the Campaign Member Explicit Source or of the Campaign associated to this Campaign Member if that Campaign has a Source Type of Internal or External.</inlineHelpText>
        <label>Campaign Member Source</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields><fields xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Campaign_Member_Upsert_ID__c</fullName>
