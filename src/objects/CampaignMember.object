        <inlineHelpText>Set to the &lt;&lt;CampaignID&gt;&gt;.&lt;&lt;ContactID OR LeadID&gt;&gt;</inlineHelpText>
        <label>Campaign Member Upsert ID</label>
        <length>31</length>
        <required>false</required>
