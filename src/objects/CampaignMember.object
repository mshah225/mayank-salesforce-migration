    <fields>
        <fullName>Campaign_Member_Explicit_Source__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <externalId>false</externalId>
        <inlineHelpText>If the Source is not implicit for this Campaign Member (e.g. load of purchased names), a Source should be identified here.</inlineHelpText>
        <label>Campaign Member Explicit Source</label>
        <referenceTo>Campaign</referenceTo>
        <relationshipLabel>Campaign Members (Source)</relationshipLabel>
        <relationshipName>Campaign_Members</relationshipName>
        <required>false</required>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Campaign_Member_Source__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(Campaign_Member_Explicit_Source__c),
IF(OR(ISPICKVAL(Campaign.Source_Type__c,"Internal"),ISPICKVAL(Campaign.Source_Type__c,"External")),
CampaignId,"NO SOURCE"),Campaign_Member_Explicit_Source__c)</formula>
        <inlineHelpText>The ID of the Campaign Member Explicit Source or of the Campaign associated to this Campaign Member if that Campaign has a Source Type of Internal or External.</inlineHelpText>
        <label>Campaign Member Source</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
