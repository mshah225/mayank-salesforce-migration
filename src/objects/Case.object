    </recordTypes><validationRules xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Disallow_Illegal_Characters_on_Email</fullName>
        <active>false</active>
        <description>If an outbound Email is sent that contains "__", "&lt;&lt;", or "&gt;&gt;" (indicating information the individual sending the email should fill out), the "Illegal Characters In Outbound Email" is set to True, activating this rule.</description>
        <errorConditionFormula>Illegal_Characters_In_Outbound_Email__c</errorConditionFormula>
        <errorMessage>An attempt was made to send outbound email that contains "__",  "&lt;&lt;", or "&gt;&gt;". These brackets are used to indicate information the staff sending the email should fill out. Please edit the email, and send again.</errorMessage>
    </validationRules><validationRules xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Fee_Waiver_Status</fullName>
        <active>true</active>
        <description>A Fee Waiver related Processing Status must be selected if Fee Waiver is set as the Sub-Category, the Case is part of the NAS process and is Closed.</description>
        <errorConditionFormula>AND( 
$RecordType.Name="ASU Admission Services", 
ISPICKVAL(Sub_Category__c, "Fee Waiver Inquiry"), 
NOT ISPICKVAL(Processing_Status__c, "Approved"), 
NOT ISPICKVAL(Processing_Status__c, "Approved - by Recruiter"),
NOT ISPICKVAL (Processing_Status__c, "Received - App Fee Paid"),
NOT ISPICKVAL (Processing_Status__c, "Received - Missing Info"),
NOT ISPICKVAL (Processing_Status__c, "Received - Needs to Apply/Re-Apply"),
NOT ISPICKVAL (Processing_Status__c, "Received - Not Applicable"), 
Needs_Attention__c,
OR ( 
ISPICKVAL (Status, "Closed: Resolved"), 
ISPICKVAL (Status, "Closed: Customer Self-Resolved"), 
ISPICKVAL (Status, "Closed: Customer Unresponsive") 
))</errorConditionFormula>
        <errorMessage>A Fee Waiver related Processing Status must be selected if Fee Waiver is set as the Sub-Category, the Case is part of the NAS process and is Closed.</errorMessage>
    </validationRules><validationRules xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Major_Change_Status</fullName>
        <active>true</active>
        <description>A Major Change related Processing Status (Approved or Not Approved) must be selected if Major Change is set as the Sub-Category, the Case is part of the NAS process and is Closed.</description>
        <errorConditionFormula>AND($RecordType.Name = "ASU Admission Services",
		NOT(ISBLANK(TEXT(Processing_Status__c))),
		NOT(
				OR(	ISPICKVAL(Sub_Category__c, "Major Change"),
		 			ISPICKVAL(Sub_Category__c, "Fee Waiver Inquiry")
		 			)
 			),
		NOT(
			OR(	ISPICKVAL (Status, "Closed: Resolved"),
				ISPICKVAL (Status, "Closed: Customer Self-Resolved"), 
				ISPICKVAL (Status, "Closed: Customer Unresponsive")
				)
			)
		)</errorConditionFormula>
        <errorDisplayField>Processing_Status__c</errorDisplayField>
        <errorMessage>A Major Change or Fee-Waiver related Processing Status (Approved or Not Approved) must be selected if Major Change or Fee Waiver is set as the Sub-Category, the Case is part of the NAS process and is Closed.</errorMessage>
    </validationRules><validationRules xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Require_Campus_for_Registrar</fullName>
        <active>false</active>
        <description>Require the Service Location picklist value when Registrar is selected for Functional Group</description>
        <errorConditionFormula>AND(
   ISPICKVAL( Functional_Group__c , "Registrar"),
   ISPICKVAL( Origin__c , "In Person"),
   ISBLANK( TEXT( Campus__c ) )  
)</errorConditionFormula>
        <errorDisplayField>Campus__c</errorDisplayField>
        <errorMessage>Please select a Location where the service is taking place.</errorMessage>
    </validationRules><validationRules xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Require_Campus_for_Tech_Studio</fullName>
        <active>true</active>
        <description>Require the Service Location picklist value when Tech Studio is selected for Functional Group</description>
        <errorConditionFormula>AND(
   ISPICKVAL( Functional_Group__c , "Tech Studio"),
   ISBLANK( TEXT( Campus__c ) )  
)</errorConditionFormula>
        <errorDisplayField>Campus__c</errorDisplayField>
        <errorMessage>Please select a Location where the service is taking place.</errorMessage>
    </validationRules><validationRules xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Require_Email_for_Closed_Forwarded</fullName>
        <active>true</active>
        <description>Forward Case To Email</description>
        <errorConditionFormula>ISPICKVAL(Status,"Closed: Forwarded")
&amp;&amp;
ISBLANK(Forward_To_Email__c)
&amp;&amp;
ISBLANK(Forward_To_Email_Calculation__c)</errorConditionFormula>
        <errorMessage>A "Closed: Forwarded" Case must have a recipient. Either Select a "Forward to Unit" or enter a "Forward To Email".</errorMessage>
    </validationRules><validationRules xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Require_Future_Followup_Date</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
 RecordTypeId = '012d00000021xGK',
 ISNEW(),
 Followup_Date__c &lt; DATEVALUE(NOW()) 
)</errorConditionFormula>
        <errorDisplayField>Followup_Date__c</errorDisplayField>
        <errorMessage>You have selected a Followup Date that has already passed. Please select a future date.</errorMessage>
    </validationRules><validationRules xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Require_Reasons_Not_Returning</fullName>
        <active>true</active>
        <description>The Reasons Not Returning must have a value if Type is "Continued Enrollment" and Student's Intension is "Not Returning"</description>
        <errorConditionFormula>AND(
  ISBLANK( Reasons_Not_Returning__c ),
  ISPICKVAL( Type , "Continued Enrollment"),
  OR(
    ISPICKVAL(Student_Intention__c,"Not returning ever"),
    ISPICKVAL(Student_Intention__c,"Not returning temporarily")
  ),
  RecordTypeId = '012d00000021xGK'
)</errorConditionFormula>
        <errorDisplayField>Reasons_Not_Returning__c</errorDisplayField>
        <errorMessage>Reason(s) Not Returning is required when Student's Intention is "Not returning" and Type is "Continued Enrollment"</errorMessage>
    </validationRules><validationRules xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Require_Reasons_Not_Returning_Other</fullName>
        <active>true</active>
        <description>Reasons Not Returning Other must have a value if "Other" is a selected option in the Reasons Not Returning field.</description>
        <errorConditionFormula>AND(
  ISBLANK( Reasons_Not_Returning_Other__c ),
  ISPICKVAL( Type , "Continued Enrollment"),
  OR(
    ISPICKVAL( Student_Intention__c ,"Not returning ever"),
    ISPICKVAL( Student_Intention__c ,"Not returning temporarily")
  ),
  INCLUDES( Reasons_Not_Returning__c ,"Other"),
  RecordTypeId = '012d00000021xGK'
)</errorConditionFormula>
        <errorDisplayField>Reasons_Not_Returning_Other__c</errorDisplayField>
        <errorMessage>Reasons Not Returning Other is required when the Student's Intention is "Not returning" and a Reason Not Returning is "Other"</errorMessage>
    </validationRules><validationRules xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Require_Recommended_Actions</fullName>
        <active>true</active>
        <description>The Recommended Actions field must have a value if "Continued Enrollment" is the type.</description>
        <errorConditionFormula>AND(
 ISBLANK( Recommended_Actions__c),
 OR(
  ISPICKVAL( Status , 'Conferred with Student by Phone'),
  ISPICKVAL( Status , 'Conferred with Student by Email'),
  ISPICKVAL( Status , 'In Person Meeting')
 ),
 RecordTypeId = '012d00000021xGK'
)</errorConditionFormula>
        <errorDisplayField>Recommended_Actions__c</errorDisplayField>
        <errorMessage>Recommended Action(s) is required.</errorMessage>
    </validationRules><validationRules xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Require_Recommended_Actions_Other</fullName>
        <active>true</active>
        <description>The Recommended Actions Other field must have a value if "Other" is a selected option in the Recommended Actions field.</description>
        <errorConditionFormula>AND(
  ISBLANK( Recommended_Actions_Other__c ), 
  INCLUDES( Recommended_Actions__c , 'Other')
)</errorConditionFormula>
        <errorDisplayField>Recommended_Actions_Other__c</errorDisplayField>
        <errorMessage>Recommended Actions Other is required when Recommended Actions is "Other".</errorMessage>
    </validationRules><validationRules xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Require_Student_Intentions</fullName>
        <active>true</active>
        <description>Checks Type and Student Intention to be entered.</description>
        <errorConditionFormula>AND(
RecordTypeId = '012d00000021xGK',
ISPICKVAL( Type , "Continued Enrollment"),
OR(ISPICKVAL(Status,"Conferred with Student by Email"),
ISPICKVAL(Status,"Conferred with Student by Phone"),
ISPICKVAL(Status,"In Person Meeting"),
ISPICKVAL(Status,"Closed: Self Resolved")),
ISBLANK(  TEXT(Student_Intention__c)   )
)</errorConditionFormula>
        <errorDisplayField>Student_Intention__c</errorDisplayField>
        <errorMessage>Please enter in a Student's Intention for this student.</errorMessage>
    </validationRules><validationRules xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Require_Student_Presented_Risk_For</fullName>
        <active>true</active>
        <description>The Student Presented Risk For field must have a value if "Will Enroll" is a selected option in Student's Intention.</description>
        <errorConditionFormula>AND( 
  ISPICKVAL( Type , 'Continued Enrollment'), 
  ISPICKVAL( Student_Intention__c , 'Will Enroll'), 
  ISBLANK( TEXT( Student_Presented_Risk_for__c ) ),
  RecordTypeId = '012d00000021xGK'
)</errorConditionFormula>
        <errorDisplayField>Student_Presented_Risk_for__c</errorDisplayField>
        <errorMessage>Student Presented Risk For is required when selecting 'Will Enroll" from Student Intention</errorMessage>
    </validationRules><validationRules xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Require_Student_Presented_Risk_For_Other</fullName>
        <active>true</active>
        <description>The Student Presented Risk For Other field must have a value if "Other" is a selected option in the Student Presented Risk For field.</description>
        <errorConditionFormula>AND(
 ISBLANK( Student_Presented_Risk_for_Other__c ),
 ISPICKVAL( Student_Presented_Risk_for__c , 'Other')
)</errorConditionFormula>
        <errorDisplayField>Student_Presented_Risk_for_Other__c</errorDisplayField>
        <errorMessage>Student Presented Risk for Other is required when Student Presented Risk for is "Other"</errorMessage>
    </validationRules><validationRules xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Require_Subject_and_Description</fullName>
        <active>true</active>
        <description>Requires a Subject and Description to be entered on manually created cases, or cases edited by users post-automatic creation.</description>
        <errorConditionFormula>AND($Profile.Id &lt;&gt; '00ed00000017Iob', OR(ISBLANK(Subject),ISBLANK(Description)
   )
)</errorConditionFormula>
        <errorMessage>The case you are trying to close is missing either a Subject or Description. Please go back, click the Edit button, enter an applicable subject and/or description, then click Save. These two fields will appear in the Student Service Center.</errorMessage>
    </validationRules><validationRules xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Require_Term_Returning</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
 RecordTypeId = '012d00000021xGK',
 ISPICKVAL( Type , 'Continued Enrollment'),
 ISPICKVAL( Student_Intention__c , 'Not Returning Temporarily'),
 OR(
  ISPICKVAL( What_term_is_the_student_planning_to_ret__c, '' ),
  ISPICKVAL( What_term_is_the_student_planning_to_ret__c, '--None--' )
 ) 
)</errorConditionFormula>
        <errorDisplayField>What_term_is_the_student_planning_to_ret__c</errorDisplayField>
        <errorMessage>Term Returning is required when the Student's Intention is "Not Returning Temporarily"</errorMessage>
    </validationRules><validationRules xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Required_Fields_on_Close_for_Tech_Studio</fullName>
        <active>true</active>
        <description>Require Category, Sub-category, and Service Location picklist values when Tech Studio is selected for Functional Group.</description>
        <errorConditionFormula>AND(
      OR(
          ISPICKVAL( Status , "Closed: Customer Self-Resolved"),
          ISPICKVAL( Status , "Closed: Customer Unresponsive"),
          ISPICKVAL( Status , "Closed: Resolved")          
          ),
      ISPICKVAL( Functional_Group__c , "Tech Studio"),
      OR(
          ISBLANK( TEXT( Campus__c )),
          ISBLANK( TEXT( Category__c )),
          ISBLANK( TEXT( Sub_Category__c ))
          )
)</errorConditionFormula>
        <errorMessage>The following fields are required to close this case: Service Location, Category, and Sub-Category.</errorMessage>
    </validationRules><validationRules xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Sub_Category_required_when_NAS_is_True</fullName>
        <active>false</active>
        <description>A Sub-Category must be selected when the Needs Attention checkbox is set to true.</description>
        <errorConditionFormula>AND (
     RecordType.Name = 'ASU Admission Services',
     Needs_Attention__c  = TRUE,
    ISBLANK(TEXT( Sub_Category__c ))
    )</errorConditionFormula>
        <errorDisplayField>Sub_Category__c</errorDisplayField>
        <errorMessage>Please provide a Sub-Category when record is marked as Needs Attention (NAS).</errorMessage>
    </validationRules><webLinks xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Admission_Services_Case_Opportunity</fullName>
        <availability>online</availability>
        <description>Custom button for Opportunity Page Layout related list to allow for Undergraduate Admission Services to create a quick case.</description>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <linkType>url</linkType>
        <masterLabel>New Case</masterLabel>
        <openType>replace</openType>
        <protected>false</protected>
        <requireRowSelection>false</requireRowSelection>
        <url>/500/e?retURL={!Opportunity.Id}
&amp;
RecordType=012d0000000x6giAAA
&amp;
cas3_lkid={!Opportunity.ContactId__c}
&amp;
CF00Nd0000007uduP={!Opportunity.Name}
&amp;
CF00Nd0000007uduP_lkid={!Opportunity.Id}</url>
    </webLinks><webLinks xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Close_Spam</fullName>
        <availability>online</availability>
        <description>Closes case as SPAM and ensures that Subject and Description are populated</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Close Spam</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT("/soap/ajax/29.0/connection.js")}

var c = new sforce.SObject("Case"); 
var currentCase = sforce.connection.query("SELECT Subject, Description FROM Case WHERE Id = '{!Case.Id}'");
var records = currentCase.getArray("records");

c.Id = "{!Case.Id}"; 
c.Status = "Closed: SPAM";
c.Subject = "SPAM: " + records[0].Subject;
c.Description = "SPAM: " + records[0].Description;

sforce.connection.update([c]);
window.location.reload();</url>
    </webLinks><webLinks xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Mass_Delete</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Mass Delete</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>{!REQUIRESCRIPT("/soap/ajax/9.0/connection.js")}

var records = {!GETRECORDIDS(  $ObjectType.Case  )};

if (records[0] == null) {
alert("Please select at least one record.") }
else {

var errors = [];
var result = sforce.connection.deleteIds(records);
if (result &amp;&amp; result.length){
var numFailed = 0;
var numSucceeded = 0;
for (var i = 0; i &lt; result.length; i++){
var res = result[i];
if (res &amp;&amp; res.success == 'true'){
numSucceeded++;
} else {
var es = res.getArray("errors");
if (es.length &gt; 0) {
errors.push(es[0].message);
}
numFailed++;
}
}
if (numFailed &gt; 0){
alert("Failed: " + numFailed + "\nSucceeded: " + numSucceeded + " \n Due to: " + errors.join("\n"));
} else {
alert("Number of records deleted: " + numSucceeded);
}
}
window.location.reload();
}</url>
    </webLinks><webLinks xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Start_Chat</fullName>
        <availability>online</availability>
        <description>Starts a chat with the student about this Case.</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Start Chat</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!requireScript("/support/console/38.0/integration.js")}
{!requireScript("/soap/ajax/38.0/connection.js")}

// Query for the base URI
sforce.connection.sessionId = '{!$Api.Session_ID}';
var result = sforce.connection.query('SELECT Id, Label, Login_Endpoint__c, Application_Base_URI__c, Authorization_Key__c, Username__c, Password__c FROM Rest_Service_Setting__mdt WHERE DeveloperName = \'RocketChat_API_Settings\'');
var contactId = '{!Case.ContactId}';
var contactName = '{!Case.Contact}';
var asuRiteId = '{!Contact.ASURite_ID__c}';
var chatURI = result.getArray('records')[0].Application_Base_URI__c + asuRiteId;

if (sforce.console.isInConsole()) {

    var openSubtab = function(result) {
        sforce.console.openSubtab(result.id, chatURI, true, 'Pitch Chat - ' + contactName, null);
    };

    sforce.console.getEnclosingPrimaryTabId(openSubtab);
}</url>
    </webLinks><webLinks xmlns="http://soap.sforce.com/2006/04/metadata">
