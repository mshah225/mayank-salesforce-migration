        <fullName>Case_Link__c</fullName>
        <externalId>false</externalId>
        <formula>LEFT($Api.Partner_Server_URL_260, FIND( '/services', $Api.Partner_Server_URL_260)) + '/' + Id</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Case Link</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields><fields xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Case_Owner__c</fullName>
        <externalId>false</externalId>
        <formula>IF(NOT(ISBLANK(Owner:User.FirstName)), 
HYPERLINK(Owner:User.Id,Owner:User.FirstName + " " + Owner:User.LastName),
IF(NOT(ISBLANK(Owner:Queue.Name)),
HYPERLINK(Owner:Queue.Id,Owner:Queue.Name),
""))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Case Record Owner</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
