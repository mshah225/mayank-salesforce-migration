        <fullName>Case_Survey_Sent_Date__c</fullName>
        <description>The date and time a survey was sent to the Contact listed on this Case.</description>
        <externalId>false</externalId>
        <inlineHelpText>The date and time a survey was sent to the Contact listed on this Case.</inlineHelpText>
        <label>Case Survey Sent Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields><fields xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Case_Survey_Status__c</fullName>
        <description>Calculated based on the Date fields below:
If Case Survey Sent Date is empty = “Survey Not Sent” 
If Case Survey Sent Dates not empty AND Case Survey Received Date is empty = “Survey Sent” 
If Case Survey Received Date is not empty = “Survey Response Received”</description>
        <externalId>false</externalId>
        <formula>IF(ISNULL(Case_Survey_Sent_Date__c),'Survey Not Sent',
IF(ISNULL(Case_Survey_Received_Date__c),'Survey Sent' 
,'Survey Response Received'))</formula>
        <inlineHelpText>If Case Survey Sent Date is empty = “Survey Not Sent” 
If Case Survey Sent Dates not empty AND Case Survey Received Date is empty = “Survey Sent” 
If Case Survey Received Date is not empty = “Survey Response Received”</inlineHelpText>
        <label>Case Survey Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
