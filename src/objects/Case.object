    </fields><fields xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Call_Result__c</fullName>
        <description>Used for calling campaigns. It is the result of the call attempt. The picklist value is dependent on the Status.</description>
        <externalId>false</externalId>
        <label>Call Result</label>
        <picklist>
            <controllingField>Status</controllingField>
            <picklistValues>
                <fullName>Left Voicemail</fullName>
                <default>false</default>
                <controllingFieldValues>1st Attempt</controllingFieldValues>
                <controllingFieldValues>2nd Attempt</controllingFieldValues>
                <controllingFieldValues>Closed: Contacted 1st Attempt</controllingFieldValues>
                <controllingFieldValues>Closed: Contacted 2nd Attempt</controllingFieldValues>
                <controllingFieldValues>Closed: Contacted 3rd Attempt</controllingFieldValues>
                <controllingFieldValues>Closed: No Contact on 3rd Attempt</controllingFieldValues>
            </picklistValues>
            <picklistValues>
                <fullName>No Answer</fullName>
                <default>false</default>
                <controllingFieldValues>1st Attempt</controllingFieldValues>
                <controllingFieldValues>2nd Attempt</controllingFieldValues>
                <controllingFieldValues>Closed: Contacted 1st Attempt</controllingFieldValues>
                <controllingFieldValues>Closed: Contacted 2nd Attempt</controllingFieldValues>
                <controllingFieldValues>Closed: Contacted 3rd Attempt</controllingFieldValues>
                <controllingFieldValues>Closed: No Contact on 3rd Attempt</controllingFieldValues>
            </picklistValues>
            <picklistValues>
                <fullName>Number disconnected</fullName>
                <default>false</default>
                <controllingFieldValues>1st Attempt</controllingFieldValues>
                <controllingFieldValues>2nd Attempt</controllingFieldValues>
                <controllingFieldValues>Closed: Contacted 1st Attempt</controllingFieldValues>
                <controllingFieldValues>Closed: Contacted 2nd Attempt</controllingFieldValues>
                <controllingFieldValues>Closed: Contacted 3rd Attempt</controllingFieldValues>
                <controllingFieldValues>Closed: No Contact on 3rd Attempt</controllingFieldValues>
            </picklistValues>
            <picklistValues>
                <fullName>Spoke with 3rd Party</fullName>
