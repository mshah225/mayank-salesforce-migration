        <fullName>X1_Please_rate_the_speed_with_which_we__c</fullName>
        <description>GetFeedback: Please rate the speed with which we solved your request.</description>
        <externalId>false</externalId>
        <inlineHelpText>GetFeedback: Please rate the speed with which we solved your request.</inlineHelpText>
        <label>1 - rate the speed with which we solved</label>
        <picklist>
            <picklistValues>
                <fullName>Excellent</fullName>
                <default>false</default>
            </picklistValues>
            <picklistValues>
                <fullName>Very Good</fullName>
                <default>false</default>
            </picklistValues>
            <picklistValues>
                <fullName>Good</fullName>
                <default>false</default>
            </picklistValues>
            <picklistValues>
                <fullName>Fair</fullName>
                <default>false</default>
            </picklistValues>
            <picklistValues>
                <fullName>Poor</fullName>
                <default>false</default>
            </picklistValues>
            <picklistValues>
                <fullName>Very Poor</fullName>
                <default>false</default>
            </picklistValues>
            <sorted>false</sorted>
        </picklist>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
    </fields><fields xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>X1_speed_Number_Value__c</fullName>
        <description>Returns the survey results from "1 - rate the speed with which we solved" as a number:
"Excellent"= 6
"Very Good" = 5
"Good"= 4
"Fair" = 3
"Poor"= 2
"Very Poor" = 1
Empty responses are left blank.</description>
        <externalId>false</externalId>
        <formula>CASE(X1_Please_rate_the_speed_with_which_we__c,
'Excellent',6,
'Very Good',5,
'Good',4,
'Fair',3,
'Poor',2,
'Very Poor',1,
null)</formula>
        <inlineHelpText>Returns the survey results from "1 - rate the speed with which we solved" as a number:
"Excellent"= 6
"Very Good" = 5
"Good"= 4
"Fair" = 3
"Poor"= 2
"Very Poor" = 1
Empty responses are left blank.</inlineHelpText>
        <label>1 - speed (Number Value)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields><fields xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>X2_knowledge_Number_Value__c</fullName>
        <description>Returns the survey results from "2 - rate the knowledge and expertis" as a number:
"Excellent"= 6
"Very Good" = 5
"Good"= 4
"Fair" = 3
"Poor"= 2
"Very Poor" = 1
Empty responses are left blank.</description>
        <externalId>false</externalId>
        <formula>CASE(X2_knowledge__c,
'Excellent',6,
'Very Good',5,
'Good',4,
'Fair',3,
'Poor',2,
