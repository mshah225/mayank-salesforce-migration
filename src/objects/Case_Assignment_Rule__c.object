        <description>[??] - This is a URL created via a formula. Use this link to verify that the ID entered in the Email Template ID field accurately identifies your desired Template.</description>
        <externalId>false</externalId>
        <formula>IF(
LEN(Email_Template_ID__c)&lt;&gt;15
||
LEFT(Email_Template_ID__c,3) &lt;&gt;"00X"
,
