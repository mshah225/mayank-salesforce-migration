    </fields><fields xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Priority__c</fullName>
        <description>[??] - The Priority for this Case Assignment Rule. It is not possible for two Rules to have the Same Priority.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the processing Priority for this Case Assignment Rule. It is not possible for two Rules to have the Same Priority.</inlineHelpText>
