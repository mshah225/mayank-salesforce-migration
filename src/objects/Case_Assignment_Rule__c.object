    </fields><fields xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Queue_ID__c</fullName>
        <description>[??] - The 15 character (case sensitive) ID of the Queue or User associated with this Assignment Rule.This ID  is shown immediatly after "....salesforce.com/p/own/Queue/d?id="  in the URL when viewing the Queue or  "...salesforce.com/" when viewing the User.</description>
        <externalId>false</externalId>
        <inlineHelpText>The 15 character (case sensitive) ID of the Queue or User associated with this Assignment Rule.This ID  is shown immediatly after "....salesforce.com/p/own/Queue/d?id="  in the URL when viewing the Queue or  "...salesforce.com/" when viewing the User.</inlineHelpText>
        <label>Queue or User ID</label>
        <length>15</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields><fields xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Queue_URL__c</fullName>
        <description>[??] - This is a URL created via a formula. Use this link to verify that the ID entered in the Queue or User ID field accurately identifies your desired Queue or User.</description>
        <externalId>false</externalId>
        <formula>IF(
LEN(Queue_ID__c) &lt;&gt; 15
||
(
LEFT(Queue_ID__c,3) &lt;&gt; "005"
&amp;&amp;
LEFT(Queue_ID__c,3) &lt;&gt; "00G"
)
,
"Enter a valid ID in the Queue or User ID field"
,
IF(LEFT(Queue_ID__c,3) = "005",
HYPERLINK("/"&amp;Queue_ID__c&amp;"?noredirect=1","Click to View Associated User")
,
HYPERLINK("/p/own/Queue/d?id="&amp;Queue_ID__c,"Click to View Associated Queue"))
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>This is a URL created via a formula. Use this link to verify that the ID entered in the Queue or User ID field accurately identifies your desired Queue or User.</inlineHelpText>
        <label>Queue or User URL</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
