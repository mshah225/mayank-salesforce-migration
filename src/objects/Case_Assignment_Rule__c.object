    </fields><fields xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Email_Template_ID__c</fullName>
        <description>[??] - The 15 character (case sensitive) ID used to identify the Email Template used for the notice emailed to the customer that a Case has been created. You can view this ID immediatly after "...salesforce.com/" in the URL when viewing the desired Template.</description>
        <externalId>false</externalId>
        <inlineHelpText>The 15 character (case sensitive) ID used to identify the Email Template used for the notice emailed to the customer that a Case has been created. You can view this ID immediatly after "...salesforce.com/" in the URL when viewing the desired Template.</inlineHelpText>
        <label>Email Template ID</label>
        <length>15</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
