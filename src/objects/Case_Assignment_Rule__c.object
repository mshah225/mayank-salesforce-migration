        <fullName>Case_Feed_Email_Template_Id__c</fullName>
        <externalId>false</externalId>
        <label>Case Feed Email Template Id</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields><fields xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Case_Feed_Email_Template_URL__c</fullName>
        <description>This is a URL created via a formula. Use this link to verify that the ID entered in the Case Feed Email Template ID field accurately identifies your desired Template.</description>
        <externalId>false</externalId>
        <formula>IF(
LEN(Case_Feed_Email_Template_Id__c)&lt;&gt;15
||
LEFT(Case_Feed_Email_Template_Id__c,3)&lt;&gt;"00X"
,
"Enter a valid ID in the Case Feed Email Template ID field"
,
HYPERLINK("/"&amp;Case_Feed_Email_Template_Id__c,"Click to View Associated Template")
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>This is a URL created via a formula. Use this link to verify that the ID entered in the Case Feed Email Template ID field accurately identifies your desired Template.</inlineHelpText>
        <label>Case Feed Email Template URL</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
