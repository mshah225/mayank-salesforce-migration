    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>An object used for classifying cases for some fields such as Functional Group, Category and Sub Category.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ReadWrite</externalSharingModel>
    <fields>
        <fullName>Active__c</fullName>
        <defaultValue>true</defaultValue>
        <description>If marked true, this record will be available for use on cases. If marked false, this record cannot be used for case creation or edits.</description>
        <externalId>false</externalId>
        <inlineHelpText>If marked true, this record will be available for use on cases. If marked false, this record cannot be used for case creation or edits.</inlineHelpText>
        <label>Active</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Chatter_Group_Id__c</fullName>
        <description>Field that holds the id value of the chatter group which will have the transfer notification posted to.</description>
        <externalId>false</externalId>
        <inlineHelpText>Holds the id value of the chatter group which will have the transfer notification posted to (this field is what's used by the flow)</inlineHelpText>
        <label>Chatter Group Id</label>
        <length>15</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Chatter_Group_Name__c</fullName>
        <description>Field that holds the name of the chatter group which will have the transfer notification posted to.</description>
        <externalId>false</externalId>
        <inlineHelpText>Holds the name of the chatter group which will have the transfer notification posted to.</inlineHelpText>
        <label>Chatter Group Name</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Default_Case_Description__c</fullName>
        <description>Contains the default description to add to a case when this category is selected.</description>
        <externalId>false</externalId>
        <label>Default Case Description</label>
        <length>32000</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Description__c</fullName>
        <description>Description of this record and how or when it should be used by the functional group.</description>
        <externalId>false</externalId>
        <inlineHelpText>Description of this record and how or when it should be used by the functional group.</inlineHelpText>
        <label>Description</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Is_Functional_Group_Private__c</fullName>
        <defaultValue>false</defaultValue>
        <externalId>false</externalId>
        <label>Is Functional Group Private</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Parent__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>If the field is dependent upon another field, it will be listed here.</description>
        <externalId>false</externalId>
        <inlineHelpText>If the field is dependent upon another field, it will be listed here.</inlineHelpText>
        <label>Parent</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>(1 AND 2) OR (3 AND 4)</booleanFilter>
            <filterItems>
                <field>$Source.RecordTypeId</field>
                <operation>equals</operation>
                <value>Category</value>
            </filterItems>
            <filterItems>
                <field>Case_Classification__c.RecordTypeId</field>
                <operation>equals</operation>
                <value>Functional Group</value>
            </filterItems>
            <filterItems>
                <field>$Source.RecordTypeId</field>
                <operation>equals</operation>
                <value>Sub Category</value>
            </filterItems>
            <filterItems>
                <field>Case_Classification__c.RecordTypeId</field>
                <operation>equals</operation>
                <value>Category</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Case_Classification__c</referenceTo>
        <relationshipLabel>Case Classifications</relationshipLabel>
        <relationshipName>Case_Classifications</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Queue_Id__c</fullName>
        <description>If a case with this functional group is assigned to a user, and that user is then deprovisioned, set the owner of the case to this Id post-deprovision.</description>
        <externalId>false</externalId>
        <label>Queue Id</label>
        <length>18</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Receives_Chatter_Notifications__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This denotes if the functional group is configured to receive Chatter notifications regarding a change in case ownership. The setting only applies to Functional Groups.</description>
        <externalId>false</externalId>
        <inlineHelpText>This denotes if the functional group is configured to receive Chatter notifications regarding a change in case ownership. The setting only applies to Functional Groups.</inlineHelpText>
        <label>Receives Chatter Notifications</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Record_Types_String__c</fullName>
        <description>Text/string that represents the values in the multi-select picklist "Record Types" (Record_Types__c) so it can be used in code.</description>
        <externalId>false</externalId>
        <label>Record Types String</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Record_Types__c</fullName>
        <description>When the record is type = Functional Group, this field lists which case record types the functional group can be used.</description>
        <externalId>false</externalId>
        <inlineHelpText>When the record is type = Functional Group, this field lists which case record types the functional group can be used.</inlineHelpText>
        <label>Record Types</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>ASU Admission Services</fullName>
                    <default>false</default>
                    <label>ASU Admission Services</label>
                </value>
                <value>
                    <fullName>(Admin Only) ASU Advisor Outreach</fullName>
                    <default>false</default>
                    <label>(Admin Only) ASU Advisor Outreach</label>
                </value>
                <value>
                    <fullName>ASU Coach Outreach</fullName>
                    <default>false</default>
                    <label>ASU Coach Outreach</label>
                </value>
                <value>
                    <fullName>(Admin Only) ASU Retention Outreach</fullName>
                    <default>false</default>
                    <label>(Admin Only) ASU Retention Outreach</label>
                </value>
                <value>
                    <fullName>ASU Service</fullName>
                    <default>false</default>
                    <label>ASU Service</label>
                </value>
                <value>
                    <fullName>ASU Student Outreach</fullName>
                    <default>false</default>
                    <label>ASU Student Outreach</label>
                </value>
                <value>
                    <fullName>ASU Secured Service</fullName>
                    <default>false</default>
                    <label>ASU Secured Service</label>
                </value>
            </valueSetDefinition>
        </valueSet>
        <visibleLines>6</visibleLines>
    </fields>
    <fields>
        <fullName>Visible__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Used to determine if an active record should be visible in the lookup fields for case.</description>
        <externalId>false</externalId>
        <inlineHelpText>Used to determine if an active record should be visible in the lookup fields for case.</inlineHelpText>
        <label>Visible</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
