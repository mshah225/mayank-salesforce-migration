    <fields>
        <fullName>ANI__c</fullName>
        <description>ANI value from InContact (Phone Number)</description>
        <externalId>true</externalId>
        <label>ANI</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Authentication_Type__c</fullName>
        <description>Type of Authentication the Contact completed</description>
        <externalId>false</externalId>
        <label>Authentication Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Push</fullName>
                    <default>true</default>
                    <label>Push</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Contact__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
