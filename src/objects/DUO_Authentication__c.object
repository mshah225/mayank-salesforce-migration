        <externalId>false</externalId>
        <label>Contact</label>
        <referenceTo>Contact</referenceTo>
        <relationshipLabel>DUO Authentication</relationshipLabel>
        <relationshipName>DUO_Authentication</relationshipName>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>Determines whether the contact has authenticated or not authenticated with DUO Authentication</description>
        <externalId>false</externalId>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Authenticated</fullName>
                    <default>false</default>
                    <label>Authenticated</label>
                </value>
                <value>
                    <fullName>Not Authenticated</fullName>
                    <default>false</default>
                    <label>Not Authenticated</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Time_of_Authentication__c</fullName>
        <description>Shows the date and time at which the authentication occurred</description>
        <externalId>false</externalId>
        <label>Time of Authentication</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
