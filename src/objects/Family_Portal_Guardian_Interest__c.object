    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Active_Interest__c</fullName>
        <businessOwnerGroup>Data_Owner_ESISD</businessOwnerGroup>
        <defaultValue>true</defaultValue>
        <description>If this is checked, the interest record is considered active by the submitter. Otherwise, it's considered an inactive interest.</description>
        <externalId>false</externalId>
        <label>Active Interest</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
