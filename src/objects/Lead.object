    </recordTypes>
    <validationRules>
        <fullName>Lead_Data_Entry_Minimum_Requirements</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
$Setup.Validation_Rule_Exception__c.Run_Validation_Rule__c,
ISCHANGED(Convert_Perform_Conversion__c),
Convert_Perform_Conversion__c = true,
OR(
ISBLANK ( FirstName ),
ISBLANK ( LastName ),
AND(
ISBLANK ( Email ),
ISBLANK ( Phone ),
ISBLANK ( MobilePhone )
)
)
)</errorConditionFormula>
        <errorMessage>You must fill out these required fields in order to convert the Lead to a Contact: First Name, Last Name, and either Phone or Email.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>silverpop__Disable_Changing_Enable_Sync</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
ISCHANGED(silverpop__Sync_to_Silverpop_Chk__c ), silverpop__Sync_to_Silverpop_Chk__c=false)</errorConditionFormula>
        <errorMessage>Sync to Silverpop selection cannot be changed. Once the box is checked, it cannot be unchecked.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>silverpop__Disable_Changing_To_None</fullName>
        <active>false</active>
        <description>Sync to Silverpop selection cannot be changed. Once set to "Yes, Always Sync" or "No, Don't Sync" it cannot be changed back to "-None-.”</description>
        <errorConditionFormula>AND( ISCHANGED(silverpop__Sync_to_Silverpop__c ) &amp;&amp; ISPICKVAL( PRIORVALUE(silverpop__Sync_to_Silverpop__c ) , "No, Don't Sync") ,ISPICKVAL( silverpop__Sync_to_Silverpop__c  , ""))</errorConditionFormula>
        <errorMessage>Sync to Silverpop selection cannot be changed. Once set to "Yes, Always Sync" or "No, Don't Sync" it cannot be changed back to "-None-.”</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>silverpop__Prevent_Change_From_Engage</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
PRIORVALUE( silverpop__Sync_to_Silverpop_Chk__c) = false , 
ISCHANGED( silverpop__CRMI_Modified_Date__c ))</errorConditionFormula>
        <errorDisplayField>silverpop__CRMI_Modified_Date__c</errorDisplayField>
        <errorMessage>Engage contact could not sync to Salesforce because the matching lead or contact in Salesforce has been set to not sync. You will need to change the "Sync to Silverpop" setting for the lead or contact in Salesforce.</errorMessage>
    </validationRules>
