    <fields>
        <fullName>Convert_Contact_Account_ID__c</fullName>
        <description>[import] - The ID of the Account Associated with the Contact specified in the Convert To Contact Lookup field. This is a lazy hack to allow the trigger to work for the proof of concept.</description>
        <externalId>false</externalId>
        <formula>Convert_Contact__r.AccountId</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>The ID of the Account Associated with the Contact specified in the Convert To Contact Lookup field. This is a lazy hack to allow the trigger to work for the proof of concept.</inlineHelpText>
        <label>Convert: Contact Account ID</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Convert_Contact__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>[import] - If a Contact is connected here, the Lead will automatically convert to that Contact (without an Opportunity).</description>
