        <fullName>Recruiting_Email_Change_Date__c</fullName>
        <description>[import] - Automatically set to the current date and time when the Email or Recruiting Email is changed on this Lead record. Mapped to the Contact record to determine if the Contact Email is to be replaced by the Recruiting Email.</description>
        <externalId>false</externalId>
        <inlineHelpText>Automatically set to the current date and time when the Email or Recruiting Email is changed on this Lead record. Mapped to the Contact record to determine if the Contact Email is to be replaced by the Recruiting Email.</inlineHelpText>
        <label>Recruiting Email Change Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
