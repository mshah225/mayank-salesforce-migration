    <fields>
        <fullName>Email_Eligible_Domestic__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
OR(
AND(ISBLANK( Email )),
HasOptedOutOfEmail = True,
International_Student__c = True),False,True)</formula>
        <label>Email Eligible Domestic</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
