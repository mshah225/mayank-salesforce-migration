    <fields>
        <fullName>Send_Email_ID__c</fullName>
        <description>[manual import] - Retrieves ID for the type of Lead Interest. If it is related to a Lead record, then Lead ID. Else it is Contact ID.</description>
        <externalId>false</externalId>
        <formula>IF( ISBLANK( Contact__c ), Leads__r.Id,  Contact__r.Id )</formula>
        <label>Send Email ID</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Send_Email__c</fullName>
        <description>[manual import] - Send email</description>
        <externalId>false</externalId>
        <formula>IF(ISBLANK( Contact__c ),  Leads__r.Email,  Contact__r.Email   )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Send Email</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
