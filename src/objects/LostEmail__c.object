    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ReadWrite</externalSharingModel>
    <fields>
        <fullName>CarbonCopies__c</fullName>
        <description>The addresses that were CC'd</description>
        <externalId>false</externalId>
        <label>CarbonCopies</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Cause__c</fullName>
        <description>The error that caused this lost email to be generated.</description>
        <externalId>false</externalId>
        <inlineHelpText>The error that caused this lost email to be generated.</inlineHelpText>
        <label>Cause</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
