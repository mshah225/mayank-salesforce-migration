    <fields>
        <fullName>Academic_Interest__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>[Purchased list] - Generic interest a prospective student is interested in</description>
        <externalId>false</externalId>
        <label>Academic Interest</label>
        <referenceTo>Academic_Interest__c</referenceTo>
        <relationshipLabel>Opportunities</relationshipLabel>
        <relationshipName>Opportunities_AcademicInterest</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Academic_Plan_Associated_College__c</fullName>
        <description>[Salesforce] - Formula field that displays the associated Academic Plan's Program (College) name.  Used in reports.</description>
        <externalId>false</externalId>
        <formula>IF( Admitted_Plan__c &lt;&gt; "",  Admitted_Plan__r.eAdvisor_Organization__r.Name ,  Academic_Plan__r.eAdvisor_Organization__r.Name )</formula>
        <inlineHelpText>This is the college name associated to Plan through the eAdvisor org.</inlineHelpText>
        <label>Printable College</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Academic_Plan__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>[Peoplesoft] - Academic plan a prospective student is interested in or a student has applied to.</description>
        <externalId>false</externalId>
        <inlineHelpText>Program of interest or applied program</inlineHelpText>
        <label>Academic Plan</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Plan__c.Available_in_Degree_Search__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <isOptional>true</isOptional>
        </lookupFilter>
        <referenceTo>Plan__c</referenceTo>
        <relationshipLabel>Opportunities</relationshipLabel>
        <relationshipName>Opportunities</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
