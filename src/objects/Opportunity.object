    <fields>
        <fullName>Call_Eligible_Domestic__c</fullName>
        <externalId>false</externalId>
        <formula>IF( 
OR( 
AND(ISBLANK(Contact__r.HomePhone),ISBLANK(Contact__r.Phone)), 
Contact__r.DoNotCall = True, 
International_Student__c = True, 
Location__r.Name = "Online", 
Location__r.Name = "Lake Havasu", 
Location__r.Name = "Eastern Arizona College", 
Admitted_Location__r.Name = "Online", 
Admitted_Location__r.Name = "Lake Havasu", 
Admitted_Location__r.Name = "Eastern Arizona College", 
ISPICKVAL(ForecastCategoryName, "Withdrawn/Denied") 
),False,True)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Call Eligible Domestic</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CampaignId</fullName>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
