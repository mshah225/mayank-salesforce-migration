    <fields>
        <fullName>Is_EC_Logged_in_User__c</fullName>
        <description>Value will equal Yes if the person viewing the record is the assigned Enrollment Coach on the Opportunity record.</description>
        <externalId>false</externalId>
        <formula>IF(Enrollment_Coach__r.Id = $User.Id, TRUE, FALSE)</formula>
        <label>Is EC Logged in User</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Is_Owner_Logged_in_User__c</fullName>
        <description>Formula field that indicates whether or not the logged in user ID matches the ID of the Opportunity Owner.</description>
        <externalId>false</externalId>
        <formula>OwnerId =  $User.Id</formula>
        <inlineHelpText>Returns True (checked) if the logged in User is the Opportunity Owner.</inlineHelpText>
        <label>Is Owner Logged in User</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
