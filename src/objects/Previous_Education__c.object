    <fields>
        <fullName>ASU_Geomarket__c</fullName>
        <externalId>false</externalId>
        <formula>Account__r.ASU_Geomarket_Code__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>ASU Geomarket</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ATP_Code__c</fullName>
        <description>The American Testing Program (ATP) Code or College Entrance Examination Board (CEEB) Code is a 6-digit number that is used by standardized tests such as SAT and ACT. The first 2 digits indicate the state. The ATP Code is a 4-digit number for higher education institutions.</description>
        <externalId>false</externalId>
        <formula>Account__r.ATP_Code__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Represents the ATP or CEEB Code</inlineHelpText>
        <label>ATP Code</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Account__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>This is a lookup to the Institution stored as an Account record.</description>
        <externalId>false</externalId>
        <label>Institution</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Account.Type</field>
                <operation>equals</operation>
                <value>Institution</value>
            </filterItems>
            <isOptional>true</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Previous Education</relationshipLabel>
        <relationshipName>Previous_Education</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Class_Rank_Percentile__c</fullName>
        <externalId>false</externalId>
        <formula>IF(Class_Rank__c &gt; 0 &amp;&amp; Class_Size__c &gt; 0,1-Class_Rank__c /Class_Size__c,null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>This student's class rank, in percentile format (rounded to a whole number). Calculated from the Class Rank and Class Size stored on this Previous Education Record.</inlineHelpText>
        <label>Class Rank Percentile</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Class_Rank__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>This student's class rank. Used along with Class Size to calculate Class Rank Percentile.</inlineHelpText>
        <label>Class Rank</label>
        <precision>6</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Class_Size__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>The size of the graduating class at the institution referenced on this Previous Education record. Used along with Class Rank to calculate Class Rank Percentile.</inlineHelpText>
        <label>Class Size</label>
        <precision>6</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Degree_Type__c</fullName>
        <description>[??] - Examples include: Undergraduate, Graduate, Certificate, General Ed, Other</description>
        <externalId>false</externalId>
        <label>Degree Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Undergraduate</fullName>
                    <default>false</default>
                    <label>Undergraduate</label>
                </value>
                <value>
                    <fullName>Graduate</fullName>
                    <default>false</default>
                    <label>Graduate</label>
                </value>
                <value>
                    <fullName>Certificate</fullName>
                    <default>false</default>
                    <label>Certificate</label>
                </value>
                <value>
                    <fullName>General Ed</fullName>
                    <default>false</default>
                    <label>General Ed</label>
                </value>
                <value>
                    <fullName>Other</fullName>
                    <default>false</default>
                    <label>Other</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Degree__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>[??] - Shows the name of the previous degree</description>
        <externalId>false</externalId>
        <label>Degree</label>
        <referenceTo>Degree_Name__c</referenceTo>
        <relationshipLabel>Previous Education</relationshipLabel>
        <relationshipName>Previous_Education</relationshipName>
