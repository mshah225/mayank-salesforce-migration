        <externalId>false</externalId>
        <formula>Account__c =  Contact__r.Last_HS_Attended__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Is Last High School Attended</label>
