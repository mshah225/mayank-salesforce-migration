        <sharedTo>
            <group>UTO_Administration</group>
            <role>S_Service</role>
            <roleAndSubordinatesInternal>SCI_Student_Centric_Initiatives_Manager</roleAndSubordinatesInternal>
        </sharedTo>
    </listViews>
