    </recordTypes><validationRules>
        <fullName>Call_Comment_Required_when_Not_Attempted</fullName>
        <active>true</active>
        <description>Validation rule that makes the Call Comment field required if the Call Result = "Not Attempted"</description>
        <errorConditionFormula>ISPICKVAL(Call_Result__c, "Not Attempted")&amp;&amp;
(LEN( Call_Comments__c ) &lt; 1)</errorConditionFormula>
        <errorDisplayField>Call_Comments__c</errorDisplayField>
        <errorMessage>Please enter a reason why the call was not attempted.</errorMessage>
    </validationRules><validationRules>
        <fullName>Call_Result_Not_Attempt_Supervisor_Only</fullName>
        <active>true</active>
        <description>Validation rule that allows the Call Result value of "Not Attempted (Supervisor Only)" to not be chosen by a user with the role of AS Peer Admissions Representative.</description>
        <errorConditionFormula>$UserRole.Name="AS Peer Admission Representative" &amp;&amp;
ISPICKVAL(Call_Result__c, "Not Attempted")</errorConditionFormula>
        <errorDisplayField>Call_Result__c</errorDisplayField>
        <errorMessage>You are not allowed to select "Not Attempted", please select a different value or contact your supervisor.</errorMessage>
    </validationRules></CustomObject>