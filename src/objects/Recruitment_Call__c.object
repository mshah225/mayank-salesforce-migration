        <relationshipLabel>Recruitment Calls</relationshipLabel>
        <relationshipName>Recruitment_Calls</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
