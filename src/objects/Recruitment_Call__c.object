    <fields>
        <fullName>Call_Success__c</fullName>
        <description>Formula field to display whether or not the call result was successful.</description>
        <externalId>false</externalId>
        <formula>Case(Call_Result__c,
"Spoke with Student","Yes",
"Spoke with Parent/Guardian", "Yes",
"Spoke with Other Family Member", "Final Attempt",
"Left Message on Voicemail", "Final Attempt",
"Left Message with Family Member", "Final Attempt",
"Disconnected", "Final Attempt",
"No Answer", "Final Attempt",
"Wrong Number", "Final Attempt",
"Not Attempted (Supervisor Only)", "Final Attempt",
""
)</formula>
        <label>Call Success</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Campaign__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Lookup field to be able to select the appropriate associated campaign for the recruitment call.</description>
        <externalId>false</externalId>
        <label>Campaign</label>
        <lookupFilter>
            <active>false</active>
            <filterItems>
                <field>Campaign.RecordType.Name</field>
                <operation>equals</operation>
                <value>Calling</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
