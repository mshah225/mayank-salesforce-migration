    </actionOverrides><fields>
        <fullName>Call_Comments__c</fullName>
        <description>Open rich text area that allows users to enter notes or comments about their phone call with the prospect or applicant.</description>
        <externalId>false</externalId>
        <label>Call Comments</label>
        <length>5000</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Html</type>
        <visibleLines>10</visibleLines>
    </fields><fields>
        <fullName>Call_Origin__c</fullName>
        <description>Picklist field to indicate whether the phone call was originated as an inbound call or as an outbound call.</description>
        <externalId>false</externalId>
        <label>Call Origin</label>
        <picklist>
            <picklistValues>
                <fullName>Inbound</fullName>
                <default>true</default>
            </picklistValues>
            <picklistValues>
                <fullName>Outbound</fullName>
                <default>false</default>
            </picklistValues>
            <sorted>false</sorted>
        </picklist>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
    </fields><fields>
        <fullName>Call_Result__c</fullName>
        <description>Picklist field that allows users to select the call result.</description>
        <externalId>false</externalId>
        <label>Call Result</label>
        <picklist>
            <picklistValues>
                <fullName>Spoke with Student</fullName>
                <default>false</default>
            </picklistValues>
            <picklistValues>
                <fullName>Spoke with Parent/Guardian</fullName>
                <default>false</default>
            </picklistValues>
            <picklistValues>
                <fullName>Spoke with Other Family Member</fullName>
                <default>false</default>
            </picklistValues>
            <picklistValues>
                <fullName>Left Message on Voicemail</fullName>
                <default>false</default>
            </picklistValues>
            <picklistValues>
                <fullName>Left Message with Family Member</fullName>
                <default>false</default>
            </picklistValues>
            <picklistValues>
                <fullName>No Answer</fullName>
                <default>false</default>
            </picklistValues>
            <picklistValues>
                <fullName>Disconnected</fullName>
                <default>false</default>
            </picklistValues>
            <picklistValues>
                <fullName>Wrong Number</fullName>
                <default>false</default>
            </picklistValues>
            <picklistValues>
                <fullName>Not Attempted</fullName>
                <default>false</default>
            </picklistValues>
            <picklistValues>
                <fullName>Emailed</fullName>
                <default>false</default>
            </picklistValues>
            <sorted>false</sorted>
        </picklist>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
    </fields><fields>
        <fullName>Call_Success__c</fullName>
        <description>Formula field to display whether or not the call result was successful.</description>
        <externalId>false</externalId>
        <formula>Case(Call_Result__c,
"Spoke with Student","Yes",
"Spoke with Parent/Guardian", "Yes",
"Spoke with Other Family Member", "Final Attempt",
"Left Message on Voicemail", "Final Attempt",
"Left Message with Family Member", "Final Attempt",
"Disconnected", "Final Attempt",
"No Answer", "Final Attempt",
"Wrong Number", "Final Attempt",
"Not Attempted (Supervisor Only)", "Final Attempt",
""
)</formula>
        <label>Call Success</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields><fields>
