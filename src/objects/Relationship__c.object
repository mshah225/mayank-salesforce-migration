    <fields>
        <fullName>Account__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The organization tracked on this Relationship Record. Used in Contact to Account and Account to Account Relationships.</description>
        <externalId>false</externalId>
        <inlineHelpText>The organization tracked on this Relationship Record.</inlineHelpText>
        <label>Account</label>
        <lookupFilter>
            <active>true</active>
            <errorMessage>Can only associate contacts with Org accounts</errorMessage>
            <filterItems>
                <field>Account.Contact__c</field>
                <operation>equals</operation>
                <value></value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Relationships</relationshipLabel>
        <relationshipName>Relationships</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Active_Relationship__c</fullName>
        <defaultValue>true</defaultValue>
        <description>If checked, indicates that this Relationship is Active.</description>
        <externalId>false</externalId>
        <inlineHelpText>Indicates the Relationship is current. Will automatically be set to false when:
1. The Relationship End Date is set to a value in the past - OR -
2. A Relationship End Date set for the future is reached.</inlineHelpText>
        <label>Active Relationship</label>
        <trackFeedHistory>true</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Contact__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The person tracked on this Relationship Record. Used in Contact to Account and Contact to Contact Relationships.</description>
        <externalId>false</externalId>
        <inlineHelpText>The person tracked on this Relationship Record.</inlineHelpText>
        <label>Contact</label>
        <referenceTo>Contact</referenceTo>
        <relationshipLabel>Relationships</relationshipLabel>
        <relationshipName>Relationships</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>FERPA__c</fullName>
        <description>FERPA Message</description>
        <externalId>false</externalId>
        <formula>IF( NOT(ISBLANK( Contact__r.EMPLID__c )), 
"Check the student’s Parent Guest Access Permissions to determine whether FERPA-protected information can be shared and with whom" 
,NULL)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>FERPA</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Parent_Guest_Access__c</fullName>
        <description>Link to PeopleSoft Portal with EMPLID</description>
        <externalId>false</externalId>
        <formula>IF( NOT(ISBLANK( Contact__r.EMPLID__c )), 
HYPERLINK("https://cs.oasis.asu.edu/psp/asucsprd/EMPLOYEE/CAMP/c/ASU_STUDENT_RECORDS.ASU_PP_PROXY_INQ.GBL?EMPLID=" + Contact__r.EMPLID__c ,"Parent Guest Access") 
,NULL)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Parent Guest Access</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Primary_Parent__c</fullName>
        <defaultValue>false</defaultValue>
        <description>indicator for primary Parent Guardian</description>
        <externalId>false</externalId>
