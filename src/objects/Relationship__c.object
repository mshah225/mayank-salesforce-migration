    <fields>
        <fullName>Reciprocal_Relationship__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Provides a direct connection between a Relationship and it's reciprocal record. Used for Contact to Contact and Account to Account Relationships.</description>
        <externalId>false</externalId>
        <inlineHelpText>Provides a direct connection between a Relationship and it's reciprocal record. Used for Contact to Contact and Account to Account Relationships.</inlineHelpText>
        <label>Reciprocal Relationship</label>
        <referenceTo>Relationship__c</referenceTo>
        <relationshipLabel>Reciprocal Relationships</relationshipLabel>
        <relationshipName>Relationships</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Reciprocal_Souce__c</fullName>
        <description>Reciprocal Relationship Source</description>
        <externalId>false</externalId>
        <formula>IF( ISNULL(Reciprocal_Relationship__c) , "",  TEXT(Reciprocal_Relationship__r.Source__c) )</formula>
        <label>Reciprocal Souce</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
