        <fullName>Related_Account__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The associated organization in an Account to Account Relationship. Used in Account to Account Relationships only. Note that the Related List from this Lookup is never to be added to a page layout.</description>
