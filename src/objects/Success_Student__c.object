        <fullName>Mobile_Phone__c</fullName>
        <externalId>false</externalId>
        <formula>SUBSTITUTE( 
SUBSTITUTE( 
SUBSTITUTE( 
SUBSTITUTE(
IF(
(ISBLANK(Student__r.MobilePhone)), Student__r.HomePhone, Student__r.MobilePhone),
 "(", ""), ")", ""), " ", ""), "-", "")</formula>
