    </fields><fields>
        <fullName>Coach_Enrollment_Status__c</fullName>
        <description>Student's enrollment status</description>
        <externalId>false</externalId>
        <inlineHelpText>New: New, first session
Continuing: Enrolled 2+ consecutive sess
Graduated: Completed program
NDrop: No credit courses
TDrop: No classes, will return
PDrop: Never return
Re-Entry: Out of class for 2-6 sess
Re-Apply: Out 6+ sess, needs new adm ppwk</inlineHelpText>
        <label>Enrollment Status</label>
        <picklist>
            <picklistValues>
                <fullName>New</fullName>
                <default>false</default>
            </picklistValues>
            <picklistValues>
                <fullName>Continuing</fullName>
                <default>false</default>
            </picklistValues>
            <picklistValues>
                <fullName>Graduated</fullName>
                <default>false</default>
            </picklistValues>
            <picklistValues>
                <fullName>NDrop</fullName>
                <default>false</default>
            </picklistValues>
            <picklistValues>
                <fullName>TDrop</fullName>
                <default>false</default>
            </picklistValues>
            <picklistValues>
                <fullName>PDrop</fullName>
                <default>false</default>
            </picklistValues>
            <picklistValues>
                <fullName>Re-Entry</fullName>
                <default>false</default>
            </picklistValues>
            <picklistValues>
                <fullName>Re-Apply</fullName>
                <default>false</default>
            </picklistValues>
            <sorted>false</sorted>
        </picklist>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
    </fields><fields xmlns="http://soap.sforce.com/2006/04/metadata">
