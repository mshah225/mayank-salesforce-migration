    <fields>
        <fullName>Coach_Enrollment_Status__c</fullName>
        <description>Student's enrollment status</description>
        <externalId>false</externalId>
        <inlineHelpText>New: New, first session
Continuing: Enrolled 2+ consecutive sess
Graduated: Completed program
NDrop: No credit courses
TDrop: No classes, will return
PDrop: Never return
Re-Entry: Out of class for 2-6 sess
Re-Apply: Out 6+ sess, needs new adm ppwk</inlineHelpText>
        <label>Enrollment Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>New</fullName>
                    <default>false</default>
                    <label>New</label>
                </value>
                <value>
                    <fullName>Continuing</fullName>
                    <default>false</default>
                    <label>Continuing</label>
                </value>
                <value>
                    <fullName>Graduated</fullName>
                    <default>false</default>
                    <label>Graduated</label>
                </value>
                <value>
                    <fullName>NDrop</fullName>
                    <default>false</default>
                    <label>NDrop</label>
                </value>
                <value>
                    <fullName>TDrop</fullName>
                    <default>false</default>
                    <label>TDrop</label>
                </value>
                <value>
                    <fullName>PDrop</fullName>
                    <default>false</default>
                    <label>PDrop</label>
                </value>
                <value>
                    <fullName>Re-Entry</fullName>
                    <default>false</default>
                    <label>Re-Entry</label>
                </value>
                <value>
                    <fullName>Re-Apply</fullName>
                    <default>false</default>
                    <label>Re-Apply</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Coaching_Student__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Used to identify which students will be part of Success Student Coaching. Info will be imported from the lists of new students for the initial cohort and each subsequent cohort as they transition from ITK to ASU. This field can be replaced with a lookup to campus once all online students are coached by ASU.</description>
        <externalId>false</externalId>
        <label>Coaching Student</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
