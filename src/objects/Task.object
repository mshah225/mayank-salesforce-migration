    </recordTypes><webLinks xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Send_Email_ID_Lead_Interest</fullName>
        <availability>online</availability>
        <description>Sends an email based on the formula field Send Email ID found in the Lead Interest object</description>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <linkType>url</linkType>
        <masterLabel>Send Email to Lead</masterLabel>
        <openType>replace</openType>
        <protected>false</protected>
        <requireRowSelection>false</requireRowSelection>
        <url>/_ui/core/email/author/EmailAuthor?p2_lkid={!Lead_Interest__c.Send_Email_ID__c}&amp;retURL={!Lead_Interest__c.Id}</url>
    </webLinks><webLinks xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Send_Email_Lead_Interest</fullName>
        <availability>online</availability>
        <description>Send an email message to either the Lead or Contact on a Lead Interest. It will select the email address found in the Send Email field on the Lead Interest</description>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Send Email Lead Interest</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>false</requireRowSelection>
        <url>location.replace('/email/author/emailauthor.jsp?p2_lkid= {!Lead_Interest__c.Send_Email__c}&amp;rtype=00Q&amp;retURL=%2F{!Lead_Interest__c.Id}&amp;template_id=00Xd00000019nTy')</url>
    </webLinks><webLinks xmlns="http://soap.sforce.com/2006/04/metadata">
        <fullName>Send_Email_Opportunity</fullName>
        <availability>online</availability>
        <description>Sends an email based on the formula field Send Email ID found in the Opportunity object</description>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <linkType>url</linkType>
        <masterLabel>Send Email</masterLabel>
        <openType>replace</openType>
        <protected>false</protected>
        <requireRowSelection>false</requireRowSelection>
        <url>/_ui/core/email/author/EmailAuthor?p2_lkid={!Opportunity.ContactId__c}&amp;rtype=003&amp;p3_lkid={!Opportunity.Id}&amp;retURL={!Opportunity.Id}</url>
    </webLinks></CustomObject>