    <fields>
        <fullName>Test_Case_Thread_Id__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Test_Case__c = '' ,'', Test_Case__r.Thread_Id__c)</formula>
        <label>Test Case Thread Id</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Test_Case__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>This is the case the email message is related to.</description>
        <externalId>false</externalId>
        <inlineHelpText>This is the case the email message is related to.</inlineHelpText>
        <label>Test Case</label>
        <referenceTo>Case</referenceTo>
        <relationshipLabel>Test Engagement Contacts</relationshipLabel>
        <relationshipName>Test_Engagement_Contacts</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Test_Contact__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>This is the contact the message is related to or intended for.</description>
        <externalId>false</externalId>
        <inlineHelpText>This is the contact the message is related to or intended for.</inlineHelpText>
        <label>Test Contact</label>
        <referenceTo>Contact</referenceTo>
        <relationshipLabel>Test Engagement Contacts</relationshipLabel>
        <relationshipName>Test_Engagement_Contacts</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Test_Status__c</fullName>
        <description>Used to indicate if the messages has been sent through Marketing Cloud.</description>
        <externalId>false</externalId>
        <inlineHelpText>Used to indicate if the messages has been sent through Marketing Cloud.</inlineHelpText>
        <label>Test Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Pending</fullName>
                    <default>true</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>Sent</fullName>
                    <default>false</default>
                    <label>Sent</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Test_Success_Resource_Primary_Email__c</fullName>
        <externalId>false</externalId>
        <formula>Test_Success_Resource__r.Primary_Email__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Test Success Resource Primary Email</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Test_Success_Resource__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Used to associate the message with a success resource.</description>
        <externalId>false</externalId>
        <inlineHelpText>Used to associate the message with a success resource.</inlineHelpText>
        <label>Test Success Resource</label>
        <referenceTo>Success_Resource__c</referenceTo>
        <relationshipLabel>Test Engagement Contacts</relationshipLabel>
        <relationshipName>Test_Engagement_Contacts</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>An object to test the Salesforce Triggered Sends using the Marketing Cloud Connector. There will also be a trigger for this object.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ReadWrite</externalSharingModel>
    <label>Test Engagement Contact</label>
    <nameField>
        <displayFormat>Test-EC-{0}</displayFormat>
        <label>Test Engagement Contacts Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Test Engagement Contacts</pluralLabel>
    <searchLayouts />
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
</CustomObject>
