    <validationRules>
        <fullName>Only_System_Admins_Create_Edit_Users</fullName>
        <active>true</active>
        <description>Prevents delegated administrators from creating or editing users in sandboxes.</description>
        <errorConditionFormula>AND(
OR (
ISNEW(),
ISCHANGED( Email ),
ISCHANGED( Alias ),
ISCHANGED( Username )),
$User.ProfileId &lt;&gt; '00ed00000017Iob'
)</errorConditionFormula>
        <errorMessage>Only System Administrators can edit your email address. Please contact salesforce.support@asu.edu if you need to change your email address.</errorMessage>
    </validationRules>
</CustomObject>
