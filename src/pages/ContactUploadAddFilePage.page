<apex:page showHeader="true" sidebar="true" standardController="Contact_Upload__c" extensions="ContactUploadAddFileExtension">
	<apex:pageBlock >
		<apex:outputPanel rendered="{!attachmentList.size>0}">
			<apex:pageBlockTable value="{!attachmentList}" var="a">
				<apex:column headerValue="">
					<apex:outputLink value="/servlet/servlet.FileDownload?file={!a.Id}">&#8681;</apex:outputLink>
				</apex:column>
				<apex:column headerValue="File">
					<apex:outputLink value="/{!a.Id}" target="_blank">{!a.Name}</apex:outputLink>
				</apex:column>
				<apex:column value="{!a.Description}"/>
				<apex:column value="{!a.CreatedDate}"/>
				<apex:column headerValue="Created By">
					<apex:outputLink value="/{!a.CreatedById}">{!a.CreatedBy.Name}</apex:outputLink>
				</apex:column>
			</apex:pageBlockTable>
		</apex:outputPanel>
		<apex:outputPanel rendered="{!attachmentList.size==0}">
			<apex:form enctype="multipart/form-data">
				<apex:pageBlockSection showHeader="false" columns="1" id="block1">
					<apex:pageBlockSectionItem >
						<apex:outputLabel value="File" for="file"/>
						<apex:inputFile value="{!attachment.body}" filename="{!attachment.name}" id="file" required="true"/>
					</apex:pageBlockSectionItem>
					<apex:pageBlockSectionItem >
						<apex:outputLabel value="File Description" for="description"/>
						<apex:inputTextarea value="{!attachment.description}" id="description"/>
					</apex:pageBlockSectionItem>
					<apex:pageBlockSectionItem >
                        <apex:outputLabel value=""/>
						<apex:commandButton action="{!upload}" value="Upload and Process File" style="height:30px;width:135px;text-align:center;" id="submit" onclick="return confirm('Please confirm that you want to process this file, creating Contact and Subscriber records.');"/>
					</apex:pageBlockSectionItem>
				</apex:pageBlockSection>
			</apex:form>
		</apex:outputPanel>
	</apex:pageBlock>
</apex:page>