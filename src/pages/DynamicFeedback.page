<apex:page sidebar="false" showHeader="false" controller="FeedbackButtonController" cache="true" action="{!init}">

    <head>
        <c:GoogleTagManager />
        <c:GoogleAnalytics />

        <title>{!carName} Feedback</title>

        <apex:stylesheet value="{!URLFOR($Resource.bootstrap_337, 'bootstrap_337/css/bootstrap.css')}" />
        <apex:stylesheet value="{!URLFOR($Resource.ASU_Web_Standards, 'ASU_Web_Standards.css')}" />

        <style>
            #asu_content_well .webform-component-textarea {
                font-weight: 400;
            }
        </style>
    </head>

    <c:ASUBrandHeader />
    <div class="asu-header-site-title-container">
        <div>
            <div id="asu-header-site-title" class="asu-header-width">
                <a href="https://webapp4.asu.edu/myasu">{!carName} Feedback</a>
            </div>
        </div>
    </div>

    <c:GoogleTagManagerBody />
    <div id="asu_content_well">
        <c:MyASUHelpPageNotifications />
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <apex:outputPanel id="alerts">
                        <c:customAlerts alerts="{!alertHandler.alerts}" />
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!NOT(ISBLANK(retURL))}">
                        <ol class="breadcrumb">
                            <li>
                                <a href="{!retURL}">Back</a>
                            </li>
                            <li class="active">Feedback</li>
                        </ol>
                    </apex:outputPanel>
                    <apex:form id="feedbackForm" style="max-width:50%;">
                        <p class="lead">ASU values your experience and wants to ensure that you receive quality service. Tell us how we can
                            improve your experience below.</p>
                        <div class="form-item webform-component webform-component-textarea webform-component--text-area">
                            <apex:outputLabel value="Feedback Comments" for="caseFeedbackComments" />
                            <apex:inputTextarea id="caseFeedbackComments" value="{!caseDescription}" styleClass="form-textarea form-control" cols="60"
                                rows="5" />
                        </div>
                        <apex:commandLink value="Submit" action="{!submit}" styleClass="btn btn-primary" reRender="alerts,feedbackForm" />
                    </apex:form>
                </div>
            </div>
        </div>
    </div>

    <c:ASUBrandFooter />
</apex:page>