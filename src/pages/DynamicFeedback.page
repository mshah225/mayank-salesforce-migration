<apex:page sidebar="false" showHeader="false" standardStylesheets="false" controller="FeedbackButtonController" cache="true"
    action="{!init}">

    <head>
        <title>My ASU | Help | {!carName} Feedback</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <c:GoogleTagManager />
        <c:GoogleAnalytics />

        <link rel="shortcut icon" href="{!URLFOR($Resource.bootstrap_4_asu, '/dist/img/favicon/favicon.ico')}" />
        <apex:stylesheet value="{! URLFOR($Resource.bootstrap_4_asu, '/dist/css/bootstrap-asu.min.css')}" />
        <apex:includeScript value="{!URLFOR($Resource.jQuery_1_11_1_Min)}" />
        <script>$ = jQuery.noConflict();</script>
        <apex:includeScript value="{!URLFOR($Resource.bootstrap_4_asu, '/dist/js/bootstrap.min.js')}" />
    </head>

    <apex:includeLightning />
    <c:SLDSRemoveGlobalStyles />

    <div id="ASUBrandHeaderWrapper"></div>

    <c:GoogleTagManagerBody />
    <main role="main">
        <c:MyASUHelpPageNotifications />
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <apex:outputPanel id="alerts">
                        <c:customAlerts alerts="{!alertHandler.alerts}" />
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!NOT(ISBLANK(retURL))}">
                        <ol class="breadcrumb">
                            <li>
                                <a href="{!retURL}">Back</a>
                            </li>
                            <li class="active">Feedback</li>
                        </ol>
                    </apex:outputPanel>
                    <apex:form id="feedbackForm">
                        <p class="lead">
                            ASU values your experience and wants to ensure that you receive quality service. Tell us how we can improve your experience
                            below.
                        </p>
                        <div class="form-item webform-component webform-component-textarea webform-component--text-area">
                            <apex:outputLabel value="Feedback Comments" for="caseFeedbackComments" />
                            <apex:inputTextarea id="caseFeedbackComments" value="{!caseDescription}" styleClass="form-textarea form-control" cols="60"
                                rows="5" />
                        </div>
                        <apex:commandLink value="Submit" action="{!submit}" styleClass="btn btn-maroon btn-md mt-1 mb-1" reRender="alerts,feedbackForm"
                        />
                    </apex:form>
                </div>
            </div>
        </div>
    </main>

    <div id="ASUBrandFooterWrapper"></div>

    <script>
        const title = '{!carName}';
        const baseUrl = 'https://webapp4.asu.edu/myasu/student/servicecenter';
        $Lightning.use(
            "c:ASUBrandApp",
            function () {
                $Lightning.createComponent(
                    "c:asuBrandHeader",
                    { title, baseUrl },
                    "ASUBrandHeaderWrapper"
                );
                $Lightning.createComponent(
                    "c:asuBrandFooter",
                    {},
                    "ASUBrandFooterWrapper"
                );
            }
        );
    </script>
</apex:page>