<apex:page controller="FamilyPortalController" action="{!familyPortalOnLoad}" standardStylesheets="false" showHeader="false" html-lang="en-US">
    <title>ASU | Family Portal</title>
    <link rel="icon" href="https://www.asu.edu/sites/all/themes/asu_home/favicon.ico" />

    <c:ASUBrandHeader />
    <div class="myasu-header-seo-container">
        <div>
            <div id="myasu-header-seo" class="myasu-cont">
                <a href="https://webapp4.asu.edu/myasu">Family Portal</a>
            </div>
        </div>
    </div>   
    
    <c:FamilyPortalResources />
    <apex:form>
        <div id="accessible-body">
            <div class="family-portal-body-container">
                <div class="family-portal-1-container">
                    <apex:pageBlock>
                        <div class="family-portal-1-header">
                            <h2>Welcome to the ASU portal for family members.</h2>
                            <p class="lead">Do you have an ASURITE ID? If not, please sign up below.</p>
                        </div>
                        <div class="family-portal-double-button-container">
                            <div class="family-portal-double-button">
                                <apex:commandLink styleClass="btn btn-primary btn-block" action="{!familyPortalStep2}">
                                    Sign up
                                </apex:commandLink>
                            </div>
                            <div class="family-portal-double-button">
                                <apex:commandLink styleClass="btn btn-secondary btn-block" action="{!generateLoginLink}">
                                    Login
                                </apex:commandLink>
                            </div>
                        </div>
                    </apex:pageBlock>
                </div>
                <c:FamilyPortalSidebar />
            </div>
        </div>
    </apex:form>
    <c:ASUBrandFooter />
</apex:page>