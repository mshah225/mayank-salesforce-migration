<apex:page controller="FamilyPortalController" standardStylesheets="false">
    <head>
        <apex:stylesheet value="{!URLFOR($Resource.MyASUHeader4_3, 'MyASUHeader4_3/font-awesome-4.3.0/css/font-awesome.css')}" />
        <apex:stylesheet value="{!URLFOR($Resource.bootstrap_337, 'bootstrap_337/css/bootstrap.css')}" />
        <apex:stylesheet value="{!URLFOR($Resource.ASU_Web_Standards, 'ASU_Web_Standards.css')}" />
        <apex:stylesheet value="{!URLFOR($Resource.FamilyPortal, 'FamilyPortal/FamilyPortal.css')}" />
    </head>

    <h2 class="family-portal-page-title">ASU Family Portal</h2>
    <apex:form>
        <div class="family-portal-1-container">
            <div class="family-portal-1-header">
                <h3>Welcome to the ASU portal for family members.</h3>
                <h4>Do you have an ASURITE ID? If not, please sign up below.</h4>
            </div>
            <div class="family-portal-double-button-container">
                <div class="family-portal-double-button">
                    <apex:commandLink styleClass="btn btn-primary btn-block" action="{!familyPortalStep2}">
                        Sign up
                    </apex:commandLink>
                </div>
                <div class="family-portal-double-button">
                    <apex:commandLink styleClass="btn btn-secondary btn-block" action="https://weblogin.asu.edu/cas/login?service=https%3A%2F%2Fshibboleth-dev.asu.edu%2Fidp%2FAuthn%2FExtCas%3Fconversation%3De1s1&entityId=https%3A%2F%2Fasu--mgilardi.my.salesforce.com/apex/FamilyPortalStep3">
                        Login
                    </apex:commandLink>
                </div>
            </div>
        </div>
        <apex:iframe id="family-portal-help-block" src="/apex/FamilyPortalHelpBlock" />
    </apex:form>
</apex:page>