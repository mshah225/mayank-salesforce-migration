<apex:page controller="FamilyPortalController" action="{!familyPortalStep4OnLoad}" standardStylesheets="false" showHeader="false" html-lang="en-US">
    <title>ASU | Welcome ASU Families - Step 4</title>
    <link rel="icon" href="https://www.asu.edu/sites/all/themes/asu_home/favicon.ico" />

    <c:ASUBrandHeader />
    <div class="myasu-header-seo-container">
        <div>
            <div id="myasu-header-seo" class="myasu-cont">
                <a href="https://webapp4.asu.edu/myasu">Welcome ASU Families</a>
            </div>
        </div>
    </div>

    <c:FamilyPortalResources />
    <apex:slds />
    <c:SLDSRemoveGlobalStyles />
    
    <apex:variable var="pbc" value="{!progressBarController}" />
    <apex:form id="family-portal-upper-container" styleClass="slds-scope">
        <div class="progress-container well" style="margin-bottom: 3em;">
            <div class="slds-grid slds-gutters">
                <div class="slds-col slds-size_1-of-3" style="width: 100%; max-width: 1170px !important; margin: auto;">
                    <span style="font-weight:700;">Form Progress</span>
                    <div style="display: block;" class="slds-progress-bar slds-progress-bar_circular" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{!pbc.currentPercentage}" role="progressbar">
                        <span class="slds-progress-bar__value slds-progress-bar__value_success" style="width: {!pbc.currentPercentage}%;">
                            <span class="slds-assistive-text">Progress: {!pbc.currentPercentage}%</span>
                        </span>
                    </div>
                    <div class="slds-grid slds-grid_align-spread slds-p-bottom_x-small" id="progress-bar-label-id-6">
                        <span></span>
                        <span aria-hidden="true">
                            <strong>{!pbc.progressCounter}% Complete</strong>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </apex:form>

    <apex:form>
        <div id="accessible-body">
            <div class="family-portal-body-container">
                <div class="family-portal-4b-container">
                    <apex:pageBlock>
                        <div class="family-portal-4b-header">
                            <h3>If you have a current or future student, please tell us about them.</h3>
                        </div>
                        <apex:dataTable value="{!studentWrapperList}" var="swl" id="family-portal-student-page-block" >
                            <apex:column headerValue="Student">
                                <strong>Status</strong>
                                <apex:inputField value="{!swl.familyPortalStudentObj.Enrollment_Status__c}" />
                            </apex:column>
                            <apex:column>
                                <strong>Graduation Year</strong>
                                <apex:inputField value="{!swl.familyPortalStudentObj.Enrollment_Status_Year__c}" />
                            </apex:column>
                            <apex:column headerValue="Action"> 
                                <apex:commandButton action="{!removeStudentRow}" value="Remove" styleClass="btn btn-secondary" reRender="family-portal-student-page-block">
                                    <apex:param value="{!swl.studentIndex}" name="index" />
                                </apex:commandButton>
                            </apex:column>
                        </apex:dataTable>         
                        <div class="family-portal-double-button-container">
                            <div class="family-portal-double-button">
                                <apex:commandLink action="{!addStudentRow}" styleClass="btn btn-secondary btn-block" reRender="family-portal-student-page-block">
                                    Add Another Student
                                </apex:commandLink>
                            </div>
                            <div class="family-portal-double-button">
                                <apex:commandLink action="{!familyPortalStep5}" styleClass="btn btn-primary btn-block">
                                    Submit
                                </apex:commandLink>
                            </div>
                        </div>
                    </apex:pageBlock>
                </div>
                <c:FamilyPortalSidebar />
            </div>
        </div>
    </apex:form>
    <c:ASUBrandFooter />
</apex:page>