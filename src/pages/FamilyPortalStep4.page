<apex:page controller="FamilyPortalController" action="{!familyPortalStep4OnLoad}" standardStylesheets="false" showHeader="false" html-lang="en-US">
    <title>ASU | Welcome ASU Families - Step 4</title>
    <link rel="icon" href="https://www.asu.edu/sites/all/themes/asu_home/favicon.ico" />

    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no;" />

        <script src="https://code.jquery.com/jquery-3.5.0.min.js" />

        <style>
            .family-portal-4-no-students-text {
                font-weight: 400;
                margin-bottom: 1em;
            }
        </style>
    </head>

    <c:ASUBrandHeader />
    <div class="myasu-header-seo-container">
        <div>
            <div id="myasu-header-seo" class="myasu-cont">
                <a href="https://webapp4.asu.edu/myasu">Welcome ASU Families</a>
            </div>
        </div>
    </div>

    <c:FamilyPortalResources />
    <apex:slds />
    <c:SLDSRemoveGlobalStyles />
    
    <apex:variable var="pbc" value="{!progressBarController}" />
    <apex:form id="family-portal-upper-container" styleClass="slds-scope">
        <div class="progress-container well" style="margin-bottom: 3em;">
            <div class="slds-grid slds-gutters">
                <div class="slds-col slds-size_1-of-3" style="width: 100%; max-width: 1170px !important; margin: auto;">
                    <span style="font-weight:700;">Form Progress</span>
                    <div style="display: block;" class="slds-progress-bar slds-progress-bar_circular" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{!pbc.currentPercentage}" role="progressbar">
                        <span class="slds-progress-bar__value slds-progress-bar__value_success" style="width: {!pbc.currentPercentage}%;">
                            <span class="slds-assistive-text">Progress: {!pbc.currentPercentage}%</span>
                        </span>
                    </div>
                    <div class="slds-grid slds-grid_align-spread slds-p-bottom_x-small" id="progress-bar-label-id-6">
                        <span></span>
                        <span aria-hidden="true">
                            <strong>{!pbc.progressCounter}% Complete</strong>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </apex:form>

    <apex:form>
        <div id="accessible-body">
            <div class="family-portal-body-container">
                <div class="family-portal-4-container container">
                    <div class="row">
                        <div class="col-sm-6 family-portal-body-margin">
                            <apex:pageBlock>
                                <div class="family-portal-4-header">
                                    <h3>If you have current or future students, please tell us about them.</h3>
                                </div>
                                <apex:dataTable value="{!studentWrapperList}" var="swl" id="family-portal-student-page-block">
                                    <apex:column headerValue="My Students">
                                        <apex:outputText style="display:block; font-weight:bold;" value="Enrollment" />
                                        <apex:inputField style="margin-bottom:1em;" value="{!swl.familyPortalStudentObj.Enrollment_Status__c}">
                                            <apex:actionSupport event="onchange" rerender="family-portal-student-page-block" />
                                        </apex:inputField>
                                        <apex:outputText style="display:block; font-weight:bold;" value="High School Graduation Year" rendered="{!swl.familyPortalStudentObj.Enrollment_Status__c == 'K-12 Student'}" />
                                        <apex:inputField style="margin-bottom:1em;" value="{!swl.familyPortalStudentObj.Enrollment_Status_Year__c}" rendered="{!swl.familyPortalStudentObj.Enrollment_Status__c == 'K-12 Student'}" />
                                        <apex:outputText style="display:block; font-weight:bold;" value="Academic College" rendered="{!swl.familyPortalStudentObj.Enrollment_Status__c == 'ASU Student'}"/>
                                        <apex:inputField style="margin-bottom:1em;" value="{!swl.familyPortalStudentObj.Academic_College__c}" rendered="{!swl.familyPortalStudentObj.Enrollment_Status__c == 'ASU Student'}" />
                                        <apex:outputText style="display:block; font-weight:bold;" value="Student Type" rendered="{!swl.familyPortalStudentObj.Enrollment_Status__c == 'ASU Student'}" />
                                        <apex:selectCheckboxes style="margin-bottom:1em;" layout="pageDirection" value="{!swl.guardianSelectedStudentTypes}" rendered="{!swl.familyPortalStudentObj.Enrollment_Status__c == 'ASU Student'}">
                                            <apex:selectOptions value="{!swl.studentTypeChoices}" />
                                        </apex:selectCheckboxes>
                                        <apex:outputText style="display:block; font-weight:bold;" value="Military Affiliation" rendered="{!swl.familyPortalStudentObj.Enrollment_Status__c != null}" />
                                        <apex:inputField style="margin-bottom:1em;" value="{!swl.familyPortalStudentObj.Military_Affiliation__c}" rendered="{!swl.familyPortalStudentObj.Enrollment_Status__c != null}" />
                                    </apex:column>
                                    <apex:column style="vertical-align:middle; text-align:center;"> 
                                        <apex:commandLink style="border-bottom:none;text-decoration:none;" action="{!removeStudentRow}" styleClass="removebtm" reRender="family-portal-student-page-block">
                                            <apex:param value="{!swl.studentIndex}" name="index" />
                                            <i class="fa fa-3x fa-times-circle" />
                                        </apex:commandLink>
                                    </apex:column>
                                </apex:dataTable>
                                <div class="family-portal-4-no-students-text">Please add a student or submit the form without adding students.</div>         
                                <div class="family-portal-double-button-container">
                                    <div class="family-portal-double-button">
                                        <apex:commandLink action="{!addStudentRow}" styleClass="btn btn-secondary btn-block firstbutton" reRender="family-portal-student-page-block">
                                            Add A Student
                                        </apex:commandLink>
                                    </div>
                                    <div class="family-portal-double-button">
                                        <apex:commandLink action="{!familyPortalStep5}" styleClass="btn btn-primary btn-block">
                                            Submit
                                        </apex:commandLink>
                                    </div>
                                </div>
                            </apex:pageBlock>
                        </div>
                        <div class="col-sm-1"></div>
                        <div class="col-sm-5">
                            <c:FamilyPortalSidebar />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </apex:form>
    <c:ASUBrandFooter />

    <script>

    if ($('tr:has(td)')) {
        $('.firstbutton').text('Add Another Student');
        $('.family-portal-4-no-students-text').hide();
    }

    if ($('.removebtm').length == 0) {
        $('.firstbutton').text('Add A Student');
        $('.family-portal-4-no-students-text').toggle();
    }

    $('a.firstbutton').click(function () {
        if ($('tr:has(td)')) {
            $('.firstbutton').text('Add Another Student');
            $('.family-portal-4-no-students-text').hide();
        }
    })

    $(document).on("click", ".removebtm", function () {
        if ($('.removebtm').length == 1) {
            $('.firstbutton').text('Add A Student');
            $('.family-portal-4-no-students-text').toggle();
        }
    })
    </script>
</apex:page>