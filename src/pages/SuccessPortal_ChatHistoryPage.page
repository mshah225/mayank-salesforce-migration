<apex:page controller="SuccessPortal_ChatHistoryPageController" 
           showHeader="false"
           sidebar="false"
           id="chatHistory"
           docType="html-5.0">

           <apex:includeScript value="https://code.jquery.com/jquery-1.12.4.js" />
           <apex:includeScript value="https://code.jquery.com/ui/1.12.0/jquery-ui.js" />

    <head>
    <script type="text/javascript">
        setDate = function(startDate, endDate){
            startDate = startDate.split('-');
            endDate = endDate.split('-');

            $( '[id*=startDate]' ).datepicker();
            $( '[id*=startDate]' ).datepicker("setDate",startDate[1] + "/" + startDate[2] + "/" + startDate[0]);
            $( '[id*=startDate]' ).datepicker({
               dateFormat : "mm/dd/yy"
            });
            
            $( '[id*=endDate]' ).datepicker();
            $( '[id*=endDate]' ).datepicker("setDate",endDate[1] + "/" + endDate[2] + "/" + endDate[0]);
            $( '[id*=endDate]' ).datepicker({
               dateFormat : "mm/dd/yy"
            });
        }; 
   
        $( function() {
            setDate('{!startDate}','{!endDate}');
        });
    </script>
    <style type="text/css">
        body {
            background: #f2f2f2;
            color: #334b70;
        }

        #first {
            width: 550px;
            float: left; /* add this */
            padding-right: 10px;
        }

        #second {
            overflow: hidden; 
        }

        #third {
            width: 100%;
        }

        .pbTitle {
            white-space: nowrap;
        }

        .btn.customBtn {
            min-width: 60px;
            padding: 5px 10px;
            margin: 5px;
            background: #f4f5f7;
            color: #334b70;
            font-weight: 100;
            font-size: 12px;
            text-decoration: none;
            border-radius: 2px;
            border: solid 1px #7f7f7f;
        }

        .btn.customActionBtn {
            min-width: 60px;
            padding: 5px 10px;
            margin: 5px;
            background: #0070d2;
            color: #fff;
            font-weight: 100;
            font-size: 12px;
            text-decoration: none;
            border-radius: 2px;
            border: solid 1px #4a90e2;
        }
        
        .bPageBlock {
            border-top: 3px solid #0070d2 !important;
            border-radius: 0px !important;
            background: #fdfdfd !important;
        }

        input {
            padding: 3px;
        }

        td, tr, th.labelCol {
            vertical-align: middle !important;
        }

        .list tr, .list td {
            padding: 10px !important;
        }

        fieldset {
            border: none !important;
        }

        .message {
            margin: 0px 0px 10px 0px !important;
        }

        .dateFormat {
            display: none;
        }

        td.dataCol {
            padding: 7px !important;
        }

        .headerRow a, .headerRow {
            color: #607395 !important;
            text-transform: uppercase;
        }

        .labelCol {
            color: #546990 !important;
        }
        .oddRows{
            background-color: #e6e6e6;
        }
        
        .evenRows{
            background-color: white;
        }
        
    </style>
    </head>
<body>
    <!--VISUALSTRAP COMPONENTS-->
    <c:vsimportvisualstrap theme="paper" />
    <c:vsPageBlockTableEnhancer enableExport="false" noConflict="true" targetPbTableIds="chatHistoryResults" paginate="true" defaultPageSize="5" pageSizeOptions="5,10,20,30,40,50"/>  

    <apex:stylesheet value="{!URLFOR($Resource.MyASUHeader4_3,'MyASUHeader4_3/font-awesome-4.3.0/css/font-awesome.css')}"/>
    
    <apex:outputPanel id="wrapper" layout="block" style="margin-top:10px;min-width:1200px;overflow:auto;padding:10px;">

            <apex:form id="frmMain" html-novalidate="novalidate">
         
            <apex:pageMessages id="messages"/>

            <div id="second">                
                <apex:outputPanel id="innersecond" layout="block">
                    <apex:outputPanel id="innersecondOpenCases"
                                      layout="block">
     
                    <apex:pageBlock title="Chat History" id="opencasespb">
                        <apex:actionFunction name="searchChat"
                                                 action="{!init}"
                                                 rerender="innersecondOpenCases"
                                                 status="loadingStatus"
                                                 oncomplete="initPageBlockTableEnhancerADV();setDate('{!startDate}','{!endDate}');">
                            <apex:param name="resourceASURiteId" value=""/>
                            <apex:param name="studentASURiteId" value=""/>
                            <apex:param name="startDateSrch" value=""/>
                            <apex:param name="endDateSrch" value=""/>
                        </apex:actionFunction>
                        
                        <apex:pageBlockButtons location="top">
 
                            <div style="text-align:left;">
                            <apex:outputLabel value="Start Date: " for="startDate"/>
                            <apex:input id="startDate"
                                    value="{!startDate}"
                                    type="text" />
                            <apex:outputLabel value="End Date: " for="endDate"/>
                            <apex:input id="endDate"
                                    value="{!endDate}"
                                    type="text" />      
                            <apex:commandButton id="searchBtn"
                                    value="Search"
                                    onClick="doSearch(); return false;"
                                    rerender="innersecondOpenCases"
                                    styleClass="customActionBtn"/>
                            <apex:actionStatus id="loadingStatus" >
                                <apex:facet name="start" >
                                    <i class="fa fa-spinner fa-spin"
                                        style="margin-top:8px;margin-left:15px;
                                        font-size:14pt;color:#334b70;position:absolute;"></i>
                                </apex:facet>
                            </apex:actionStatus>
                            </div>
                        </apex:pageBlockButtons>

                        <apex:inputHidden value="{!resourceASURiteId}" id="rASURiteId"/>
                        <apex:inputHidden value="{!studentASURiteId}" id="sASURiteId"/>

                        <div style="height:auto;overflow-y:auto;border-bottom: solid 1px #ccc;">
                           <apex:outputPanel rendered="{!IF(!isError && chatHistory == null, true, false)}">
                                <div style="font-weight:bold;height:auto;padding:15px;">
                                    Chat History Not Found.
                                </div>
                            </apex:outputPanel>
                            
                            <apex:outputPanel rendered="{!IF(!isError && !isStudentAssigned, true, false)}">
                                <div style="font-weight:bold;height:100px;padding:15px;">
                                    Chat History Not Allowed for this Resource/Student combination.
                                </div>
                           </apex:outputPanel>
                           
                           <apex:outputPanel >
                               <c:vsVisualStrapBlock >
                                   <apex:pageBlockTable value="{!chatHistory}"
                                             rendered="{!IF((!isError && chatHistory != null && isStudentAssigned), true , false)}"
                                             var="chat"
                                             id="chatHistoryResults"
                                             styleClass="table table-striped table-hover">
                                         <apex:column headerValue="Username"
                                                     value="{!chat.chatUsername}"
                                                     title="Username"/>
                                         <apex:column headerValue="Name"
                                                     value="{!chat.chatName}"
                                                     title="Name"/>
                                         <apex:column headerValue="Message"
                                                     value="{!chat.chatMessage}"
                                                     title="Message"
                                                     rendered="{!IF(!chat.hasUrl, true, false)}"/>
                                          <apex:column headerValue="Message" title="Message" rendered="{!IF(!chat.hasUrl, false, true)}">
                                              <apex:outputLink target="_blank" value="{!chat.chatMessage}">{!chat.chatMessage}</apex:outputLink>
                                          </apex:column>     
                                         <apex:column headerValue="Date"
                                                     value="{!chat.chatDate}"
                                                     title="Date"
                                                     html-data-order="{!chat.chatDate}"/>
                                    </apex:pageBlockTable>
                                </c:vsVisualStrapBlock>
                            </apex:outputPanel>
                        </div>
                    </apex:pageBlock>
                    </apex:outputPanel>
                </apex:outputPanel>
            </div>
            </apex:form>
    </apex:outputPanel>

    </body>
    
      <script type='text/javascript'>
        function doSearch() {
            var rASURiteId = document.getElementById('{!$Component.chatHistory:frmMain:opencasespb:rASURiteId}').value;
            var sASURiteId = document.getElementById('{!$Component.chatHistory:frmMain:opencasespb:sASURiteId}').value;
            
            var _startDate = $( '[id*=startDate]' ).datepicker("getDate");
            var startDate = $.datepicker.formatDate("yy-mm-dd", _startDate);
            
            var _endDate = $( '[id*=endDate]' ).datepicker("getDate");
            var endDate = $.datepicker.formatDate("yy-mm-dd", _endDate);

            console.log("Date: " + startDate);
            searchChat(rASURiteId,sASURiteId,startDate,endDate);
        }
    </script>
    
</apex:page>