<apex:page showHeader="false"
    sidebar="false"
    cache="true"
    docType="html-5.0"
    controller="AKBController"
    action="{!init}"
    extensions="ServiceCenter,vfKeywordSearchController,AutoCompleteController,NavLinks">
<head>
    <title>My ASU | {!article.title}</title>
    <c:asu_responsive_header_section />
    
    <style>
        .detailList a {
            color: #990033 !important;
        }

        body {
            overflow-x: scroll !important;
        }

        .caseTab .secondaryPalette, .individualPalette .caseBlock .secondaryPalette {
            border-top-color: #990033 !important;
        }

        .x-toolbar-ct tr td{
            vertical-align: middle !important;
            padding: 0px !important;
        }

        .bPageBlock .detailList .labelCol {
            width: 1% !important;
            font-size: 8pt;
        }

        .searchKB2 {
            margin-bottom: -10px !important;
        }

        .header {
            margin-left: 0px !important;
        }

        iframe, embed {
            width: 100% !important;
            max-width: 500px !important;
        }

        .img-responsive {
            width: 100% !important;
            max-width: 450px !important;
        }

        th.labelCol.vfLabelColTextWrap {
            display: none !important;
        }

        .articleContent {
            word-break: break-word !important;
            padding: 0px;
        }

        .modal-content {
            border-radius: 0px !important;
            box-shadow: none !important;
        }

        .submitButton, .clearButton {
            padding 2px !important;
        }

        @media screen and (max-width: 931px) {
            .sparky {
                display: none !important;
            }
        }

        @-moz-document url-prefix() {
            .clearButton, .submitButton {
                height: 17px !important;
            }
        }

        @media screen and (-webkit-min-device-pixel-ratio:0) {
            .clearButton, .submitButton {
                height: 16px !important;
                padding-top: 5px !important;
            }
        }
    </style>

    <script>
        (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
        (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
        m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
        })(window,document,'script','//www.google-analytics.com/analytics.js','ga');

        ga('create', 'UA-47141114-2', 'auto');
        ga('set', 'dimension1', '{!funcGroup}');
        ga('set', 'dimension2', '{!artType}');
        ga('set', 'dimension3', '{!article.CreatedBy.Name}');
        ga('set', 'dimension4', '{!userContact.Name}');
        ga('send', 'pageview');
    </script>

    <c:SCBomgarScripts asurite="{!userContact.ASURite_Id__c}"/>
</head>
<body onload="getLinks()">
    <div id="main-search" class="main-search closed"></div>
    <c:SCHeader/>

    <div id="asu_content_well">
        <c:SCPageNotifications/>
        
        <div class="container">
            <ol class="breadcrumb">
                <li><a href="/studentSC">Back</a></li>
                <li class="active" style="font-size:10pt;">View Article</li>
            </ol>
            <div class="row">
                <div class="col-md-7">
                    <div class="box">
                        <div class="header">
                            <h6><b>Knowledge Article &#35;{!article.ArticleNumber}</b></h6>
                        </div>
                        <div class="content">
                            <apex:form id="autoCompleteForm" styleClass="searchKB">
                                <apex:pageBlock mode="maindetail">
                                    <p>Search the Knowledge Base for more articles.</p><br />
                                    <div class="searchKB2">
                                        <div class="form-horizontal">
                                            <apex:inputText id="articleTextBoxId" value="{!searchstring}" styleClass="searchBox"
                                            html-placeholder="Enter search terms"/>
                                            <apex:commandButton value="Search" action="{!checkSearchString}" id="submitButton" styleClass="kbbtn searchBtn" reRender="theSearchResults"/>
                                            <apex:commandButton value="Clear" styleClass="kbbtn searchBtn" style="width:37px;" onclick="this.form.reset();return false;"/>
                                        </div>
                                        <apex:inputHidden id="searchArticleId" value="{!selectedArticle}" />
                                    </div>
                                </apex:pageBlock>
                            </apex:form>
                            <apex:form id="theSearchResults">
                                <apex:pageBlock mode="maindetail" rendered="{!searchstring != ''}">
                                    <br />
                                    <hr />
                                    <h5><b>Search Results for:</b> '{!searchstring}'</h5>
                                    <div style="height:5px;"></div>
                                    <knowledge:articleList articleVar="articleSearch"
                                        pageNumber="{!currentPageNumber}"
                                        Keyword="{!searchstring}"
                                        hasMoreVar="true"
                                        pageSize="10"
                                        rendered="{!searchstring != ''}">
                                        <table>
                                            <tr>
                                                <td style="vertical-align:top;">
                                                    &#8226;&nbsp;
                                                </td>
                                                <td>
                                                    <apex:outputLink value="/akb?id={!articleSearch.id}">{!articleSearch.title}</apex:outputLink>
                                                    <br />
                                                    <div style="height:6px;"></div>
                                                </td>
                                            </tr>
                                        </table>
                                    </knowledge:articleList>
                                    <button class="btn kbbtn" data-toggle="modal" data-target="#suggestAnArticle">
                                    Suggest An Article
                                    </button>
                                </apex:pageBlock>

                                <apex:outputPanel rendered="{!searchString == null}">
                                    <br />
                                </apex:outputPanel>
                            </apex:form>
                            <hr />
                            <h3>{!article.title}</h3>
                            <br />
                            <br />
                            <apex:form id="articleContentForm">
                                <apex:actionFunction name="setLink" action="{!changeLink}" oncomplete="changeLinkOnPage('{!fixedLinksJSON}')" reRender="url1">
                                    <apex:param name="urlNameToChange" value="" assignTo="{!urlsJSON}" />
                                </apex:actionFunction>
                                <div id="articleContentDiv" class="articleContent">
                                    <apex:pageBlock tabStyle="Case">
                                        <apex:pageBlockSection columns="1">
                                            <apex:outputText value="Category" rendered="{!IF(faq.Functional_Group__c != null,true,false)}" style="font-size:8pt;font-weight:bold;margin-left:-5px;color:#4a4a5b"/>
                                            <apex:outputText rendered="{!IF(faq.Functional_Group__c != null,true,false)}" value="{!faq.Functional_Group__c}"/>
                                            <apex:outputText value="Category" rendered="{!IF(info.Functional_Group__c != null,true,false)}" style="font-size:8pt;font-weight:bold;margin-left:-5px;color:#4a4a5b"/>
                                            <apex:outputText rendered="{!IF(info.Functional_Group__c != null,true,false)}" value="{!info.Functional_Group__c}"/>
                                            <apex:outputText value="Category" rendered="{!IF(howTo.Functional_Group__c != null,true,false)}" style="font-size:8pt;font-weight:bold;margin-left:-5px;color:#4a4a5b"/>
                                            <apex:outputText rendered="{!IF(howTo.Functional_Group__c != null,true,false)}" value="{!howTo.Functional_Group__c}"/>
                                            <apex:outputText rendered="{!IF(faq.Functional_Group__c != null || info.Functional_Group__c != null || howTo.Functional_Group__c != null,true,false)}">
                                            <hr />
                                            </apex:outputText>
                                            <apex:outputField value="{!info.Information__c}" rendered="{!IF(article.ArticleType = 'Informational__kav',true,false)}" label=""/>
                                            <apex:outputText value="Question" rendered="{!IF(article.ArticleType = 'FAQ__kav',true,false)}" style="font-size:8pt;font-weight:bold;margin-left:-5px;color:#4a4a5b"/>
                                            <apex:outputField value="{!faq.Question__c}" rendered="{!IF(article.ArticleType = 'FAQ__kav',true,false)}" label="" styleClass="noLabel"/>
                                            <apex:outputText value="Answer" rendered="{!IF(article.ArticleType = 'FAQ__kav',true,false)}" style="font-size:8pt;font-weight:bold;margin-left:-4px;color:#4a4a5b"/>
                                            <apex:outputField value="{!faq.Answer__c}" rendered="{!IF(article.ArticleType = 'FAQ__kav',true,false)}" label="" styleClass="noLabel"/>
                                            <apex:outputField value="{!howto.Content__c}" rendered="{!IF(article.ArticleType = 'How_To__kav',true,false)}" label=""/>
                                        </apex:pageblocksection>
                                    </apex:pageBlock>
                                </div>
                            </apex:form>
                            <div class="page-header">
                                <h5>Article Feedback</h5>
                            </div>
                            <apex:form id="feedbackButtons">
                                <apex:outputPanel rendered="{!feedbackVisible}">
                                    <p>&nbsp;Was this article helpful?</p>
                                    &nbsp;
                                    <apex:commandButton value="Yes" action="{!helpfulYes}" styleClass="btn btn-default" style="width:25px;height:15px;padding:3px;"/>
                                    &nbsp;
                                    <!-- Button trigger modal -->
                                    <button class="btn btn-default" data-toggle="modal" data-target="#feedbackNoComments" style="width:25px;height:15px;padding:3px;">
                                        No
                                    </button>
                                </apex:outputPanel>

                                 <apex:outputPanel rendered="{!NOT(feedbackVisible)}">
                                     <p>Thanks for the feedback!</p>
                                 </apex:outputPanel>
                             </apex:form>

                             <apex:form id="feedbackNoComments">
                                 <!-- Modal -->
                                 <div class="modal fade" id="feedbackNoComments" tabindex="-1" role="dialog" aria-labelledby="feedbackCommentsLabel" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                                                <h6 class="modal-title" id="feedbackCommentsLabel">Feedback - {!article.title}</h6>
                                            </div>
                                            <div class="modal-body">
                                                <p>Please tell us how we can make this article more useful.</p>
                                                <apex:pageBlock mode="maindetail">
                                                    <apex:inputField id="articleFeedback" required="true" value="{!feedbackHelpful.Comments__c}" style="width:100%;max-width:400px;height:100px;"/>
                                                </apex:pageBlock>
                                            </div>
                                            <div class="modal-footer">
                                                <div class="pull-left">
                                                    <apex:commandButton value="Submit" action="{!helpfulNo}" styleClass="btn btn-default" style="width:40px;height:15px;padding:3px;"/>
                                                    <button type="button" class="btn btn-default" data-dismiss="modal" style="width:35px;height:15px;padding:3px;margin-top:0px;">Close</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </apex:form>
                        </div>
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="box">
                        <div class="header">
                            <h6><b>Articles You May Find Helpful</b></h6>
                        </div>
                        <div class="content">
                            <knowledge:articleList articleVar="relatedart"
                                keyword="{!titleKeyword}"
                                hasMoreVar="true"
                                pageSize="6">
                                <table>
                                    <tr id="relatedArticleLink">
                                        <td style="vertical-align:top;">
                                            &#8226;&nbsp;
                                        </td>
                                        <td>
                                            <apex:outputLink value="/akb?id={!relatedart.id}">{!relatedart.title}</apex:outputLink>
                                            <br />
                                            <div style="height:6px;"></div>
                                        </td>
                                    </tr>
                                </table>
                            </knowledge:articleList>

                            <script>
                                $( '[id$=relatedArticleLink]' ).first().hide();
                            </script>

                            <br />
                            <button class="btn kbbtn" data-toggle="modal" data-target="#suggestAnArticle">
                                Suggest An Article
                            </button>
                        </div>
                    </div>
                    <apex:form id="suggestAnArticle">
                        <!-- Modal -->
                        <div class="modal fade" id="suggestAnArticle" tabindex="-1" role="dialog" aria-labelledby="suggestAnArticleLabel" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                                        <h6 class="modal-title" id="suggestAnArticleLabel">Suggest An Article</h6>
                                    </div>
                                    <div class="modal-body">
                                        <apex:pageBlock mode="maindetail">
                                            <p>Have an idea for an article you'd like to see? Please tell us below!</p>
                                            <br />
                                            <apex:inputField id="articleDetails" required="true" value="{!suggestAnArticle.Description}" style="width:100%;max-width:400px;height:100px;"/>
                                        </apex:pageBlock>
                                    </div>
                                    <div class="modal-footer">
                                        <div class="pull-left">
                                            <apex:commandButton value="Submit" action="{!suggestAnArticleSubmit}" styleClass="btn btn-default" style="width:40px;height:15px;padding:3px;"/>
                                            <button type="button" class="btn btn-default" data-dismiss="modal" style="width:35px;height:15px;padding:3px;margin-top:0px;">Close</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </apex:form>
                    <c:SCImmediateAssistanceBox HelpBox="{!HelpBox}"
                                                NormalPhone="{!NormalPhone}"
                                                RoverPhone="{!RoverPhone}"
                                                myPin="{!myPin}"
                                                newPin="{!newPin}"
                                                changePin="{!changePin}"/>
                    <c:SCMyCasesBox/>
                </div><!-- end col-md-4 -->
            </div>
        </div><!-- end row -->
        <c:SCFooter/>
    </div><!-- end ASU Content -->

    <script>
        $( document ).ready(function() {
            $( "#articleContentDiv img" ).addClass("img-responsive");
        });
    </script>

    <script>
        function getLinks()
        {
            var links = document.getElementById("{!$Component.articleContentForm}").getElementsByTagName("a");
            var addLink;
            var linkArray = [];
            var articleLinks = []

            for (i = 0; i < links.length; i++)
            {
                if (links[i].href.indexOf('/articles') > -1)
                {
                    articleLinks.push(links[i]);
                }
            }

            for (i = 0; i < articleLinks.length; i++)
            {
                addlink = articleLinks[i].href.substring(articleLinks[i].href.lastIndexOf("/") + 1);
                linkArray.push(addlink);
            }
            linkArray = JSON.stringify(linkArray);
            setLink(linkArray);
        }

        function changeLinkOnPage(newLinks)
        {
            var links = document.getElementById("{!$Component.articleContentForm}").getElementsByTagName("a");
            var articleLinks = []
            var parsed = JSON.parse(newLinks);
            var arr = [];

            for (i = 0; i < links.length; i++)
            {
                if (links[i].href.indexOf('/articles') > -1)
                {
                    articleLinks.push(links[i]);
                }
            }

            for (var x in parsed)
            {
                arr.push(parsed[x]);
            }

            for (i = 0; i < articleLinks.length; i++)
            {
                articleLinks[i].href = arr[i];
                articleLinks[i].target = "_self";
            }
            return false;
        }
    </script>

    <script>
        if (!(navigator.userAgent.match(/Android/i)
             || navigator.userAgent.match(/webOS/i)
             || navigator.userAgent.match(/iPhone/i)
             || navigator.userAgent.match(/iPad/i)
             || navigator.userAgent.match(/iPod/i)
             || navigator.userAgent.match(/BlackBerry/i)
             || navigator.userAgent.match(/Windows Phone/i)))
        {
            document.getElementById("normalPhone").addEventListener("click", function(event){
                event.preventDefault();
            });

            document.getElementById("normalPhone").addEventListener("contextmenu", function(event){
                event.preventDefault();
            });

            document.getElementById("roverPhone").addEventListener("click", function(event){
                event.preventDefault();
            });

            document.getElementById("roverPhone").addEventListener("contextmenu", function(event){
                event.preventDefault();
            });
        }
    </script>
</body>
</apex:page>
