        .caseTab .secondaryPalette, .individualPalette .caseBlock .secondaryPalette {
            border-top-color: #990033 !important;
        }
        
        .x-toolbar-ct tr td{
            vertical-align: middle !important;
            padding: 0px !important;
        }
       
        .bPageBlock .detailList .labelCol {
            width: 1% !important;
            font-size: 8pt;
        }
        
        .searchKB2 {
            margin-bottom: -10px !important;
        }
        
        .header {
            margin-left: 0px !important;
        }
        
        iframe, embed {
            width: 100% !important;
            max-width: 500px !important;
        }
        
        .img-responsive { 
            width: 100% !important; 
            max-width: 450px !important; 
        }
        
        th.labelCol.vfLabelColTextWrap {
            display: none !important;
        }
        
        .articleContent {
            word-break: break-word !important;
            padding: 0px;
        }
        
        .modal-content {
            border-radius: 0px !important;
            box-shadow: none !important;
        }
        
        .submitButton, .clearButton {
            padding 2px !important;
        }
               
        @media screen and (max-width: 931px) {
            .sparky {
                display: none !important;
            }
        }
        
        @-moz-document url-prefix() {
            .clearButton, .submitButton {
                height: 17px !important;
            }
        }
        
        @media screen and (-webkit-min-device-pixel-ratio:0) { 
            .clearButton, .submitButton {
                height: 16px !important;
                padding-top: 5px !important;
            }            
        }
    </style>
    
    <script src="https://bomgar.asu.edu/api/start_session.js"></script>
    <script>
        BG.setSite("bomgar.asu.edu");
        var custName = "{!$Component.customer_name}";
        var desc = "{!$Component.description}";
        var emplid = "{!$User.EmplId__c}";
    
        function start(){
            var jsonString = null;
            var jsonObject = {};
            jsonObject.employeeNumber = emplid;
            jsonObject.description = document.getElementById('description').value;
            try{
                jsonString = JSON.stringify(jsonObject);
            }
            catch(e){
            
            }
            if(jsonString == null){
                jsonString = '{"employeeNumber":"{!$User.EmplId__c}", "description":"' + document.getElementById('description').value + '"}';
            }
                     
            BG.start(BG.START_TYPE.CHAT, {
                issue: {
                    codeName: 'salesforce_chat',
                    customerName: '{!$User.Contact_First_Name__c} {!$User.Contact_Last_Name__c}',
                    companyName: 'ASU',
                    details: document.getElementById('description').value
                },
                attributes:{
                    externalKey: ('SFDC:' + jsonString)
                },
                uiOptions:{
                    fallbackToFullWindow:true
                }
            });              
        }
    </script> 
    
    <script>
        $( document ).ready(function() {
            $( "#articleContentDiv img" ).addClass("img-responsive");
        });
    </script>

    <script>
        function getLinks(){ 
            var links = document.getElementById("{!$Component.articleContentForm}").getElementsByTagName("a");
            var addLink;
            var linkArray = [];
            var articleLinks = []

            for(i = 0; i < links.length; i++) {
                if(links[i].href.indexOf('/articles') > -1) {
                    articleLinks.push(links[i]);
                }
            }

            for(i = 0; i < articleLinks.length; i++) {
                addlink = articleLinks[i].href.substring(articleLinks[i].href.lastIndexOf("/") + 1);;
                linkArray.push(addlink);
            }
            linkArray = JSON.stringify(linkArray);
            setLink(linkArray);
        }
        
        function changeLinkOnPage(newLinks) {
            var links = document.getElementById("{!$Component.articleContentForm}").getElementsByTagName("a");
            var articleLinks = []
            var parsed = JSON.parse(newLinks);
            var arr = [];

            for(i = 0; i < links.length; i++) {
                if(links[i].href.indexOf('/articles') > -1) {
                    articleLinks.push(links[i]);
                }
            }

            for(var x in parsed){
                arr.push(parsed[x]);
            }

            for(i = 0; i < articleLinks.length; i++) {
                articleLinks[i].href = arr[i];
                articleLinks[i].target = "_self";
            }
            return false;
        }
    </script>
</head>
