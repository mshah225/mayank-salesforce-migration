<apex:page showHeader="false"
    sidebar="false"
    cache="true"
    docType="html-5.0"
    controller="AKBController"
    action="{!init}"
    extensions="ServiceCenter,vfKeywordSearchController,AutoCompleteController,NavLinks,newCase"
    tabStyle="Case">
<head>
    <title>My ASU - {!article.title}</title>
    <c:asu_responsive_header_section />

    <style>
        .detailList a {
            color: #990033 !important;
        }

        body {
            overflow-x: scroll !important;
        }

        .caseTab .secondaryPalette, .individualPalette .caseBlock .secondaryPalette {
            border-top-color: #990033 !important;
        }

        .x-toolbar-ct tr td{
            vertical-align: middle !important;
            padding: 0px !important;
        }

        .bPageBlock .detailList .labelCol {
            width: 1% !important;
            font-size: 8pt;
        }

        .searchKB2 {
            margin-bottom: -10px !important;
        }

        .header {
            margin-left: 0px !important;
        }

        iframe, embed {
            width: 100% !important;
            max-width: 500px !important;
        }

        .img-responsive {
            width: 100% !important;
            max-width: 450px !important;
        }

        th.labelCol.vfLabelColTextWrap {
            display: none !important;
        }

        .articleContent {
            word-break: break-word !important;
            padding: 0px;
        }

        .modal-content {
            border-radius: 0px !important;
            box-shadow: none !important;
        }

        .submitButton, .clearButton {
            padding 2px !important;
        }

        @media screen and (max-width: 931px) {
            .sparky {
                display: none !important;
            }
        }

        @-moz-document url-prefix() {
            .clearButton, .submitButton {
                height: 17px !important;
            }
        }

        @media screen and (-webkit-min-device-pixel-ratio:0) {
            .clearButton, .submitButton {
                height: 16px !important;
                padding-top: 5px !important;
            }
        }
    </style>

    <script>
        (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
        (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
        m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
        })(window,document,'script','//www.google-analytics.com/analytics.js','ga');

        ga('create', 'UA-47141114-2', 'auto');
        ga('set', 'dimension1', '{!funcGroup}');
        ga('set', 'dimension2', '{!artType}');
        ga('set', 'dimension3', '{!article.CreatedBy.Name}');
        ga('set', 'dimension4', '{!currentUser}');
        ga('send', 'pageview');
    </script>

    <script src="https://bomgar.asu.edu/api/start_session.js"></script>
    <script>
        BG.setSite("bomgar.asu.edu");

        // Start 'Finances' Chat
        function startFAChat()
        {
            var jsonString = null;
            var jsonObject = {};
                jsonObject.employeeNumber = "{!$User.EmplId__c}";
                jsonObject.description = document.getElementById('FADesc').value;
                jsonObject.asuriteId = "{!$User.Alias}";
                jsonObject.externalKey = 'Finances';
            try
            {
                jsonString = JSON.stringify(jsonObject);
            }
            catch (e)
            {

            }
            if (jsonString == null)
            {
                jsonString = '{"employeeNumber":"{!$User.EmplId__c}", "description":"' + document.getElementById('FADesc').value + '", "asuriteId":"{!$User.Alias}", "externalKey":"Finances"}';
            }

            BG.start(BG.START_TYPE.CHAT,
            {
                issue:
                {
                    codeName: 'studentfinances_chat',
                    customerName: "{!$User.FirstName} {!$User.LastName}",
                    companyName: 'ASU',
                    details: document.getElementById('FADesc').value
                },
                attributes:
                {
                    externalKey: ('SFDC:' + jsonString)
                },
                uiOptions:
                {
                    fallbackToFullWindow:true
                }
            });
        }
    </script>

    <script>
        BG.setSite("bomgar.asu.edu");

        // Start 'Other' Chat
        function startSFDCChat()
        {
            var jsonString = null;
            var jsonObject = {};
                jsonObject.employeeNumber = "{!$User.EmplId__c}";
                jsonObject.description = document.getElementById('SFDCDesc').value;
                jsonObject.asuriteId = "{!$User.Alias}";
                jsonObject.externalKey = 'Other';
            try
            {
                jsonString = JSON.stringify(jsonObject);
            }
            catch (e)
            {

            }
            if (jsonString == null)
            {
                jsonString = '{"employeeNumber":"{!$User.EmplId__c}", "description":"' + document.getElementById('SFDCDesc').value + '", "asuriteId":"{!$User.Alias}", "externalKey":"Other"}';
            }

            BG.start(BG.START_TYPE.CHAT,
            {
                issue:
                {
                    codeName: 'salesforce_chat',
                    customerName: "{!$User.FirstName} {!$User.LastName}",
                    companyName: 'ASU',
                    details: document.getElementById('SFDCDesc').value
                },
                attributes:
                {
                    externalKey: ('SFDC:' + jsonString)
                },
                uiOptions:
                {
                    fallbackToFullWindow:true
                }
            });
        }
    </script>
</head>
