                        <script>
                            $( "[id$=qmarkPin]" ).click(function() {
                                $( "[id$=tooltipPin]" ).show();    
                            });
                            
                            $( "[id$=closeTooltip]" ).click(function() {
                                $( "[id$=tooltipPin]" ).hide();    
                            });
                            
                            $(document).mouseup(function (e) {
                                var container = $( "[id$=tooltipPin]" );
                                if (!container.is(e.target) && container.has(e.target).length === 0) {
                                    container.hide();
                                }
                            });
                        </script>
                                                
                        <script>
                            //Show and hide our buttons and input boxes. 
                            $( "[id$=viewPinBtn]" ).click(function() {
                                $( "[id$=yourPinHidden]" ).hide();
                                $( "[id$=viewPinBtn]" ).hide();
                                $( "[id$=hidePinBtn]" ).show();
                                $( "[id$=yourPin]" ).show();
                            });
                            
                            $( "[id$=hidePinBtn]" ).click(function() {
                                $( "[id$=hidePinBtn]" ).hide();
                                $( "[id$=yourPin]" ).hide();
                                $( "[id$=yourPinHidden]" ).show();
                                $( "[id$=yourPinHidden]" ).val( "••••••••••" );
                                $( "[id$=viewPinBtn]" ).show();
                            });
                        
                            $( "[id$=resetPin]" ).click(function() {
                                $( "[id$=hidePinBtn]" ).hide();
                                $( "[id$=yourPin]" ).hide();
                                $( "[id$=yourPinHidden]" ).hide();
                                $( "[id$=viewPinBtn]" ).hide();
                                $( "[id$=resetPin]" ).hide();
                                $( "[id$=newPinInput]" ).show().focus();
                                $( "[id$=savePinBtn]" ).show();
                                $( "[id$=cancelPinInput]" ).show();
                            });
                            
                            $( "[id$=cancelPinInput]" ).click(function() {
                                $( "[id$=yourPinHidden]" ).show();
                                $( "[id$=yourPinHidden]" ).val( "••••••••••" );
                                $( "[id$=yourPin]" ).hide();
                                $( "[id$=viewPinBtn]" ).show();
                                $( "[id$=resetPin]" ).show();
                                $( "[id$=newPinInput]" ).hide();
                                $( "[id$=savePinBtn]" ).hide();
                                $( "[id$=cancelPinInput]" ).hide();
                            });
                            
                            //populate the hidden field on page load
                            $( document ).ready(function() {
                                $( "[id$=yourPinHidden]" ).val( "••••••••••" );
                                $( "[id$=newPinInput]" ).val( "" );
                            });
                        
                            //function to prevent anthing but numbers be entered into our reset pin box.
                            function inputLimiter(e,allow) {
                                var AllowableCharacters = '';
                    
                                if (allow == 'Letters'){AllowableCharacters=' ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';}
                                if (allow == 'Numbers'){AllowableCharacters='1234567890';}
                                if (allow == 'NameCharacters'){AllowableCharacters=' ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-.\'';}
                                if (allow == 'NameCharactersAndNumbers'){AllowableCharacters='1234567890 ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-\'';}
                                if (allow == 'Currency'){AllowableCharacters='1234567890.';}
                    
                                var k = document.getElementById('newPinInput')?parseInt(e.keyCode): parseInt(e.which);
                                if (k!=13 && k!=8 && k!=0){
                                    if ((e.ctrlKey==false) && (e.altKey==false)) {
                                    return (AllowableCharacters.indexOf(String.fromCharCode(k))!=-1);
                                    } else {
                                    return true;
                                    }
                                } else {
                                    return true;
                                }
                            }
                        </script>
