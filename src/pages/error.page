<apex:page sidebar="false" showHeader="false">
<html>
<head>
    <title>Error - Service Center</title>
    <meta charset="utf-8" />
    <link rel="shortcut icon" href="{!URLFOR($Resource.bootstrap_303, 'favicon.ico')}"/>
    <c:asu_responsive_header_section />
    <apex:stylesheet value="{!URLFOR($Resource.bootstrap_303, '/dist/css/bootstrap.min.css')}"/>
    <c:myasustyles />
    <apex:includeScript value="{!URLFOR($Resource.bootstrap_303, '/dist/js/jquery-1.10.2.min.js')}"/>
    <apex:includeScript value="{!URLFOR($Resource.bootstrap_303, '/dist/js/bootstrap.min.js')}"/>

    <style>
        .panel {
            border-radius: 0px !important;
        }
    </style>
</head>
<body>
    <script>
        if (window.top !== window.self) top.location.replace(self.location.href);
    </script>
    <c:SCSecondaryHeader/>
    <div class="container">
        <div class="panel panel-default">
            <div class="panel-body">
                <p>ASU was unable to process your request. We apologize for the inconvenience.<br /><br />

                Please return to the Service Center in <a href="https://webapp4.asu.edu/myasu" style="color:#990033;">My ASU</a> to ask questions, report an issue, and get help.<br /><br />

                If you’re unable to access the My ASU Service Center or need immediate assistance, please call 1-855-ASU-5080.</p>
            </div>
        </div>
    </div>
    <br />
    <c:SCSecondaryFooter/>
</body>
</html>
</apex:page>
