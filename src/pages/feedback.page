        <div class="page-title">
            <a href="/studentSC" class="mobileHeaderLink">Student Service Center</a>
        </div>

        <div id="asu-content-container" role="main">
            <c:MyASUHelpPageNotifications viewingAs="{!viewingAs}" firstName="{!firstName}" lastName="{!lastName}" />
            <div class="container">
                <ol class="breadcrumb">
                    <li>
                        <a href="/studentSC">Back</a>
                    </li>
                    <li class="active" style="font-size: 10pt">Feedback</li>
                </ol>
                <div class="panel panel-default">
                    <div class="panel-body">
                        <apex:form id="feedbackForm" style="max-width: 600px">
                            <h3>
                                <b style="font-weight: 400">My ASU Service Center Feedback</b>
                            </h3>
                            <br />
                            <br />

                            <p>
                                ASU values your experience and wants to ensure that you receive quality service. The My ASU Service Center is your personalized
                                online resource for reporting issues and getting help. How can ASU improve the way we provide
                                support through the Service Center?
                            </p>
                            <br />

                            <apex:outputText value="Feedback Comments:" />
                            <br />
                            <apex:inputTextarea id="caseFeedbackComments" value="{!comments}" style="max-width: 100%; border: solid 1px #999; border-radius: 2px"
                                rows="5" cols="120" required="true" />
                            <br />
                            <apex:commandButton value="Submit" action="{!submit}" styleClass="kbbtn submitButton" style="margin-top: 15px; width: 45px"
                            />
                        </apex:form>
                    </div>
                </div>
