        <apex:includeScript value="{!URLFOR($Resource.MyASUHeader4_3, 'MyASUHeader4_3/js/asu_header.js')}" />
        <apex:includeScript value="{!URLFOR($Resource.bootstrap_303, '/dist/js/jquery-1.10.2.min.js')}" />

        <script>
            viewAsLinks();

            function viewAsLinks() {
                var masqCookie = '{!masqScopeIdCookie}';
                var viewingAs = '{!viewingAs}';
                if (masqCookie != '' && viewingAs == 'true') {
                    $('a').each(function () {
                        var href = this.href;
                        if (href.indexOf('force') > -1) {
                            if (href.indexOf('?') != -1) {
                                href = href + '&masqScopeIdCookie={!masqScopeIdCookie}';
                            } else {
                                href = href + '?masqScopeIdCookie={!masqScopeIdCookie}';
                            }
                            $(this).attr('href', href);
                        }
                    });
                }
            }
        </script>
