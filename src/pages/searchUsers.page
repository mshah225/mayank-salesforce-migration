<apex:page sidebar="false"
    showHeader="true"
    standardStylesheets="true"
    tabStyle="Search_Users__tab"
    controller="SearchUsers"
    docType="html-5.0">
<head>
    <style>
        .even>td, .odds>td {
            padding: 10px !important;
            font-size: 10pt;
        }

        .odds td a:hover, .even td a:hover{
            color: #990033 !important;
        }

        small {
            font-size: 9pt;
            font-weight: 400;
        }

        .myBtn {
            background: #990033 !important;
            color: #fff !important;
            border: none !important;
            padding: 6px !important;
            font-weight: 400 !important;
            border-radius: 0px !important;
            width: 50px;
        }

        .myBtn:hover {
            background: #8A002E !important;
            color: #fff !important;
            border: none !important;
            padding: 6px !important;
            font-weight: 300 !important;
            border-radius: 0px !important;
        }

        .tablesorter-blue th, .tablesorter-blue thead td {
            color: #000 !important;
            background-color: #d2d2d2 !important;
        }
    </style>

    <apex:includeScript value="{!$Resource.jQuery_1_11_1_Min}"/>
    <apex:includeScript value="{!$Resource.tablesorter_min_js}"/>
    <apex:stylesheet value="{!$Resource.Theme_Blue_css}"/>
</head>
<body>
    <apex:form >
        <apex:pageBlock mode="maindetail">
            <apex:inputText id="searchBox"
                            value="{!searchString}"
                            style="border-radius:2px;width:100%;max-width:400px;height:20px;"
                            html-placeholder="Enter search here"
                            styleClass="form-control" />
            <apex:commandButton action="{!search}"
                                reRender="userTable,pageErrors"
                                status="actStatusId"
                                oncomplete="tableSort()"
                                value="Search" id="submitButton"
                                styleClass="myBtn"/>

            <apex:commandButton value="Reset"
                                action="{!clear}"
                                reRender="list"
                                status="actStatusId"
                                styleClass="myBtn"
                                oncomplete="tableSort()"/>

            <apex:actionStatus id="actStatusId" onstop="tableSort()">
                <apex:facet name="start" >
                    <img src="/img/loading.gif" style="margin-bottom:-4px;"/>
                </apex:facet>
            </apex:actionStatus>

            <br />
            <br />

            <apex:inputCheckbox selected="true"
                                label="Hide Community Users"
                                id="hideCommunity"
                                value="{!hideCommunity}" />
            Hide Community Users

            <br/>

            <apex:pageMessages id="pageErrors"/>

            <br />

            <small>
                <i>
                    Search for User Id, Name, Profile Name, EmplId,
                    ASURITE Id, Alias, Federation Id
                </i>
            </small>

            <br />
            <br />

            <apex:outputText rendered="{!searchString != null}">
                You searched for: {!searchString}
            </apex:outputText>

            <apex:outputPanel id="userTable">
                <apex:pageBlockSection id="userPageBlock"
                                       title="First 50 results"
                                       collapsible="false"
                                       columns="1">
                    <apex:dataTable value="{!uList}"
                                    var="u"
                                    id="list"
                                    width="100%"
                                    cellPadding="5"
                                    rowClasses="even,odds">
                        <apex:column headerValue="User">
                            <apex:outputLink styleClass="nameLink"
                                             value="/{!u.Id}?noredirect=1"
                                             target="_blank">
                                {!u.Name}
                            </apex:outputLink>
                        </apex:column>

                        <apex:column headerValue="Alias">
                            <apex:outputText rendered="{!NOT(ISNULL(u.Alias))}" value="{!u.Alias}"/>
                            <apex:outputText rendered="{!ISNULL(u.Alias)}">--</apex:outputText>
                        </apex:column>

                        <apex:column headerValue="ASURITE Id">
                            <apex:outputText rendered="{!NOT(ISNULL(u.Contact.ASURite_ID__c))}">
                                {!u.Contact.ASURite_ID__c}
                            </apex:outputText>

                            <apex:outputText rendered="{!ISNULL(u.Contact.ASURite_ID__c)}">
                                --
                            </apex:outputText>
                        </apex:column>

                        <apex:column headerValue="User Id" value="{!u.Id}" />

                        <apex:column headerValue="Federation Id">
                            <apex:outputText rendered="{!NOT(ISNULL(u.FederationIdentifier))}"
                                             value="{!u.FederationIdentifier}" />

                            <apex:outputText rendered="{!ISNULL(u.FederationIdentifier)}">
                                --
                            </apex:outputText>
                        </apex:column>

                        <apex:column headerValue="Profile" value="{!u.Profile.Name}" />

                        <apex:column headerValue="Active?" value="{!u.isActive}"/>
                    </apex:dataTable>

                    <apex:outputPanel rendered="{!NoResults}">
                        No results found
                    </apex:outputPanel>
                </apex:pageBlockSection>
            </apex:outputPanel>
        </apex:pageBlock>
    </apex:form>
    <script>
        window.$j = jQuery.noConflict();

        $j(document).ready(tableSort());

        function tableSort()
        {
            $j("[id$='list']").tablesorter({theme: 'blue', dateFormat : "dd/mm/yyyy"});
        };
    </script>
</body>
</apex:page>