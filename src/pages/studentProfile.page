<apex:page id="studentProfile"
    controller="StudentProfileController"
    cache="true"
    showHeader="false"
    sideBar="false"
    standardStylesheets="false"
    docType="HTML-5.0"
    action="{!init}">
    <head>
        <title>{!theContact.FirstName}'s Student Profile</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <!--<apex:stylesheet value="{!URLFOR($Resource.bootstrap_303,-->
                <!--'/dist/css/bootstrap.min.css')}"/>-->
        <apex:stylesheet value="{!URLFOR($Resource.MyASUHeader4_3,
            'MyASUHeader4_3/font-awesome-4.3.0/css/font-awesome.css')}"/>
        <!-- Latest compiled and minified CSS -->
        <link rel="stylesheet"
              href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/css/bootstrap.min.css"
              integrity="sha384-1q8mTJOASx8j1Au+a5WDVnPi2lkFfwwEAa8hDDdjZlpLegxhjVME1fgjWPGmkzs7"
              crossorigin="anonymous"/>
        <link href='https://fonts.googleapis.com/css?family=Roboto:normal,medium'
              rel='stylesheet'
              type='text/css'/>
        <apex:stylesheet value="{!URLFOR($Resource.MyASUHeader4_3,
                'MyASUHeader4_3/font-awesome-4.3.0/css/font-awesome.css')}"/>
        <c:StudentProfileStyles />
        <!--
        <script text="text/javascript">
            // Method to fire an event from code, used to simulate a tab click
            function eventFire(el, etype){
                //if (el.fireEvent) {
                //    el.fireEvent('on' + etype);
                //} 
                //else {
                    var evObj = document.createEvent('Events');
                    evObj.initEvent(etype, true, false);
                    el.dispatchEvent(evObj);
                //}
            }
        </script>
        -->
        <script src="/support/console/37.0/integration.js" type="text/javascript"></script>
        <script type="text/javascript">
            var inConsole = false;
            function setTabTitle() {
                //Set the current tab's title
                try {
                    sforce.console.setTabTitle('{!theContact.FirstName}\'s Student Profile');
                    inConsole = true;
                } catch (e) {
                    console.log('Notice: Tab title can only be set when the Student Profile is opened inside of a Service Console tab! ' + e.message);
                }
            }
            var pageLoad = window.onload;
              window.onload = function() {
                    if (pageLoad) {
                            pageLoad();
                    }
                    setTabTitle();
              }
        </script>
        <script text="text/javascript">        
            function openNewSubtab(subtabUrl, subtabTitle)
            {
             
                var openSubtab = function(result)
                {
                      if (subtabTitle != 'null')
                        sforce.console.openSubtab(result.id, subtabUrl, true, subtabTitle, null);
                      else
                        sforce.console.openSubtab(result.id, subtabUrl, true);

                };

                if (inConsole)
                      sforce.console.getEnclosingPrimaryTabId(openSubtab);
                else
                    window.open(subtabUrl);
             }
        </script>  
        <style>
            .mobile {
                display:none;
                margin:auto !important;
                margin-bottom:24px !important;
                max-width:50% !important;
            }
            
            li.transcriptAddress {
                list-style: none;
            }
            
            th.transcriptHeader {
                width: 165px;
            }
            
            @media screen and (max-width:767px) {
                .browser {
                    display:none;
                }
            
                .mobile {
                    display:block;
                }
            }
            
            @media screen and (min-width:992px) and (max-width:1115px) {
                .browser {
                    padding:8px !important;
                    font-size:15px !important;
                }
            
                .browser img {
                    height:36px !important;
                    width:36px !important;
                }
            }
            
            .hide {
                display: none;
            }
        </style>
    </head>
    
    <!--script src="/support/console/37.0/integration.js" type="text/javascript"></script> -->
    <script type="text/javascript">
        Visualforce.remoting.timeout = 120000; // Set timeout at page level
    </script>


    <body>
        <div class="mainCont">

    <!--
        <apex:outputPanel rendered="{!IF($CurrentPage.parameters.tabbable == 'true',false,true)}">
            <div class="headerBackground"></div>
        </apex:outputPanel>

        <div class="mainCont">
            <apex:tabPanel styleClass="mainTab"
                           activeTabClass="mainTabActive"
                           switchType="client"
                           selectedTab="mainTab"
                           id="mainTabPanel"
                           headerClass="mainTabHeader">
                <apex:tab label="Student Profile"
                          name="mainTab"
                          id="mainTab"
                          styleClass="firstTab"
                          rendered="{!IF(theContact.EMPLID__c != null, true, false)}">
    -->
                    <div class="row" style="margin-top:20px;">
                        <div class="col-md-8">
                            <div class="row intro">
                                <div class="col-sm-4 intro"
                                     style="margin-bottom:10px;max-width:230px;">
                                    <div>
                                        <c:DynamicFeedbackButton carName="Student Profile"
                                            miscInformation="{!theContact.FirstName} {!theContact.lastName} Id:{!theContact.EMPLID__c}"
                                            classes="mobile"
                                            betaTag="true" />
                                    </div>
                                    <apex:outputPanel id="photoRerenderPanel" layout="none">
                                        <apex:form >                                     
                                        <img id="studentPhotoImg2"
                                             src="
                                                  {!if(ISBLANK(suncardPhotoURL), URLFOR($Resource.blankAvatar), suncardPhotoURL)}"
                                             alt="suncard photo"
                                             class="img-responsive intro"
                                             style="max-width:200px;width:100%;"/> 
                                        </apex:form>
                                    </apex:outputPanel>

                                </div>

                                <div class="col-sm-8" style="margin-top:5px;">
                                    <div style="display:inline;float:left;">
                                    <span style="color:#6e7d83;font-weight:200">
                                        <h2 style=";margin-top:0px;" class="intro">
                                            <span style="color:#9f2b50">
                                                {!theContact.FirstName} {!theContact.LastName}
                                            </span>
                                            <apex:outputPanel rendered="{!deceased != ''}">
                                                <span style="font-size:12pt;
                                                             margin-left:20px;">
                                                        {!deceased}
                                                </span>
                                            </apex:outputPanel>
                                        </h2>
                                        
                                        <h4 class="intro">
                                            <span style="color:#353535">ID:</span>
                                            &nbsp;{!theContact.EMPLID__c}
                                            <span style="color:#353535">|</span>
                                            <span style="color:#353535">ASURITE:</span>
                                            &nbsp;{!theContact.ASURite_ID__c}
                                        </h4>

                                        <apex:outputPanel rendered="{!IF(primaryProgramPlan.Status__c ==
                                         'Active in Program', true, false)}">
                                            <h4 class="intro">
                                                <span style="color:#353535;">Academic Level:</span>
                                                &nbsp;{!primaryProgramPlan.Career__c}
                                            </h4>

                                            <h4 class="intro">
                                                <span style="color:#353535;">College:</span>
                                                &nbsp;{!primaryProgramPlan.Program_Description__c}
                                            </h4>

                                            <h4 class="intro">
                                                <span style="color:#353535;">Plan, Degree:</span>
                                                &nbsp;{!primaryProgramPlan.Plan_Description__c + IF(ISBLANK(primaryProgramPlan.Degree__c),'', ', ' + primaryProgramPlan.Degree__c)}
                                            </h4>
                                            
                                            <h4 class="intro">
                                                <span style="color:#353535;">Sub-Plan:</span>
                                                &nbsp;{!IF(subPlanString==null, '--', subPlanString)}

                                            </h4>
                                            
                                            <h4 class="intro">
                                                <span style="color:#353535;">Campus:</span>
                                                &nbsp;{!primaryProgramPlan.Campus__r.Name}
                                            </h4>
                                        </apex:outputPanel>
                                    </span>
                                    </div>
                                    <div style="display:inline;float:right;">
                                        <c:DynamicFeedbackButton carName="Student Profile"
                                            miscInformation="{!theContact.FirstName} {!theContact.lastName} Id:{!theContact.EMPLID__c}"
                                            classes="browser"
                                            betaTag="true"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Nav tabs -->
                            <ul class="nav nav-tabs responsive" role="tablist">
                                <li role="presentation" class="active">
                                    <a href="#general"
                                       aria-controls="general"
                                       role="tab"
                                       data-toggle="tab"
                                       class="tabLink">
                                        General
                                    </a>
                                </li>

                                <li role="presentation">
                                    <a href="#UGacademics"
                                       aria-controls="UGacademics"
                                       role="tab"
                                       data-toggle="tab"
                                       style="padding:5px;text-align:center;"
                                       class="tabLink"
                                       onclick="loadUGAcademicsTab();">
                                        Undergraduate Academics
                                    </a>
                                </li>

                                <li role="presentation">
                                    <a href="#Gacademics"
                                       aria-controls="Gacademics"
                                       role="tab"
                                       data-toggle="tab"
                                       style="padding:5px;text-align:center;"
                                       class="tabLink"
                                       onclick="loadGradAcademicsTab();">
                                        Graduate Academics
                                    </a>
                                </li>

                                <li role="presentation">
                                    <a href="#classes"
                                       aria-controls="classes"
                                       role="tab"
                                       data-toggle="tab"
                                       class="tabLink"
                                       onclick="loadClassesTab();">
                                        Classes
                                    </a>
                                </li>

                                <li role="presentation">
                                    <a href="#finances"
                                       aria-controls="finances"
                                       role="tab"
                                       data-toggle="tab"
                                       class="tabLink"
                                       onclick="loadFinancesTab();">
                                        Finances
                                    </a>
                                </li>

                                <li role="presentation">
                                    <a href="#UGindicators"
                                       id="UGindicatorsLink"
                                       aria-controls="UGindicators"
                                       role="tab"
                                       data-toggle="tab"
                                       style="padding:5px;text-align:center;"
                                       class="tabLink"
                                       onclick="loadUGIndicatorTab();">
                                        Undergraduate Indicators
                                    </a>
                                </li>

                                <li role="presentation">
                                    <a href="#comments"
                                       aria-controls="comments"
                                       role="tab"
                                       data-toggle="tab"
                                       class="tabLink"
                                       onclick="loadCommentsTab();">
                                        Comments
                                    </a>
                                </li>

                                <li role="presentation">
                                    <a href="#careerdevelopment"
                                       aria-controls="careerdevelopment"
                                       role="tab"
                                       data-toggle="tab"
                                       style="padding:5px;text-align:center;"
                                       class="tabLink"
                                       onclick="loadCareerDevelopmentTab();">
                                        Career Development
                                    </a>
                                </li>
                            </ul>

                            <!-- Tab panes -->
                            <div class="tab-content responsive">
                                <div role="tabpanel" class="tab-pane active" id="general">
                                    <apex:pageBlock mode="maindetail">
                                        <div class="page-header-smaller">
                                            <h4>
                                                <i class="fa fa-caret-down"></i>
                                                &nbsp;Contact Information
                                            </h4>
                                        </div>
                                        <div class="row">
                                            <apex:outputPanel id="generalContact">
                                                <div class="col-sm-6">
                                                    <table class="table table-striped">
                                                        <tr>
                                                            <th>Address</th>
                                                            <td>
                                                                {!theContact.MailingStreet}
                                                                <br />
                                                                {!theContact.MailingCity}
                                                                <br />
                                                                {!theContact.MailingStateCode}
                                                                -{!theContact.MailingPostalCode}
                                                                <br />
                                                                {!theContact.MailingCountryCode}
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </div>

                                                <div class="col-sm-6">
                                                    <table class="table table-striped">
                                                        <tr>
                                                            <th>ASU Email</th>
                                                            <td>
                                                                <a href="mailto:{!theContact.Email}">{!theContact.Email}</a>
                                                            </td>
                                                        </tr>

                                                        <tr>
                                                            <th>Other Email</th>
                                                            <td>
                                                                <a href="mailto:{!theContact.EPO_Email__c}">{!theContact.EPO_Email__c}</a>
                                                            </td>
                                                        </tr>

                                                        <tr>
                                                            <th>Cell Phone</th>
                                                            <td class="phone">{!IF(ISBLANK(theContact.MobilePhone),'--', theContact.MobilePhone)}</td>
                                                        </tr>

                                                        <tr>
                                                            <th>Home Phone</th>
                                                            <td class="phone">{!IF(ISBLANK(theContact.HomePhone), '--', theContact.HomePhone)}</td>
                                                        </tr>

                                                        <tr>
                                                            <th>Local Phone</th>
                                                            <td class="phone">{!IF(ISBLANK(theContact.OtherPhone), '--', theContact.OtherPhone)}</td>
                                                        </tr>
                                                    </table>
                                                </div>
                                            </apex:outputPanel>
                                        </div>

                                        <div class="page-header-smaller">
                                            <h4>
                                                <i class="fa fa-caret-down"></i>
                                                &nbsp;Personal Information
                                            </h4>
                                        </div>

                                        <div class="row">
                                            <apex:outputPanel id="generalPersonal">
                                                <div class="col-sm-6">
                                                    <table class="table table-striped">
                                                        <tr>
                                                            <th>Gender</th>
                                                            <td>{!theContact.Gender__c}</td>
                                                        </tr>

                                                        <tr>
                                                            <th>Ethnicity</th>
                                                            <td>{!theContact.Ethnicity__c}</td>
                                                        </tr>

                                                        <tr>
                                                            <th>Age</th>
                                                            <td>{!IF(ISBLANK(studentDemographic.AGE_YEARS__c), '--', 
                                                                 FLOOR(VALUE(studentDemographic.AGE_YEARS__c)))}</td>
                                                            <!--td>{!FLOOR((TODAY() - theContact.BirthDate)/365.2425)}</td-->
                                                        </tr>

                                                        <tr>
                                                            <th>Birthdate</th>
                                                            <td>
                                                                <apex:outputText value="{0, date, MMMM d','  yyyy}">
                                                                    <apex:param value="{!theContact.Birthdate}"/>
                                                                </apex:outputText>
                                                            </td>
                                                        </tr>

                                                        <tr>
                                                            <!--Opportunity Object
                                                            First_Generation__c-->
                                                            <th>First Generation</th>
                                                            <td>{!IF(ISBLANK(studentDemographic.FIRST_GEN_FLG__c), '--', 
                                                                 studentDemographic.FIRST_GEN_FLG__c)}</td>
                                                        </tr>
                                                    </table>
                                                </div>

                                                <div class="col-sm-6">
                                                    <table class="table table-striped">
                                                        <tr>
                                                            <th>WUE</th>
                                                            <td>{!IF(ISBLANK(studentProgram.WUE__c), '--', 
                                                                 studentProgram.WUE__c)}</td>
                                                        </tr>

                                                        <tr>
                                                            <th>Residency</th>
                                                            <td>{!IF(ISBLANK(studentProgram.RESIDENCY__c), '--', 
                                                                 studentProgram.RESIDENCY__c)}</td>
                                                        </tr>

                                                        <tr>
                                                            <th>Country of Citizenship</th>
                                                            <td>{!IF(ISBLANK(theContact.Country_of_Citizenship__c), '--', theContact.Country_of_Citizenship__c)}
                                                            </td>
                                                        </tr>

                                                        <tr>
                                                            <th>FERPA Level</th>
                                                            <td>
                                                                {!IF(ISBLANK(theContact.FERPA_Directory_Hold__c), '--', theContact.FERPA_Directory_Hold__c)}
                                                            </td>
                                                        </tr>

                                                        <tr>
                                                            <!--Financial Aid Package Object
                                                            EFC_Range__c-->
                                                            <th>Financial Need Level</th>
                                                            <td>{!IF(ISBLANK(studentProgram.FINANCIAL_NEED_LVL__c), '--', 
                                                                 studentProgram.FINANCIAL_NEED_LVL__c)}</td>
                                                        </tr>
                                                    </table>
                                                </div>
                                            </apex:outputPanel>
                                        </div>

                                        <div class="page-header-smaller">
                                            <h4>
                                                <i class="fa fa-caret-down"></i>
                                                &nbsp;Student Status
                                            </h4>
                                        </div>

                                        <div class="row">
                                            <apex:outputPanel id="generalStatus">
                                                <div class="col-sm-6">
                                                    <table class="table table-striped">
                                                        <tr>
                                                            <th>Current Academic Level</th>
                                                            <td>{!IF(ISBLANK(profileHeader.COHORT__c), '--', 
                                                                 profileHeader.COHORT__c)}</td>
                                                        </tr>

                                                        <tr>
                                                            <th>{!currentTermName} Term Enrolled Hours</th>
                                                            <td>{!IF(ISBLANK(studentProgram.ENRL_HRS__c), '--', 
                                                                 FLOOR(studentProgram.ENRL_HRS__c))}</td>
                                                        </tr>

                                                        <tr>
                                                            <th>{!nextTermName} Term Enrolled Hours</th>
                                                            <td>{!IF(ISBLANK(studentProgram.ENRL_HRS_PENDING__c), '--', 
                                                                 FLOOR(studentProgram.ENRL_HRS_PENDING__c))}</td>
                                                        </tr>
                                                    </table>
                                                </div>

                                                <div class="col-sm-6">
                                                    <table class="table table-striped">
                                                        <tr>
                                                            <th>Expected Graduation Date</th>
                                                            <td>{!IF(ISBLANK(studentProgram.EXP_GRAD_TERM__c), '--', 
                                                                 StudentProgram.EXP_GRAD_TERM__r.Name)}
                                                            </td>
                                                        </tr>

                                                        <tr>
                                                            <th>{!currentTermName} Enrollment Appointment</th>
                                                            <td>
                                                                <!--
                                                                <c:FormattedDateTime dateTimeValue="{!studentProgram.APPT_DT__c}" datetimeFormat="MMMM d','  yyyy h:mm aaa z" />
                                                                -->
                                                                <apex:outputText value="{0, date, MMMM d','  yyyy h:mm aaa 'AZ'}" rendered="{!(!ISBLANK(studentProgram.APPT_DT__c))}">
                                                                    <apex:param value="{!studentProgram.APPT_DT__c}"/>
                                                                </apex:outputText>
                                                                <apex:outputText rendered="{ISBLANK(studentProgram.APPT_DT__c)}">--</apex:outputText>
                                                            </td>
                                                        </tr>

                                                        <tr>
                                                            <th>{!nextTermName} Enrollment Appointment</th>
                                                            <td>
                                                                <!--
                                                                <c:FormattedDateTime dateTimeValue="{!studentProgram.APPT_DT_PENDING__c}" datetimeFormat="MMMM d','  yyyy h:mm aaa z" />
                                                                -->
                                                                <apex:outputText value="{0, date, MMMM d','  yyyy h:mm aaa 'AZ'}" rendered="{!(!ISBLANK(studentProgram.APPT_DT_PENDING__c))}">
                                                                    <apex:param value="{!studentProgram.APPT_DT_PENDING__c}"/>
                                                                </apex:outputText>
                                                                <apex:outputText rendered="{ISBLANK(studentProgram.APPT_DT_PENDING__c)}">--</apex:outputText>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </div>
                                            </apex:outputPanel>
                                        </div>
                                    </apex:pageBlock>
                                </div>

                                <div role="tabpanel" class="tab-pane" id="UGacademics">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="page-header-smaller">
                                                <h4>
                                                    <i class="fa fa-caret-down"></i>
                                                    &nbsp;Active / Completed Programs and Plans
                                                </h4>
                                            </div>

                                            <div class="table-responsive">
                                                <apex:dataTable styleClass="table table-striped table-bordered"
                                                                value="{!ugProgramPlans}"
                                                                var="app"
                                                                rendered="{!IF(ugProgramPlans.size
                                                                        > 0,true,false)}">
                                                    <apex:column headerValue="Status"
                                                                 value="{!app.Status__c}"/>
                                                    <apex:column headerValue="Program"
                                                                 value="{!app.Program_Description__c}"/>
                                                    <apex:column headerValue="Plan">
                                                        <apex:outputLink value="/{!app.Id}"
                                                                         target="_blank">
                                                            <apex:outputField value="{!app.Plan_Description__c}"/>
                                                        </apex:outputLink>
                                                    </apex:column>
                                                    <apex:column headerValue="Sub-Plan">

                                                        <apex:outputText rendered="{!IF(subPlanString==null,false,true)}"
                                                                         value="{!subPlanString}"/>
                                                        <apex:outputText rendered="{!IF(subPlanString==null,true,false)}"

                                                                         value="--"/>
                                                    </apex:column>
                                                    <apex:column headerValue="Plan Type"
                                                                 value="{!app.Plan_Type_Text__c}"/>
                                                    <apex:column headerValue="Degree"
                                                                 value="{!app.Degree__c}"/>
                                                    <apex:column headerValue="Campus"
                                                                 value="{!app.Campus__r.Name}"/>
                                                    <apex:column headerValue="Grad Term"
                                                                 value="{!app.Completion_Term__c}"/>
                                                    <apex:column headerValue="Primary"
                                                                 value="{!app.Primary_Flag__c}"/>
                                                </apex:dataTable>
                                            </div>

                                            <apex:outputText rendered="{!IF(allProgramPlans.size
                                                    == 0,true,false)}" value="No Programs/Plans
                                                    found."/>

                                            <div class="page-header-smaller">
                                                <h4>
                                                    <i class="fa fa-caret-down"></i>
                                                    &nbsp;Academic Progress
                                                </h4>
                                            </div>
 
                                            <div id="UGacademicProgress"
                                                 style="display:none;width:100%;">
                                                <div class="row">
                                                    <div class="col-sm-12">
                                                        <table class="table table-striped">
                                                            <tr>
                                                                <th>Cumulative GPA</th>
                                                                <td id="ugap_gpa"></td>
                                                            </tr>
                                                            <tr>
                                                                <th>Cumulative Hours</th>
                                                                <td id="ugap_cumulative_hours"></td>
                                                            </tr>
                                                            <tr>
                                                                <th>eAdvisor Status</th>
                                                                <td id="ugap_eadvisor_status"></td>
                                                            </tr>
                                                            <tr>
                                                                <th>Academic Standing</th>
                                                                <td id="ugap_academic_standing"></td>
                                                            </tr>
                                                            <tr>
                                                                <th>Advisors</th>
                                                                <td id="ugap_advisors"></td>
                                                            </tr>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>

                                            <div id="UGacademicProgressErrors"></div>

                                            <div class="page-header-smaller">
                                                <h4>
                                                    <i class="fa fa-caret-down"></i>
                                                    &nbsp;Test Scores
                                                </h4>
                                            </div>

                                            <div id="ps_test_score_section_ug"
                                                         style="display:none;"></div>

                                            <div id="psTestScoreErrorsUG"></div>

                                            <div class="page-header-smaller">
                                                <h4>
                                                    <i class="fa fa-caret-down"></i>
                                                    &nbsp;Milestone Information
                                                </h4>
                                            </div>

                                            <div id="ps_milestone_section_ug"
                                                         style="display:none; width: 100%;"></div>

                                            <div id="psMilestoneErrorsUG"></div>

                                            <div class="page-header-smaller">
                                                <h4>
                                                    <i class="fa fa-caret-down"></i>
                                                    &nbsp;Admission Information
                                                </h4>
                                            </div>
                                            <div class="row">
                                                <apex:outputPanel id="admissionInformation">
                                                <div class="col-sm-6">
                                                    <table class="table table-striped">
                                                        <tr>
                                                            <th>Application Admit Type</th>
                                                            <td>{!IF(ISBLANK(ugStudentProgram.ADMIT_TYPE__c), '--', ugStudentProgram.ADMIT_TYPE__c)}</td>
                                                        </tr>
                                                        <tr>
                                                            <th>Applied Program</th>
                                                            <td>{!IF(ISBLANK(ugStudentProgram.ADM_APPL_PROG__c), '--', ugStudentProgram.ADM_APPL_PROG__c)}</td>
                                                        </tr>
                                                        <tr>
                                                            <th>Applied Date</th>
                                                            <td>
                                                                <apex:outputText value="{0, date, MMMM d','  yyyy}" rendered="{!(!ISBLANK(ugStudentProgram.ADM_APPL_DT__c))}">
                                                                    <apex:param value="{!ugStudentProgram.ADM_APPL_DT__c}"/>
