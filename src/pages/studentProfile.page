            function filterFinancialAid() {
                var e = document.getElementById("ps_financial_aid_year_select"); 
                var search = e.options[e.selectedIndex].text ;
                var faTable = document.getElementById('financial_aid_table');
                var offeredTotal = 0.00;
                var acceptedTotal = 0.00;
                var disbursedTotal = 0.00;
                for (var r = 1; r < faTable.rows.length; r++) {
                    var ele = faTable.rows[r].cells[6].innerHTML;
                    var displayStyle = 'none';
                    if (r == (faTable.rows.length -1)) {
                        displayStyle = 'table-row';
                    }
                    else if (ele.indexOf(search)>=0 || search=='All') {
                        displayStyle = 'table-row';
                        offeredTotal += parseInt(faTable.rows[r].cells[3].innerHTML.replace("$","").replace(",",""));
                        acceptedTotal += parseInt(faTable.rows[r].cells[4].innerHTML.replace("$","").replace(",",""));
                        disbursedTotal += parseInt(faTable.rows[r].cells[5].innerHTML.replace("$","").replace(",",""));
                    }
                    else {
                        displayStyle = 'none';
                    }
                    faTable.rows[r].style.display = displayStyle;
                }
                var o = "en-US";
                var s = { style: "currency", currency: "USD" };
                document.getElementById('fa_offered_total').innerHTML = offeredTotal.toLocaleString(o,s);
                document.getElementById('fa_accepted_total').innerHTML = acceptedTotal.toLocaleString(o,s);
                document.getElementById('fa_disbursed_total').innerHTML = disbursedTotal.toLocaleString(o,s);
            }

            // Method to load the Undergraduate Indicators tab
            function getMe3Results() {
                if (!careerDevelopmentTabLoaded) {
                    var errorHtml = "";
    
                    document.getElementById("me3ResponseErrors").innerHTML =
                        "<i class='fa fa-spinner fa-pulse fa-2x fa-fw margin-bottom'></i>";
    
                    Visualforce.remoting.Manager.invokeAction(
                        '{!$RemoteAction.StudentProfileController.getMe3Results}',
                        '{!theContact.Id}',
                        function (result, event) {
                            if (event.status) {
                                document.getElementById("me3ResponseErrors").innerHTML =
                                    "";     
                                if (!Object.getOwnPropertyNames(result).length == 0) {
                                    document.getElementById("Me3Results").style.display =
                                        "initial";

                                    var utcSeconds = result.Test_Completed_Date__c;
                                    var testDate = new Date(utcSeconds);
                                    testDate = (testDate.getUTCMonth() + 1) + '/' +
                                        testDate.getUTCDate() + '/' +
                                        testDate.getUTCFullYear();

                                    document.getElementById('me3_completion_date').innerHTML =
                                        testDate;
                                     document.getElementById('me3_source').innerHTML = result.Source__c;
                                     document.getElementById('me3_r_score').innerHTML = 
                                        (result.R_Score__c > 0 ? result.R_Score__c : '0') + ' / 100';
                                     document.getElementById('me3_a_score').innerHTML = 
                                        (result.A_Score__c > 0 ? result.A_Score__c : '0') + ' / 100';
                                     document.getElementById('me3_i_score').innerHTML = 
                                        (result.I_Score__c > 0 ? result.I_Score__c : '0') + ' / 100';
                                     document.getElementById('me3_s_score').innerHTML = 
                                        (result.S_Score__c > 0 ? result.S_Score__c : '0') + ' / 100';
                                     document.getElementById('me3_e_score').innerHTML = 
                                        (result.E_Score__c > 0 ? result.E_Score__c : '0') + ' / 100';
                                     document.getElementById('me3_c_score').innerHTML = 
                                        (result.C_Score__c > 0 ? result.C_Score__c : '0') + ' / 100';

                                    var html = 
                                     "<div class='table-responsive'>" +
                                        "<table id='career_dev_table' class='table table-striped table-bordered'> " +
                                        "<tbody>";

                                    for (var i = 0; i < result.me3_Careers__r.length; i++) {
                                        var cdUtcSeconds = result.me3_Careers__r[i].Updated_Date__c;
                                        var updatedDate = new Date(cdUtcSeconds);
                                        updatedDate = (updatedDate.getUTCMonth() + 1) + '/' +
                                            updatedDate.getUTCDate() + '/' +
                                            updatedDate.getUTCFullYear();       
                                        html += "" +
                                            (result.me3_Careers__r[i].Active__c == true ?  "<tr style='font-weight:bold;'>" : "<tr style='font-weight:normal;'>") +
                                                "<td>" + updatedDate + "</td>" +
                                                "<td style='font-weight:bold;color:red;'>" + (result.me3_Careers__r[i].Active__c == true ? '' : 'X') + "</td>" +
                                                "<td>Career Interest: " + result.me3_Careers__r[i].Career_Interest__c + "</td>" +
                                                "<td>Degree Interest: " + result.me3_Careers__r[i].Degree_Interest__c + " (" +
                                                result.me3_Careers__r[i].Plan_Code__c + ")</td>" +
                                            "</tr>";
                                    }
                                    html += "</tbody></table></div>";
                                    document.getElementById('me3_career_interest_table').innerHTML = html;

                                    cleanUpUndefined("Me3Results");
                                    careerDevelopmentTabLoaded = true;
                                } else {
                                    document.getElementById("me3ResponseErrors").innerHTML =
                                        'No Me3 results found';
                                    careerDevelopmentTabLoaded = true;
                                }
                            } else if (event.type === 'exception') {
                               document.getElementById("me3ResponseErrors").innerHTML = "<br/>\n<pre>" + event.where + "</pre>";
                            } else {
                                document.getElementById("me3ResponseErrors").innerHTML = event.message;
                            }
                        },
                        {escape: true}
                    );
                }
            }

