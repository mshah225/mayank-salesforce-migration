                                            createdDate.getDate() + '/' +
                                            createdDate.getFullYear();

                                        var totIndicators = 0;

                                        if (typeof result[i].FA_INDICATOR__c == 'string' && result[i].FA_INDICATOR__c != '')
                                            totIndicators++;                       
                                        if (result[i].CI_INDEX_INDICATOR__c > 0 && result[i].CI_INDEX_INDICATOR__c <= 93)
                                            totIndicators++;
                                        if (result[i].ASR_INDICATOR__c > 0)
                                            totIndicators++;
                                        if (typeof result[i].EADVISOR_INDICATOR__c == 'string' && result[i].EADVISOR_INDICATOR__c.startsWith('Off Track'))
                                            totIndicators++;
