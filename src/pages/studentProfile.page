        <script>
            $j = jQuery.noConflict();

            $j("#sunCard").error(function() {
                $j(this).attr("src", "{!$Resource.blankAvatar}");
            });
        
            $j(document).ready(function() {
                // $j('.fa-caret-down').hide();    
            });

            // Arrow Functionality
            $j(".page-header-smaller").click(function() {                                    
                var container = $j(this);
                var arrow = $j(this).find('.fa');
                
                if (arrow.hasClass('fa-caret-down')) {
                    container.next().slideUp().addClass('hide');
                } else if (arrow.hasClass('fa-caret-right')) {
                    container.next().removeClass('hide').slideDown();
                }
                
                arrow.toggleClass('fa-caret-right');
                arrow.toggleClass('fa-caret-down');                    
            });

            // Call load functions when tabs are collpased, and add smooth scroll 
            // to tab on click for mobile
            $j(document).on('click', "a.tabLink", function() {    
                if ((navigator.userAgent.match(/Android/i)
                    || navigator.userAgent.match(/webOS/i)
                    || navigator.userAgent.match(/iPhone/i)
                    || navigator.userAgent.match(/iPad/i)
                    || navigator.userAgent.match(/iPod/i)
                    || navigator.userAgent.match(/BlackBerry/i)
                    || navigator.userAgent.match(/Windows Phone/i)))
                {
                    if (!$j(this).hasClass("collapsed")) {
                        $j('html, body').animate({
                            scrollTop: $j(this).offset().top - 10
                        }, 800);
                    }
                }
                // Handling for responsive tabs
                if ($j(this).attr('href') === '#collapse-UGindicators') {
                    loadUGIndicatorTab();
                } else if ($j(this).attr('href') === '#collapse-comments') {
                    loadCommentsTab();
                } else if ($j(this).attr('href') === '#collapse-UGacademics') {
                    loadUGAcademicsTab();
                } else if ($j(this).attr('href') === '#collapse-Gacademics') {
                    loadGradAcademicsTab();
                } else if ($j(this).attr('href') === '#collapse-finances') {
                    loadFinancesTab();
                } else if ($j(this).attr('href') === '#collapse-classes') {
                    loadClassesTab();
                }  
            })
        </script>

