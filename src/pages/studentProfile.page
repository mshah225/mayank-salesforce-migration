        <!-- Script to mask Phone Numbers -->
        <apex:includeScript value="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.0/jquery.mask.min.js" />
        <script>
            // Mask each phone number in (XXX) XXX-XXXX format
            function maskPhoneNumbers() {
                $j('.phone').each(function() {                
                    if ($j(this).text() != '--') {
                        $j(this).mask('(000) 000-0000');    
                    }
                });
            }
        
            $j(document).ready(function() {
                maskPhoneNumbers();    
            });
        </script>
