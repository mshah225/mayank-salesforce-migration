    <div id="myasu-header-seo"><a href="https://webapp4.asu.edu/myasu">My ASU</a></div>

    <!-- MyASU Tab Bar -->
    <header class="navbar navbar-default" role="banner">
        <apex:outputPanel rendered="{!IF(ISNULL(linkList),true,false) || IF(ISBLANK(linkList),true,false)}">
            <div id="myasu-tabs">
                <div class="navbar-links">
                    <span class='tab'><a href="https://webapp4.asu.edu/myasu" class="tracking"><span class="fa fa-home" title="Home"></span></a></span>

                    <span class='tab'><a href="https://webapp4.asu.edu/myasu/student/finances" class="tracking">Finances</a></span>

                    <span class='selected tab'><a href="/" class="tracking" >Service Center</a></span>

                    <span class='tab'><a href="https://webapp4.asu.edu/myasu/student/campusservices" class="tracking">Campus Services</a></span>

                    <span class='tab'><a href="https://webapp4.asu.edu/myasu/student/profile" class="tracking">Profile</a></span>
                    <p class="username pull-right">
                        {!$User.FirstName} {!$User.LastName}
                    </p>
                </div>
            </div>
        </apex:outputPanel>

        <apex:outputPanel rendered="{!IF(ISNULL(linkList),false,true) || IF(ISBLANK(linkList),false,true)}">
            <div id="myasu-tabs">
                <div class="navbar-links">
                    <apex:repeat value="{!linkList}" var="link" id="linkRepeater">
                        <span class='tab'>
                            <apex:outputLink value="{!link.url}" title="{!link.name}" rendered="{!IF(link.name == 'Home',true,false)}">
                                <span class="fa fa-home" title="Home"></span>
                            </apex:outputLink>

                            <apex:outputLink rendered="{!IF(link.name != 'Home' && link.name != 'Service Center',true,false)}" value="{!link.url}">
                                {!link.name}
                            </apex:outputLink>

                            <apex:outputPanel rendered="{!IF(link.name == 'Service Center',true,false)}">
                                <span class='selected tab'><a href="/" class="tracking">Service Center</a></span>
                            </apex:outputPanel>
                        </span>
                    </apex:repeat>

                    <p class="username pull-right">
                        {!$User.FirstName} {!$User.LastName}
                    </p>
                </div>
            </div>
        </apex:outputPanel>
    </header>

    <div class="page-title">
        <a href="/studentSC" class="mobileHeaderLink">Student Service Center</a>
    </div>

    <!-- START CONTENT -->
    <div id="asu_content_well">
    <center>
        <apex:outputPanel rendered="{!$CurrentPage.parameters.Confirm == 'newcase'}">
            <div class="alert alert-success caseConfirm">
                <button type='button' class='close' id="closeConfirmCase" data-dismiss='alert'>×</button>
                <p><strong>Your request has been submitted.</strong> We are working on responding to you as soon as possible.<br />
                A member of the ASU team will contact you if additional information is needed to answer your request.<br />
                Please check back here, in the My ASU Service Center, to track the status of your request.</p>
            </div>
        </apex:outputPanel>

        <apex:outputPanel rendered="{!$CurrentPage.parameters.Confirm == 'feedback'}">
            <div class="alert alert-success caseConfirm">
                <button type='button' class='close' id="closeConfirmFeedback" data-dismiss='alert'>×</button>
                <p><strong>Thank you for your feedback about the My ASU Service Center!</strong></p>
            </div>
        </apex:outputPanel>

        <apex:outputPanel rendered="{!pinError}">
            <div class="alert alert-danger">
                <button type='button' class='close' data-dismiss='alert'>×</button>
                <apex:outputText escape="false" value="{!pinMessage}"/>
            </div>
        </apex:outputPanel>

        <apex:outputPanel rendered="{!pinSuccess}">
            <div class="alert alert-success">
                <button type='button' class='close' data-dismiss='alert'>×</button>
                <apex:outputText escape="false" value="{!pinMessage}"/>
            </div>
        </apex:outputPanel>
        <apex:outputPanel rendered="{!$CurrentPage.parameters.Suggest != null}">
            <div class="alert alert-success feedbackConfirm">
                <button type='button' class='close' id="closeFeedbackConfirm" data-dismiss='alert'>×</button>
                <p><strong>Thank you for suggesting an article!</strong> Your suggestions help ASU make the Knowledge Base better.</p>
            </div>
         </apex:outputPanel>
    </center>

    <div class="container">
        <div class="row">
            <div class="col-md-7">
                <div class="box firstbox">
                    <div class="header">
                        <h6><b>ASU Knowledge Base</b></h6>
                    </div>
                    <div class="content box-padding" id="search_content" >
                        <apex:form id="autoCompleteForm" styleClass="searchKB">
                            <apex:pageBlock mode="maindetail">
                                <p>Search for any issue or question to learn how ASU can help!</p><br />
                                <div class="searchKB2">
                                    <div class="form-horizontal">
                                        <apex:inputText id="articleTextBoxId" value="{!searchstring}" styleClass="searchBox" html-placeholder="Enter search terms"/>
                                        <apex:commandButton value="Search" action="{!checkSearchString}" id="submitButton" styleClass="kbbtn searchBtn" reRender="theSearchResults"/>
                                        <apex:commandButton value="Clear" styleClass="kbbtn searchBtn" style="width:37px;" onclick="this.form.reset();return false;"/>
                                    </div>

                                    <apex:inputHidden id="searchArticleId" value="{!selectedArticle}" />
                                </div>
                            </apex:pageBlock>
                        </apex:form>
                        <br />
                        <hr />
                        <apex:form id="theSearchResults">
                            <apex:pageBlock mode="maindetail" rendered="{!searchstring != ''}">
                                <h5><b>Search Results for:</b> '{!searchstring}'</h5>
                                <div style="height:5px;"/>
                                <knowledge:articleList articleVar="article"
                                    pageNumber="{!currentPageNumber}"
                                    Keyword="{!searchstring}"
                                    hasMoreVar="true"
                                    pageSize="10"
                                    rendered="{!searchstring != ''}">
                                    <table>
                                        <tr>
                                            <td style="vertical-align:top;">
                                                &#8226;&nbsp;
                                            </td>
                                            <td>
                                                <apex:outputLink value="/akb?id={!article.id}">{!article.title}</apex:outputLink><br />
                                                <div style="height:6px;"/>
                                            </td>
                                        </tr>
                                    </table>
                                </knowledge:articleList>
                                <button class="btn kbbtn" data-toggle="modal" data-target="#suggestAnArticle">
                                    Suggest An Article
                                </button>
                            </apex:pageBlock>

                            <apex:pageBlock mode="maindetail" rendered="{!searchString == null}">
                                <h5><b>Top 5 Help Articles</b></h5>
                                <div style="height:5px;"/>
                                <knowledge:articleList articleVar="article"
                                    sortBy="mostViewed">
                                    <table>
                                        <tr>
                                            <td style="vertical-align:top;">
                                                &#8226;&nbsp;
                                            </td>
                                            <td>
                                                <apex:outputLink value="/akb?id={!article.id}">{!article.title}</apex:outputLink><br />
                                                <div style="height:6px;"/>
                                            </td>
                                        </tr>
                                    </table>
                                </knowledge:articleList>
                            </apex:pageBlock>
                        </apex:form>
                    </div>
                </div>
                <div class="box firstbox">
                    <iframe src="https://webapp4.asu.edu/narrowcasting/ad/SMALL/myasu-servicecenter-1/true?rotate=true&interval=6000" scrolling="no" frameborder="0" width="100%" height="57" style="margin-bottom: -5px;"></iframe>
                </div>
            </div><!-- end col-md-7 -->
            <apex:form id="suggestAnArticle">
                <!-- Modal -->
                <div class="modal fade" id="suggestAnArticle" tabindex="-1" role="dialog" aria-labelledby="suggestAnArticleLabel" aria-hidden="true">
                  <div class="modal-dialog">
                    <div class="modal-content">
                      <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                        <h6 class="modal-title" id="suggestAnArticleLabel">Suggest An Article</h6>
                      </div>
                      <div class="modal-body">
                        <apex:pageBlock mode="maindetail">
                            <p>Have an idea for an article you'd like to see? Please tell us below!</p>
                            <br />
                            <apex:inputField id="articleDetails" required="true" value="{!suggestAnArticle.Description}" style="width:100%;max-width:400px;height:100px;border:solid 1px #999;border-radius:2px;"/>
                        </apex:pageBlock>
                      </div>
                      <div class="modal-footer">
                        <div class="pull-left">
                            <apex:commandButton value="Submit" action="{!suggestAnArticleSubmit}" styleClass="btn btn-default" style="width:40px;height:15px;padding:3px;"/>
                            <button type="button" class="btn btn-default" data-dismiss="modal" style="width:35px;height:15px;padding:3px;margin-top:0px;">Close</button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
            </apex:form>

            <div class="col-md-5">
                <apex:outputPanel rendered="{!HelpBox}">
                    <div class="box">
                        <div class="header">
                            <h6><b>Immediate Assistance</b></h6>
                        </div>
                        <div class="content">
                        <p>Please contact us if you need immediate assistance. We're available 24/7 to answer your questions.</p>
                        <div id="normalPhone">
                            <apex:outputLink styleClass="btn kbbtn btnLink" rendered="{!NormalPhone}" style="width:160px;color:#fff;background:#990033;padding:5px;" value="tel:1-855-278-5080"><span class="glyphicon glyphicon-earphone pull-left" style="padding-left:10px;"></span>&nbsp;&nbsp;&nbsp;1-855-ASU-5080</apex:outputLink>
                        </div>
                        <div id="roverPhone">
                            <apex:outputLink styleClass="btn kbbtn btnLink" rendered="{!RoverPhone}" style="width:160px;color:#fff;background:#990033;padding:5px;" value="tel:1-844-278-6693"><span class="glyphicon glyphicon-earphone pull-left" style="padding-left:10px;"></span>&nbsp;&nbsp;&nbsp;1-844-ASU-6693</apex:outputLink>
                        </div>

                        <hr />

                        <apex:outputPanel id="pinPanel" rendered="{!IF(myPin != null,true,false)}">
                            <apex:form id="pinForm" styleClass="pinForm">
                                <div id="pinFormDiv" style="margin-left:30px;">
                                    <h5>ASU Finances PIN</h5>&nbsp;

                                    <button type="button" class="qMarkMobile" data-toggle="modal" data-target="#finPinMobile" style="display:none">
                                        <img src="https://webapp4.asu.edu/myasu/images/icon-qmark.png" width="14" height="14" alt="qmark" style="margin-bottom:3px;cursor:pointer;"/>
                                    </button>

                                    <div class="modal fade" id="finPinMobile" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
                                        <div class="modal-dialog">
                                          <div class="modal-content">
                                            <div class="modal-header">
                                                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                                                <span class="glyphicon glyphicon-info-sign"></span>&nbsp;&nbsp;<h6 class="modal-title" id="myModalLabel">ASU Finances PIN Help</h6>
                                            </div>
                                            <div class="modal-body">
                                                <p>Use this PIN to access information about your financial aid and account balance when you call the number above. The PIN should be used to access your confidential account information and should not be shared with anyone. To choose another PIN select Reset and enter your own six digit PIN selection.</p>
                                            </div>
                                            <div class="modal-footer">
                                                <div class="pull-left">
                                                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                                                </div>
                                            </div>
                                          </div>
                                        </div>
                                    </div>

                                    <div id="tooltipPin" class="tooltipBox" style="margin-left:-190px;margin-top:-22px;display:none;position:absolute;width:100%;max-width:300px;height:auto;background:#eee;color:#000;z-index:200;box-shadow: 5px 4px 5px 0px rgba(0,0,0,0.5);">
                                        <div id="tooltipArrow"></div>
                                        <div style="width:100%;background:#ddd;padding:3px;padding-left:5px;border-bottom:solid 2px #cdcdcd;"><h6>ASU Finances PIN Help</h6><span id="closeTooltip" class="pull-right" style="padding-right:5px;cursor:pointer;"><a href="">x</a></span></div>
                                        <div style="padding:5px;font-size:8pt;"><p>Use this PIN to access information about your financial aid and account balance when you call the number above. The PIN should be used to access your confidential account information and should not be shared with anyone. To choose another PIN select Reset and enter your own six digit PIN selection.</p></div>
                                    </div>

                                    <a id="qmarkPin" href=""><img src="https://webapp4.asu.edu/myasu/images/icon-qmark.png" width="14" height="14" alt="qmark" style="margin-bottom:3px;cursor:pointer;"/></a><br />
                                    <input id="yourPinHidden" class="hiddenPinBox" style="padding-right:30px;width:60px;border:none;padding:6px;" disabled="true"/>
                                    <button id="viewPinBtn" class="viewPin" type="button">View</button>

                                    <apex:outputText id="yourPin" styleClass="pinBox" style="display:none" value="{!myPin}"/>
                                    <button id="hidePinBtn" class="viewPin" type="button" style="display:none;">Hide PIN</button>

                                    <button id="resetPin" class="resetPin kbbtn" type="button">Reset</button>

                                    <apex:inputText id="newPinInput" value="{!newPin}" html-placeholder="New Pin" onkeypress="return inputLimiter(event,'Numbers');" maxlength="10" styleClass="pinBoxInput" style="display:none;"/>
                                    <apex:commandButton id="savePinBtn" value="Save" action="{!changePin}" styleClass="savePin" style="display:none;"/>
                                    <button id="cancelPinInput" class="resetPin kbbtn" onclick="this.form.reset();" style="display:none;" type="button">Cancel</button>
                                    <p style="margin-top:5px;">Select <b>View</b> when calling to access confidential information about your financial aid and account balance.</p>
                                </div>

                                <script>
                                    $( "[id$=qmarkPin]" ).click(function() {
                                        $( "[id$=tooltipPin]" ).show();
                                    });

                                    $( "[id$=closeTooltip]" ).click(function() {
                                        $( "[id$=tooltipPin]" ).hide();
                                    });

                                    $(document).mouseup(function (e) {
                                        var container = $( "[id$=tooltipPin]" );
                                        if (!container.is(e.target) && container.has(e.target).length === 0) {
                                            container.hide();
                                        }
                                    });
                                </script>

                                <script>
                                    $( "[id$=viewPinBtn]" ).click(function() {
                                        $( "[id$=yourPinHidden]" ).hide();
                                        $( "[id$=viewPinBtn]" ).hide();
                                        $( "[id$=hidePinBtn]" ).show();
                                        $( "[id$=yourPin]" ).show();
                                    });

                                    $( "[id$=hidePinBtn]" ).click(function() {
                                        $( "[id$=hidePinBtn]" ).hide();
                                        $( "[id$=yourPin]" ).hide();
                                        $( "[id$=yourPinHidden]" ).show();
                                        $( "[id$=yourPinHidden]" ).val( "••••••••••" );
                                        $( "[id$=viewPinBtn]" ).show();
                                    });

                                    $( "[id$=resetPin]" ).click(function() {
                                        $( "[id$=hidePinBtn]" ).hide();
                                        $( "[id$=yourPin]" ).hide();
                                        $( "[id$=yourPinHidden]" ).hide();
                                        $( "[id$=viewPinBtn]" ).hide();
                                        $( "[id$=resetPin]" ).hide();
                                        $( "[id$=newPinInput]" ).show().focus();
                                        $( "[id$=savePinBtn]" ).show();
                                        $( "[id$=cancelPinInput]" ).show();
                                    });

                                    $( "[id$=cancelPinInput]" ).click(function() {
                                        $( "[id$=yourPinHidden]" ).show();
                                        $( "[id$=yourPinHidden]" ).val( "••••••••••" );
                                        $( "[id$=yourPin]" ).hide();
                                        $( "[id$=viewPinBtn]" ).show();
                                        $( "[id$=resetPin]" ).show();
                                        $( "[id$=newPinInput]" ).hide();
                                        $( "[id$=savePinBtn]" ).hide();
                                        $( "[id$=cancelPinInput]" ).hide();
                                    });

                                    $( document ).ready(function() {
                                        $( "[id$=yourPinHidden]" ).val( "••••••••••" );
                                        $( "[id$=newPinInput]" ).val( "" );
                                    });

                                    function inputLimiter(e,allow) {
                                        var AllowableCharacters = '';

                                        if (allow == 'Letters'){AllowableCharacters=' ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';}
                                        if (allow == 'Numbers'){AllowableCharacters='1234567890';}
                                        if (allow == 'NameCharacters'){AllowableCharacters=' ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-.\'';}
                                        if (allow == 'NameCharactersAndNumbers'){AllowableCharacters='1234567890 ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-\'';}
                                        if (allow == 'Currency'){AllowableCharacters='1234567890.';}

                                        var k = document.getElementById('newPinInput')?parseInt(e.keyCode): parseInt(e.which);
                                        if (k!=13 && k!=8 && k!=0){
                                            if ((e.ctrlKey==false) && (e.altKey==false)) {
                                            return (AllowableCharacters.indexOf(String.fromCharCode(k))!=-1);
                                            } else {
                                            return true;
                                            }
                                        } else {
                                            return true;
                                        }
                                    }
                                </script>
                            </apex:form>
