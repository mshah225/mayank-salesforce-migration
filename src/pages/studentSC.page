<apex:page showHeader="false"
    sidebar="false"
    cache="true"
    docType="html-5.0"
    controller="ServiceCenter"
    action="{!init}"
    extensions="vfKeywordSearchController,AutoCompleteController,NavLinks">
<head>
    <title>My ASU | Service Center</title>
    <c:asu_responsive_header_section />
    
    <style>
        .checkboxHidden {
            visibility:hidden;
        }

        .contactPhone td {
            padding: 0px !important;
        }

    </style>

    <script>
        (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
        (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
        m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
        })(window,document,'script','//www.google-analytics.com/analytics.js','ga');

        ga('create', 'UA-47141114-2', 'auto');
        ga('send', 'pageview');
    </script>

    <c:SCBomgarScripts asurite="{!asurite}"
                       firstName="{!firstName}"
                       lastName="{!lastName}"
                       emplId="{!emplId}"
                       viewingAs="{!viewingAs}"/>
</head>
<body onload="viewAsLinks()">
    <script>
        if (window.top !== window.self) top.location.replace(self.location.href);
    </script>

    <div id="main-search" class="main-search closed"></div>
    <c:SCHeader firstName="{!firstName}" 
                lastName="{!lastName}" 
                viewingAs="{!viewingAs}" 
                emplId="{!emplId}" 
                stopViewAsUrl="{!stopViewAsUrl}" 
                viewAsUrl="{!viewAsUrl}"/>

    <div id="asu_content_well">
        <c:SCPageNotifications viewingAs="{!viewingAs}"/>

        <apex:form id="suggestAnArticle">
            <!-- Modal -->
            <div class="modal fade" id="suggestAnArticle" tabindex="-1" role="dialog" aria-labelledby="suggestAnArticleLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                            <h6 class="modal-title" id="suggestAnArticleLabel">Suggest An Article</h6>
                        </div>
                        <div class="modal-body">
                            <apex:pageBlock mode="maindetail">
                                <p>Have an idea for an article you'd like to see? Please tell us below!</p>
                                <br />
                                <apex:inputField id="articleDetails" required="true" value="{!suggestAnArticle.Description}" style="width:100%;max-width:400px;height:100px;"/>
                            </apex:pageBlock>
                        </div>
                        <div class="modal-footer">
                            <div class="pull-left">
                                <apex:commandButton value="Submit" action="{!suggestAnArticleSubmit}" styleClass="btn btn-default" style="width:40px;height:15px;padding:3px;"/>
                                <button type="button" class="btn btn-default" data-dismiss="modal" style="width:35px;height:15px;padding:3px;margin-top:0px;">Close</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </apex:form>

        <div class="container">
            <div class="row">
                <div class="col-md-7">
                    <div class="box firstbox">
                        <div class="header">
                            <h6><b>ASU Knowledge Base</b></h6>
                        </div>

                        <div class="content box-padding" id="search_content" >
                            <apex:form id="autoCompleteForm" styleClass="searchKB">
                                <apex:pageBlock mode="maindetail">
                                    <p>Search for any issue or question to learn how ASU can help!</p><br />
                                    <div class="searchKB2">
                                        <div class="form-horizontal">
                                            <apex:inputText id="articleTextBoxId" value="{!searchstring}" styleClass="searchBox"
                                            html-placeholder="Enter search terms"/>
                                            <apex:commandButton value="Search" action="{!checkSearchString}" id="submitButton" styleClass="kbbtn searchBtn" reRender="theSearchResults" oncomplete="viewAsLinks()"/>
                                            <apex:commandButton value="Clear" styleClass="kbbtn searchBtn" style="width:37px;" onclick="this.form.reset();return false;"/>
                                        </div>

                                        <apex:inputHidden id="searchArticleId" value="{!selectedArticle}" />
                                    </div>
                                </apex:pageBlock>
                            </apex:form>
                            <br />
                            <hr />
                            <apex:form id="theSearchResults">
                                <apex:pageBlock mode="maindetail" rendered="{!searchstring != ''}">
                                    <h5><b>Search Results for:</b> '{!searchstring}'</h5>
                                    <div style="height:5px;"/>
                                    <knowledge:articleList articleVar="article"
                                        pageNumber="{!currentPageNumber}"
                                        Keyword="{!searchstring}"
                                        hasMoreVar="true"
                                        pageSize="10"
                                        rendered="{!searchstring != ''}">
                                        <table>
                                            <tr>
                                                <td style="vertical-align:top;">
                                                    &#8226;&nbsp;
                                                </td>
                                                <td>
                                                    <apex:outputLink value="/akb?id={!article.id}">{!article.title}</apex:outputLink><br />
                                                    <div style="height:6px;"/>
                                                </td>
                                            </tr>
                                        </table>
                                    </knowledge:articleList>
                                    <br />
                                    <button class="btn kbbtn" data-toggle="modal" data-target="#suggestAnArticle">
                                        Suggest An Article
                                    </button>
                                </apex:pageBlock>

                                <apex:pageBlock mode="maindetail" rendered="{!searchString == null}">
                                    <h5><b>Top 5 Help Articles</b></h5>
                                    <div style="height:5px;"/>
                                    <knowledge:articleList articleVar="article"
                                        sortBy="mostViewed">
                                        <table>
                                            <tr>
                                                <td style="vertical-align:top;">
                                                    &#8226;&nbsp;
                                                </td>
                                                <td>
                                                    <apex:outputLink value="/akb?id={!article.id}">{!article.title}</apex:outputLink><br />
                                                    <div style="height:6px;"/>
                                                </td>
                                            </tr>
                                        </table>
                                    </knowledge:articleList>
                                </apex:pageBlock>
                            </apex:form>
                        </div>
                    </div>
                    <div class="box firstbox">
                        <iframe src="https://webapp4.asu.edu/narrowcasting/ad/SMALL/myasu-servicecenter-1/true?rotate=true&interval=6000" scrolling="no" frameborder="0" width="100%" height="57" style="margin-bottom: -5px;"></iframe>
                    </div>
                </div><!-- end col-md-7 -->

                <div class="col-md-5">
                    <c:SCImmediateAssistanceBox HelpBox="{!HelpBox}"
                                                NormalPhone="{!NormalPhone}"
                                                RoverPhone="{!RoverPhone}"
                                                myPin="{!myPin}"
                                                newPin="{!newPin}"
                                                changePin="{!changePin}"/>
                    <c:SCMyCasesBox />
                </div><!-- end col-md-5 -->
            </div><!-- end first row -->
        </div><!-- End main container -->
        <c:SCFooter />
    </div><!-- End ASU Content -->

    <!-- Autocomplete Code -->
    <script type="text/javascript">
        var PLACEHOLDER = '';
        var articleObjects;
        var queryTerm;

        $('[id$=articleTextBoxId]').autocomplete({
            minLength: 2,
            source: function(request, response) {
                        queryTerm = request.term;
                        AutoCompleteController.searchArticle(request.term, function(result, event){
                            if(event.type == 'exception') {
                                  alert(event.message);
                            } else {
                                 articleObjects = result;
                                 response(articleObjects);
                            }
                        });
                   },
            focus: function( event, ui ) {
                    $('[id$=articleTextBoxId]').val( ui.item.Title );
                    return false;
                    },
            select: function( event, ui ) {
                        $('[id$=articleTextBoxId]').val( ui.item.Title );
                        $('[id$=searchArticleId]').val( ui.item.Id );
                        return false;
                    },
         })
         .data( "ui-autocomplete" )._renderItem = function( ul, item ) {
            var entry = "<a href=/akb?id=" + item.KnowledgeArticleId + ">" + item.Title + "</a><hr>";

            entry = entry.replace(queryTerm, "<b>" + queryTerm + "</b>");
            return $( "<li></li>" )
                .data( "item.autocomplete", item )
                .append( entry )
                .appendTo( ul );
        };

        $('[id$=articleTextBoxId]').val(PLACEHOLDER);
        $('[id$=articleTextBoxId]').on("focus",  function(event){
            $tgt = $(event.target);
            if($tgt.val() === PLACEHOLDER ){
                $tgt.val('');
                $tgt.removeClass('placeHolder');
            }
        });
        $('[id$=articleTextBoxId]').on( "blur",  function(event){
            $tgt = $(event.target);
            if($tgt.val() === '' ){
                $tgt.val(PLACEHOLDER);
                $tgt.addClass('placeHolder');
            }
        });
    </script>

    <script>
        if (!(navigator.userAgent.match(/Android/i)
             || navigator.userAgent.match(/webOS/i)
             || navigator.userAgent.match(/iPhone/i)
             || navigator.userAgent.match(/iPad/i)
             || navigator.userAgent.match(/iPod/i)
             || navigator.userAgent.match(/BlackBerry/i)
             || navigator.userAgent.match(/Windows Phone/i)))
        {
            document.getElementById("normalPhone").addEventListener("click", function(event){
                event.preventDefault();
            });

            document.getElementById("normalPhone").addEventListener("contextmenu", function(event){
                event.preventDefault();
            });

            document.getElementById("roverPhone").addEventListener("click", function(event){
                event.preventDefault();
            });

            document.getElementById("roverPhone").addEventListener("contextmenu", function(event){
                event.preventDefault();
            });
        }
    </script>

    <script>
        function viewAsLinks() {
            var masqCookie = "{!masqScopeIdCookie}";
            var viewingAs = "{!viewingAs}";
            if (masqCookie != "" && viewingAs == "true") {
                $("a").each(function() {
                    var href = this.href;
                    if (href.indexOf("force") > -1)
                    {
                        if (href.indexOf("?") != -1) {
                            href = href + "&masqScopeIdCookie={!masqScopeIdCookie}";
                        }
                        else {
                            href = href + "?masqScopeIdCookie={!masqScopeIdCookie}";
                        }
                        $(this).attr("href", href);
                    }
                });
            }
        }
    </script>
</body>
</apex:page>
