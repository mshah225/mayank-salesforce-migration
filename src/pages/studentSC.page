<apex:page docType="html-5.0" showHeader="false" standardStylesheets="false" sidebar="false" controller="MyASUHelpController"
    cache="true" extensions="MyASUHelpPaginationController">

    <head>
        <title>My ASU | Help</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="shortcut icon" href="{!URLFOR($Resource.bootstrap_4_asu, '/dist/img/favicon/favicon.ico')}" />
        <c:GoogleTagManager />
        <c:GoogleAnalytics />
        <apex:includeScript value="{!URLFOR($Resource.jQuery_1_11_1_Min)}" />
        <script>$ = jQuery.noConflict();</script>
        <apex:stylesheet value="{! URLFOR($Resource.bootstrap_4_asu, '/dist/css/bootstrap-asu.min.css')}" />
        <c:MyASUHelpStyles />
        <c:MyASUHelpBomgarService asurite="{!asurite}" firstName="{!firstName}" lastName="{!lastName}" emplId="{!emplId}" viewingAs="{!viewingAs}"
        />
    </head>

    <apex:includeLightning />
    <c:SLDSRemoveGlobalStyles />
    <div id="ASUBrandHeaderWrapper"></div>
    <div id="ASUBrandViewAsWrapper" style="{!IF(viewingAs, '', 'display:none')}" />

    <c:GoogleTagManagerBody />
    <div role="main">
        <c:MyASUHelpPageNotifications maintenanceString="{!mMessage}" />
        <div class="container myasu-help-scope">
            <div class="row">
                <div class="col-lg-7">
                    <c:MyASUHelpFAQ />
                </div>
                <div class="col-lg-5">
                    <div class="mb-4">
                        <c:MyASUHelpContactUs HelpBox="{!HelpBox}" NormalPhone="{!NormalPhone}" RoverPhone="{!RoverPhone}" />
                    </div>
                    <div class="mb-4">
                        <c:MyASUHelpMyRequests/>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12">
                    <c:FeedbackButton carName="My ASU Help Tab" classes="btn btn-maroon btn-md mb-1" />
                </div>
            </div>
        </div>
    </div>

    <div id="ASUBrandFooterWrapper"></div>

    <script>
        var widthToPush;
        var viewAsLinkWidth = realWidth($('.asu-brand-menu-view-as-change'));
        var logoutAsLinkWidth = realWidth($('.asu-brand-menu-view-as-logout'));

        if (viewAsLinkWidth > logoutAsLinkWidth) {
            widthToPush = viewAsLinkWidth;
        } else if (viewAsLinkWidth < logoutAsLinkWidth) {
            widthToPush = logoutAsLinkWidth;
        } else {
            widthToPush = logoutAsLinkWidth;
        }

        $('.asu-brand-menu-view-as-dropdown-menu').width(widthToPush + 2);

        function realWidth(obj) {
            var clone = obj.clone();
            clone.css('visibility', 'hidden');
            $('body').append(clone);
            var width = clone.outerWidth();
            clone.remove();
            return width;
        }

        // Load LWCs
        const urlParams = new URLSearchParams(window.location.search);
        let navTreeStr = '{"navbarLinks" : [{"text": "Home", "type": "icon-home", "class": "data-class", "href": "https://webapp4.asu.edu/myasu/student" }, {"text": "Finances", "href": "https://webapp4.asu.edu/myasu/student/finances" }, {"text": "Campus Services", "href": "https://webapp4.asu.edu/myasu/student/campusservices" }, {"text": "Profile", "href": "https://webapp4.asu.edu/myasu/student/profile" }, {"text": "Help", "href": "https://webapp4.asu.edu/myasu/student/servicecenter", "selected": true }]}';
        let title = 'My ASU';
        let baseUrl = 'https://webapp4.asu.edu/myasu/student';
        if (urlParams.get('navTree') != null || urlParams.get('navbar') != null) {
            navTreeStr = undefined;
        }
        if (urlParams.get('title') != null) {
            title = undefined;
        }
        if (urlParams.get('baseUrl') != null) {
            baseUrl = undefined;
        }

        $Lightning.use(
            "c:ASUBrandApp",
            function () {
                $Lightning.createComponent(
                    "c:asuBrandHeader",
                    { title, baseUrl, navTreeStr },
                    "ASUBrandHeaderWrapper"
                );
                $Lightning.createComponent(
                    "c:asuBrandFooter",
                    {},
                    "ASUBrandFooterWrapper"
                );
                $Lightning.createComponent(
                    "c:asuBrandViewAs",
                    {
                        firstName: '{!firstName}',
                        lastName: '{!lastName}',
                        viewingAs: '{!viewingAs}',
                        emplId: '{!emplId}',
                        stopViewAsUrl: '{!stopViewAsUrl}',
                        viewAsUrl: '{!viewAsUrl}'
                    },
                    "ASUBrandViewAsWrapper"
                );
            }
        );

    </script>
    <c:MyASUHelpPageResources masqScopeIdCookie="{!masqScopeIdCookie}" viewingAs="{!viewingAs}" />
</apex:page>