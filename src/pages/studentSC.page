<apex:page showHeader="false" 
    sidebar="false" 
    docType="html-5.0" 
    title="My Service Center" 
    controller="ServiceCenter"
    action="{!init}"
    tabStyle="Dashboard"
    extensions="vfKeywordSearchController,AutoCompleteController,NavLinks">  
<head>
    <title>My ASU - Service Center</title>
    <link rel="shortcut icon" href="{!URLFOR($Resource.bootstrap_303, 'favicon.ico')}"/>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1, maximum-scale=1" />

    <c:asu_responsive_header_section />
    
    <!-- Stylesheets for Bootstrap/jQuery UI/MyASU -->
    <apex:stylesheet value="{!URLFOR($Resource.bootstrap_303, '/dist/css/bootstrap.min.css')}"/>
    <apex:stylesheet value="{!URLFOR($Resource.jquery_ui, '/themes/base/minified/jquery-ui.min.css')}"/>
    <c:myasustyles />  
    
    <!-- Javascript for Autocomplete/Bootstrap -->
    <apex:includeScript value="{!URLFOR($Resource.bootstrap_303, '/dist/js/jquery-1.10.2.min.js')}"/>
    <apex:includeScript value="{!URLFOR($Resource.bootstrap_303, '/dist/js/bootstrap.min.js')}"/>
    <apex:includeScript value="{!URLFOR($Resource.jquery_ui, '/ui/minified/jquery-ui.min.js')}"/>
    
    
    <style>
        .checkboxHidden {
            visibility:hidden;
        }
        
        .contactPhone td {
            padding: 0px !important;
        }

        .alert.alert-success {
            border-radius: 0px;
        }
    </style> 
    
    <script src="https://bomgar.asu.edu/api/start_session.js"></script>
    <script>
        BG.setSite("bomgar.asu.edu");
        var custName = "{!$Component.customer_name}";
        var desc = "{!$Component.description}";
        var emplid = "{!$User.EmplId__c}";
    
        function start(){
            var jsonString = null;
            var jsonObject = {};
            jsonObject.employeeNumber = emplid;
            jsonObject.description = document.getElementById('description').value;
            try{
                jsonString = JSON.stringify(jsonObject);
            }
            catch(e){
            
            }
            if(jsonString == null){
                jsonString = '{"employeeNumber":"{!$User.EmplId__c}", "description":"' + document.getElementById('description').value + '"}';
            }
                     
            BG.start(BG.START_TYPE.CHAT, {
                issue: {
                    codeName: 'salesforce_chat',
                    customerName: '{!$User.Contact_First_Name__c} {!$User.Contact_Last_Name__c}',
                    companyName: 'ASU',
                    details: document.getElementById('description').value
                },
                attributes:{
                    externalKey: ('SFDC:' + jsonString)
                },
                uiOptions:{
                    fallbackToFullWindow:true
                }
            });              
        }
    </script>    
</head>
