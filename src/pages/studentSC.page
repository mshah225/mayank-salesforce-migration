                                            <apex:outputLink rendered="{!searchstring != ''}" onMouseOver="this.style.color='#990033';" onMouseOut="this.style.color='';" value="/akb?id={!article.id}">-&nbsp;{!article.title}</apex:outputLink>
                                            </td>
                                        </tr>
                                    </table>
                                </knowledge:articleList>
                                </apex:panelGrid> 
