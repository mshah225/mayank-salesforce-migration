                <apex:form id="autoCompleteForm" styleClass="searchKB">
                    <apex:pageBlock mode="maindetail">
                        <p>Search for any issue or question to learn how ASU can help!</p><br />
                        <div class="searchKB2">   
                            <div class="form-horizontal">
                                <apex:inputText id="articleTextBoxId" value="{!searchstring}" styleClass="placeHolder" style="height:24px;width:58%;border-radius:2px;border:solid 1px #990033;padding-left:5px;padding-top:.5px;font-size:1em;"/>
                                <apex:commandButton value="Search" id="submitButton" styleClass="kbbtn submitButton" style="" reRender="theSearchResults" />
                                <apex:commandButton value="Clear" styleClass="kbbtn clearButton" style="width:37px;" onclick="this.form.reset();return false;" />
                            </div>
                             
                            <apex:inputHidden id="searchArticleId" value="{!selectedArticle}" />
                        </div>
                         
