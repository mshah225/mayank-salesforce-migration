<apex:page docType="html-5.0"
    showHeader="false"
    sidebar="false"
    controller="ServiceCenter"
    extensions="ViewAllArticlesController,NavLinks">
<head>
    <title>My ASU | Search For Articles</title>
    <c:asu_responsive_header_section />

    <script>
        (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
        (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
        m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
        })(window,document,'script','//www.google-analytics.com/analytics.js','ga');

        ga('create', 'UA-47141114-2', 'auto');
        ga('send', 'pageview');
    </script>
</head>

<body onload="viewAsLinks()">
    <div id="main-search" class="main-search closed"></div>

    <c:SCHeader firstName="{!firstName}"
                lastName="{!lastName}"
                viewingAs="{!viewingAs}"
                emplId="{!emplId}"
                stopViewAsUrl="{!stopViewAsUrl}"
                viewAsUrl="{!viewAsUrl}"/>

    <div id="asu_content_well">
        <c:SCPageNotifications viewingAs="{!viewingAs}"
                               firstName="{!firstName}"
                               lastName="{!lastName}"/>

        <apex:form id="suggestAnArticle">
            <!-- Modal -->
            <div class="modal fade"
                 id="suggestAnArticle"
                 tabindex="-1" role="dialog"
                 aria-labelledby="suggestAnArticleLabel"
                 aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button"
                                    class="close"
                                    data-dismiss="modal">
                                <span aria-hidden="true">&times;</span>
                                <span class="sr-only">
                                    Close
                                </span>
                            </button>
                            <h6 class="modal-title" id="suggestAnArticleLabel">Suggest An Article</h6>
                        </div>

                        <div class="modal-body">
                            <apex:pageBlock mode="maindetail">
                                <p>Have an idea for an article you'd like to see? Please tell us below!</p>
                                <br />
                                <apex:inputField id="articleDetails"
                                                 required="true"
                                                 value="{!suggestAnArticle.Description}"
                                                 style="width:100%;max-width:400px;height:100px;"/>
                            </apex:pageBlock>
                        </div>

                        <div class="modal-footer">
                            <div class="pull-left">
                                <apex:commandButton
                                        value="Submit"
                                        action="{!suggestAnArticleSubmit}"
                                        styleClass="btn btn-default"
                                        style="width:40px;height:15px;padding:3px;"/>

                                <button type="button"
                                        class="btn btn-default"
                                        data-dismiss="modal"
                                        style="width:35px;height:15px;padding:3px;margin-top:0px;">
                                    Close
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </apex:form>

        <div class="container">
            <ol class="breadcrumb">
                <li><a href="/{!source}">Back</a></li>
                <li class="active" style="font-size:10pt;">Search For Articles</li>
            </ol>

            <div class="row">
                <div class="col-md-12">
                    <div class="box">
                        <div class="header">
                            <h6><b>Article Search</b></h6>
                        </div>

                        <div class="content box-padding" id="search_content">
                            <apex:form id="autoCompleteForm" styleClass="searchKB">
                                <apex:pageBlock mode="maindetail">
                                    <p>Search for any issue or question to learn how ASU can help!</p><br />
                                    <div class="searchKB2">
                                        <div class="form-horizontal">
                                            <apex:inputText id="articleTextBoxId"
                                                            value="{!searchstring}"
                                                            styleClass="searchBox"
                                                html-placeholder="What would you like to know?"/>

                                            <apex:commandButton value="Search"
                                                                action="{!checkSearchString}"
                                                                id="submitButton"
                                                                styleClass="kbbtn searchBtn"
                                                                reRender="theSearchResults"
                                                                oncomplete="viewAsLinks()"
                                                                status="KBSearchStatus"/>

                                            <apex:commandButton value="Clear"
                                                                styleClass="kbbtn searchBtn"
                                                                style="width:37px;"
                                                                action="{!clearSearchString}"/>

                                            <apex:actionStatus id="KBSearchStatus">
                                                <apex:facet name="start">
                                                    <img src="/img/loading.gif"
                                                         style="position:absolute;margin-left:-125px;margin-top:6px;"/>
                                                </apex:facet>
                                            </apex:actionStatus>
                                        </div>
                                    </div>
                                </apex:pageBlock>
                            </apex:form>
                            <br />
                            <hr />
                            <apex:form id="theSearchResults">
                                <apex:pageBlock mode="maindetail" rendered="{!searchstring != ''}">
                                    <h5><b>Results for:</b> '{!searchstring}'</h5>
                                    <div style="height:5px;"></div>
                                    <knowledge:articleList articleVar="article"
                                                           Keyword="{!searchstring}"
                                                           pageSize="20">
                                        <table>
                                            <tr>
                                                <td style="vertical-align:top;">
                                                    &#8226;&nbsp;
                                                </td>
                                                <td>
                                                    <apex:outputLink value="/akb?id={!article.Id}">
                                                        {!article.Title}
                                                    </apex:outputLink>
                                                    <br />
                                                    <apex:outputText value="Date Updated: " />
                                                    <apex:outputText value="{0,date,MMMMM' 'd', 'yyyy}">
                                                        <apex:param value="{!article
                                                        .LastModifiedDate}" />
                                                    </apex:outputText>
                                                    <br />
                                                    <div style="height:15px;"></div>
                                                </td>
                                            </tr>
                                        </table>
                                    </knowledge:articleList>
                                    <br />
                                    <button class="btn kbbtn"
                                            data-toggle="modal"
                                            data-target="#suggestAnArticle">
                                        Suggest An Article
                                    </button>
                                </apex:pageBlock>

                                <apex:pageBlock mode="maindetail" rendered="{!searchString == null}">
                                    <h5><b>Popular Articles</b></h5>
                                    <div style="height:5px;"></div>
                                    <knowledge:articleList articleVar="article"
                                                           sortBy="mostViewed"
                                                           pageSize="20">
                                        <table>
                                            <tr>
                                                <td style="vertical-align:top;">
                                                    &#8226;&nbsp;
                                                </td>
                                                <td>
                                                    <apex:outputLink value="/akb?id={!article.id}">
                                                        {!article.title}
                                                    </apex:outputLink>
                                                    <br />
                                                    <apex:outputText value="Date Updated: " />
                                                    <apex:outputText value="{0,date,MMMMM' 'd', 'yyyy}">
                                                        <apex:param value="{!article
                                                        .LastModifiedDate}" />
                                                    </apex:outputText>
                                                    <br />
                                                    <div style="height:15px;"></div>
                                                </td>
                                            </tr>
                                        </table>
                                    </knowledge:articleList>
                                </apex:pageBlock>
                            </apex:form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <c:SCFooter/>

    <script>
        function viewAsLinks() {
            var masqCookie = "{!masqScopeIdCookie}";
            var viewingAs = "{!viewingAs}";
            if (masqCookie != "" && viewingAs == "true") {
                $("a").each(function() {
                    var href = this.href;
                    if (href.indexOf("force") > -1) {
                        if (href.indexOf("?") != -1) {
                            href = href + "&masqScopeIdCookie={!masqScopeIdCookie}";
                        }
                        else {
                            href = href + "?masqScopeIdCookie={!masqScopeIdCookie}";
                        }
                        $(this).attr("href", href);
                    }
                });
            }
        }
    </script>
</body>
</apex:page>
