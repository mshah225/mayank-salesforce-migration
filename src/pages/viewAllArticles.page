<apex:page docType="html-5.0" showHeader="false" standardStylesheets="false" sidebar="false" controller="MyASUHelpController"
    cache="true" extensions="MyASUHelpPaginationController">

    <head>
        <title>My ASU | Help | View All Articles</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="shortcut icon" href="{!URLFOR($Resource.bootstrap_4_asu, '/dist/img/favicon/favicon.ico')}" />
        <apex:stylesheet value="{! URLFOR($Resource.bootstrap_4_asu, '/dist/css/bootstrap-asu.min.css')}" />
        <apex:includeScript value="{!URLFOR($Resource.jQuery_1_11_1_Min)}" />
        <script>$ = jQuery.noConflict();</script>
        <c:GoogleTagManager />
        <c:GoogleAnalytics />
        <c:MyASUHelpStyles />
    </head>

    <c:GoogleTagManagerBody />

    <apex:includeLightning />
    <c:SLDSRemoveGlobalStyles />

    <div id="ASUBrandHeaderWrapper" class="no-slds-scope"></div>

    <c:MyASUHelpPageNotifications viewingAs="{!viewingAs}" firstName="{!firstName}" lastName="{!lastName}" />

    <div role="main">
        <div class="container myasu-help-scope">
            <nav aria-label="breadcrumbs">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">Home</li>
                    <li class="breadcrumb-item">
                        <a class="c-text-maroon" href="/">Help</a>
                    </li>
                    <li class="breadcrumb-item active">View All Articles</li>
                </ol>
            </nav>

            <div class="row">
                <div class="col-lg-12">
                    <c:MyASUHelpFAQ EmbedLocation="viewAllArticles" />
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12">
                    <c:FeedbackButton carName="My ASU Help Tab" classes="btn btn-maroon btn-md mt-1 mb-1" />
                </div>
            </div>
        </div>
    </div>

    <div id="ASUBrandFooterWrapper" class="no-slds-scope"></div>
    <c:MyASUHelpPageResources masqScopeIdCookie="{!masqScopeIdCookie}" viewingAs="{!viewingAs}" />

    <script>
        function checkNumbers() {
            var pageSize = '{!pageSize}';
            var aCount = document.getElementById('{!$Component.theSearchResults}').getElementsByTagName('a').length;
            console.log('aCount: ' + aCount);
            console.log('pageSize: ' + pageSize);
            if (aCount < pageSize) {
                console.log('In if');
                document.getElementById('{!$Component.theSearchResults.searchResults.nextBtn}').style.display = 'none';
                document.getElementById('{!$Component.theSearchResults.searchResults.nextBtnDisabled}').style.display =
                    'block';
            } else {
                document.getElementById('{!$Component.theSearchResults.searchResults.nextBtn}').style.display =
                    'initial';
                document.getElementById('{!$Component.theSearchResults.searchResults.nextBtnDisabled}').style.display =
                    'none';
            }
        }

        const urlParams = new URLSearchParams(window.location.search);
        let navTreeStr = '{"navbarLinks" : [{"text": "Home", "type": "icon-home", "class": "data-class", "href": "https://webapp4.asu.edu/myasu/student" }, {"text": "Finances", "href": "https://webapp4.asu.edu/myasu/student/finances" }, {"text": "Campus Services", "href": "https://webapp4.asu.edu/myasu/student/campusservices" }, {"text": "Profile", "href": "https://webapp4.asu.edu/myasu/student/profile" }, {"text": "Help", "href": "https://webapp4.asu.edu/myasu/student/servicecenter", "selected": true }]}';
        let title = 'My ASU';
        let baseUrl = 'https://webapp4.asu.edu/myasu/student';
        if (urlParams.get('navTree') != null || urlParams.get('navbar') != null) {
            navTreeStr = undefined;
        }
        if (urlParams.get('title') != null) {
            title = undefined;
        }
        if (urlParams.get('baseUrl') != null) {
            baseUrl = undefined;
        }

        $Lightning.use(
            "c:ASUBrandApp",
            function () {
                $Lightning.createComponent(
                    "c:asuBrandHeader",
                    { title, baseUrl, navTreeStr },
                    "ASUBrandHeaderWrapper"
                );
                $Lightning.createComponent(
                    "c:asuBrandFooter",
                    {},
                    "ASUBrandFooterWrapper"
                );
            }
        );
    </script>
</apex:page>