<apex:page docType="html-5.0" showHeader="false" sidebar="false" controller="MyASUHelpFAQController" action="{!init}" cache="true"
    extensions="MyASUHelpPaginationController,NavLinks">

    <head>
        <c:GoogleTagManager />
        <c:GoogleAnalytics />

        <title>My ASU | Help | View All Articles</title>

        <c:MyASUHelpStyles />
    </head>

    <c:GoogleTagManagerBody />

    <c:ASUBrandHeader />
    <div class="asu-header-site-title-container">
        <div>
            <div id="asu-header-site-title" class="asu-header-width">
                <a href="https://webapp4.asu.edu/myasu">My ASU</a>
            </div>
        </div>
    </div>
    <c:MyASUHelpMegaMenu firstName="{!firstName}" lastName="{!lastName}" viewingAs="{!viewingAs}" emplId="{!emplId}" stopViewAsUrl="{!stopViewAsUrl}"
        viewAsUrl="{!viewAsUrl}" linkList="{!linkList}" />

    <div id="asu_content_well" class="myasu-help-region myasu-help-region-full-width">
        <c:MyASUHelpPageNotifications viewingAs="{!viewingAs}" firstName="{!firstName}" lastName="{!lastName}" />
        <apex:form id="suggestAnArticle">
            <div class="modal fade" id="suggestAnArticle" tabindex="-1" role="dialog" aria-labelledby="suggestAnArticleLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal">
                                <span aria-hidden="true">&times;</span>
                                <span class="sr-only">
                                    Close
                                </span>
                            </button>
                            <h6 class="modal-title" id="suggestAnArticleLabel">Suggest An Article</h6>
                        </div>

                        <div class="modal-body">
                            <apex:pageBlock mode="maindetail">
                                <p>Have an idea for an article you'd like to see? Please tell us below!</p>
                                <br />
                                <apex:inputField id="articleDetails" required="true" value="{!suggestAnArticle.Description}" style="width:100%;max-width:400px;height:100px;"
                                />
                            </apex:pageBlock>
                        </div>

                        <div class="modal-footer">
                            <div class="pull-left">
                                <apex:commandButton value="Submit" action="{!suggestAnArticleSubmit}" styleClass="btn btn-default" style="width:40px;height:15px;padding:3px;"
                                />

                                <button type="button" class="btn btn-default" data-dismiss="modal" style="width:35px;height:15px;padding:3px;margin-top:0px;">
                                    Close
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </apex:form>

        <div class="container myasu-help-region">
            <ol class="breadcrumb">
                <li class="active">Home</li>
                <li class="active">
                    <a href="/">Help</a>
                </li>
                <li class="active">View All Articles</li>
            </ol>
            <div class="row">
                <div class="col-md-12">
                    <c:MyASUHelpFAQ EmbedLocation="viewAllArticles" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div id="bgWrapper">
                        <c:FeedbackButton carName="MyASU Service Center" classes="btn btn-primary" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <c:ASUBrandFooter />
    <c:MyASUHelpPageResources masqScopeIdCookie="{!masqScopeIdCookie}" viewingAs="{!viewingAs}" />

    <script>
        function checkNumbers() {
            var pageSize = "{!pageSize}";
            var aCount = document.getElementById("{!$Component.theSearchResults}")
                .getElementsByTagName("a").length;
            console.log("aCount: " + aCount);
            console.log("pageSize: " + pageSize);
            if (aCount < pageSize) {
                console.log("In if");
                document.getElementById("{!$Component.theSearchResults.searchResults.nextBtn}").style.display = "none";
                document.getElementById("{!$Component.theSearchResults.searchResults.nextBtnDisabled}").style.display = "block";
            } else {
                document.getElementById("{!$Component.theSearchResults.searchResults.nextBtn}").style.display = "initial";
                document.getElementById("{!$Component.theSearchResults.searchResults.nextBtnDisabled}").style.display = "none";
            }
        }
    </script>
</apex:page>