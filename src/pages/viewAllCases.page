<apex:page docType="html-5.0"
	showHeader="false"
	sidebar="false"
	controller="ViewAllCasesController"
	extensions="NavLinks">
<head>
    <title>MyASU - Service Center View All Cases</title>
	<meta charset="utf-8" />
    <link rel="shortcut icon" href="{!URLFOR($Resource.bootstrap_303, 'favicon.ico')}"/>
    <c:asu_responsive_header_section />
    <apex:stylesheet value="{!URLFOR($Resource.bootstrap_303, '/dist/css/bootstrap.min.css')}"/>
    <c:myasustyles />
    <apex:includeScript value="{!URLFOR($Resource.bootstrap_303, '/dist/js/jquery-1.10.2.min.js')}"/>
    <apex:includeScript value="{!URLFOR($Resource.bootstrap_303, '/dist/js/bootstrap.min.js')}"/>

    <style>
        .panel {
            border-radius: 0px !important;
        }
        .myCasesTable {
        	margin-top: 0px !important;
        }
    </style>
</head>
<body>
    <c:SCHeader/>
    <div class="container">
        <ol class="breadcrumb">
            <li><a href="/{!source}">Back</a></li>
            <li class="active" style="font-size:10pt;">View All Cases</li>
        </ol>
        <div class="row">
            <div class="col-md-12">
            	<!-- My Open Cases view -->
                <div class="box">
                    <div class="header">
                        <h6><b>My Open Cases</b></h6>
                    </div>
	                <div id="openCases">
	                    <apex:form >
	                        <apex:pageBlock mode="maindetail">
	                            <apex:pageBlockTable rendered="{!(openCases.size >= 1)}" value="{!openCases}" var="case" styleClass="myCasesTable" style="border:none;box-shadow:none;">
	                                <apex:column headerValue="Subject" styleClass="truncate" width="50%" value="{!case.Subject}" style="background-color:white;overflow-x:hidden;" onmousemove="this.style.backgroundColor='white'" onmouseout="this.style.backgroundColor ='white'"/>
                                    <apex:column headerValue="Status" width="30%" value="{!case.Status}" style="background-color:white" onmousemove="this.style.backgroundColor='white'" onmouseout="this.style.backgroundColor ='white'"/>
                                    <apex:column headerValue="Date Opened" width="15%" value="{!case.CreatedDate}" style="background-color:white" onmousemove="this.style.backgroundColor='white'" onmouseout="this.style.backgroundColor ='white'"/>
                                    <apex:column width="5%" style="background-color:white;text-align:right" onmousemove="this.style.backgroundColor='white'" onmouseout="this.style.backgroundColor ='white'">
	                                    <apex:commandLink value="View" styleClass="btn" style="padding:4px;" action="{!viewCase}">
	                                        <apex:param name="caseId" value="{!case.Id}"/>
	                                    </apex:commandLink>
	                                </apex:column>
	                            </apex:pageBlockTable>
	                            <apex:outputText rendered="{!(openCases.size = 0)}">
                                    <div class="padClass"> You do not have any open cases. </div>
                                </apex:outputText>
	                        </apex:pageBlock>
	                    </apex:form>
	                </div>
	            </div>
	            <br />
	            <!-- My Closed Cases view -->
                <div class="box">
                	<div class="header">
                		<h6><b>My Closed Cases</b></h6>
                	</div>
                	<div id="closedCases">
	                    <apex:form >
	                        <apex:pageBlock mode="maindetail">
	                            <apex:pageBlockTable rendered="{!(closedCases.size >= 1)}" value="{!closedCases}" var="case" styleClass="myCasesTable" style="border:none;box-shadow:none;">
	                                <apex:column headerValue="Subject" styleClass="truncate" width="50%" value="{!case.Subject}" style="background-color:white;overflow-x:hidden;" onmousemove="this.style.backgroundColor='white'" onmouseout="this.style.backgroundColor ='white'"/>
                                    <apex:column headerValue="Status" width="30%" value="{!case.Status}" style="background-color:white" onmousemove="this.style.backgroundColor='white'" onmouseout="this.style.backgroundColor ='white'"/>
                                    <apex:column headerValue="Date Closed" width="15%" value="{!case.ClosedDate}" style="background-color:white" onmousemove="this.style.backgroundColor='white'" onmouseout="this.style.backgroundColor ='white'"/>
                                    <apex:column width="5%" style="background-color:white;text-align:right" onmousemove="this.style.backgroundColor='white'" onmouseout="this.style.backgroundColor ='white'">
	                                    <apex:commandLink value="View" styleClass="btn" style="padding:4px;" action="{!viewCase}">
	                                        <apex:param name="caseId" value="{!case.Id}"/>
	                                    </apex:commandLink>
	                                </apex:column>
	                            </apex:pageBlockTable>
	                            <apex:outputText rendered="{!(closedCases.size = 0)}">
                                    <div class="padClass"> You do not have any closed cases. </div>
                                </apex:outputText>
	                        </apex:pageBlock>
	                    </apex:form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />
    <c:SCSecondaryFooter/>
</body>
</apex:page>
