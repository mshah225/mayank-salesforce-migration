<apex:page docType="html-5.0" showHeader="false" standardStylesheets="false" sidebar="false" controller="ViewAllCasesController"
    action="{!init}" cache="true" extensions="ASUBrandController">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.1/jquery.min.js" />

    <head>
        <title>My ASU | Help | View All Requests</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <c:GoogleTagManager />
        <c:GoogleAnalytics />
        <c:MyASUHelpStyles />
    </head>

    <c:ASUBrandHeader siteTitleName="{!siteTitleName}" siteTitleUrl="{!siteTitleUrl}" />
    <c:ASUBrandMenu firstName="{!firstName}" lastName="{!lastName}" viewingAs="{!viewingAs}" emplId="{!emplId}" stopViewAsUrl="{!stopViewAsUrl}"
        viewAsUrl="{!viewAsUrl}" menuLinks="{!menuLinks}" />

    <c:GoogleTagManagerBody />
    <div id="asu-content-container" role="main">
        <div class="container">
            <ol class="breadcrumb">
                <li class="active">Home</li>
                <li class="active">
                    <a href="/">Help</a>
                </li>
                <li class="active">View All Requests</li>
            </ol>
            <div class="row">
                <div class="col-md-12 myasu-help-region myasu-help-region-full-width">
                    <!-- My Open Cases view -->
                    <div class="myasu-help-region-view-all-requests-pending">
                        <div class="myasu-help-region-header">Pending Requests</div>
                        <div class="myasu-help-region-my-requests-content">
                            <p class="myasu-help-region-requests-text" style="{!IF(myCases.size > 0, 'display:block;', 'display:none;')}">
                                Click the View button to see a history of your request, including chat and email history.
                            </p>
                            <apex:form>
                                <apex:pageBlock mode="maindetail">
                                    <apex:pageBlockTable rendered="{!myCases.size > 0}" value="{!myCases}" var="case" styleClass="myCasesTable">
                                        <apex:column headerValue="Subject" styleClass="truncate" width="50%" value="{!case.Subject}" style="background-color: white; overflow-x: hidden"
                                            onmousemove="this.style.backgroundColor='white'" onmouseout="this.style.backgroundColor ='white'"
                                        />
                                        <apex:column headerValue="Status" width="30%" value="{!case.Status}" style="background-color: white" onmousemove="this.style.backgroundColor='white'"
                                            onmouseout="this.style.backgroundColor ='white'" />
                                        <apex:column headerValue="Date Opened" width="15%" value="{!case.CreatedDate}" style="background-color: white" onmousemove="this.style.backgroundColor='white'"
                                            onmouseout="this.style.backgroundColor ='white'" />
                                        <apex:column width="5%" style="background-color: white; text-align: right" onmousemove="this.style.backgroundColor='white'"
                                            onmouseout="this.style.backgroundColor ='white'">
                                            <apex:commandLink value="View" styleClass="btn btn-secondary" action="{!viewCase}">
                                                <apex:param name="caseId" value="{!case.Id}" />
                                            </apex:commandLink>
                                        </apex:column>
                                    </apex:pageBlockTable>
                                    <apex:outputText rendered="{!myCases.size == 0}">
                                        <p class="myasu-help-region-my-requests-no-cases">
                                            You do not currently have any open requests.
                                        </p>
                                    </apex:outputText>
                                </apex:pageBlock>
                            </apex:form>
                        </div>
                    </div>
                    <br />
                    <!-- My Closed Cases view -->
                    <div class="myasu-help-region-view-all-requests-completed">
                        <div class="myasu-help-region-header">Completed Requests</div>
                        <div class="myasu-help-region-my-requests-content">
                            <p class="myasu-help-region-requests-text" style="{!IF(allClosedCases.size > 0, 'display:block;', 'display:none;')}">
                                Click the View button to see a history of your request, including chat and email history.
                            </p>
                            <apex:form>
                                <apex:pageBlock mode="maindetail">
                                    <apex:pageBlockTable rendered="{!allClosedCases.size > 0}" value="{!allClosedCases}" var="case" styleClass="myCasesTable">
                                        <apex:column headerValue="Subject" styleClass="truncate" width="50%" value="{!case.Subject}" style="background-color: white; overflow-x: hidden"
                                            onmousemove="this.style.backgroundColor='white'" onmouseout="this.style.backgroundColor ='white'"
                                        />

                                        <apex:column headerValue="Status" width="30%" value="{!case.Status}" style="background-color: white" onmousemove="this.style.backgroundColor='white'"
                                            onmouseout="this.style.backgroundColor ='white'" />

                                        <apex:column headerValue="Date Closed" width="15%" value="{!case.ClosedDate}" style="background-color: white" onmousemove="this.style.backgroundColor='white'"
                                            onmouseout="this.style.backgroundColor ='white'" />

                                        <apex:column width="5%" style="background-color: white; text-align: right" onmousemove="this.style.backgroundColor='white'"
                                            onmouseout="this.style.backgroundColor ='white'">
                                            <apex:commandLink value="View" styleClass="btn btn-secondary" action="{!viewCase}">
                                                <apex:param name="caseId" value="{!case.Id}" />
                                            </apex:commandLink>
                                        </apex:column>
                                    </apex:pageBlockTable>
                                    <apex:outputText rendered="{!allClosedCases.size == 0}">
                                        <p class="myasu-help-region-my-requests-no-cases">
                                            You do not currently have any completed requests.
                                        </p>
                                    </apex:outputText>
                                </apex:pageBlock>
                            </apex:form>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div id="bgWrapper">
                        <c:FeedbackButton carName="My ASU Help Tab" classes="btn btn-primary" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <c:ASUBrandFooter />
    <c:MyASUHelpPageResources masqScopeIdCookie="{!masqScopeIdCookie}" viewingAs="{!viewingAs}" />
</apex:page>