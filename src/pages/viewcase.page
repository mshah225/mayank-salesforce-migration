<apex:page docType="html-5.0"
           showHeader="false"
           sidebar="false"
           controller="viewCaseController"
           action="{!init}"
           cache="true"
           extensions="NavLinks">
    <head>
        <title>My ASU | {!caseDetails.Subject}</title>
        <c:asu_responsive_header_section linkList="{!linkList}"/>

        <style>
            .caseTab .secondaryPalette, .individualPalette .caseBlock .secondaryPalette {
                border-top-color: #990033 !important;
            }

            td, tr {
                vertical-align: middle !important;
            }

            .bPageBlock .detailList .dataCol {
                width: 100% !important;
            }

            .detailList td, .detailList th {
                vertical-align: middle !important;
                padding: 6px !important;
            }

            .detailList tr {
                border-bottom: solid 1px #e6e6e6 !important;
            }

            #newCaseForm .detailList tr {
                border-bottom: none !important;
            }

            .detailList tr:last-child {
                border-bottom: none !important;
            }

            .labelCol.vfLabelColTextWrap  {
                vertical-align: top !important;
            }

            label {
                margin-bottom: 0px !important;
            }

            .bPageBlock.brandSecondaryBrd.apexDefaultPageBlock.secondaryPalette {
                border-top-color: #990033;
            }

            .panel {
                border-radius: 0px;
                margin-bottom: 10px;
                box-shadow: 0 1px 1px rgba(0,0,0,0.05) !important;
            }

            .commentBox .content {
                padding-bottom: 0px !important;
            }

            a.emailToggle {
                text-decoration:none;
                outline: none;
                color: #990033;
                display: block;
                margin-top: 20px;
                font-weight: 600;
                width:  90px;
            }

            .emailMessage {
                font-family: Helvetica, Arial !important;
                word-wrap: break-word !important;
            }

            .emailMessage img {
                display: none !important;
            }

            .emailMessage p, .emailMessage span {
                font-family: Helvetica, Arial !important;
                font-size: 10pt !important;
                line-height: 1.5em !important;
                font-weight: 400;
            }

            .morecontent {
                display: none;
            }

            .chatUserInfo {
                font-weight: bold;
            }
        </style>

        <script>
            (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
                    (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
                m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
            })(window,document,'script','//www.google-analytics.com/analytics.js','ga');

            ga('create', 'UA-47141114-2', 'auto');
            ga('send', 'pageview');
        </script>

        <c:SCBomgarScripts asurite="{!asurite}"
                           firstName="{!firstName}"
                           lastName="{!lastName}"
                           emplId="{!emplId}"
                           viewingAs="{!viewingAs}"/>

        <script>
            var $j = jQuery.noConflict();
            $j(document).ready(function()
            {
                var showChar = 250;
                var ellipsestext = "...";
                var moretext = 'Show More <span class="caret" style="margin-bottom:2px;"></span>';
                var lesstext = 'Show Less <span class="dropup"><span class="caret"' +
                    'style="margin-bottom:2px;"></span></span>';

                $j("[id$=emailMore]").each(function()
                {
                    var content = $j(this).clone().html();
                    if (content.indexOf("Inline image") > 0)
                    {
                        content = content.replace(/\[[^\]]+\]/,'');
                        content = content.replace(/(<br\s*\/?>){2}/, '');
                    }

                    if (content.length > showChar)
                    {
                        var c = content.substr(0, showChar);
                        var h = content.substr(showChar, content.length - showChar);
                        var html = c + '<span class="moreellipses">' + ellipsestext +
                            '&nbsp;</span><span class="morecontent"><span>' + h +
                            '</span>&nbsp;&nbsp;</span><a href="" class="emailToggle">' +
                            moretext + '</a>';
                        $j(this).html(html);
                    }
                });

                $j(".emailToggle").click(function()
                {
                    if ($j(this).hasClass("less"))
                    {
                        $j(this).removeClass("less");
                        $j(this).html(moretext);
                        $j(this).prevAll(".moreellipses:first").toggle();
                    }
                    else
                    {
                        $j(this).addClass("less");
                        $j(this).html(lesstext);
                        $j(this).prevAll(".moreellipses:first").toggle();
                    }
                    $j(this).prev().toggle();
                    return false;
                });
            });
        </script>
        
    </head>

    <body>
    
    <apex:pageMessages id="message" />

    <div id="main-search" class="main-search closed"></div>

    <c:SCHeader firstName="{!firstName}"
                lastName="{!lastName}"
                viewingAs="{!viewingAs}"
                emplId="{!emplId}"
                stopViewAsUrl="{!stopViewAsUrl}"
                viewAsUrl="{!viewAsUrl}"
                linkList="{!linkList}"/>


    <div id="asu_content_well">
        <c:SCPageNotifications viewingAs="{!viewingAs}"
                               firstName="{!firstName}"
                               lastName="{!lastName}"/>

        <div class="container">

            <ol class="breadcrumb">
                <li><a href="/{!source}">Back</a></li>
                <li class="active" style="font-size:10pt;">Case Details</li>
            </ol>

            <div class="row">
                <div class="col-md-7">
                    <div class="box">
                        <div class="header">
                            <h6 class="floatleft"><b>Case &#35;{!caseDetails.CaseNumber} Details</b></h6>
                        </div>

                        <div class="content">
                            <apex:form styleClass="detailsForm">
                                <h3 style="word-wrap: break-word;">{!caseDetails.subject}</h3>
                                <br />
                                <br />
                                <apex:pageBlock tabStyle="Case" mode="maindetail">
                                    <apex:pageBlockSection collapsible="false" columns="1">
                                        <apex:outputText value="{!caseDetails.Status}" />

                                        <apex:outputField value="{!caseDetails.Subject}"/>

                                        <apex:outputField value="{!caseDetails.description}"/>
                                        

                                        <apex:outputText value="{!caseDetails.CC_Functional_Group__r.Name}"
                                                         label="Department"
                                                         rendered="{!IF(caseDetails.CC_Functional_Group__c != null,true,false)}" />

                                        <apex:outputText value="{0, date, MMMM d','  yyyy, hh:MM a z}"
                                                         label="Date Opened">
                                            <apex:param value="{!caseDetails.CreatedDate}"/>
                                        </apex:outputText>

                                        <apex:outputText rendered="{!IF(CONTAINS(caseDetails.Status,'Closed'),true,false)}"
                                                         value="{0, date, MMMM d','  yyyy, hh:MM a z}"
                                                         label="Date Closed">
                                            <apex:param value="{!caseDetails.ClosedDate}"/>
                                        </apex:outputText>

                                        <apex:outputText rendered="{!IF((caseDetails.Status == 'Closed: Resolved')
                                                && (caseDetails.Feedback_Link__c != ''),true,false)}"
                                                         value="{!caseDetails.Feedback_Link__c}"
                                                         escape="false"
                                                         styleClass="feedbackLink"
                                                         label="Feedback"/>
                                    </apex:pageBlockSection>
                                </apex:pageBlock>
                            </apex:form>
                        </div>
                    </div>
                    
                    <apex:outputPanel id="emailMessagesBox"
                                      rendered="{!IF(EmailMessages.empty,false,true)}">
                        <div class="box commentBox">
                            <div class="header">
                                <h6><b>Responses To This Case</b></h6>
                            </div>

                            <div class="content">
                                <apex:repeat value="{!EmailMessages}" var="EM">
                                    <div class="panel panel-default">
                                        <div class="panel-body">
                                            <apex:outputLabel for="emailSentDate" value="Sent Date:"/>
                                            <apex:outputText id="emailSentDate"
                                                             value="{0, date, MMMM d',' yyyy, hh:MM a z}">
                                                <apex:param value="{!EM.CreatedDate}"/>
                                            </apex:outputText>
                                            <br />
                                            <apex:outputPanel rendered="{!IF(EM.FromAddress != null,true,false)}">
                                                <apex:outputLabel for="fromAddress"
                                                                  value="From Address:"/>
                                                &nbsp;
                                                <apex:outputText id="fromAddress">
                                                {!EM.FromName} &#60;{!EM.FromAddress}&#62;
                                                </apex:outputText>
                                                <br />
                                            </apex:outputPanel>

                                            <apex:outputPanel rendered="{!IF(EM.ToAddress != null,true,false)}">
                                                <apex:outputLabel for="toAddress"
                                                                  value="To Address:"/>
                                                &nbsp;
                                                <apex:outputText id="toAddress"
                                                                 value="{!EM.ToAddress}"/>
                                                <br />
                                            </apex:outputPanel>

                                            <apex:outputPanel rendered="{!IF(EM.CCAddress != null,true,false)}">
                                                <apex:outputLabel for="ccAddress" value="CC:"/>
                                                &nbsp;
                                                <apex:outputText id="ccAddress"
                                                                 value="{!EM.CCAddress}"/>
                                                <br />
                                            </apex:outputPanel>
                                            <br />
                                            <apex:outputField id="emailMore"
                                                              styleClass="emailMessage"
                                                              value="{!EM.TextBody}"
                                                              style="word-wrap: break-word !important;"/>
                                        </div>
                                    </div>
                                </apex:repeat>
                            </div>
                        </div>
                    </apex:outputPanel>
                    
                     <apex:outputPanel id="replySection">
                        <div class="box">
                             <div class="header">
                                    <h6 class="floatleft"><b>Reply to Case or Upload Attachment</b></h6>
                            </div>
                            <div class="content">
                                <apex:form styleClass="detailsForm">
                                    <apex:outputPanel id="replyButton" >
                                        <apex:commandButton action="{!displayReplyBox}" rendered="{!showReplyButton}"
                                            value="Reply Or Add Attachment" styleClass="btn kbbtn"
                                            style="color:#fff;background:#990033;padding:5px;" reRender="replyButton, replyBox" />
                                    </apex:outputPanel>
                                </apex:form>
                                <apex:outputPanel id="replyBox">
                                     <apex:outputPanel id="replyPanel" rendered="{!showReplyBox}" >
                                        <apex:form id="replyForm" styleClass="detailsForm">
                                            <br />
                                            <apex:inputTextarea value="{!caseReply}" id="replyText" rows="10" cols="98" style="max-width: 100%; max-height: 100%;"/>
                                            <br />
                                            <br />
                                            <div class="box">
                                                <div class="header">
                                                    <h6>
                                                        <b>Upload New Attachments (Max size 25MB) </b>
                                                    </h6>
                                                </div>
                                                <br />
                                                <apex:inputFile fileName="{!replyCaseAttachment.name}" id="replyFile" value="{!replyCaseAttachment.Body}" style="float:left;"/>
                                                <script>
                                                    function validateReply() {
                                                        var filePresent = false;
                                                        var replyPresent = false;
                                                        if (document.getElementById('{!$Component.replyFile}').value.length > 0) {
                                                            filePresent = true;
                                                        }
                                                        if (document.getElementById('{!$Component.replyText}').value.trim().length > 0) {
                                                            replyPresent = true;
                                                        }
                                                        if (filePresent) {
                                                            return validateFile();
                                                        }
                                                        if (filePresent || replyPresent) {
                                                            return true;
                                                        } else {
                                                            document.getElementById('errorDiv').innerHTML = 'Error: Please add a reply or an attachment\n';
                                                        }
                                                        return false;
                                                    }
            
                                                    function validateFile() {
                                                        var errorPresent = false;
                                                        $j('input[type=file]').each(function() {
                                                            fileName = this.files[0].name;
                                                            fileSize = this.files[0].size/1000000;
                                                            var validFileTypes = ['.doc','.docx','.xls','.xlsx','.jpg', '.jpeg', '.gif', '.png', '.pdf', '.txt'];
                                                            var fileExtensionArray = fileName.split('.');
                                                            var fileExtension = '.' + fileExtensionArray[fileExtensionArray.length - 1];                      
    
                                                            if (validFileTypes.indexOf(fileExtension.toLowerCase()) == -1 ) {
                                                                document.getElementById('errorDiv').innerHTML = 
                                                                    'Error: This attachment is not an acceptable file type.\n' +
                                                                    'The following attachment types are allowed:\n' +
                                                                    'Microsoft Word (.doc or .docx)\n' +
                                                                    'Microsoft Excel (.xls or .xlsx)\n' +
                                                                    'Image (.jpg, .jpeg, .gif, .png)\n' +
                                                                    'Adobe PDF (.pdf)\n'+
                                                                    'Text (.txt)\n';
                                                                errorPresent = true;
                                                            }
                                                            
                                                            if (fileSize > 25) {
                                                                document.getElementById('errorDiv').innerHTML = 'The attachment exceeds the file size limit of 25 MB\n';
                                                                errorPresent = true;
                                                            }
                                                        });       
                                                        
                                                        if (errorPresent)
                                                            return false;
                                                        
                                                        return true;                            
                                                    }  
                                                </script>
                                                <br />
                                            </div>
                                            <div align="center" draggable="false" >
                                                <apex:commandButton action="{!clearContentsAndCloseBox}" value="Cancel" styleClass="btn kbbtn"
                                                style="color:#fff;background:#990033;padding:5px;" />
                                                <div style="width: 10px; display: inline-block;" />
                                                <apex:commandButton onclick="return validateReply();" action="{!submitReply}"
                                                value="Submit" styleClass="btn kbbtn"
                                                style="color:#fff;background:#990033;padding:5px;" />
                                            </div>
                                            <br />
                                            <div class="errorMsg" id="errorDiv" />
                                        </apex:form>
                                    </apex:outputPanel>
                                </apex:outputPanel>
                            </div>
                        </div>
                    </apex:outputPanel>
                    
                    <apex:outputPanel rendered="{!showCaseAttachments}" >
                        <apex:pageBlock >
                            <div class="row">
                                <div class="header">
                                    <h6><b>View Attachments</b></h6>
                                </div>
                                <apex:pageBlockTable value="{!allCaseAttachments}" rendered="{!showCaseAttachments}" var="eachAttachment" columns="2">
                                    <apex:column headerValue="Name">
                                        <apex:outputLink value="{!URLFOR($Action.Attachment.Download, eachAttachment.id)}" style="color:#990033;" target="_blank">{!eachAttachment.Name}</apex:outputLink>
                                    </apex:column>
                                    <apex:column headerValue="Created Date">
                                        <apex:outputText value="{0, date, MMMM d','  yyyy, hh:MM a z}"
                                            label="Date Opened">
                                            <apex:param value="{!eachAttachment.CreatedDate}"/>
                                        </apex:outputText>
                                    </apex:column>
                                </apex:pageBlockTable>
                            </div>
                        </apex:pageBlock>
                    </apex:outputPanel>
                    
                    <apex:outputPanel id="chatMessagesBox" rendered="{!IF(chatMessages.empty,false,true)}" >
                        <div class="box commentBox">
                            <div class="header">
                                <h6><b>Chat Session</b></h6>
                            </div>
                            
                            <div class="content">
                                <apex:repeat value="{!chatMessages}" var="cm">
                                    <div class="panel panel-default">
                                        <div class="panel-body">
                                            <div class="chatUserInfo">
                                                <apex:outputText id="chatUserInfo" value="{!cm.bomgar__PerformedByValue__c}"/>
                                            </div>
                                            <apex:outputText value="{!cm.bomgar__Text__c}"/>
                                        </div>
                                    </div>
                                </apex:repeat>
                            </div>
                        </div>
                    </apex:outputPanel>

                    
                </div><!-- end col-md-8 -->
                <div class="col-md-5">
                    <c:SCImmediateAssistanceBox HelpBox="{!HelpBox}"
                                                NormalPhone="{!NormalPhone}"
                                                RoverPhone="{!RoverPhone}"
                                                myPin="{!myPin}"
                                                newPin="{!newPin}"
                                                changePin="{!changePin}"/>
                    <c:SCMyCasesBox />
                </div><!-- end col-md-4-->
            </div><!-- end row -->
        </div><!-- end container -->
    </div><!-- End ASU Content -->
    <c:SCFooter />

    <script>
        if (!(navigator.userAgent.match(/Android/i)
            || navigator.userAgent.match(/webOS/i)
            || navigator.userAgent.match(/iPhone/i)
            || navigator.userAgent.match(/iPad/i)
            || navigator.userAgent.match(/iPod/i)
            || navigator.userAgent.match(/BlackBerry/i)
            || navigator.userAgent.match(/Windows Phone/i)))
        {
            document.getElementById("normalPhone").addEventListener("click", function(event){
                event.preventDefault();
            });

            document.getElementById("normalPhone").addEventListener("contextmenu", function(event){
                event.preventDefault();
            });

            document.getElementById("roverPhone").addEventListener("click", function(event){
                event.preventDefault();
            });

            document.getElementById("roverPhone").addEventListener("contextmenu", function(event){
                event.preventDefault();
            });
        }
    </script>

    <script>
        viewAsLinks();

        function viewAsLinks() {
            var masqCookie = "{!masqScopeIdCookie}";
            var viewingAs = "{!viewingAs}";
            if (masqCookie != "" && viewingAs == "true") {
                $j("a").each(function() {
                    var href = this.href;
                    if (href.indexOf("force") > -1)
                    {
                        if (href.indexOf("?") != -1) {
                            href = href + "&masqScopeIdCookie={!masqScopeIdCookie}";
                        }
                        else {
                            href = href + "?masqScopeIdCookie={!masqScopeIdCookie}";
                        }
                        $j(this).attr("href", href);
                    }
                });
            }
        }
    </script>
    </body>

</apex:page>