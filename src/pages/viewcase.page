            padding-bottom: 0px !important;
        }
        
        a.emailToggle {
            text-decoration:none;
            outline: none;
            color: #990033;
        }
        
        .moreContent {
            display: none;
        }
        
        .emailMessage {
            font-family: Helvetica, Arial !important;
            overflow: hidden;
        }
        
        .emailMessage p, .emailMessage span {
