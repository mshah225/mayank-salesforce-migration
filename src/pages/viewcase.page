                                    <button id="hidePinBtn" class="viewPin" type="button" style="display:none;">Hide PIN</button>

                                    <button id="resetPin" class="resetPin kbbtn" type="button">Reset</button>

                                    <apex:inputText id="newPinInput" value="{!newPin}" html-placeholder="New PIN" onkeypress="return inputLimiter(event,'Numbers');" maxlength="10" styleClass="pinBoxInput" style="display:none;"/>
                                    <apex:commandButton id="savePinBtn" value="Save" action="{!changePin}" styleClass="savePin" style="display:none;"/>
                                    <button id="cancelPinInput" class="resetPin kbbtn" onclick="this.form.reset();" style="display:none;" type="button">Cancel</button>
                                    <p style="margin-top:5px;">Select <b>View</b> when calling to access confidential information about your financial aid and account balance.</p>
                                </div>

                                <script>
                                    $( "[id$=qmarkPin]" ).click(function() {
                                        $( "[id$=tooltipPin]" ).show();
                                    });

                                    $( "[id$=closeTooltip]" ).click(function() {
                                        $( "[id$=tooltipPin]" ).hide();
                                    });

                                    $(document).mouseup(function (e) {
                                        var container = $( "[id$=tooltipPin]" );
                                        if (!container.is(e.target) && container.has(e.target).length === 0) {
                                            container.hide();
                                        }
                                    });
                                </script>

                                <script>
                                    $( "[id$=viewPinBtn]" ).click(function() {
                                        $( "[id$=yourPinHidden]" ).hide();
                                        $( "[id$=viewPinBtn]" ).hide();
                                        $( "[id$=hidePinBtn]" ).show();
                                        $( "[id$=yourPin]" ).show();
                                    });

                                    $( "[id$=hidePinBtn]" ).click(function() {
                                        $( "[id$=hidePinBtn]" ).hide();
                                        $( "[id$=yourPin]" ).hide();
                                        $( "[id$=yourPinHidden]" ).show();
                                        $( "[id$=yourPinHidden]" ).val( "••••••••••" );
                                        $( "[id$=viewPinBtn]" ).show();
                                    });

                                    $( "[id$=resetPin]" ).click(function() {
                                        $( "[id$=hidePinBtn]" ).hide();
                                        $( "[id$=yourPin]" ).hide();
                                        $( "[id$=yourPinHidden]" ).hide();
                                        $( "[id$=viewPinBtn]" ).hide();
                                        $( "[id$=resetPin]" ).hide();
                                        $( "[id$=newPinInput]" ).show().focus();
                                        $( "[id$=savePinBtn]" ).show();
                                        $( "[id$=cancelPinInput]" ).show();
                                    });

                                    $( "[id$=cancelPinInput]" ).click(function() {
                                        $( "[id$=yourPinHidden]" ).show();
                                        $( "[id$=yourPinHidden]" ).val( "••••••••••" );
                                        $( "[id$=yourPin]" ).hide();
                                        $( "[id$=viewPinBtn]" ).show();
                                        $( "[id$=resetPin]" ).show();
                                        $( "[id$=newPinInput]" ).hide();
                                        $( "[id$=savePinBtn]" ).hide();
                                        $( "[id$=cancelPinInput]" ).hide();
                                    });

                                    $( document ).ready(function() {
                                        $( "[id$=yourPinHidden]" ).val( "••••••••••" );
                                        $( "[id$=newPinInput]" ).val( "" );
                                    });

                                    function inputLimiter(e,allow) {
                                        var AllowableCharacters = '';

                                        if (allow == 'Letters'){AllowableCharacters=' ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';}
                                        if (allow == 'Numbers'){AllowableCharacters='1234567890';}
                                        if (allow == 'NameCharacters'){AllowableCharacters=' ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-.\'';}
                                        if (allow == 'NameCharactersAndNumbers'){AllowableCharacters='1234567890 ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-\'';}
                                        if (allow == 'Currency'){AllowableCharacters='1234567890.';}

                                        var k = document.getElementById('newPinInput')?parseInt(e.keyCode): parseInt(e.which);
                                        if (k!=13 && k!=8 && k!=0){
                                            if ((e.ctrlKey==false) && (e.altKey==false)) {
                                            return (AllowableCharacters.indexOf(String.fromCharCode(k))!=-1);
                                            } else {
                                            return true;
                                            }
                                        } else {
                                            return true;
                                        }
                                    }
                                </script>
                            </apex:form>
                        </apex:outputPanel>

                        <hr />

                        <div class="dropdown" style="display:inline-block">
                            <button type="button" class="btn kbbtn dropdown-toggle" style="width:160px;color:#fff;background:#990033;padding:5px;" data-toggle="dropdown" href="//asu.edu/helpchat">
                                <span class="glyphicon glyphicon-comment pull-left" style="padding-left:10px;"></span>
                                Live Chat &nbsp;
                                <span class="caret"></span>
                            </button>
                            <ul class="dropdown-menu">
                                <li><a id="faChat" class="chat-link">Finances</a></li>

                                <li><a id="bomgarChat" class="chat-link">Other</a></li>
                           </ul>
                        </div>

                            <script>
                                $( "#bomgarChat" ).click(function() {
                                    $( "#bomgarChatForm" ).slideToggle( "700");
                                    $( "#faChatForm" ).slideUp( "700" );
                                });

                                $( "#faChat" ).click(function() {
                                    $( "#bomgarChatForm" ).slideUp( "700");
                                    $( "#faChatForm" ).slideToggle( "700" );
                                });
                            </script>

                            <div id="bomgarChatForm" style="margin-top:20px;display:none;">
                                <apex:pageBlock >
                                    <h5>Get Help</h5><br /><br />
                                    <textarea id="description" placeholder="Enter a brief description of your issue" rows="6" style="width:100%;max-width:300px;resize:none;padding: 5px;border-radius: 2px;border: solid 1px #999;"></textarea><br />
                                    <apex:pageBlockButtons location="bottom">
                                        <button name="chat" class="btn kbbtn" style="color:#fff;background:#990033;padding:5px;" onClick="start();width:60px;">Start Chat</button>
                                    </apex:pageBlockButtons>
                                </apex:pageBlock>
                            </div>

                            <div id="faChatForm" style="margin-top:20px;display:none;">
                                <apex:pageBlock >
                                    <h5>Get Help with Finances</h5><br /><br />
                                    <textarea id="FADesc" placeholder="Enter a brief description of your issue" rows="6" style="width:100%;max-width:300px;resize:none;padding: 5px;border-radius: 2px;border: solid 1px #999;"></textarea><br />
                                    <apex:pageBlockButtons location="bottom">
                                        <button name="chat" class="btn kbbtn" style="color:#fff;background:#990033;padding:5px;width:60px;" onClick="startFAChat();">Start Chat</button>
                                    </apex:pageBlockButtons>
                                </apex:pageBlock>
                            </div>
                        </div>
                    </div>
                </apex:outputPanel>


             <div class="box">
                <div class="header">
                    <h6><b>My Cases</b></h6>
                </div>
                <div class="content box-padding" id="crm_content" >
                        <p>Save time and submit your question or support request online.</p>
                        <button id="showNewCase" class="btn kbbtn" style="color:#fff;background:#990033;padding:5px;width:75px;">New Case</button>
                        <button id="cancel" class="btn kbbtn" style="display:none;color:#fff;background:#990033;padding:5px;width:75px;">My Cases</button><br /><br />

                        <script>
                            $( "#showNewCase" ).click(function() {
                                $( "#newCaseForm" ).slideToggle( "700" );
                                $( "#myCases" ).slideToggle( "700" );
                                $( "#showNewCase" ).hide();
                                $( "#cancel" ).show();
                                $( "[id$=caseSubject]" ).focus(700);
                            });

                            $( "#cancel" ).click(function() {
                                $( "#newCaseForm" ).slideToggle( "700" );
                                $( "#myCases" ).slideToggle( "700" );
                                $( "#showNewCase" ).show();
                                $( "#cancel" ).hide();
                            });
                        </script>

                        <div id="myCases">
                        <apex:form >
                            <h5>My Open Cases</h5>
                            <apex:pageBlock mode="maindetail">
                                <apex:pageBlockTable rendered="{!(myCases.size >= 1)}" value="{!myCases}" var="case" styleClass="myCasesTable">
                                    <apex:column headerValue="Subject" styleClass="truncate" width="66%" value="{!case.Subject}" style="background-color:white;" onmousemove="this.style.backgroundColor='white'" onmouseout="this.style.backgroundColor ='white'"/>
                                    <apex:column headerValue="Status" width="33%" value="{!case.Status}" style="background-color:white;" onmousemove="this.style.backgroundColor='white'" onmouseout="this.style.backgroundColor ='white'"/>
                                    <apex:column width="33%" onmousemove="this.style.backgroundColor='white'" style="background-color:white;" onmouseout="this.style.backgroundColor ='white'">
                                        <apex:commandLink value="View" styleClass="btn" style="padding:4px;" action="{!viewCase}">
                                            <apex:param name="caseId" value="{!case.Id}"/>
                                        </apex:commandLink>
                                    </apex:column>
                                </apex:pageBlockTable>
                                <apex:outputText rendered="{!(myCases.size = 0)}">
                                    <div class="padClass"> You do not have any open cases. </div>
                                </apex:outputText>
                            </apex:pageBlock>
                        </apex:form>

                        <br />
                        <apex:form >
                            <h5>My Closed Cases</h5>
                            <apex:pageBlock mode="maindetail">
                                <apex:pageBlockTable rendered="{!(closedCases.size >= 1)}" value="{!closedCases}" var="case" styleClass="myCasesTable">
                                    <apex:column headerValue="Subject" styleClass="truncate" width="66%" value="{!case.Subject}" style="background-color:white;" onmousemove="this.style.backgroundColor='white'" onmouseout="this.style.backgroundColor ='white'"/>
                                    <apex:column headerValue="Status" width="33%" value="{!case.Status}" style="background-color:white;" onmousemove="this.style.backgroundColor='white'" onmouseout="this.style.backgroundColor ='white'"/>
                                    <apex:column width="33%" style="background-color:white;" onmousemove="this.style.backgroundColor='white'" onmouseout="this.style.backgroundColor ='white'">
                                        <apex:commandLink value="View" styleClass="btn" style="padding:4px;" action="{!viewCase}">
                                            <apex:param name="caseId" value="{!case.Id}"/>
                                        </apex:commandLink>
                                    </apex:column>
                                </apex:pageBlockTable>
                                <apex:outputText rendered="{!(closedCases.size = 0)}">
                                    <div class="padClass"> You do not have any closed cases. </div>
                                </apex:outputText>
                            </apex:pageBlock>
                        </apex:form>

                        <div style="text-align:right">
                            <br />
                            <apex:form >
                                <apex:pageBlock mode="maindetail">
                                    <a href="/viewAllCases?source=studentSC" style="padding:4px" class="btn">
                                        View All Cases
                                    </a>
                                </apex:pageBlock>
                            </apex:form>
                        </div>

                        </div>

                        <script>
                            jQuery(document).ready(function($){
                                $("td.truncate").each(function(){
                                        if ($(this).text().length > 99) {
                                            $(this).text($(this).text().substr(0, 99));
                                            $(this).append('...');
                                        }
                                    });
                            });
                        </script>

                        <div id="newCaseForm" style="display:none">
                            <apex:form style="width:100%">
                                <h5>Create a New Case</h5>
                                <div style="height:5px;"></div>
                                <apex:pageBlock >
                                    <apex:pageBlockSection collapsible="false" columns="1">
                                        <label for="caseSubject" style="margin-bottom:0px;">Subject</label>
                                        <apex:inputField id="caseSubject" styleClass="caseField" value="{!c.subject}" required="true" label="" html-placeholder="Enter a subject"/>
                                        <br />
                                        <label for="caseDesc" style="margin-bottom:0px;">Description</label>
                                        <apex:inputField id="caseDesc" styleClass="caseField" value="{!c.description}" required="true" style="height:100px;resize:none;" label="" html-placeholder="Enter a description"/>
                                        <apex:outputText id="newCaseHelpText">Responses to your case will be sent to your official ASU email or the email account you are forwarding your ASU email to.</apex:outputText>
                                    </apex:pageBlockSection>
                                    <apex:pageblockbuttons location="bottom">
                                        <apex:commandButton action="{!submitCase}" value="Submit" styleClass="btn kbbtn" style="color:#fff;background:#990033;padding:5px;width:55px;"/>
                                    </apex:pageblockbuttons>
                                </apex:pageBlock>
                            </apex:form>
                        </div>
                    </div>
                </div><!-- end box -->
            </div>
        </div>
    </div>

        <div style="float:right;margin:1em;">
            <a href="/feedback">
                <img src="https://webapp4.asu.edu/myasu/images/feedback-1-web.jpg" alt="Feedback" title="Please leave your feedback" onmouseover="this.src='https://webapp4.asu.edu/myasu/images/feedback-2-web.jpg'" onmouseout="this.src='https://webapp4.asu.edu/myasu/images/feedback-1-web.jpg'" border="0"/>
            </a>
