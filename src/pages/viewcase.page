                                    <input type="text" class="hidden" name="SESSIONVAR!UserID" value="{!$User.EmplId__c}" />
                                    <input type="text" class="hidden" name="SESSIONVAR!identifier" value="{!$User.Contact_First_Name__c}" />
                                    <input type="text" class="hidden" name="SESSIONVAR!LastName" value="{!$User.Contact_Last_Name__c}" />
                                    <input type="text" class="hidden" name="SESSIONVAR!ASU_Request_Type" value="BbSS Chat" /> 
                                    <input type="text" class="hidden" name="SESSIONVAR!ASU_Request_Type_Detail" value="BbSS Chat" />
                                    <textarea id="caseDescription" maxlength="32000" name="SESSIONVAR!ASU_Request_Description" rows="6" style="width:100%;max-width:300px;resize:none;" placeholder="Enter a brief description of your issue"></textarea><br />
                                    <apex:pageBlockButtons location="bottom">
                                        <input type="submit" id="faChatSubmit" class="btn kbbtn" style="color:#fff;background:#990033;padding:5px;" value="Start Chat" />
                                    </apex:pageBlockButtons>
                                </apex:pageBlock>
                            </form>  
                        </div>
                    </div>
                </apex:outputPanel>
        
            
             <div class="box">
                <div class="header">
                    <h6><b>My Cases</b></h6>
                </div>
                <div class="content box-padding" id="crm_content" >
                        <p>Save time and submit your question or support request online.</p>
                        <button id="showNewCase" class="btn kbbtn" style="color:#fff;background:#990033;padding:5px;">New Case</button>
                        <button id="cancel" class="btn kbbtn" style="display:none;color:#fff;background:#990033;padding:5px;"><span class="glyphicon glyphicon-chevron-left"></span>&nbsp;&nbsp;My Cases</button><br /><br />
                        
                        <script>
                            $( "#showNewCase" ).click(function() {
                                $( "#newCaseForm" ).slideToggle( "700" );
                                $( "#myCases" ).slideToggle( "700" );
                                $( "#showNewCase" ).hide();
                                $( "#cancel" ).show();
                            });
                            
                            $( "#cancel" ).click(function() {
                                $( "#newCaseForm" ).slideToggle( "700" );
                                $( "#myCases" ).slideToggle( "700" );
                                $( "#showNewCase" ).show();
                                $( "#cancel" ).hide();
                            });
                        </script>
                        
                        <div id="myCases">
                        <apex:form >
                            <h5>Cases I've Opened</h5>
                            <apex:pageBlock mode="maindetail">
                                <apex:pageBlockTable rendered="{!(myCases.size >= 1)}" value="{!myCases}" var="case" styleClass="myCasesTable">
                                    <apex:column headerValue="Subject" styleClass="truncate" width="66%" value="{!case.Subject}" style="background-color:white;" onmousemove="this.style.backgroundColor='white'" onmouseout="this.style.backgroundColor ='white'"/>
                                    <apex:column headerValue="Status" width="33%" value="{!case.Status}" style="background-color:white;" onmousemove="this.style.backgroundColor='white'" onmouseout="this.style.backgroundColor ='white'"/>
                                    <apex:column width="33%" onmousemove="this.style.backgroundColor='white'" style="background-color:white;" onmouseout="this.style.backgroundColor ='white'">
                                        <apex:commandLink value="View" styleClass="btn" style="padding:4px;" action="{!viewCase}">
                                            <apex:param name="caseId" value="{!case.Id}"/>
                                        </apex:commandLink>
                                    </apex:column>
                                </apex:pageBlockTable>
                                <apex:outputText rendered="{!(myCases.size = 0)}" value="You do not have any open cases." />
                            </apex:pageBlock>
                        </apex:form>
    
                        <br />
                        <apex:form >
                            <h5>My Closed Cases</h5>
                            <apex:pageBlock mode="maindetail">
                                <apex:pageBlockTable rendered="{!(closedCases.size >= 1)}" value="{!closedCases}" var="case" styleClass="myCasesTable">
                                    <apex:column headerValue="Subject" styleClass="truncate" width="66%" value="{!case.Subject}" style="background-color:white;overflow-x:hidden;" onmousemove="this.style.backgroundColor='white'" onmouseout="this.style.backgroundColor ='white'"/>
                                    <apex:column headerValue="Status" width="33%" value="{!case.Status}" style="background-color:white;" onmousemove="this.style.backgroundColor='white'" onmouseout="this.style.backgroundColor ='white'"/>
                                    <apex:column width="33%" style="background-color:white;" onmousemove="this.style.backgroundColor='white'" onmouseout="this.style.backgroundColor ='white'">
                                        <apex:commandLink value="View" styleClass="btn" style="padding:4px;" action="{!viewCase}">
                                            <apex:param name="caseId" value="{!case.Id}"/>
                                        </apex:commandLink>
                                    </apex:column>
                                </apex:pageBlockTable>
                                <apex:outputText rendered="{!(closedCases.size = 0)}" value="You do not have any closed cases." />
                            </apex:pageBlock>
                        </apex:form>
                        </div>
                        
                        <script>
                            jQuery(document).ready(function($){
                                $("td.truncate").each(function(){
                                        if ($(this).text().length > 30) {
                                            $(this).text($(this).text().substr(0, 27));
                                            $(this).append('...');
                                        }
                                    });
                            });
                        </script>
                    
                        
