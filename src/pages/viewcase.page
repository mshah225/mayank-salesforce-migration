<apex:page showHeader="false"
    sidebar="false"
    cache="true"
    docType="html-5.0"
    controller="ServiceCenter"
    action="{!init}"
    extensions="NavLinks">
<head>
    <title>My ASU | {!caseDetails.Subject}</title>
    <c:asu_responsive_header_section />
    
    <style>
        .caseTab .secondaryPalette, .individualPalette .caseBlock .secondaryPalette {
            border-top-color: #990033 !important;
        }

        td, tr {
           vertical-align: middle !important;
        }

        .bPageBlock .detailList .dataCol {
            width: 100% !important;
        }

        .detailList td, .detailList th {
            vertical-align: middle !important;
            padding: 6px !important;
        }

        .detailList tr {
            border-bottom: solid 1px #e6e6e6 !important;
        }

        #newCaseForm .detailList tr {
            border-bottom: none !important;
        }

        .detailList tr:last-child {
            border-bottom: none !important;
        }

        .labelCol.vfLabelColTextWrap  {
            vertical-align: top !important;
        }

        label {
            margin-bottom: 0px !important;
        }

        .bPageBlock.brandSecondaryBrd.apexDefaultPageBlock.secondaryPalette {
            border-top-color: #990033;
        }

        .panel {
            border-radius: 0px;
            margin-bottom: 10px;
            box-shadow: 0 1px 1px rgba(0,0,0,0.05) !important;
        }

        .commentBox .content {
            padding-bottom: 0px !important;
        }

        a.emailToggle {
            text-decoration:none;
            outline: none;
            color: #990033;
            display: block;
            margin-top: 20px;
            font-weight: 600;
            width:  90px;
        }

        .emailMessage {
            font-family: Helvetica, Arial !important;
            word-wrap: break-word !important;
        }

        .emailMessage img {
            display: none !important;
        }

        .emailMessage p, .emailMessage span {
            font-family: Helvetica, Arial !important;
            font-size: 10pt !important;
            line-height: 1.5em !important;
            font-weight: 400;
        }

        .morecontent {
            display: none;
        }
    </style>

    <script>
        (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
        (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
        m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
        })(window,document,'script','//www.google-analytics.com/analytics.js','ga');

        ga('create', 'UA-47141114-2', 'auto');
        ga('send', 'pageview');
    </script>

    <c:SCBomgarScripts asurite="{!userContact.ASURite_Id__c}"/>

    <script>
        $(document).ready(function()
        {
            var showChar = 250;
            var ellipsestext = "...";
            var moretext = 'Show More <span class="caret" style="margin-bottom:2px;"></span>';
            var lesstext = 'Show Less <span class="dropup"><span class="caret"  style="margin-bottom:2px;"></span></span>';
            $("[id$=emailMore]").each(function()
            {
                var content = $(this).clone().html();
                if (content.indexOf("Inline image") > 0)
                {
                    content = content.replace(/\[[^\]]+\]/,'');
                    content = content.replace(/(<br\s*\/?>){2}/, '');
                }

                if (content.length > showChar)
                {
                    var c = content.substr(0, showChar);
                    var h = content.substr(showChar, content.length - showChar);
                    var html = c + '<span class="moreellipses">' + ellipsestext+ '&nbsp;</span><span class="morecontent"><span>' + h + '</span>&nbsp;&nbsp;</span><a href="" class="emailToggle">' + moretext + '</a>';
                    $(this).html(html);
                }

            });

            $(".emailToggle").click(function()
            {
                if ($(this).hasClass("less"))
                {
                    $(this).removeClass("less");
                    $(this).html(moretext);
                    $(this).prevAll(".moreellipses:first").toggle();
                }
                else
                {
                    $(this).addClass("less");
                    $(this).html(lesstext);
                    $(this).prevAll(".moreellipses:first").toggle();
                }
                $(this).prev().toggle();
                return false;
            });
        });
    </script>
</head>

<body>
    <div id="main-search" class="main-search closed"></div>
    <c:SCHeader />

    <div id="asu_content_well">
        <c:SCPageNotifications/>

        <div class="container">

            <ol class="breadcrumb">
                <li><a href="/{!source}">Back</a></li>
                <li class="active" style="font-size:10pt;">Case Details</li>
            </ol>

            <div class="row">
                <div class="col-md-7">
                    <div class="box">
                        <div class="header">
                            <h6 class="floatleft"><b>Case &#35;{!caseDetails.CaseNumber} Details</b></h6>
                        </div>

                        <div class="content">
                            <apex:form styleClass="detailsForm">
                              <h3 style="word-wrap: break-word;">{!caseDetails.subject}</h3><br /><br />
                                <apex:pageBlock tabStyle="Case" mode="maindetail">
                                    <apex:pageBlockSection collapsible="false" columns="1">
                                        <apex:outputText value="{!caseDetails.Status}" />
                                        <apex:outputField value="{!caseDetails.Subject}"/>
                                        <apex:outputField value="{!caseDetails.description}"/>
                                        <apex:outputText value="{!caseDetails.Functional_Group__c}" label="Department" rendered="{!IF(caseDetails.Functional_Group__c != null,true,false)}"/>
                                        <apex:outputText value="{0, date, MMMM d','  yyyy, hh:MM a z}" label="Date Opened">
                                            <apex:param value="{!caseDetails.CreatedDate}"/>
                                        </apex:outputText>
                                        <apex:outputText rendered="{!IF(CONTAINS(caseDetails.Status,'Closed'),true,false)}" value="{0, date, MMMM d','  yyyy, hh:MM a z}" label="Date Closed">
                                            <apex:param value="{!caseDetails.ClosedDate}"/>
                                        </apex:outputText>
                                        <apex:outputText rendered="{!IF((caseDetails.Status == 'Closed: Resolved') && (caseDetails.Feedback_Link__c != ''),true,false)}" value="{!caseDetails.Feedback_Link__c}" escape="false" styleClass="feedbackLink" label="Feedback"/>
                                  </apex:pageBlockSection>
                                </apex:pageBlock>
                            </apex:form>
                        </div>
                    </div>

                    <apex:outputPanel id="emailMessagesBox" rendered="{!IF(EmailMessages.empty,false,true)}">
                        <div class="box commentBox">
                        <div class="header">
                            <h6><b>Responses To This Case</b></h6>
                        </div>
                            <div class="content">
                                <apex:repeat value="{!EmailMessages}" var="EM">
                                    <div class="panel panel-default">
                                        <div class="panel-body">
                                            <apex:outputLabel for="emailSentDate" value="Sent Date:"/>
                                            <apex:outputText id="emailSentDate" value="{0, date, MMMM d','  yyyy, hh:MM a z}">
                                                <apex:param value="{!EM.CreatedDate}"/>
                                            </apex:outputText><br />

                                            <apex:outputPanel rendered="{!IF(EM.FromAddress != null,true,false)}">
                                                <apex:outputLabel for="fromAddress" value="From Address:"/>&nbsp;
                                                <apex:outputText id="fromAddress">{!EM.FromName} &#60;{!EM.FromAddress}&#62;</apex:outputText><br />
                                            </apex:outputPanel>

                                            <apex:outputPanel rendered="{!IF(EM.ToAddress != null,true,false)}">
                                                <apex:outputLabel for="toAddress" value="To Address:"/>&nbsp;
                                                <apex:outputText id="toAddress" value="{!EM.ToAddress}"/><br />
                                            </apex:outputPanel>

                                            <apex:outputPanel rendered="{!IF(EM.CCAddress != null,true,false)}">
                                                <apex:outputLabel for="ccAddress" value="CC:"/>&nbsp;
                                                <apex:outputText id="ccAddress" value="{!EM.CCAddress}"/><br />
                                            </apex:outputPanel>
                                            <br />
                                            <apex:outputField id="emailMore" styleClass="emailMessage" value="{!EM.TextBody}" style="word-wrap: break-word !important;"/>
                                        </div>
                                    </div>
                                </apex:repeat>
                            </div>
                        </div>
                    </apex:outputPanel>
                </div><!-- end col-md-8 -->

                <div class="col-md-5">
                    <c:SCImmediateAssistanceBox HelpBox="{!HelpBox}"
                                                NormalPhone="{!NormalPhone}"
                                                RoverPhone="{!RoverPhone}"
                                                myPin="{!myPin}"
                                                newPin="{!newPin}"
                                                changePin="{!changePin}"/>
                    <c:SCMyCasesBox/>
                </div><!-- end col-md-4-->
            </div><!-- end row -->
        </div><!-- end container -->
        <c:SCFooter />
    </div><!-- End ASU Content -->

    <script>
        if (!(navigator.userAgent.match(/Android/i)
             || navigator.userAgent.match(/webOS/i)
             || navigator.userAgent.match(/iPhone/i)
             || navigator.userAgent.match(/iPad/i)
             || navigator.userAgent.match(/iPod/i)
             || navigator.userAgent.match(/BlackBerry/i)
             || navigator.userAgent.match(/Windows Phone/i)))
        {
            document.getElementById("normalPhone").addEventListener("click", function(event){
                event.preventDefault();
            });

            document.getElementById("normalPhone").addEventListener("contextmenu", function(event){
                event.preventDefault();
            });

            document.getElementById("roverPhone").addEventListener("click", function(event){
                event.preventDefault();
            });

            document.getElementById("roverPhone").addEventListener("contextmenu", function(event){
                event.preventDefault();
            });
        }
    </script>
</body>
</apex:page>
