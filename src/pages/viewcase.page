                                    <textarea id="description" placeholder="Enter a brief description of your issue" rows="6" style="width:100%;max-width:300px;resize:none;"></textarea><br />
                                    <apex:pageBlockButtons location="bottom">
                                        <button name="chat" class="btn kbbtn" style="color:#fff;background:#990033;padding:5px;" onClick="start();">Start Chat</button>
                                    </apex:pageBlockButtons>
                                </apex:pageBlock>
