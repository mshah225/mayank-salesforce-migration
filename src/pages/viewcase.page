                                $( "#faChat" ).click(function() {
                                    $( "#bomgarChatForm" ).slideUp( "700");
                                    $( "#faChatForm" ).slideToggle( "700" );
                                });
                            </script>
                            
                            <div id="bomgarChatForm" style="margin-top:5px;display:none;">
