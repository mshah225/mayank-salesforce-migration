    <script src="https://bomgar.asu.edu/api/start_session.js"></script>
    <script>
        BG.setSite("bomgar.asu.edu");
        var custName = "{!$Component.customer_name}";
        var desc = "{!$Component.description}";
        var emplid = "{!$User.EmplId__c}";
    
        function start(){
            var jsonString = null;
            var jsonObject = {};
            jsonObject.employeeNumber = emplid;
            jsonObject.description = document.getElementById('description').value;
            try{
                jsonString = JSON.stringify(jsonObject);
            }
            catch(e){
            
            }
            if(jsonString == null){
                jsonString = '{"employeeNumber":"{!$User.EmplId__c}", "description":"' + document.getElementById('description').value + '"}';
            }
                     
            BG.start(BG.START_TYPE.CHAT, {
                issue: {
                    codeName: 'salesforce_chat',
                    customerName: '{!$User.Contact_First_Name__c} {!$User.Contact_Last_Name__c}',
                    companyName: 'ASU',
                    details: document.getElementById('description').value
                },
                attributes:{
                    externalKey: ('SFDC:' + jsonString)
                },
                uiOptions:{
                    fallbackToFullWindow:true
                }
            });              
        }
    </script>

    <script>
        $(document).ready(function() {
            var showChar = 200;
            var ellipsestext = "...";
            var moretext = "...Show More";
            var lesstext = "Show Less";
            $('.emailMessage').each(function() {
                var content = $(this).html();
        
                if(content.length > showChar) {
        
                    var c = content.substr(0, showChar);
                    var h = content.substr(showChar, content.length - showChar);
                    var shortHtml = c + '<span class="moreEllipses">' + ellipsestext + '</span>';
                    var longHtml = c + '<span class="moreContent"><span>' + h + '</span></span>&nbsp;<a href="" class="emailToggle">' + moretext + '</a>';
        
                    if($(this).hasClass("less")) {
                        $(this).html(shortHtml);
                    } else {
                        $(this).html(longHtml);
                    }
                }
        
            });
        
            $(".emailToggle").click(function(){
                if($(this).hasClass("less")) {
                    $(this).removeClass("less");
                    $(this).html(moretext);
                } else {
                    $(this).addClass("less");
                    $(this).html(lesstext);
                }
                $(this).parent().prev().fadeToggle();
                $(this).prev().fadeToggle();
                return false;
            });
        });
    </script>
</head>

